---
// src/components/PerfProbe.astro
//
// A TEMPORARY diagnostic. Same idea as the ?grid overlay: everything is
// gated behind a query parameter, so it costs nothing and renders nothing
// unless you ask for it. Delete this file and its one import when done.
//
// WHY IT EXISTS: the Firefox-mobile slowness can't be bisected the usual
// way, because there is no DevTools on a phone to paste CSS overrides
// into. And judging "did that help?" by feel has already misled us once —
// blanking the foxing appeared to help, but baking it to raster did not,
// which only makes sense if the cost was the mask/blend on that layer
// rather than the filter behind it. So this measures instead of asking.
//
// USE:
//   /?perf=off    HUD only, nothing disabled (this is your baseline)
//   /?perf=a      foxing mask-image off      (keeps texture + blend)
//   /?perf=b      foxing mix-blend-mode off  (keeps texture + mask)
//   /?perf=c      foxing layer not painted   (the original bisect winner)
//   /?perf=d      .book filter off           (tests 3D-scene flattening)
//   /?perf=e      .book clip-path off        (tests the clip-mask path)
//   /?perf=f      leaf turn shadow-pulse off (animated filter per frame)
//   /?perf=g      cover width transition off (layout per frame, 0.9s)
//   /?perf=all    everything above off       (the floor — how fast CAN it be?)
//
// Tap RUN to drive a fixed workload (eight page turns, opening the cover
// first if needed) while sampling frame times. Compare p95 and JANK across
// modes, not the average — the average hides exactly the stalls you feel.
//
// READ THE NUMBERS, NOT THE FEEL. A mode is only interesting if it moves
// p95 or jank materially against ?perf=off on the SAME device and build.
---

<div id="perf-probe" hidden>
  <div class="pp-row"><strong id="pp-mode">off</strong><span id="pp-live">–</span></div>
  <div class="pp-row"><button id="pp-run" type="button">RUN</button><span id="pp-out">tap RUN</span></div>
  <div class="pp-row pp-modes" id="pp-modes"></div>
</div>

<style is:global>
  /* ── the overrides being bisected ─────────────────────────────────
     Deliberately plain: no filter, blend, mask or transform anywhere in
     this file's own UI, so the probe can't contaminate what it measures. */

  [data-perf="a"] .leaf-face--front::after,
  [data-perf="a"] .leaf-face--back::after,
  [data-perf="all"] .leaf-face--front::after,
  [data-perf="all"] .leaf-face--back::after {
    -webkit-mask-image: none !important;
    mask-image: none !important;
  }

  [data-perf="b"] .leaf-face--front::after,
  [data-perf="b"] .leaf-face--back::after,
  [data-perf="all"] .leaf-face--front::after,
  [data-perf="all"] .leaf-face--back::after {
    mix-blend-mode: normal !important;
  }

  [data-perf="c"] .leaf-face--front::after,
  [data-perf="c"] .leaf-face--back::after,
  [data-perf="all"] .leaf-face--front::after,
  [data-perf="all"] .leaf-face--back::after {
    display: none !important;
  }

  [data-perf="d"] .book,
  [data-perf="all"] .book { filter: none !important; }

  [data-perf="e"] .book,
  [data-perf="all"] .book { clip-path: none !important; }

  [data-perf="f"] .leaf.is-turning,
  [data-perf="all"] .leaf.is-turning { animation: none !important; }

  [data-perf="g"] .cover,
  [data-perf="all"] .cover { transition: none !important; }

  /* ── the HUD ─────────────────────────────────────────────────── */
  #perf-probe {
    position: fixed;
    left: 0; right: 0; bottom: 0;
    z-index: 99999;
    background: #111;
    color: #eee;
    font: 12px/1.4 ui-monospace, Menlo, monospace;
    padding: 6px 8px calc(6px + env(safe-area-inset-bottom, 0px));
    display: grid;
    gap: 4px;
  }
  #perf-probe[hidden] { display: none; }
  .pp-row { display: flex; gap: 8px; align-items: center; }
  .pp-modes { flex-wrap: wrap; gap: 4px; }
  #perf-probe a, #perf-probe button {
    color: #eee;
    background: #333;
    border: 1px solid #555;
    border-radius: 3px;
    padding: 4px 7px;
    text-decoration: none;
    font: inherit;
    min-height: 28px;
    display: inline-flex;
    align-items: center;
  }
  #perf-probe a[aria-current="true"] { background: #B85A38; border-color: #B85A38; }
  #pp-out { flex: 1; }
</style>

<script is:inline>
  (function () {
    var MODES = ['off','a','b','c','d','e','f','g','all'];
    var params = new URLSearchParams(location.search);
    if (!params.has('perf')) return;                    // renders nothing unless asked

    var mode = params.get('perf') || 'off';
    if (MODES.indexOf(mode) === -1) mode = 'off';
    document.documentElement.dataset.perf = mode;

    var box = document.getElementById('perf-probe');
    if (!box) return;
    box.hidden = false;
    document.getElementById('pp-mode').textContent = 'perf=' + mode;

    // mode switcher: plain links, so each mode is a real page load and no
    // state carries over from the previous measurement
    var nav = document.getElementById('pp-modes');
    MODES.forEach(function (m) {
      var a = document.createElement('a');
      a.href = '?perf=' + m;
      a.textContent = m;
      if (m === mode) a.setAttribute('aria-current', 'true');
      nav.appendChild(a);
    });

    // ── frame sampling ───────────────────────────────────────────
    function sampler() {
      var times = [], last = performance.now(), running = true;
      (function tick(now) {
        if (!running) return;
        times.push(now - last); last = now;
        requestAnimationFrame(tick);
      })(last);
      return {
        stop: function () { running = false; return times; },
        peek: function () { return times.slice(-30); }
      };
    }
    function stats(t) {
      if (!t.length) return null;
      var s = t.slice().sort(function (a, b) { return a - b; });
      return {
        p50: s[Math.floor(s.length * 0.5)],
        p95: s[Math.floor(s.length * 0.95)],
        max: s[s.length - 1],
        // frames that took longer than two 60Hz refreshes — the visible stalls
        jank: t.filter(function (v) { return v > 33; }).length,
        n: t.length
      };
    }

    // live readout, so you can also just scroll/pinch and watch it
    var live = sampler();
    setInterval(function () {
      var st = stats(live.peek());
      if (st) document.getElementById('pp-live').textContent =
        'live p95 ' + st.p95.toFixed(1) + 'ms';
    }, 500);

    // ── fixed workload ───────────────────────────────────────────
    // Eight page turns with a real pause between them, so every mode is
    // measured against the identical amount of work.
    var TURN_MS = 600, GAP = 900;
    document.getElementById('pp-run').addEventListener('click', function () {
      var out = document.getElementById('pp-out');
      var cover = document.getElementById('cover');
      if (cover && !cover.hasAttribute('inert')) cover.click();

      out.textContent = 'running…';
      var next = document.getElementById('reg-next');
      var prev = document.getElementById('reg-prev');
      var seq = ['n','n','n','n','p','p','p','p'], i = 0;
      var run = sampler();

      (function step() {
        if (i >= seq.length) {
          setTimeout(function () {
            var st = stats(run.stop());
            out.textContent = st
              ? 'p50 ' + st.p50.toFixed(1) + '  p95 ' + st.p95.toFixed(1) +
                '  max ' + st.max.toFixed(0) + '  jank ' + st.jank + '/' + st.n
              : 'no frames';
          }, TURN_MS);
          return;
        }
        var btn = seq[i++] === 'n' ? next : prev;
        if (btn && !btn.disabled) btn.click();
        setTimeout(step, GAP);
      })();
    });
  })();
</script>