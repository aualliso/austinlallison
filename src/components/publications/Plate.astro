---
// src/components/publications/Plate.astro
//
// One image on /publications. Every image there is named by its /public
// path (/images/<dir>/<file>), because that is where the article pages read
// them from. If the same file also exists under
// src/assets/publications/<dir>/<file> - the other location FigureSet
// already supports - it goes through Astro's image pipeline and is served
// as resized WebP at the widths the layout needs. Otherwise the /public
// original is served as-is.
//
// The image is wrapped in a span that says what kind of OBJECT it shows
// (img.object: print, clipping, pamphlet, document, notebook, plate), so the
// page can present a newspaper clipping, a photographic print and an archival
// deed as three different things rather than three shadowed rectangles. The
// treatments are the <style> block at the foot of this file. Pass `bare` where
// the image fills a cropped frame (full-bleed bands, magazine frames) and
// should carry no object treatment at all.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { ResolvedImage } from '../../data/publications/index';

interface Props {
  img: ResolvedImage;
  /** The sizes attribute: how wide this image renders at each breakpoint. */
  sizes: string;
  widths?: number[];
  class?: string;
  loading?: 'lazy' | 'eager';
  /** No object wrapper: the image fills a frame the page draws itself. */
  bare?: boolean;
}

const {
  img,
  sizes,
  widths = [480, 800, 1200, 1600, 2200],
  class: cls = '',
  loading = 'lazy',
  bare = false,
} = Astro.props;

const assets = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/publications/**/*.{jpg,jpeg,png,webp}',
  { eager: true }
);
const key = img.src.replace(/^\/images\//, '/src/assets/publications/');
const meta = assets[key]?.default;

// Never ask the pipeline to upscale a small original.
const usable = meta ? widths.filter((w) => w <= meta.width) : [];
const style = img.position ? `object-position: ${img.position}` : undefined;
const imgClass = bare ? ['unmatted', cls] : ['unmatted', 'obj-img'];
---

{bare ? (
  meta ? (
    <Image src={meta} alt={img.alt} widths={usable.length ? usable : [meta.width]} sizes={sizes}
      loading={loading} decoding="async" class:list={imgClass} style={style} />
  ) : (
    <img src={img.src} alt={img.alt} loading={loading} decoding="async" class:list={imgClass} style={style} />
  )
) : (
  <span class:list={['obj', `obj--${img.object}`, cls]}>
    {meta ? (
      <Image src={meta} alt={img.alt} widths={usable.length ? usable : [meta.width]} sizes={sizes}
        loading={loading} decoding="async" class:list={imgClass} style={style} />
    ) : (
      <img src={img.src} alt={img.alt} loading={loading} decoding="async" class:list={imgClass} style={style} />
    )}
  </span>
)}

<style is:global>
  /* ================================================================ *
   * OBJECTS - each image presented as the thing it is.
   * Box-shadow, border, transform and pseudo-elements only.
   * ================================================================ */
  .obj { position: relative; display: block; }
  .obj-img { display: block; width: 100%; height: auto; }

  /* a modern photograph reproduced on the page: clean, a soft lift */
  .obj--plate { box-shadow: 0 30px 46px -34px rgba(48,32,16,.5); }

  /* a photographic print: white border, thin edge, lies flat */
  .obj--print { background: #fbf8f1; padding: 9px; box-shadow: 0 0 0 1px rgba(60,44,24,.12), 0 1px 2px rgba(48,32,16,.18), 0 22px 30px -24px rgba(48,32,16,.5); }

  /* newsprint or a printed advertisement: flat on the page, clipped edge */
  .obj--clipping { box-shadow: 0 0 0 1px rgba(60,44,24,.16), 0 1px 0 rgba(48,32,16,.10); transform: rotate(-.5deg); }

  /* a bound pamphlet: spine on the left, sits up off the page */
  .obj--pamphlet { box-shadow: 0 2px 3px rgba(48,32,16,.25), 0 34px 44px -26px rgba(48,32,16,.6); }
  .obj--pamphlet::before { content: ''; position: absolute; top: 0; bottom: 0; left: 0; width: 12px; background: linear-gradient(90deg, rgba(30,20,10,.38), rgba(30,20,10,.08) 55%, rgba(255,255,255,.14) 70%, rgba(30,20,10,0)); pointer-events: none; }
  .obj--pamphlet::after { content: ''; position: absolute; top: 3px; bottom: -3px; right: -3px; left: 3px; z-index: -1; background: #e9dfc9; box-shadow: 0 0 0 1px rgba(60,44,24,.14); }

  /* an archival sheet in a clear mylar sleeve */
  .obj--document { padding: 14px; background: rgba(255,255,255,.07); box-shadow: inset 0 0 0 1px rgba(255,255,255,.22), 0 0 0 1px rgba(0,0,0,.18), 0 30px 40px -24px rgba(0,0,0,.7); }
  .obj--document::after { content: ''; position: absolute; inset: 0; pointer-events: none; background: linear-gradient(115deg, rgba(255,255,255,0) 30%, rgba(255,255,255,.10) 42%, rgba(255,255,255,0) 54%); }
  .obj--document .obj-img { box-shadow: 0 1px 2px rgba(0,0,0,.35); }

  /* a notebook page held down by photo corners (two diagonal ones read as four) */
  .obj--notebook { padding: 14px; background: #efe8d9; box-shadow: 0 0 0 1px rgba(60,44,24,.10), 0 30px 46px -34px rgba(48,32,16,.5); }
  /* corners drawn as border triangles: no clip-path, nothing for Firefox to mask */
  .obj--notebook::before, .obj--notebook::after { content: ''; position: absolute; width: 0; height: 0; border: 17px solid transparent; pointer-events: none; }
  .obj--notebook::before { top: 6px; left: 6px; border-top-color: #2b2620; border-left-color: #2b2620; }
  .obj--notebook::after { bottom: 6px; right: 6px; border-bottom-color: #2b2620; border-right-color: #2b2620; }
  @media (max-width: 860px) {
    .obj--notebook::before, .obj--notebook::after { border-width: 12px; }
  }
</style>