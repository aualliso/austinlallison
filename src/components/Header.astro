  <!-- Set the phase AND the sky's darkness before first paint so a night
       visitor never sees a daytime flash. Uses the same real-sunrise/sunset
       math as the module script below (kept minimal here — this copy just
       needs the altitude, not the elevation curve or the azimuth, before
       first paint). Runs once; the module script takes over and refines/
       animates from there. The sun's horizontal position deliberately isn't
       computed here: like --sun-elev, it falls back to a CSS default and is
       overwritten by the module script, whose write lands well inside
       #sun-wrap's own 1.1s entrance-fade delay — so the correction
       happens while the sun is still invisible.
       2026-08-04: now uses a circular (wraparound-safe) window check —
       see the top-of-file comment for why the old >=/< comparisons broke
       dusk for negative (western) longitudes.
       2026-08-07: also writes --night and --ink-flip. Since the dark-sky
       pass, data-phase supplies only the sky's HUE, so setting it alone had
       stopped preventing the very flash this script exists for. See note 14. -->
  <script is:inline>
    (function () {
      var LAT = 33.5779, LON = -101.8552;
      var el = document.getElementById('horizon-header');
      // is:inline scripts aren't Vite-processed, so import.meta.env isn't
      // available here — the DEV flag arrives via the data-debug-time
      // attribute the frontmatter set on the header element instead.
      var debugEnabled = el && el.getAttribute('data-debug-time') === '1';
      function getNow() {
        if (debugEnabled) {
          var override = new URLSearchParams(location.search).get('debugTime');
          if (override) {
            var d = new Date(override);
            if (!isNaN(d.getTime())) return d;
          }
        }
        return new Date();
      }
      function solarAltitude(date) {
        var rad = Math.PI / 180;
        var start = Date.UTC(date.getUTCFullYear(), 0, 0);
        var dayOfYear = Math.floor((Date.UTC(date.getUTCFullYear(), date.getUTCMonth(), date.getUTCDate()) - start) / 86400000);
        var gamma = (2 * Math.PI / 365) * (dayOfYear - 1);
        var eqtime = 229.18 * (0.000075 + 0.001868 * Math.cos(gamma) - 0.032077 * Math.sin(gamma) - 0.014615 * Math.cos(2 * gamma) - 0.040849 * Math.sin(2 * gamma));
        var decl = 0.006918 - 0.399912 * Math.cos(gamma) + 0.070257 * Math.sin(gamma) - 0.006758 * Math.cos(2 * gamma) + 0.000907 * Math.sin(2 * gamma) - 0.002697 * Math.cos(3 * gamma) + 0.00148 * Math.sin(3 * gamma);
        var utcMin = date.getUTCHours() * 60 + date.getUTCMinutes() + date.getUTCSeconds() / 60;
        var tsm = (((utcMin + eqtime + 4 * LON) % 1440) + 1440) % 1440;
        var ha = (tsm / 4 - 180) * rad;
        var phi = LAT * rad;
        return {
          alt: Math.asin(Math.sin(phi) * Math.sin(decl) + Math.cos(phi) * Math.cos(decl) * Math.cos(ha)) / rad,
          morning: ha < 0
        };
      }
      var s = solarAltitude(getNow());
      var p;
      if (s.alt > 6) p = 'day';
      else if (s.alt < -6) p = 'night';
      else p = s.morning ? 'dawn' : 'dusk';
      if (el) {
        el.setAttribute('data-phase', p);
        /* The phase supplies only the HUE now — --night is what actually
           darkens the sky, and --ink-flip is what keeps the type legible
           against it. Without these two the pre-paint script left a
           midnight visitor on a pale canvas sky with dark ink until the
           module landed, which is precisely the flash it was written to
           prevent. Same smoothstep as nightness() and the same 0.625 as
           INK_FLIP_AT in the module script — retune the pair together. */
        var t = Math.max(0, Math.min(1, (3 - s.alt) / 13));
        var night = t * t * (3 - 2 * t);
        el.style.setProperty('--night', night.toFixed(3));
        el.style.setProperty('--ink-flip', night >= 0.625 ? '1' : '0');
      }
    })();
  </script>
</div>

<script>
  // This module runs exactly once per site load. The header itself persists
  // across view transitions, so everything below is written to be re-entrant
  // via astro:after-swap — never re-bound.

  const header = document.getElementById('horizon-header');
  const SITE_LAT = 33.5779;
  const SITE_LON = -101.8552;

  /* ---- dev-only time override (2026-08-04) -------------------------------
     Lets ?debugTime=<ISO string> stand in for the real clock everywhere in
     this component, so dawn/dusk/night can be tested on demand instead of
     waiting for the real Lubbock sky or fighting an OS that auto-resyncs a
     manually-set system clock. Gated by data-debug-time, which the
     frontmatter only sets when import.meta.env.DEV is true — so this is
     compiled out of production, not just hidden behind a flag check. */
  const debugEnabled = header?.getAttribute('data-debug-time') === '1';

  /* Dev-only wind override: ?debugWind=<mph>. Same gate and same idiom as
     ?debugTime above, so a dusty sunset can be staged with both at once:
       ?debugTime=2026-08-05T20:40:00-05:00&debugWind=34
     Bypasses the sessionStorage cache AND the fetch entirely, and never
     writes back — so a test value can't poison the real cached reading for
     the rest of the session. Re-read on every applyWeather() tick rather
     than captured once, so the periodic refresh keeps honouring it. */
  function debugWindMph(): number | null {
    if (!debugEnabled) return null;
    const raw = new URLSearchParams(location.search).get('debugWind');
    if (raw == null) return null;
    const v = parseFloat(raw);
    return Number.isFinite(v) ? v : null;
  }

  /* Dev-only wind DIRECTION override: ?debugWindDir=<compass degrees>, same
     gate and same idiom as ?debugWind above. Added 2026-08-09 alongside the
     yaw fix, and it is half of that fix: the head's orientation was the one
     real-data-driven thing in this header with no way to drive it by hand, so
     a sign error in it could only have been caught by waiting for the weather
     to change and remembering what it looked like last time. Meteorological
     convention, matching the API: the direction the wind comes FROM. */
  function debugWindDirDeg(): number | null {
    if (!debugEnabled) return null;
    const raw = new URLSearchParams(location.search).get('debugWindDir');
    if (raw == null) return null;
    const v = parseFloat(raw);
    return Number.isFinite(v) ? v : null;
  }

  function getNow(): Date {
    if (debugEnabled) {
      const override = new URLSearchParams(location.search).get('debugTime');
      if (override) {
        const d = new Date(override);
        if (!isNaN(d.getTime())) return d;
      }
    }
    return new Date();
  }

  /* ---- real solar position (NOAA-style approximation) -------------------
     ONE function now produces everything the sky needs: the sun's true
     ALTITUDE above the horizon and its true AZIMUTH (compass bearing), both
     from the same declination / equation-of-time series.

     2026-08-05 (second pass). This replaces solarTimesUTCMinutes() +
     computeSolarState() + mapElevation() + solarAzimuthDeg() + the dawn/dusk
     clock windows. The bug that forced it: the sun stayed visibly above the
     horizon well after real sunset. mapElevation() never consulted the sun's
     actual altitude — it ramped --sun-elev linearly across the twilight
     WINDOW (sunset +/- 35 min) with a hard floor of 6%, so the exact instant
     of sunset landed at that window's midpoint and emitted 10%, then the
     disc snapped out of existence at duskEnd rather than setting. Checked
     against Lubbock on 21 Dec: real sunset 17:42 CST, real solar altitude
     -0.85deg, old code still drawing the sun at 10% of the header height.

     Deriving altitude directly fixes it by construction — 0deg IS the
     horizon, so the disc lands on the line at the real sunset instant and
     keeps going down through it. It also deletes a whole class of bug: the
     2026-08-04 UTC-midnight wraparound existed only because the phase was
     decided by comparing clock times against window bounds. Nothing here
     compares clock times at all any more, so normMin()/inWindow()/
     windowLength()/TWILIGHT_MIN are gone with it. */
  function solarPosition(date: Date, lat: number, lon: number) {
    const rad = Math.PI / 180;
    const start = Date.UTC(date.getUTCFullYear(), 0, 0);
    const dayOfYear = Math.floor(
      (Date.UTC(date.getUTCFullYear(), date.getUTCMonth(), date.getUTCDate()) - start) / 86400000
    );
    const gamma = (2 * Math.PI / 365) * (dayOfYear - 1);

    const eqtime = 229.18 * (
      0.000075 + 0.001868 * Math.cos(gamma) - 0.032077 * Math.sin(gamma)
      - 0.014615 * Math.cos(2 * gamma) - 0.040849 * Math.sin(2 * gamma)
    ); // minutes

    const decl = 0.006918 - 0.399912 * Math.cos(gamma) + 0.070257 * Math.sin(gamma)
      - 0.006758 * Math.cos(2 * gamma) + 0.000907 * Math.sin(2 * gamma)
      - 0.002697 * Math.cos(3 * gamma) + 0.00148 * Math.sin(3 * gamma); // radians

    // True solar time at this longitude -> hour angle. Negative before local
    // solar noon, positive after — which is also what separates dawn from
    // dusk below, since altitude alone can't tell them apart.
    const utcMin = date.getUTCHours() * 60 + date.getUTCMinutes() + date.getUTCSeconds() / 60;
    const trueSolarMin = (((utcMin + eqtime + 4 * lon) % 1440) + 1440) % 1440;
    const ha = (trueSolarMin / 4 - 180) * rad;

    const phi = lat * rad;
    const altitude = Math.asin(
      Math.sin(phi) * Math.sin(decl) + Math.cos(phi) * Math.cos(decl) * Math.cos(ha)
    );
    // south-based / west-positive -> compass degrees, matching starAltAz()
    const azimuth = Math.atan2(
      Math.sin(ha),
      Math.cos(ha) * Math.sin(phi) - Math.tan(decl) * Math.cos(phi)
    );

    return {
      altitudeDeg: altitude / rad,
      azimuthDeg: ((azimuth / rad) + 180 + 360) % 360,
      isMorning: ha < 0,
    };
  }

  /* Phase from real altitude instead of clock windows. +/-6deg is civil
     twilight, the standard definition; at this latitude that band takes
     about 50 minutes to cross, close enough to the 70-minute window it
     replaces that the dawn/dusk colour states last about as long as before. */
  const CIVIL_TWILIGHT_DEG = 6;

  /* ---- how dark the sky is (2026-08-06) ----------------------------------
     The stars were invisible, and no tuning of the stars could have fixed it:
     the night sky was canvas mixed 79-93% with #33415C — a LIGHT grey-blue
     around rgb(223,225,227). A pure white point on that is 1.31:1, and the
     B-V colours added the pass before actually spent what little headroom
     there was, landing Vega at 1.05:1. You cannot render a bright point on a
     background already three quarters of the way to white. The sky itself had
     to get dark.

     Driven continuously off real solar altitude rather than switched on the
     phase attribute, so it eases through the dawn and dusk already built
     instead of snapping at the civil-twilight boundary. Full daylight above
     +3deg, full night by -10deg, smoothstep between — which puts --night at
     0.77 by the time stars first appear at -6deg, so they emerge into a sky
     dark enough to hold them (white against it: 8.4:1, up from 1.31:1).

     DUPLICATED, deliberately, in the is:inline pre-paint script above: that
     copy can't import from here, and without it a night visitor gets a pale
     sky for the first frame. If this curve is retuned, retune that one. */
  function nightness(altitudeDeg: number): number {
    const t = Math.max(0, Math.min(1, (3 - altitudeDeg) / 13));
    return t * t * (3 - 2 * t);
  }

  /* The ink has to flip from dark to light as the sky crosses under it, and
     this is deliberately a STEP rather than a fade. Crossfading the text
     colour looks like the smooth choice and is the broken one: it drags the
     type through mid-grey at exactly the moment the sky is also mid-grey,
     bottoming out near 1.0:1 no matter where the fade is centred or how wide
     it is. Stepping skips the mid-grey entirely.

     0.625 is where dark-on-sky and light-on-sky come out equally legible,
     solved against the real luminance ramp: 3.89:1 immediately before the
     flip, 3.94:1 immediately after. That 3.94 is the worst contrast the nav
     reaches anywhere in the entire cycle — better than the 3.82:1 it manages
     today in broad daylight, so this raises the floor rather than trading it
     away for a darker sky. (Also hardcoded as 0.625 in the pre-paint script.) */
  const INK_FLIP_AT = 0.625;

  /* Latest --night, so applyStars() can give each star its own emergence
     threshold instead of the whole field appearing at once. */
  let nightValue = 0;

  function phaseFromAltitude(altitudeDeg: number, isMorning: boolean) {
    if (altitudeDeg > CIVIL_TWILIGHT_DEG) return 'day';
    if (altitudeDeg < -CIVIL_TWILIGHT_DEG) return 'night';
    return isMorning ? 'dawn' : 'dusk';
  }

  /* Altitude (degrees) -> --sun-elev (percent of header height), with 0deg
     mapping to exactly 0% so the CSS can pin that to the horizon line.

     Shared by the sun, the moon and (as of 2026-08-07) every star, so it is
     the one vertical curve in this header. See note 14 for what that cost:
     the whole dome from 0-80deg lives in the bottom SKY_SPAN_PCT of the
     header, which is also where the name and the nav are.

     THE REFERENCE ALTITUDE. The first version normalised against 90deg,
     which was simply wrong: 90deg is the sun directly overhead, and that
     only ever happens between the tropics. At 33.58N the sun tops out at
     79.86deg on the summer solstice, so dividing by 90 left the top ~7% of
     the span as dead range the sun could never reach — and squashed every
     altitude below it to match. That is most of why the December sun looked
     so flat. PEAK_ALTITUDE_DEG derives the real ceiling from the site's own
     latitude (90 - |lat| + axial tilt), so summer-solstice noon now lands
     exactly at the top of the span and everything below is measured against
     a reachable maximum. Clamped at 90 so the formula stays sane if SITE_LAT
     is ever moved into the tropics. Note that two catalog stars (Vega,
     Pollux) genuinely transit ABOVE this ceiling and clamp to the top of the
     span for a while around culmination — accepted, see note 14.

     THE CURVE. SKY_CURVE < 1 expands the low-altitude end, where everything
     interesting happens (the set itself, the grazing light, the horizon
     flatten), and compresses the top, where a linear map would park the
     summer sun against the header's ceiling for hours either side of noon.
     It also lifts winter relative to strict proportion: December's noon
     altitude is 41% of June's in reality but renders at 59% of June's height
     here. Lower it toward 0.5 to lift December further at the cost of
     seasonal contrast; raise it toward 1 for literal proportion and a
     flatter-looking winter.

     THE SPAN. SKY_SPAN_PCT is the height of the summer-solstice noon sun as
     a percent of the header's height, and therefore the ceiling for
     everything else — the dial to turn if the whole arc should sit higher or
     lower. There is headroom above it (the disc doesn't approach the
     header's top edge until roughly 90%), but the practical limit is lower:
     past about 55% the sun starts crowding the top of the sky band on a
     collapsed, scrolled header, where padding-top drops from 3.5rem to 1rem.

     Below the horizon the same curve continues negative, and its steepness
     right at zero is a feature, not an artifact: the disc goes from bisected
     by the line to gone in roughly the three minutes a real sunset takes. */
  const AXIAL_TILT_DEG = 23.44;
  const PEAK_ALTITUDE_DEG = Math.min(90, 90 - Math.abs(SITE_LAT) + AXIAL_TILT_DEG);
  const SKY_SPAN_PCT = 46;
  const SKY_CURVE = 0.6;

  function elevationPercent(altitudeDeg: number) {
    const sign = altitudeDeg < 0 ? -1 : 1;
    const t = Math.min(1, Math.abs(altitudeDeg) / PEAK_ALTITUDE_DEG);
    return sign * SKY_SPAN_PCT * Math.pow(t, SKY_CURVE);
  }

  /* ---- the LOCAL horizon (2026-08-05, sixth pass) ------------------------
     0deg altitude was being pinned to the flat baseline of the horizon SVG
     (y=19, i.e. 3px up), but that baseline is only the true skyline at the
     far left and right edges. Every route's silhouette rises well above it
     across the middle of the header — which is exactly where the sky window
     now keeps the sun. The result was a sun that set behind a mesa long
     before it reached its own zero, most severely at sunrise on a wide
     screen, where the disc was entirely hidden before the moment of sunrise
     on the home, publications and photography routes.

     The fix is to anchor zero to the terrain the sun is actually in front of:
     sample the active silhouette's height at the sun's own x and offset the
     disc by it, so the sun always meets the skyline it's actually setting
     behind, whatever the route and whatever the viewport width. The sun then
     sinks INTO the ridge and the ground fill (which paints after #sun-wrap)
     occludes it on the way down, which is both correct and better-looking
     than the disc blinking out.

     COUPLING WORTH KNOWING: this reads the rendered `d` off .horizon-path, so
     it always matches whatever setHorizon() last applied — but it assumes the
     SVG's 22-unit viewBox is rendered at 22px tall (it is: h-[22px] with
     preserveAspectRatio="none"), so one viewBox unit is one pixel vertically.
     Change that height and this offset silently mis-scales. */
  const HORIZON_VIEWBOX_W = 1440;
  const HORIZON_BASELINE_Y = 19;

  function terrainYAt(d: string, x: number): number {
    // Letters generally, not just [MLH]: the far plane's `d` is a CLOSED
    // path (it ends `V22 H0 Z` to fill down to the bottom), and a regex that
    // skipped 'V' would have happily parsed its 22 as another coordinate.
    // The profile is finished by the time either appears, so stop there.
    const tokens = d.match(/[A-Za-z]|-?\d+(?:\.\d+)?/g);
    if (!tokens) return HORIZON_BASELINE_Y;
    const points: Array<[number, number]> = [];
    let y = HORIZON_BASELINE_Y;
    for (let i = 0; i < tokens.length; ) {
      const c = tokens[i];
      if (c === 'M' || c === 'L') {
        y = parseFloat(tokens[i + 2]);
        points.push([parseFloat(tokens[i + 1]), y]);
        i += 3;
      } else if (c === 'H') {
        points.push([parseFloat(tokens[i + 1]), y]);
        i += 2;
      } else if (c === 'V' || c === 'v' || c === 'Z' || c === 'z') {
        break; // the closing fill commands — the skyline is complete
      } else {
        i += 1;
      }
    }
    if (!points.length) return HORIZON_BASELINE_Y;
    for (let i = 0; i < points.length - 1; i++) {
      const [x0, y0] = points[i];
      const [x1, y1] = points[i + 1];
      if (x >= x0 && x <= x1) {
        return x1 === x0 ? y0 : y0 + ((y1 - y0) * (x - x0)) / (x1 - x0);
      }
    }
    return points[points.length - 1][1];
  }

  /* How far above the flat baseline the skyline sits at a given x, in pixels
     — 0 where the land is flat, several px at the crest of a mesa.

     Samples BOTH profiles and takes whichever is higher (the smaller y), since
     the sun has to clear whatever is actually in front of it. Sampling only
     the near silhouette was a real geometry bug: where the near ground is low
     and the far plane rises above it, the sun came to rest at the near
     baseline — a point the far land already covered — so it "set" behind
     something it should still have been above. Seeded with the baseline so
     the lift can never go negative and drop the sun below the flat line.

     Called for the sun, the moon and every visible star now. That is up to
     ~28 calls per tick, each two querySelector + one small regex parse; at a
     60s cadence for the two bodies and 15min for the field it stays far below
     anything worth caching against the risk of a stale `d` after a swap. */
  function horizonLiftPx(azPct: number): number {
    const x = (azPct / 100) * HORIZON_VIEWBOX_W;
    let y = HORIZON_BASELINE_Y;
    for (const sel of ['.horizon-path', '.far-plane']) {
      const d = document.querySelector(sel)?.getAttribute('d');
      if (d) y = Math.min(y, terrainYAt(d, x));
    }
    return HORIZON_BASELINE_Y - y;
  }

  /* Below this the disc is entirely behind the local skyline, so it's hidden
     outright. Was -1deg when zero meant the flat baseline; now that the disc
     comes to rest ON the ridge at 0deg it has to travel a further half-disc
     to be fully occluded, which takes roughly 2.5deg at this span. -3deg
     leaves margin. Deliberately NOT tied to the night phase: the sun is gone
     well before then, while the dawn/dusk colour and the grazing afterglow
     correctly persist down to -6deg with no sun in the sky, which is what
     the real thing does. */
  const SUN_HIDDEN_BELOW_DEG = -3;

  /* ---- atmospheric refraction -------------------------------------------
     The atmosphere bends light downward, so everything near the horizon
     appears HIGHER than it geometrically is — by about 34 arcminutes right at
     the horizon, which is slightly more than the sun's own diameter. That's
     why you watch the sun touch down at a moment when it is, geometrically,
     already below the line. Bennett's formula, in arcminutes.

     Used for POSITION and visibility, not for phase: civil twilight is
     defined on the sun's geometric centre, so phaseFromAltitude() keeps
     taking the raw value. Worth roughly 2px of lift and about three minutes
     of timing at this latitude. Applied to the stars too as of 2026-08-07 —
     the atmosphere doesn't make an exception for them. */
  function refractionDeg(altitudeDeg: number): number {
    const h = Math.max(altitudeDeg, -1); // the formula blows up below the horizon
    return (1 / Math.tan(((h + 7.31 / (h + 4.4)) * Math.PI) / 180)) / 60;
  }

  function apparentAltitude(altitudeDeg: number): number {
    return altitudeDeg + refractionDeg(altitudeDeg);
  }

  /* ---- the sky window (2026-08-05, third pass) ---------------------------
     The sun's horizontal travel is now bounded to the clear span BETWEEN the
     landmark on the left and the nav on the right, instead of the whole
     viewport. Two problems, both worst on wide screens: with max-w-7xl
     content centred in a 2560px viewport, a full-width projection put a
     summer sunrise near 17% — hundreds of pixels out in empty margin,
     visually detached from everything else in the header — and a winter
     sunrise near 33%, which is right on top of the name.

     MEASURED from real layout rather than assumed from breakpoints, because
     the bounds depend on rendered text width: the name, three nav labels,
     and a signature that's display:none below sm. No set of hardcoded
     percentages survives all of that across every viewport.

     offsetLeft/offsetWidth deliberately, NOT getBoundingClientRect(): the
     landmark name and signature are scaled by transforms as the header
     collapses on scroll, and rect() would shrink with them — making the sky
     window silently breathe in and out while you scroll. Offsets are layout
     values and ignore transforms, so the window depends on viewport width
     alone, which is the only thing that should move it.

     WIDTH-RESPONSIVE as of 2026-08-10. The two problems quoted above are
     both WIDE-SCREEN problems, and the fix was being applied at every width.
     On a phone the first one cannot occur — there is no empty margin for a
     sunrise to fly out into — while the cost is severe: the measured gap
     between the name and the nav falls under MIN_SKY_SPAN_PCT, the floor
     kicks in, and the whole sky collapses to a 12% strip. On a 390px screen
     that is ~47px of travel for an entire day, which makes the summer sweep
     45px and the winter one 23px. The seasonal narrowing that note 8 exists
     to show is a 22px difference nobody will ever see, and the sun reads as
     a stationary dot.

     So the window is now a wide-screen device rather than a universal one.
     Above WIDE_LAYOUT_PX the measured behaviour is UNCHANGED to the pixel —
     same offsets, same gap, same floor — because that is where it earns its
     keep. Below it the sun opens out to NARROW_SPAN and is allowed to pass
     BEHIND the name and the nav, which the header already accepts for the
     star field (note 14) on exactly the same reasoning: the content row
     comes later in DOM order, so the type paints in front and the occlusion
     reads as depth rather than collision.

     NARROW_SPAN is 4-96 rather than 0-100 so a rise or set still happens
     just inside the frame instead of half a disc off the edge; the sun's
     own 6px radius plus its glow wants a little room to sit in.

     WHAT TO WATCH: the disc is not the risk, the glow is. #horizon-sun
     carries box-shadows out to 34px blur, and INK_FLIP_AT was solved
     against the SKY's luminance ramp with a worst case of 3.94:1 — thin
     enough that a bloom passing behind 11px type could push it under. If
     that shows, attenuate the outer shadow layers near the content row
     rather than dimming the disc: the disc is the object, the halo is what
     eats text. */
  const SKY_EDGE_GAP_PX = 18;   // clearance from name/nav — disc is 12px plus glow
  const MIN_SKY_SPAN_PCT = 12;  // degenerate-layout floor; centred if we can't do better

  /* Below this the measured window is abandoned for NARROW_SPAN. 900 sits
     above the tablet widths where a real gap still opens between the name
     and the nav, and below the point where max-w-7xl starts leaving margin
     the original window was written to keep the sun out of. */
  const WIDE_LAYOUT_PX = 900;
  const NARROW_SPAN_LEFT_PCT = 4;
  const NARROW_SPAN_RIGHT_PCT = 96;

  let skyLeftPct = 30;
  let skyRightPct = 70;

  function measureSkyWindow() {
    if (!header) return;
    const landmark = header.querySelector<HTMLElement>('.landmark');
    const nav = document.getElementById('horizon-nav');
    const total = header.offsetWidth;
    if (!landmark || !nav || !total) return;

    /* Narrow viewport: let the sky use the whole width and pass behind the
       type. Deliberately does not consult the landmark/nav offsets at all —
       the point is that their positions should stop constraining the sun
       here, not that they should constrain it a little less. */
    if (total < WIDE_LAYOUT_PX) {
      skyLeftPct = NARROW_SPAN_LEFT_PCT;
      skyRightPct = NARROW_SPAN_RIGHT_PCT;
      return;
    }

    let l = ((landmark.offsetLeft + landmark.offsetWidth + SKY_EDGE_GAP_PX) / total) * 100;
    let r = ((nav.offsetLeft - SKY_EDGE_GAP_PX) / total) * 100;

    /* A very narrow viewport can leave no usable gap at all. Rather than
       freezing the sun in place, fall back to a minimum span centred on
       whatever gap there is and accept a little overlap: a sun that grazes
       the nav reads as depth, a sun that never moves reads as broken.
       Now only reachable above WIDE_LAYOUT_PX, where a degenerate gap means
       unusually long text rather than a small screen — kept because that
       case is still possible and freezing the sun is still the worse
       outcome. */
    if (!(r - l >= MIN_SKY_SPAN_PCT)) {
      const mid = (l + r) / 2 || 50;
      l = mid - MIN_SKY_SPAN_PCT / 2;
      r = mid + MIN_SKY_SPAN_PCT / 2;
    }
    skyLeftPct = Math.max(0, l);
    skyRightPct = Math.min(100, r);
  }

  /* Which slice of the compass gets stretched across that window. NOT the
     full 0-360deg: the sun at this latitude never bears north, so mapping the
     whole compass would leave both ends of the window permanently
     unreachable and waste most of the travel. 60-300deg is the annual
     extreme — the summer solstice rise/set bearings (60.8 / 299.2) — so June
     uses the window edge to edge, December uses only its middle, and the
     seasonal narrowing of the sweep survives the change intact. 180deg
     (solar noon) still lands exactly at the window's centre, so the midday
     composition is unchanged for a third time running.

     Widened from 60-300 to 55-305 so the MOON fits the same mapping. The
     moon's declination reaches +/-28.7deg against the sun's +/-23.4deg, so it
     rises and sets a few degrees further north — about 55deg at this
     latitude. One shared mapping matters more than a tight fit: two bodies
     using different projections would disagree about where east is, and the
     moon would pile up against a clamp for an hour at the extremes. Solar
     noon still lands at exactly 50%. */
  const SUN_AZ_MIN_DEG = 55;
  const SUN_AZ_MAX_DEG = 305;

  /* ---- ONE PROJECTION FOR THE WHOLE SKY (2026-08-07) ---------------------
     Piecewise, and now shared by the sun, the moon, the anti-solar Belt of
     Venus AND the star field. It used to be just the middle branch, with
     azimuths outside the window clamped to its edges — while applyStars()
     ran its own `azimuthDeg / 360 * 100` across the full width. The comment
     defending that split argued the two were never on screen together, which
     was true of the SUN and the stars and stopped being true of the moon the
     moment the moon lost its night-only gate (note 13). All night, every
     night, two objects were disagreeing about where east is.

       az in [55, 305]  -> the measured window, exactly as before
       az in [0, 55]    -> the left margin, with due north at x = 0
       az in [305, 360] -> the right margin, with due north at x = 100

     Continuous and monotonic at both joins, and the middle branch is
     arithmetically identical to what it replaced — so the sun and the moon
     do not move by a pixel and solar noon is still dead centre at 50%.

     WHY NORTH SITS AT THE EDGES: the viewer of this header faces SOUTH (the
     sun rises on the left and sets on the right, and the windmill's yaw is
     built on the same assumption). The wrap point of a facing-south panorama
     is directly behind the viewer, which is due north — so 0deg and 360deg
     meeting at the two edges is the correct seam, not an arbitrary one.

     THE COST: the horizontal scale changes at 55deg and 305deg, since 55deg
     of compass is compressed into each margin while 250deg is stretched
     across the window. A constellation straddling one of those bearings gets
     a kink. The Big Dipper is the only figure in this catalog wide enough for
     it to show, and it will sometimes sit right on the northwestern seam.
     Judged the cheapest of three bad options: dropping the window puts a
     summer sunrise back out in a wide screen's empty margin, and a smooth
     power curve spreads the distortion into the sun's own travel, which has
     been tuned across eleven passes and shouldn't move to fix the stars.

     DEGENERATE LAYOUTS: on a very narrow viewport measureSkyWindow() can
     leave almost no margin, in which case the northern sky compresses hard
     and a few far-north stars pile up near an edge. Nothing the sun or the
     moon can reach is affected — they never leave the middle branch — and
     the joins stay continuous regardless, so this is a cosmetic squeeze on
     the least important objects at the least common width. */
  function azimuthToPercent(azimuthDeg: number) {
    const az = ((azimuthDeg % 360) + 360) % 360;

    if (az >= SUN_AZ_MIN_DEG && az <= SUN_AZ_MAX_DEG) {
      const t = (az - SUN_AZ_MIN_DEG) / (SUN_AZ_MAX_DEG - SUN_AZ_MIN_DEG);
      return skyLeftPct + t * (skyRightPct - skyLeftPct);
    }

    if (az < SUN_AZ_MIN_DEG) {
      // due north at the left edge, out to the window's left edge at 55deg
      return (az / SUN_AZ_MIN_DEG) * skyLeftPct;
    }

    // the window's right edge at 305deg, out to due north at the right edge
    const t = (az - SUN_AZ_MAX_DEG) / (360 - SUN_AZ_MAX_DEG);
    return skyRightPct + t * (100 - skyRightPct);
  }

  /* ---- grazing-light colour + intensity ---------------------------------
     Both now take the sun's real ALTITUDE in degrees rather than the
     --sun-elev percentage they used to read. That indirection was fine
     while elevation was an invented ramp, but it broke the moment elevation
     became physical: the old cutoff of "16% elevation" corresponds to about
     42deg of real altitude under the new mapping, which would have kept
     golden-hour colour burning most of the day. 8deg is the honest number —
     roughly the golden-hour band, and independent of however the elevation
     curve is tuned later. */
  const GRAZING_TOP_DEG = 12;

  /* How long the deep amber HOLDS before easing toward gold. The colour ramp
     used to be linear in altitude, which is why the deep orange felt like an
     instant rather than a phase of the evening: at half the band's height the
     colour was already half-neutralised, so the truly deep tone only existed
     in the last couple of degrees. Measured at this latitude, that gave about
     18 minutes of genuinely deep colour against a ~43-minute warm band.

     An exponent > 1 keeps t near 0 (deepest amber) through the low part of
     the band and does its neutralising higher up: at 4deg the colour is 86%
     of the way to full amber where it used to be 50%. Together with the wider
     GRAZING_TOP_DEG that roughly doubles the deep window to ~34-40 minutes,
     seasonally. Raise it to hold longer still; 1.0 restores the old linear
     ramp. */
  const GRAZING_COLOR_HOLD = 1.8;

  /* The disc's geometric SQUASH is deliberately NOT on GRAZING_TOP_DEG.
     Atmospheric refraction only compresses the sun's disc within a few
     degrees of the horizon — it's negligible by 5deg and gone well before
     12deg. Widening the colour band to 12deg while leaving the squash tied to
     it would have left a visibly oval sun sitting a sixth of the way up the
     sky, which is the kind of detail that reads as wrong without being
     obviously identifiable as wrong. Brightness stays on --grazing-light,
     since atmospheric extinction genuinely does dim a sun that low over
     roughly that wider range. */
  const REFRACTION_FLATTEN_DEG = 5;

  /* Real low-angle sunlight reddens the lower the sun sits — more atmosphere
     in the sightline scatters out more blue, leaving red/orange. Deep
     amber-red at and below the horizon, easing to the neutral gold the disc
     already uses in full daylight by GRAZING_TOP_DEG. Purely a function of
     altitude — deliberately NOT tied to wind/haze, unlike the intensity
     multiplier below. */
  /* Blowing dust reddens transmitted sunlight — the more aerosol in the
     slant path, the more of the short wavelengths are scattered out before
     the light reaches the viewer. That's why a Llano dust sunset goes
     properly blood-orange while a clean one stays amber. Scaled by (1 - t)
     so it only bites near the horizon, where the slant path is long enough
     for it to matter; a high sun stays its normal colour however hard it's
     blowing. */
  const DUST_RED = [168, 54, 28];
  const DUST_REDDENING = 0.55;

  function grazingColorRGB(altitudeDeg: number): string {
    const raw = Math.max(0, Math.min(1, altitudeDeg / GRAZING_TOP_DEG));
    const t = Math.pow(raw, GRAZING_COLOR_HOLD);
    const from = [201, 98, 46];   // #C9622E — deep amber-red, at the horizon
    const to = [232, 168, 92];    // #E8A85C — neutral gold, the daytime sun tone
    const base = from.map((c, i) => c + (to[i] - c) * t);
    const dust = hazeStrength * (1 - t) * DUST_REDDENING;
    const mixed = base.map((c, i) => Math.round(c + (DUST_RED[i] - c) * dust));
    return `rgb(${mixed[0]}, ${mixed[1]}, ${mixed[2]})`;
  }

  /* Full strength at the horizon, fading up to GRAZING_TOP_DEG as the sun
     climbs — and, going the other way, fading DOWN to zero at -6deg as the
     afterglow dies. That second half is new: the old version cut grazing to
     0 the instant the phase flipped to night, which was a hard edge. Now
     the light fades out over civil twilight with no sun in the sky, which
     is the part of a real dusk this header never had. */
  /* Refraction squash: full at and below the horizon, gone by
     REFRACTION_FLATTEN_DEG. Eased through the same easeGrazing() curve as the
     light itself so the disc holds its flattened shape right at the horizon
     rather than starting to relax the instant it touches down. */
  function refractionFlatten(altitudeDeg: number): number {
    return Math.max(0, Math.min(1, 1 - altitudeDeg / REFRACTION_FLATTEN_DEG));
  }

  function rawGrazingFromAltitude(altitudeDeg: number): number {
    if (altitudeDeg >= 0) return Math.max(0, 1 - altitudeDeg / GRAZING_TOP_DEG);
    return Math.max(0, 1 + altitudeDeg / CIVIL_TWILIGHT_DEG);
  }

  /* ---- grazing-light intensity easing (2026-08-05) ------------------------
     Raw elevation gives a straight linear ramp from 1 (at the horizon) to 0
     (by ~16% elevation) — see mapElevation's dawn/dusk range. A pure linear
     fade means the "deep orange" moment is only ever instantaneous: the
     instant the sun clears the horizon, intensity is already dropping.
     easeGrazing() reshapes that into a hold-then-ease curve instead: it
     stays close to 1 for the first third of the raw fade (the sun lingers
     at its deepest color for a real beat right at the horizon) before
     easing out the rest of the way with a smoothstep, rather than easing
     from the very first instant. Purely a reshaping of the same 0..1 input
     — every consumer of --grazing-light (bloom, streak, rim-light, haze
     tint, AND the sun disc's own color/flatten) gets the held-then-eased
     curve for free without needing its own easing logic. */
  function easeGrazing(raw: number): number {
    const HOLD = 0.35; // fraction of the raw fade to hold near-full intensity
    if (raw >= 1 - HOLD) {
      // remap the hold region to stay high (0.85–1) rather than flat 1,
      // so it's a gentle plateau, not a visible "step"
      const t = (raw - (1 - HOLD)) / HOLD;
      return 0.85 + 0.15 * t;
    }
    // remaining region eases out with a smoothstep (3t^2 - 2t^3)
    const t = Math.max(0, Math.min(1, raw / (1 - HOLD)));
    return t * t * (3 - 2 * t) * 0.85;
  }

  /* ---- the Belt of Venus + Earth's shadow --------------------------------
     After sunset, look AWAY from the sun: a blue-grey band rises out of the
     eastern horizon — the planet's own shadow, cast on its atmosphere — with
     a pink band sitting directly on top of it, backscattered light from a sun
     that has already set for the ground but not for the air up there. On a
     truly flat horizon it's unmistakable, and the Llano is one of the best
     places on the continent to watch it. The header had a warm arch on the
     sun's side and nothing at all opposite.

     The anti-solar point is simply the sun's azimuth + 180, and its ALTITUDE
     is the negative of the sun's — so as the sun sinks, the shadow rises at
     the same rate, which is the whole visual. Both go through the same sky
     window and the same elevation curve as everything else. (The anti-solar
     bearing always lands inside the window's own 55-305deg branch whenever
     the sun does, so the piecewise projection never sends it into a margin.)

     Timing: nothing while the sun is up, full through the sweet spot around
     2-4deg below, gone by 8deg when the shadow has climbed out of the frame
     and the sky is uniformly dark. Runs at dawn too, mirrored, which is
     correct — it is just much less often seen. */
  function beltStrength(apparentSunAlt: number): number {
    if (apparentSunAlt > 1) return 0;
    if (apparentSunAlt > -2) return (1 - apparentSunAlt) / 3;
    if (apparentSunAlt > -4) return 1;
    if (apparentSunAlt > -8) return (apparentSunAlt + 8) / 4;
    return 0;
  }

  const applyPhase = () => {
    if (!header) return;
    const now = getNow();
    const { altitudeDeg, azimuthDeg, isMorning } = solarPosition(now, SITE_LAT, SITE_LON);

    const phase = phaseFromAltitude(altitudeDeg, isMorning);
    if (header.dataset.phase !== phase) header.dataset.phase = phase;

    /* How dark the sky is, and which way the type has to read against it.
       Both continuous in the sun's real altitude, so day -> dusk -> night is
       one unbroken ramp rather than three states. --ink-flip is the one
       deliberate exception: see INK_FLIP_AT. */
    nightValue = nightness(altitudeDeg);
    header.style.setProperty('--night', nightValue.toFixed(3));
    header.style.setProperty('--ink-flip', nightValue >= INK_FLIP_AT ? '1' : '0');

    // Vertical: real APPARENT altitude — geometric plus refraction, so the
    // disc touches the line at the moment you'd actually see it touch down.
    // 0deg == the horizon line (the CSS subtracts a 3px correction so 0%
    // lands the disc's CENTRE on the line rather than its bottom edge). Can
    // and should go negative as the sun sets.
    const apparentAlt = apparentAltitude(altitudeDeg);
    header.style.setProperty('--sun-elev', `${elevationPercent(apparentAlt).toFixed(2)}%`);

    /* Horizontal: real azimuth, mapped through the measured sky window (see
       measureSkyWindow / azimuthToPercent) so the disc always travels in the
       clear span between the landmark and the nav, at any viewport width,
       rather than flying out into the margins of a wide screen. */
    const azPct = azimuthToPercent(azimuthDeg);
    header.style.setProperty('--sun-az', `${azPct.toFixed(2)}%`);

    // ...and how high the land stands at that x, so 0deg altitude means the
    // skyline the sun is actually in front of, not the flat baseline.
    header.style.setProperty('--horizon-lift', `${horizonLiftPx(azPct).toFixed(2)}px`);

    // Once the disc is fully under the line, hide it outright. Kept separate
    // from the night-phase rule on purpose — see SUN_HIDDEN_BELOW_DEG.
    const sunWrap = document.getElementById('sun-wrap') as HTMLElement | null;
    if (sunWrap) sunWrap.style.display = apparentAlt < SUN_HIDDEN_BELOW_DEG ? 'none' : '';

    /* The Belt of Venus and Earth's shadow, opposite the sun. Anti-solar
       azimuth is +180; anti-solar altitude is the negation of the sun's, so
       the shadow rises exactly as fast as the sun sinks. */
    header.style.setProperty('--belt-x', `${azimuthToPercent((azimuthDeg + 180) % 360).toFixed(2)}%`);
    header.style.setProperty('--belt-top', `${elevationPercent(Math.max(0, -apparentAlt)).toFixed(2)}%`);
    header.style.setProperty('--belt-strength', beltStrength(apparentAlt).toFixed(3));

    // Grazing light, from the same altitude. easeGrazing() reshapes the raw
    // 0..1 into a held-then-eased curve (see note above) so the deep-orange
    // horizon moment reads as a beat rather than an instant. --grazing-light
    // also drives the disc's own flatten/darken/colour blend, and feeds
    // --grazing-effective (see base CSS), which scales it further by the
    // real wind-driven haze strength applyWeather() sets independently.
    const grazing = easeGrazing(rawGrazingFromAltitude(altitudeDeg));
    header.style.setProperty('--grazing-light', grazing.toFixed(3));
    header.style.setProperty('--grazing-color', grazingColorRGB(altitudeDeg));
    applyStationReadout(); // the clock ticks with the same 60s cadence
    header.style.setProperty('--horizon-flatten', easeGrazing(refractionFlatten(altitudeDeg)).toFixed(3));
  };


  /* ---- moon phase + real moonrise/moonset --------------------------------
     Phase (for the crescent shape) is simple synodic-month math. Whether
     the moon is actually shown is a separate, real check: a low-precision
     lunar position (the same class of formula used across most open-source
     "suncalc"-style libraries) gives topocentric-ish altitude for Lubbock,
     and the moon only renders when that altitude is above the horizon —
     so on nights when the real moon hasn't risen yet, or has already set,
     the sky is just the star field, same as it would actually look.

     PLACED FOR REAL as of 2026-08-05 (see note 13). It had been pinned at a
     fixed left/bottom through several passes, on the grounds that driving its
     vertical position from real altitude would collide with the ground band
     and the nav. That objection died once the sun hit exactly the same
     problem and the sky window, --horizon-lift and elevationPercent were
     built to solve it — the machinery was already sitting there. */
  function moonPhaseFraction(date: Date) {
    const synodic = 29.530588853;
    const knownNewMoonUTC = Date.UTC(2000, 0, 6, 18, 14);
    const days = (date.getTime() - knownNewMoonUTC) / 86400000;
    let phase = (days % synodic) / synodic;
    if (phase < 0) phase += 1;
    return phase; // 0 = new, 0.5 = full
  }

  /* Was moonAltitudeDeg(), returning only enough to answer "is it up". It now
     returns azimuth as well, because the moon is finally PLACED rather than
     pinned: same sky window, same elevation curve, same terrain lift as the
     sun. It was the last object in this header sitting somewhere that
     corresponded to nothing. */
  function moonPosition(date: Date, lat: number, lon: number) {
    const rad = Math.PI / 180;
    const dayMs = 86400000, J1970 = 2440588, J2000 = 2451545;
    const toDays = (d: Date) => (d.valueOf() / dayMs - 0.5 + J1970) - J2000;
    const e = rad * 23.4397;

    const d = toDays(date);
    const L = rad * (218.316 + 13.176396 * d);
    const M = rad * (134.963 + 13.064993 * d);
    const F = rad * (93.272 + 13.229350 * d);
    const l = L + rad * 6.289 * Math.sin(M);
    const b = rad * 5.128 * Math.sin(F);

    const ra = Math.atan2(Math.sin(l) * Math.cos(e) - Math.tan(b) * Math.sin(e), Math.cos(l));
    const dec = Math.asin(Math.sin(b) * Math.cos(e) + Math.cos(b) * Math.sin(e) * Math.sin(l));

    const lw = rad * -lon, phi = rad * lat;
    const siderealTime = rad * (280.16 + 360.9856235 * d) - lw;
    const H = siderealTime - ra;

    const alt = Math.asin(Math.sin(phi) * Math.sin(dec) + Math.cos(phi) * Math.cos(dec) * Math.cos(H));
    // same south-based, west-positive convention as starAltAz() and solarPosition()
    const az = Math.atan2(Math.sin(H), Math.cos(H) * Math.sin(phi) - Math.tan(dec) * Math.cos(phi));
    return { altitudeDeg: alt / rad, azimuthDeg: ((az / rad) + 180 + 360) % 360 };
  }

  /* The disc comes to rest ON the skyline at 0deg apparent, so it needs a
     further half-disc of travel to be fully behind it — same reasoning as
     SUN_HIDDEN_BELOW_DEG, scaled for an 11px moon. */
  const MOON_HIDDEN_BELOW_DEG = -2.5;

  /* The tilt is an atan2 result, so it wraps at +/-180 — and a bare wrap would
     send the 1.5s transform transition spinning the long way round the circle.
     Unwrapped against the last applied value so successive updates always take
     the short path. */
  let lastMoonTilt = 0;

  const applyMoon = () => {
    if (!header) return;
    const now = getNow();
    const moonEl = document.getElementById('horizon-moon') as HTMLElement | null;
    if (!moonEl) return;

    const m = moonPosition(now, SITE_LAT, SITE_LON);
    const mAlt = apparentAltitude(m.altitudeDeg);
    if (mAlt < MOON_HIDDEN_BELOW_DEG) {
      moonEl.style.display = 'none';
      return;
    }
    moonEl.style.display = '';

    /* The moon's own rise/set extremes reach about 54.8deg here — marginally
       outside the 55-305deg window branch. Before the projection went
       piecewise it clamped there; now it travels a fraction of a percent into
       the left margin, which is simply more correct. */
    const mAzPct = azimuthToPercent(m.azimuthDeg);
    const mElevPct = elevationPercent(mAlt);
    header.style.setProperty('--moon-az', `${mAzPct.toFixed(2)}%`);
    header.style.setProperty('--moon-elev', `${mElevPct.toFixed(2)}%`);
    header.style.setProperty('--moon-lift', `${horizonLiftPx(mAzPct).toFixed(2)}px`);

    // The lit fraction, which drives how far the shadow disc is offset.
    //
    // FIXED 2026-08-10 (first pass). This was `(1 - illum) * 100`, which is
    // the shadow disc's offset backwards. #horizon-moon::after is a
    // same-size disc, clipped by the moon's own circular overflow:hidden,
    // sliding across the lit base disc — so the offset needs to be SMALL
    // when illum is low (shadow sits nearly concentric, covering almost
    // everything, leaving only a thin lit sliver) and LARGE when illum is
    // high (shadow slides almost entirely out of the clip circle, exposing
    // the full disc). `(1 - illum)` inverted that: at that morning's real
    // illum of ~9% (a waning crescent) it produced a 91% offset — pushing
    // the shadow almost entirely out of frame and leaving the disc looking
    // nearly full. The two forms only agree at illum = 0.5 (quarter moon),
    // which is why a half-moon never looked wrong.
    //
    // FIXED 2026-08-10 (second pass). The sign here used to flip on
    // `waxing`, which conflicted with the terminator-tilt rotation just
    // below: that rotation hard-codes a `-90` offset on the fixed premise
    // that the UNROTATED lit side is always on the right (see the comment
    // on the tilt). A negative shadow-x offset genuinely does put the lit
    // side on the right — confirmed by simulating the mask geometry
    // directly — but only the WAXING branch produced a negative offset;
    // waning flipped it positive, putting the lit side on the left, which
    // the tilt's fixed `-90` doesn't account for. Because the base crescent
    // is symmetric top-to-bottom, rotating a lit-left shape by an angle
    // computed for lit-right lands exactly 180° off: the lit limb pointed
    // directly away from the sun instead of toward it, for every waning
    // phase — including the one on screen when the first bug was reported.
    // The sign is now constant (always lit-right, unrotated), matching the
    // tilt's premise for every phase; the real left/right/up/down direction
    // comes entirely from the rotation below, which already uses the real
    // sun bearing and needs no phase-dependent branch to get it right.
    const phase = moonPhaseFraction(now);
    const illum = (1 - Math.cos(2 * Math.PI * phase)) / 2;
    header.style.setProperty('--moon-shadow-x', `${(-illum * 100).toFixed(1)}%`);

    /* THE TERMINATOR'S TILT. The mask offsets purely horizontally, so without
       this the crescent always had a vertical edge — but the illuminated limb
       always faces the sun, which is why a low crescent lies on its back (the
       "wet moon" you get out here) rather than standing upright.

       Computed as the screen-space bearing from the moon to the SUN in THIS
       header's own projection, rather than by importing the celestial
       position angle of the bright limb. That's deliberate: both bodies are
       placed through the same non-physical azimuth window and elevation
       curve, so the projection's own geometry is what the eye will actually
       read, and it sidesteps the parallactic-angle sign conventions that are
       very easy to get backwards. Unrotated, the lit limb points right, i.e.
       90deg clockwise from up — hence the -90. */
    const s = solarPosition(now, SITE_LAT, SITE_LON);
    const dx = ((azimuthToPercent(s.azimuthDeg) - mAzPct) / 100) * (header.offsetWidth || 1);
    const dyUp = ((elevationPercent(apparentAltitude(s.altitudeDeg)) - mElevPct) / 100)
      * (header.offsetHeight || 1);
    let tilt = (Math.atan2(dx, dyUp) * 180) / Math.PI - 90;
    while (tilt - lastMoonTilt > 180) tilt -= 360;
    while (tilt - lastMoonTilt < -180) tilt += 360;
    lastMoonTilt = tilt;
    header.style.setProperty('--moon-tilt', `${tilt.toFixed(1)}deg`);
  };

  /* ---- real stars (2026-08-02 rework) -------------------------------------
     Replaces the old fixed 20-dot scatter with a real bright-star catalog (real
     right ascension/declination), positioned by actual altitude/azimuth for
     Lubbock at the current moment — same class of math as the moon above,
     just extended with an azimuth calculation the moon didn't need. Stars
     below the horizon simply aren't drawn. Magnitude drives size/brightness
     (compressed range — real stars are point sources; brightness reads
     mostly as glow, not disc size) and atmospheric extinction dims stars
     sitting low near the horizon, same physics as the grazing-light color
     shift. Rendered as plain circular divs with a fixed pixel diameter
     rather than SVG circles in a stretched viewBox — that guarantees they
     stay round regardless of the header's actual width/height at any given
     viewport, rather than depending on the viewBox happening to match the
     container's proportions. Static positions, no twinkle — same
     philosophy as the rest of the night sky: it changes state, it doesn't
     animate for its own sake.

     2026-08-07: the field is no longer placed by rules of its own. It shares
     azimuthToPercent(), elevationPercent(), horizonLiftPx() and
     apparentAltitude() with the sun and the moon — one projection, one
     vertical curve, one refraction, one local skyline. See notes 14 and 15
