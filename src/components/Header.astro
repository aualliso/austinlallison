              <path d="M6.90 6.00 L9.47 5.26" />
              <path d="M7.45 3.95 L10.05 4.59" />
              <path d="M8.95 2.45 L10.88 4.30" />
              <path d="M11.00 1.90 L11.75 4.47" />
              <path d="M13.05 2.45 L12.41 5.05" />
              <path d="M14.55 3.95 L12.70 5.88" />
            </g>
