// THE ROCK'S PICTURES (see THE ROCK IS A PAINTING, above).
const ROCK = '/images/footer';

// THE CLIP that cuts the rock's picture to the land. The picture is an
// ordinary image under the drawing, so it cannot use the drawing's own
// clip; it gets the same outline as a CSS polygon in percentages, which
// stretches with the box exactly as the drawing does. The outline is
// worked out here from surfacePath, so the two cannot drift apart: each
// curve is walked in ten steps, which is finer than a pixel at any size
// the footer is shown, and the drawing's surface line lies over the join.
function outline(d: string, steps = 10): [number, number][] {
  const points: [number, number][] = [];
  let at: [number, number] = [0, 0];
  for (const [, letter, rest] of d.matchAll(/([MLC])([^MLC]*)/g)) {
    const n = rest.trim().split(/[\s,]+/).map(Number);
    if (letter === 'C') {
      for (let i = 0; i + 5 < n.length; i += 6) {
        const [x1, y1, x2, y2, x3, y3] = n.slice(i, i + 6);
        for (let step = 1; step <= steps; step++) {
          const t = step / steps;
          const k = 1 - t;
          points.push([
            k * k * k * at[0] + 3 * k * k * t * x1 + 3 * k * t * t * x2 + t * t * t * x3,
            k * k * k * at[1] + 3 * k * k * t * y1 + 3 * k * t * t * y2 + t * t * t * y3,
          ]);
        }
        at = [x3, y3];
      }
    } else {
      for (let i = 0; i + 1 < n.length; i += 2) {
        at = [n[i], n[i + 1]];
        points.push(at);
      }
    }
  }
  return points;
}
const rockClip = `polygon(${[...outline(surfacePath), [1440, 180], [0, 180]]
  .map(([x, y]) => `${(x / 14.4).toFixed(2)}% ${(y / 1.8).toFixed(2)}%`)
  .join(', ')})`;

// THE PLAINS' TREES AND THE ROCK HOUSE. Each is a small picture laid
// over the drawing and sized in pixels, like the grass, so that it keeps
// its shape however the box is stretched. x is its place in the
// drawing's 1440; w its width in pixels. Its foot is put on the land
// surface, which is read off surfacePath here (groundAt), so a tree
// moved to a new x still stands on the ground.
//
// `show` is how wide the page must be for it to appear at all, which is
// what keeps a phone's short plain from being crowded:
//
//   (nothing)  always: two junipers, two mesquite, one cottonwood
//   'mid'      wider than a phone (over 680px)
//   'wide'     wider than 1140px
//
// The Rock House has a rule of its own: over 1024px only.
const land = outline(surfacePath, 24);
function groundAt(x: number): number {
  for (let i = land.length - 1; i > 0; i--) {
    const [x0, y0] = land[i - 1];
    const [x1, y1] = land[i];
    if (x1 > x0 && x0 <= x && x <= x1) return y0 + ((y1 - y0) * (x - x0)) / (x1 - x0);
  }
  return land[land.length - 1][1];
}
/** the box for a picture `w` pixels wide and `ratio` times as tall, its foot `sink` pixels into the ground at x */
function stand(x: number, w: number, ratio: number, sink = 0.6): string {
  const h = w * ratio;
  return (
    `left:calc(${x} / 1440 * 100% - ${(w / 2).toFixed(1)}px);` +
    `top:calc(${groundAt(x).toFixed(1)} / 180 * 100% - ${(h - sink).toFixed(1)}px);` +
    `width:${w}px;height:${h.toFixed(1)}px`
  );
}
interface Tree {
  x: number;
  w: number;
  flip?: boolean;
  show?: 'mid' | 'wide';
}
