</footer>

<style>
  .caprock {
    /* ── THE PALETTE ──
       The colours of the type and the line-work, and the tones that
       stand in for the painting until it has loaded. Change them here
       and nowhere else.

       The rock itself is in the pictures now (see the note at the top
       of the file). The five tones from --redbed to --redbed-floor are
       the painting's own fall of colour with depth, at 0, 55, 150, 252
       and 600 pixels below the drawing; if the pictures are ever
       painted again with a different fall, these have to follow, or
       the footer will change tone as the picture arrives. */
    --ogallala: #b59279; /*       dry sand, until the painting loads */
    --sandstone: #8a7566; /*      the ledge's fallen blocks */
    --caliche: #d8ccb6; /*        the caprock's fallen blocks, and the corner's rocks */
    --house-stone: #b3a48e; /*    the Rock House's walls, and its rock wall */
    --rock-ink: #33251a; /*       lettering and line-work on the sand */
    --water: #5f8ba3; /*          the water table and the seep */
    --water-lift: #a9cfe0; /*     water in the bore */
    --redbed: #8e4f3e; /*         reddish brown: the top of the red beds */
    --redbed-2: #713f31; /*       55px down */
    --redbed-deep: #5c3328; /*    150px down, about where the words sit */
    --redbed-low: #3a2019; /*     252px down */
    --redbed-floor: #2b1813; /*   600px down, and anything below that */
    --basement: #22100b;
    --ink: #e8e1d1; /*            type on the redbeds */
    --ink-soft: rgba(240, 232, 216, 0.9);
    --ink-faint: rgba(240, 232, 216, 0.82);
    --rule: rgba(232, 225, 209, 0.16);

    /* THE HOUR'S TWO WASHES, laid flat over the rock wherever it shows:
       --wash-warm is the low sun's colour at dawn and dusk, --wash-night
       the dark of the night. --graze, --grazing and --night come from
       the header (see THE SKY, below). */
    --wash-warm: color-mix(in srgb, var(--grazing) calc(var(--graze) * 27%), transparent);
    --wash-night: color-mix(in srgb, #0b101d calc(var(--night) * 70%), transparent);

    /* ── FULL-BLEED BREAK-OUT ──
       Works inside a max-width wrapper.

       Sized to the page that is actually visible, not to 100vw. On a
       desktop 100vw counts the width of the vertical scrollbar, so a
       footer sized with it is that much wider than the page, sticks
       out half of it on each side and makes the page scroll sideways
       by a few pixels. --page-w is documentElement.clientWidth, kept
       current by fitCaprock() in the script below; 100vw is only the
       fallback until that has run. (The home page's desk does the
       same: see .register in src/pages/index.astro.) */
    width: var(--page-w, 100vw);
    margin-left: calc(50% - var(--page-w, 100vw) / 2);
    position: relative;
    color: var(--ink);
    font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, Consolas, monospace);
    isolation: isolate;
    overflow: hidden;
  }

  /* ── the escarpment ───────────────────────────────────────── */
  /* .scarp-wrap holds the sky and, below the sky's rise, .scarp-box,
     which is the drawing and everything laid over it. All the positions
     given as fractions of the drawing's height are fractions of
     .scarp-box. */
  .scarp-wrap {
    position: relative;
    /* padding, not a margin on the box below: a margin there would
       collapse through this element and leave the sky no taller than
       the drawing */
    padding-top: var(--sky-rise);
  }
  .scarp-box {
    position: relative;
  }
  /* THE ROCK, under the drawing: the painting, stretched to this box as
     the drawing is and cut to the land by the clip-path written on the
     element. Its background is what shows until the picture loads, sand
     over brick, parted at --sand-base, where the sands rest on the beds
     below (OGALLALA_BASE, written on the element with the clip). */
  .rock {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, var(--ogallala) var(--sand-base, 53.3%), var(--redbed) var(--sand-base, 53.3%));
  }
  .rock img {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* ── THE SKY ──
     The header's sky of this moment, standing over the land. Four values
     come from the header by way of readHeader():

       --sky-top, --sky-horizon   the header's own two sky colours, as it
                                  has them right now
       --night                    0 by day, 1 in full dark
       --graze, --grazing         how low the sun is and the colour that
                                  gives; --glow-x is where along the
                                  footer that glow sits

     The sky runs from nothing at its top, so that it rises out of the
     page, through the header's upper colour to its horizon colour at the
     land. --sky-rise is how far it stands above the drawing.

     The section looks north, so west is on the left: the evening glow is
     low over the plain and the morning's over the Rolling Plains.

     Until the script has run, the values written here give a plain
     midday sky. */
  .caprock {
    --sky-rise: clamp(4rem, 8vw, 7rem);
    --sky-top: #c1d2e7;
    --sky-horizon: #d6dde2;
    --night: 0;
    --graze: 0;
    --grazing: rgb(232, 168, 92);
    --glow-x: 12%;
    --glow-y: 0.144;
  }
  .sky {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--sky-top) 0%, transparent) 0%,
      var(--sky-top) 58%,
      var(--sky-horizon) 100%
    );
  }
  /* THE GLOW of a low sun: a wide, shallow ellipse centred ON the horizon
     at --glow-x, so that half of it is behind the land and the half that
     shows lies along the skyline, strongest where the land meets the sky.
     --glow-y is how far down the drawing that skyline is: the plain's
     level in the west, the Rolling Plains' in the east. */
  .sky-glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse 38% 70% at var(--glow-x) calc(var(--sky-rise) + (100% - var(--sky-rise)) * var(--glow-y)),
      color-mix(in srgb, var(--grazing) calc(var(--graze) * 88%), transparent) 0%,
      color-mix(in srgb, var(--grazing) calc(var(--graze) * 46%), transparent) 38%,
      transparent 100%
    );
  }
  .sky-stars {
    position: absolute;
    left: 0;
    top: 0;
    width: 1px;
    height: 1px;
    border-radius: 50%;
    opacity: var(--night);
  }
  /* On the home page the map is the backdrop: no sky, and the drawing
     starts at the top of the footer, where index.astro expects it. */
  .caprock--map {
    --sky-rise: 0px;
  }
  .caprock--map .sky {
    display: none;
  }

  /* NIGHT ON THE LAND. Under a dark sky (or, on the home page, a dark
     map) the land cannot stay in daylight. The whole of the rock, down
     to the basement, takes the two washes of the hour (--wash-warm and
     --wash-night); the lettering in the sands turns from dark ink to
     pale so it can still be read; the grass dulls; and the caliche and
     the basement, which are not part of the painting, are tinted to
     match. The footer's words only gain by it: the rock behind them
     darkens and they do not. */
  /* THE LETTERING IN THE SANDS switches from dark ink to pale; it does
     not fade from one to the other. Faded in step with --night, the ink
     passed through the sand's own tone on the way, and for about half
     an hour at dawn and again at dusk the three labels in the sand could
     not be read (measured at 1.1:1).

       --sand-flip, --water-flip   0 by day, 1 by night: the step itself.
       --sand-flip-at, --water-flip-at   the --night at which each steps.
                    That is where dark ink and pale ink are equally
                    legible on the darkening rock behind the label, so it
                    depends on that rock. The plain's and the playa's
                    names lie on the reddish-brown upper sand, which is
                    dark enough that pale ink wins early. The water
                    table's name lies on the paler sand under it and
                    holds its dark ink longer; on a narrower page the
                    drawing is lower, that name reaches up into the
                    darker sand, and it switches earlier too (see the
                    1140px rule further down).
       --sand-push, --water-push   how near its step the hour is, from
                    either side: 0 far from it, 1 at it. Both inks are
                    strengthened by it, because that is when the rock is
                    closest to them in tone.

     --sand-ink is the brown lettering and --water-ink the blue. The
     half-second transition on .mark is the only softening the switch
     gets. */
  .caprock {
    --sand-flip-at: 0.14;
    --water-flip-at: 0.4;
    --sand-flip: clamp(0, calc((var(--night) - var(--sand-flip-at)) * 100000), 1);
    --sand-push: calc(1 - min(1, max(var(--night) - var(--sand-flip-at), var(--sand-flip-at) - var(--night)) * 2.22));
    --water-flip: clamp(0, calc((var(--night) - var(--water-flip-at)) * 100000), 1);
    --water-push: calc(1 - min(1, max(var(--night) - var(--water-flip-at), var(--water-flip-at) - var(--night)) * 2.22));
    --sand-ink: color-mix(in srgb,
      color-mix(in srgb, var(--rock-ink), #120c07 calc(var(--sand-push) * 100%)),
      color-mix(in srgb, #e3ddd0, #fbf7ee calc(var(--sand-push) * 100%)) calc(var(--sand-flip) * 100%));
    --water-ink: color-mix(in srgb,
      color-mix(in srgb, #1b3644, #06121a calc(var(--water-push) * 100%)),
      color-mix(in srgb, #c3dceb, #f4faff calc(var(--water-push) * 100%)) calc(var(--water-flip) * 100%));
  }
  /* THE FALLEN BLOCKS lie on the slope, outside the rock's outline, so
     the two washes over the rock do not reach them. They take the hour
     here, in the same two measures. --stone is each lot's own colour:
     the ledge's gray-brown, or the caprock's pale caliche. The survey
     corner's rocks (further down) are coloured the same way. */
  .caprock .blocks,
  .corner .stone {
    --stone: var(--sandstone);
    fill: color-mix(in srgb,
      color-mix(in srgb, var(--stone), var(--grazing) calc(var(--graze) * 27%)),
      #0b101d calc(var(--night) * 70%));
    stroke: rgba(40, 24, 14, 0.62);
    stroke-width: 0.75;
    stroke-linejoin: round;
  }
  .caprock .blocks--cap {
    --stone: var(--caliche);
  }
  /* THE HEIGHT OF THE DRAWING. The home page repeats this clamp as
     --footer-scarp so that it can run its map down behind the profile;
     if you change it here, change it there. */
  .scarp {
    display: block;
    position: relative; /* so that it lies over .rock */
    width: 100%;
    height: clamp(104px, 12vw, 184px);
  }
  /* Line-work keeps its weight however far the box is stretched. */
  .scarp path {
    fill: none;
    vector-effect: non-scaling-stroke;
  }
  /* the hour's light, over the painting and under the line-work */
  .wash--warm {
    fill: var(--grazing);
    opacity: calc(var(--graze) * 0.27);
  }
  .wash--night {
    fill: #0b101d;
    opacity: calc(var(--night) * 0.7);
  }
  .water {
    stroke: var(--water);
    stroke-width: 1.25;
    stroke-dasharray: 7 5;
  }
  .surface {
    stroke: rgba(40, 24, 14, 0.62);
    stroke-width: 1;
  }
  .bore {
    stroke: var(--rock-ink);
    stroke-width: 3;
    opacity: 0.55;
  }
  /* THE WATER IN THE BORE. Short dashes climbing from the water table to
     the well head, one dash-and-gap every --pump seconds. --pump comes
     from the header's windmill (see pumpCaprock() below): a quarter of
     the time its wheel takes to turn once, so a stiff wind lifts water
     briskly and a calm day barely moves it. To have a still footer,
     delete the animation line. */
  .lift {
    stroke: var(--water-lift);
    stroke-width: 1.5;
    stroke-dasharray: 2 6;
    animation: caprock-lift var(--pump, 6s) linear infinite;
  }
  @keyframes caprock-lift {
    to {
      stroke-dashoffset: -8;
    }
  }
  .wellhead {
    stroke: var(--rock-ink);
    stroke-width: 3;
    stroke-linecap: square;
  }
  .seep {
    stroke: var(--water);
    stroke-width: 1.25;
    stroke-linecap: round;
    opacity: 0.9;
  }

  /* ── THE FALLS ──
     All three follow --playa, the same reading of recent rain that
     fills the playa (see below), so the scarp is wet when the plain is.

       .seep-run   the seep again, heavier, laid over the everyday one
       .fall       water dropping from the ledge's lip, its dashes moving
                   downward. To have it still, delete the animation line.
       .pool       the water in the hollow under the ledge: drawn full
                   and scaled down from its floor, as the playa's is. It
                   is full while the fall runs and outlasts it, drying
                   to nothing as the rain is forgotten.
       .creek      the water in the channel in the plains' draw, which
                   fills and dries exactly as the pool does.

     Neither the run nor the fall shows until --playa passes 0.2. */
  .seep-run {
    stroke: var(--water);
    stroke-width: 2.25;
    stroke-linecap: butt;
    opacity: calc((var(--playa) - 0.2) * 2);
  }
  .fall {
    stroke: var(--water);
    stroke-width: 1.75;
    stroke-dasharray: 3 1.2;
    opacity: calc((var(--playa) - 0.2) * 2.5);
    animation: caprock-fall 0.55s linear infinite;
  }
  @keyframes caprock-fall {
    to {
      stroke-dashoffset: -4.2;
    }
  }
  .scarp .pool,
  .scarp .creek {
    fill: var(--water);
    fill-opacity: 0.95;
    stroke: #3f6c84;
    stroke-width: 0.8;
    transform-box: fill-box;
    transform-origin: 50% 100%;
    transform: scale(calc(0.6 + 0.4 * min(1, var(--playa) * 1.8)), min(1, calc(var(--playa) * 1.8)));
    transition: transform 1.2s ease;
  }

  /* ── THE PLAYA ──
     --playa is how full it is, 0 to 1, from recent rain (the header works
     it out; readHeader() copies it onto the footer). The water is one
     lens-shaped path, drawn full, and scaled down from its lowest point:
     a little narrower and a lot shallower as it dries, to nothing. The
     cracks fade in as the last of it goes, and the recharge shows once
     there is water enough to sink: three dotted threads to the water
     table, their dots drifting downward. */
  .caprock {
    --playa: 0;
  }
  .scarp .playa-water {
    fill: var(--water);
    fill-opacity: 0.95;
    stroke: #3f6c84;
    stroke-width: 0.8;
    transform-box: fill-box;
    transform-origin: 50% 100%;
    transform: scale(calc(0.45 + 0.55 * var(--playa)), var(--playa));
    transition: transform 1.2s ease;
  }
  .playa-cracks {
    stroke: var(--rock-ink);
    stroke-width: 1;
    opacity: calc(0.6 - var(--playa) * 4);
  }
  .recharge {
    stroke: #9fcbe0;
    stroke-width: 1.1;
    stroke-dasharray: 1.5 4;
    opacity: calc((var(--playa) - 0.12) * 2.2);
    animation: caprock-sink 5s linear infinite;
  }
  @keyframes caprock-sink {
    to {
      stroke-dashoffset: -5.5;
    }
  }

  /* ── THE GRASS ──
     Two strips standing on the level plain, west and east of the playa,
     their feet on the surface line (26 of the drawing's 180 units down).
     --lean is how far the wind pushes the blades over, as an angle, with
     its sign giving the direction; the strip is skewed by it from its
     foot, and sways between a little less and a little more than that
     every --gust seconds. In a calm --lean is nothing and so is the sway.
     Skewing a strip is the cheap way to lean every blade on it at once.

     WHERE A STRIP ENDS. The blades are one tile repeated, and a strip
     whose edge falls part way through a tuft would show that tuft's
     tips with no foot under them. So each strip is shortened by a few
     pixels (--trim-west, --trim-east, set by trimGrass() in the script
     whenever the drawing changes size) to end in a gap between tufts.
     Both are shortened at the playa's side, where the grass thins out
     anyway: the west strip from its right, the east strip from its
     left, which keeps its other end at the rim. */
  .caprock {
    --lean: 0deg;
    --gust: 3.6s;
  }
  .grass {
    position: absolute;
    top: calc(26 / 180 * 100% - 10px);
    height: 10px;
    pointer-events: none;
    transform-origin: 50% 100%;
    transform: skewX(var(--lean));
    animation: caprock-sway var(--gust) ease-in-out infinite alternate;
  }
  /* THE SEASON'S COAT. Each strip is two flat fields of colour, one for
     the darker blades and one for the paler, and each field is cut to
     the shape of its blades by a mask (--blades-dark and --blades-light,
     set on the element). The colours are --grass-dark and --grass-light,
     which readHeader() works out from the date and the recent rain; the
     ones written here are winter's, for a browser without script. The
     turf is a line of the paler colour along the plain's surface, so the
     season shows at any size, not only in the blades. */
  .caprock {
    --grass-dark: #7a6740;
    --grass-light: #c2a871;
  }
  .grass::before,
  .grass::after {
    content: '';
    position: absolute;
    inset: 0;
    transition: background-color 1.2s ease;
    -webkit-mask-repeat: repeat-x;
    mask-repeat: repeat-x;
    -webkit-mask-position: left bottom;
    mask-position: left bottom;
  }
  .grass::before {
    background-color: color-mix(in srgb, var(--grass-dark), #262b3a calc(var(--night) * 62%));
    -webkit-mask-image: var(--blades-dark);
    mask-image: var(--blades-dark);
  }
  .grass::after {
    background-color: color-mix(in srgb, var(--grass-light), #3a4052 calc(var(--night) * 62%));
    -webkit-mask-image: var(--blades-light);
    mask-image: var(--blades-light);
  }
  .turf {
    stroke: color-mix(in srgb, var(--grass-light), #3a4052 calc(var(--night) * 55%));
    stroke-width: 2.5;
    stroke-linecap: butt;
    transition: stroke 1.2s ease;
  }
  .grass--west {
    left: 0;
    width: calc(166 / 1440 * 100% - var(--trim-west, 0px));
  }
  .grass--east {
    left: calc(428 / 1440 * 100% + var(--trim-east, 0px));
    width: calc(170 / 1440 * 100% - var(--trim-east, 0px));
  }
  @keyframes caprock-sway {
    from {
      transform: skewX(calc(var(--lean) * 0.72));
    }
    to {
      transform: skewX(calc(var(--lean) * 1.16));
    }
  }

  /* ── THE PLAINS ──
     The trees and the Rock House (.flora) are small pictures standing
     on the land; where each stands is worked out in the frontmatter and
     written on the element.

     HOW MANY SHOW depends on the page's width, so that a short plain is
     never crowded. The two rules that thin them are in the responsive
     section further down: .flora--wide goes at 1140px, .flora--mid and
     everything's size at 680px, and the Rock House at 1024px.

     THE LEAVES. --mesquite and --cottonwood are the season's colours for
     each tree's leaves, and --mesquite-leaf and --cottonwood-leaf how
     much leaf there is, 0 (bare) to 1; dressTrees() in the script works
     all four out from the date. The values written here are summer's,
     for a browser without script. The junipers do not change.

     Everything darkens with --night as the grass does, and the stone of
     the house takes the low sun's colour as the fallen blocks do. */
  .caprock {
    --mesquite: #74884a;
    --mesquite-leaf: 1;
    --cottonwood: #5f8246;
    --cottonwood-leaf: 1;
  }
  .flora {
    position: absolute;
    overflow: visible;
    pointer-events: none;
    transform-origin: 50% 100%;
  }
  .flora .trunk {
    fill: color-mix(in srgb, #4a3a2a, #0b101d calc(var(--night) * 62%));
  }
  .flora .bole {
    fill: color-mix(in srgb, #6d5d4a, #0b101d calc(var(--night) * 62%));
  }
  .flora .wood {
    fill: none;
    stroke: color-mix(in srgb, #3b2a1c, #0b101d calc(var(--night) * 60%));
    stroke-width: 0.9;
    stroke-linecap: round;
  }
  .flora--cottonwood .wood {
    stroke: color-mix(in srgb, #5d4e3d, #0b101d calc(var(--night) * 60%));
    stroke-width: 0.8;
  }
  .flora--juniper .leaf-dark {
    fill: color-mix(in srgb, #3c4832, #121722 calc(var(--night) * 66%));
  }
  .flora--juniper .leaf-light {
    fill: color-mix(in srgb, #5c6c46, #1a202c calc(var(--night) * 66%));
  }
  .flora--mesquite .leaf {
    fill: color-mix(in srgb, var(--mesquite), #262b3a calc(var(--night) * 62%));
    opacity: calc(var(--mesquite-leaf) * 0.8);
  }
  .flora--cottonwood .leaf {
    fill: color-mix(in srgb, var(--cottonwood), #262b3a calc(var(--night) * 62%));
    opacity: var(--cottonwood-leaf);
  }
  .flora--cottonwood .leaf-light {
    fill: color-mix(in srgb, color-mix(in srgb, var(--cottonwood), #fff1b8 34%), #3a4052 calc(var(--night) * 62%));
    opacity: calc(var(--cottonwood-leaf) * 0.9);
  }

  /* THE ROCK HOUSE. Stone, roof, the pale woodwork of the gallery, the
     shade under it, and the windmill. One window keeps a lamp, which
     comes up as the night does. The mill's wheel turns once in the time
     the header's does: --pump is a quarter of that (see THE WATER IN
     THE BORE), so four of them. To have it still, delete the animation
     line. */
  .house .stonework {
    fill: color-mix(in srgb,
      color-mix(in srgb, var(--house-stone), var(--grazing) calc(var(--graze) * 27%)),
      #0b101d calc(var(--night) * 70%));
    stroke: rgba(40, 24, 14, 0.62);
    stroke-width: 0.5;
    stroke-linejoin: round;
  }
  .house .courses {
    fill: none;
    stroke: rgba(60, 40, 26, 0.36);
    stroke-width: 0.35;
  }
  .house .roof {
    fill: color-mix(in srgb, #66584b, #0b101d calc(var(--night) * 70%));
    stroke: rgba(40, 24, 14, 0.62);
    stroke-width: 0.5;
    stroke-linejoin: round;
  }
  .house .shade {
    fill: rgba(30, 20, 14, 0.5);
  }
  .house .gallery {
    fill: color-mix(in srgb, #e9e2d2, #0b101d calc(var(--night) * 66%));
    stroke: rgba(40, 24, 14, 0.5);
    stroke-width: 0.35;
  }
  .house .gallery-posts {
    fill: none;
    stroke: color-mix(in srgb, #d9d1bf, #0b101d calc(var(--night) * 66%));
    stroke-width: 0.5;
  }
  .house .pane {
    fill: #2c2119;
  }
  .house .pane--lamp {
    fill: color-mix(in srgb, #2c2119, #f6cb6c calc(min(1, var(--night) * 1.6) * 100%));
  }
  .house .mill,
  .house .mill-wheel {
    fill: none;
    stroke: color-mix(in srgb, #4a3a2c, #0b101d calc(var(--night) * 60%));
    stroke-width: 0.55;
    stroke-linecap: round;
  }
  .house .mill-tail {
    fill: color-mix(in srgb, #6a5746, #0b101d calc(var(--night) * 60%));
  }
  .house .mill-wheel {
    stroke-width: 0.45;
    transform-box: fill-box;
    transform-origin: 50% 50%;
    animation: caprock-mill calc(var(--pump, 6s) * 4) linear infinite;
  }
  .house .mill-wheel circle {
    fill: color-mix(in srgb, #8a7460, #0b101d calc(var(--night) * 60%));
    fill-opacity: 0.45;
  }
  @keyframes caprock-mill {
    to {
      transform: rotate(360deg);
    }
  }

  /* ── THE SURVEY CORNER ──
     A mound of rock with a stake in it, standing on the plain between
     the well and the rim. Its place across is a fraction of the
     drawing's width and its foot is on the surface line; its size is in
     pixels. The rocks are caliche, picked up where the mound was built;
     alternate ones are a shade darker so the pile reads as stones. */
  .corner {
    position: absolute;
    left: calc(524 / 1440 * 100% - 8px);
    top: calc(26 / 180 * 100% - 13.5px);
    width: 16px;
    height: 14px;
    overflow: visible;
    pointer-events: none;
  }
  .corner .stone {
    --stone: var(--caliche);
    stroke-width: 0.5;
  }
  .corner .stone--shade {
    --stone: color-mix(in srgb, var(--caliche), #6b5a48 28%);
  }
  .corner .stake {
    fill: color-mix(in srgb, #4a3524, #0b101d calc(var(--night) * 60%));
  }

  /* ── THE TUMBLEWEED ──
     Out of sight unless the script says the wind is strong enough and
     from the west (data-weed="on"). Then it travels the land surface from
     off the left of the page to off the right: offset-path is that
     surface, written onto the element by layWeedRoad() at the drawing's
     real size, and the animation moves offset-distance along it. Three
     boxes, one job each: .weed goes along the road, .weed-hop bounces,
     .weed-ball turns. --roll is the time for one crossing; the rest of
     the cycle it waits out of sight, so it comes by now and then, not in
     a procession. */
  .caprock {
    --roll: 22s;
  }
  .weed {
    display: none;
    position: absolute;
    left: 0;
    top: 0;
    width: 30px;
    height: 30px;
    offset-rotate: 0deg;
    offset-anchor: 50% 96%;
    offset-distance: 0%;
    pointer-events: none;
  }
  /* only where the browser can move a box along a path; anywhere else
     the weed would sit in the corner of the drawing and spin there */
  @supports (offset-path: path('M0,0 L1,1')) {
    .caprock[data-weed='on'] .weed {
      display: block;
      animation: caprock-roll calc(var(--roll) / 0.6) linear infinite;
    }
  }
  @keyframes caprock-roll {
    0% {
      offset-distance: 0%;
    }
    60%,
    100% {
      offset-distance: 100%;
    }
  }
  .weed-hop {
    animation: caprock-hop 2.3s ease-in-out infinite;
  }
  @keyframes caprock-hop {
    0%, 16%, 38%, 68%, 90%, 100% { transform: translateY(0); }
    8% { transform: translateY(-6px); }
    30% { transform: translateY(-2px); }
    55% { transform: translateY(-9px); }
    80% { transform: translateY(-3px); }
  }
  .weed-ball {
    display: block;
    width: 100%;
    height: 100%;
    animation: caprock-turn calc(var(--roll) / 14) linear infinite;
  }
  @keyframes caprock-turn {
    to {
      transform: rotate(360deg);
    }
  }

  /* THE MARKS, lettered in the rock. Their positions are fractions of
     the drawing's height (a level in the 180-unit box, over 180), so
     they keep their place in the strata at every size. */
  .mark {
    position: absolute;
    font-size: 0.5625rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    white-space: nowrap;
    pointer-events: none;
    font-variant-numeric: tabular-nums;
    transition: color 0.5s ease;
  }
  .mark--plateau {
    left: clamp(1.25rem, 4vw, 3.5rem);
    top: calc(34 / 180 * 100%);
    color: var(--sand-ink);
  }
  /* under the playa, to the right of the threads of recharge; which of
     its two endings shows follows the playa (the script sets data-playa) */
  .mark--playa {
    left: calc(312 / 1440 * 100%);
    top: calc(40 / 180 * 100%);
    font-family: cormorant-garamond, serif;
    font-style: italic;
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    text-transform: none;
    color: var(--sand-ink);
  }
  .playa-wet,
  .caprock[data-playa='wet'] .playa-dry {
    display: none;
  }
  .caprock[data-playa='wet'] .playa-wet {
    display: inline;
  }
  .mark--water {
    left: 35%;
    top: calc(74 / 180 * 100% - 1.5em);
    font-family: cormorant-garamond, serif;
    font-style: italic;
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    text-transform: none;
    color: var(--water-ink);
  }
  /* on the brick-red rock, which is the brightest ground any lettering
     here has to cross: full-strength cream by day */
  .mark--basin {
    right: clamp(1.25rem, 4vw, 3.5rem);
    top: calc(155 / 180 * 100%);
    color: color-mix(in srgb, #f4eede, #e3ddd0 calc(var(--night) * 100%));
  }

  /* ── the section ──────────────────────────────────────────── */
  /* The redbeds, darkening with depth. Three layers, from the back:

       the gradient   on .section itself: the painting's own fall of
                      colour, in the same pixels. It is all that shows
                      until the picture loads, and it is what goes on
                      below the picture if the section is ever taller
       .deep          the painting, hung from the top of the section at
                      its own height (600px) and stretched only
                      sideways, so the bright beds and the seams of
                      gypsum stay in the first 22 pixels, above the
                      words, at every size
       ::before       the hour's two washes

     and the words (.inner) over all of it. None of it uses a blend mode. */
  .section {
    position: relative;
    margin-top: -1px;
    overflow: hidden;
    background: linear-gradient(to bottom,
      var(--redbed) 0,
      var(--redbed-2) 55px,
      var(--redbed-deep) 150px,
      var(--redbed-low) 252px,
      var(--redbed-floor) 600px);
  }
  .deep img {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 600px;
  }
  .section::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(var(--wash-night), var(--wash-night)), linear-gradient(var(--wash-warm), var(--wash-warm));
  }
  .inner {
    position: relative;
    z-index: 2;
    max-width: 78rem;
    margin: 0 auto;
    padding: clamp(2.25rem, 4vw, 3.25rem) clamp(1.25rem, 4vw, 3.5rem) clamp(3rem, 5vw, 4rem);
    display: grid;
    /* the name and its lines on the left, at the column's own edge (the
       copyright line below starts at the same place); the links on the
       right */
    grid-template-columns: minmax(0, 1fr) auto;
    gap: clamp(1.25rem, 4vw, 3.5rem);
  }

  .name {
    display: inline-block;
    font-family: cormorant-garamond, serif;
    font-weight: 500;
    font-size: clamp(1.75rem, 2.6vw, 2.3rem);
    line-height: 1;
    color: var(--ink);
    text-decoration: none;
  }
  .name:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 4px;
    border-radius: 1px;
  }
  .roles {
    font-size: 0.6875rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin: 1rem 0 0;
  }
  .tagline {
    font-family: cormorant-garamond, serif;
    font-size: clamp(1.0625rem, 1.5vw, 1.1875rem);
    line-height: 1.5;
    color: var(--ink-soft);
    max-width: 30rem;
    margin: 0.85rem 0 0;
  }

  .cols {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(2rem, 5vw, 4.5rem);
  }
  .label {
    font-size: 0.625rem;
    font-weight: 400;
    letter-spacing: 0.19em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin: 0 0 0.9rem;
  }
  .col ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  /* the index runs in two columns of three, so the footer stays low */
  .col--index ul {
    columns: 2;
    column-gap: clamp(2rem, 4vw, 3.5rem);
  }
  .col li {
    margin-bottom: 0.6rem;
    break-inside: avoid;
  }
  .col a {
    font-family: cormorant-garamond, serif;
    color: var(--ink);
    text-decoration: none;
    font-size: 1rem;
    letter-spacing: 0.015em;
    position: relative;
    padding-bottom: 2px;
    white-space: nowrap;
  }
  .col a::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.32s cubic-bezier(0.2, 0.7, 0.3, 1);
  }
  .col a:hover::after,
  .col a:focus-visible::after {
    transform: scaleX(1);
  }
  .col a:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 4px;
    border-radius: 1px;
  }

  /* ── basement ─────────────────────────────────────────────── */
  .basement {
    position: relative;
    background: color-mix(in srgb,
      color-mix(in srgb, var(--basement), var(--grazing) calc(var(--graze) * 8%)),
      #0b101d calc(var(--night) * 70%));
    border-top: 1px solid rgba(232, 225, 209, 0.1);
  }
  .basement .wrap {
    max-width: 78rem;
    margin: 0 auto;
    padding: 1rem clamp(1.25rem, 4vw, 3.5rem);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.75rem;
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(232, 225, 209, 0.62);
    font-variant-numeric: tabular-nums;
  }

  /* ── responsive ───────────────────────────────────────────── */
  /* Below this width the playa's label would run into the plateau's,
     which is set from the left margin while the playa keeps its place
     in the drawing. The playa itself still shows whether it is wet. */
  @media (max-width: 1140px) {
    .mark--playa {
      display: none;
    }
    /* the slope under the rim leans back toward the well, so on a
       narrower page there is less sand between the two: the water
       table's name moves up against the well and is set a size smaller */
    .mark--water {
      left: calc(468 / 1440 * 100% + 7px);
      font-size: 0.75rem;
    }
  }
  /* the water table's name on a lower drawing: see THE LETTERING IN THE
     SANDS, above. On .caprock itself, because that is where the ink is
     worked out. */
  @media (max-width: 1140px) {
    .caprock {
      --water-flip-at: 0.25;
    }
  }
  /* THE PLAINS, THINNED. The plain gets shorter with the page and the
     trees do not, so fewer of them are shown: the outermost go first,
     then the Rock House (which wants a wide plain to stand on), and on a
     phone all but five, drawn three-quarters size. */
  @media (max-width: 1140px) {
    .flora--wide {
      display: none;
    }
  }
  @media (max-width: 1024px) {
    .house {
      display: none;
    }
  }
  @media (max-width: 900px) {
    /* the links go under the name */
    .inner {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 680px) {
    /* the drawing is too low here to carry lettering */
    .mark {
      display: none;
    }
    .weed {
      width: 22px;
      height: 22px;
    }
    .flora--mid {
      display: none;
    }
    .flora {
      transform: scale(0.75);
    }
    .corner {
      left: calc(524 / 1440 * 100% - 6px);
      top: calc(26 / 180 * 100% - 10.2px);
      width: 12px;
      height: 10.5px;
    }
    .inner {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }
    .cols {
      gap: 2rem 3rem;
    }
  }

  /* THE MOTION RESTS WHEN THE FOOTER IS OUT OF SIGHT. The script marks
     the footer data-live="off" while it is well clear of the window and
     "on" as it comes near (watchCaprock()); while it is off, every
     animation in it is held where it was, and picks up from there. With
     no script the mark is never set and everything simply runs. */
  .caprock[data-live='off'],
  .caprock[data-live='off'] * {
    animation-play-state: paused !important;
  }

  @media (prefers-reduced-motion: reduce) {
    .lift,
    .recharge,
    .fall,
    .grass,
    .house .mill-wheel {
      animation: none;
    }
    .caprock[data-weed='on'] .weed {
      display: none;
    }
    .scarp .playa-water,
    .scarp .pool,
    .scarp .creek,
    .grass::before,
    .grass::after,
    .turf,
    .mark {
      transition: none;
    }
    .col a::after {
      transition: none;
    }
  }
</style>

<script>
  const footerNow = () => document.querySelector<HTMLElement>('[data-caprock]');

  /* The page's real width, for the full-bleed break-out (see .caprock).
     Written onto whichever footer is in the page now: on first load, after
     every client-side navigation (the footer element is a new one each
     time), and whenever the root element changes size, which covers both
     a window resize and a scrollbar appearing or going. */
  function fitCaprock() {
    footerNow()?.style.setProperty('--page-w', `${document.documentElement.clientWidth}px`);
  }

  /* THE GRASS STRIPS END BETWEEN TUFTS (see WHERE A STRIP ENDS in the
     stylesheet). The blades are a 96px tile; TUFT_GAPS are the places
     across it where no blade stands, measured from the tile's drawing.
     For each strip: how far its natural width runs into its last tile,
     back to the nearest gap before that, and the difference is the trim.
     The widths are the strips' shares of the drawing's 1440. */
  const TUFT_GAPS = [0, 11.2, 20.2, 33.8, 43.1, 54.2, 74.5, 85.2];
  function trimGrass() {
    const footer = footerNow();
    const width = footer?.querySelector<SVGElement>('.scarp')?.getBoundingClientRect().width;
    if (!footer || !width) return;
    for (const [side, share] of [['west', 166], ['east', 170]] as const) {
      const over = ((share / 1440) * width) % 96;
      const gap = TUFT_GAPS.filter((g) => g <= over).pop() ?? 0;
      footer.style.setProperty(`--trim-${side}`, `${(over - gap).toFixed(1)}px`);
    }
  }

  /* THE MOTION RESTS WHEN THE FOOTER IS OUT OF SIGHT (the rule that does
     the holding is in the stylesheet). The footer counts as near from
     240px before it reaches the window, so nothing is seen starting up.
     Set up afresh on every page, since the footer is a new element. */
  let watcher: IntersectionObserver | null = null;
  function watchCaprock() {
    const footer = footerNow();
    if (!footer || !('IntersectionObserver' in window)) return;
    watcher?.disconnect();
    watcher = new IntersectionObserver(
      (entries) => {
        const last = entries[entries.length - 1];
        if (last) footer.dataset.live = last.isIntersecting ? 'on' : 'off';
      },
      { rootMargin: '240px 0px' }
    );
    watcher.observe(footer);
  }

  /* THE WELL KEEPS TIME WITH THE WINDMILL. The header turns its windmill
     by Lubbock's wind and records how long one turn of the wheel takes as
     --windmill-speed on #windmill (13s in a gale, about 26s in a calm).
     The water in the footer's bore climbs one step in a quarter of that.
     With no header on the page, or before the wind has been read, the
     stylesheet's 6s stands. */
  function pumpCaprock() {
    const turn = parseFloat(document.getElementById('windmill')?.style.getPropertyValue('--windmill-speed') ?? '');
    const footer = footerNow();
    if (!footer) return;
    if (Number.isFinite(turn) && turn > 0) footer.style.setProperty('--pump', `${(turn / 4).toFixed(2)}s`);
    else footer.style.removeProperty('--pump');
  }

  /* THE WEATHER. The header reads Lubbock's wind and recent rain and
     publishes them on #horizon-header:

       --wind-mph        2 to 45
       --wind-from-deg   the bearing the wind blows FROM
       --playa           how full the playa is, 0 to 1

     This turns them into what the drawing needs. The section looks
     north, so east is to the right: a wind from the west leans the grass
     to the right. Only the east-west part of the wind shows in a section,
     so a due north or south wind stirs the grass without leaning it far.

     The tumbleweed needs a real blow, 18 mph or more, with most of it
     from the west, since it has to cross the plain and go over the rim.
     Nothing is done here when nothing has changed.

     The sky is read first, from the same element at the same moments. */
  /* THE SEASON'S COAT, for the grass and the turf.

     The Llano's grasses are warm-season ones (blue grama, buffalograss):
     dormant and straw-coloured from mid November to mid March, greening
     through spring, at their best in early summer, tiring by late summer
     and curing through the autumn. `green` is that calendar as a number,
     0 for dormant to about 0.7 at the peak. Rain pushes it up and a dry
     spell lets it sag, but only while the grass is growing: no amount of
     December rain turns it green.

     The result picks a colour along straw -> gold -> green, for the
     darker blades and the paler ones separately. */
  const COATS = {
    dark: [[122, 103, 64], [106, 100, 40], [60, 95, 42]],
    light: [[194, 168, 113], [179, 161, 74], [127, 163, 76]],
  };
  function coat(stops: number[][], green: number): string {
    const t = Math.max(0, Math.min(1, green)) * 2;
    const [a, b] = t < 1 ? [stops[0], stops[1]] : [stops[1], stops[2]];
    const f = t < 1 ? t : t - 1;
    return `rgb(${a.map((v, i) => Math.round(v + (b[i] - v) * f)).join(' ')})`;
  }
  /* Dev only: the footer's "today". ?debugDate=2026-05-20 shows it as on
     that day. Failing that, the header's own ?debugTime=<ISO string> is
     used, so that one override stages the sky and the season together;
     the season is that moment's date on this computer's clock. */
  function footerToday(): Date {
    if (import.meta.env.DEV) {
      const query = new URLSearchParams(location.search);
      const day = query.get('debugDate');
      for (const raw of [day ? `${day}T12:00:00` : null, query.get('debugTime')]) {
        const d = raw ? new Date(raw) : null;
        if (d && !Number.isNaN(d.getTime())) return d;
      }
    }
    return new Date();
  }
  function greenness(playa: number): number {
    const now = footerToday();
    const day = (Date.UTC(now.getFullYear(), now.getMonth(), now.getDate()) - Date.UTC(now.getFullYear(), 0, 0)) / 86400000;
    // day of the year -> how green the calendar alone would make it. The
    // plain's grasses are warm-season ones: nothing until the frosts are
    // over (about 2 April at Lubbock), greenest in early summer, holding
    // through September, and cured within a week of the first frost of
    // autumn (about 5 November).
    const calendar: [number, number][] = [
      [0, 0], [92, 0], [152, 0.6], [196, 0.7], [258, 0.55], [316, 0], [366, 0],
    ];
    let base = 0;
    for (let i = 1; i < calendar.length; i++) {
      const [d0, g0] = calendar[i - 1];
      const [d1, g1] = calendar[i];
      if (day <= d1) {
        base = g0 + ((g1 - g0) * (day - d0)) / (d1 - d0);
        break;
      }
    }
    if (base <= 0) return 0;
    // growing: recent rain lifts it by up to 0.35, none at all costs 0.15
    return Math.max(0.12, Math.min(1, base + playa * 0.5 - 0.15));
  }

  /* THE HEADER'S SKY COLOURS. The header keeps them as --sky-top and
     --sky-horizon in its own stylesheet, where each is a chain of
     colour-mixing that this footer cannot inherit and should not copy.
     So they are read off the header as finished colours: a probe, a
     zero-sized span inside the header whose background is the variable,
     is asked what colour it turned out to be. (The header reads its own
     --sky-top the same way, for the browser's address bar.) An answer of
     "transparent" means the header has not got that far yet. */
  const skyProbes = new Map<string, HTMLElement>();
  function skyColour(header: HTMLElement, token: string): string | null {
    let probe = skyProbes.get(token);
    if (!probe || !probe.isConnected) {
      probe = document.createElement('span');
      probe.setAttribute('aria-hidden', 'true');
      probe.style.cssText = `position:absolute;width:0;height:0;overflow:hidden;pointer-events:none;background-color:var(${token})`;
      header.appendChild(probe);
      skyProbes.set(token, probe);
    }
    const colour = getComputedStyle(probe).backgroundColor;
    return !colour || colour === 'transparent' || colour === 'rgba(0, 0, 0, 0)' ? null : colour;
  }

  /* THE SKY, copied from the header onto the footer: its two colours, how
     dark it is, how low the sun is and what colour that makes the light,
     and which side the glow is on. The section looks north, so the sun in
     the west (azimuth 270) is at the left and in the east at the right. */
  let skyKey = '';
  function readSky(footer: HTMLElement, header: HTMLElement | null) {
    if (!header) return;
    const get = (name: string) => header.style.getPropertyValue(name).trim();
    const top = skyColour(header, '--sky-top');
    const low = skyColour(header, '--sky-horizon');
    const night = parseFloat(get('--night'));
    const graze = parseFloat(get('--grazing-light'));
    const azimuth = parseFloat(get('--sun-azimuth-deg'));
    const glowX = Number.isFinite(azimuth) ? 50 + 40 * Math.sin((azimuth * Math.PI) / 180) : 12;
    const key = [top, low, night, graze, get('--grazing-color'), glowX.toFixed(0)].join('|');
    if (key === skyKey && footer.style.getPropertyValue('--night')) return;
    skyKey = key;
    if (top) footer.style.setProperty('--sky-top', top);
    if (low) footer.style.setProperty('--sky-horizon', low);
    if (Number.isFinite(night)) footer.style.setProperty('--night', night.toFixed(3));
    if (Number.isFinite(graze)) footer.style.setProperty('--graze', graze.toFixed(3));
    if (get('--grazing-color')) footer.style.setProperty('--grazing', get('--grazing-color'));
    footer.style.setProperty('--glow-x', `${glowX.toFixed(0)}%`);
    // the skyline under the glow: the plain (26 of 180 down) when the sun
    // is in the west, the Rolling Plains (about 145) when it is in the east
    footer.style.setProperty('--glow-y', (glowX < 50 ? 26 / 180 : 145 / 180).toFixed(3));
  }

  /* THE TREES' YEAR. For each tree, stops through the year: the day of
     the year, the colour of its leaves then, and how much leaf it has
     (0 bare, 1 full). Between stops both are read off in proportion.
     The dates hang on Lubbock's frosts: on average the last of spring
     comes about 2 April (day 92) and the first of autumn about 5
     November (day 309).

       cottonwood  breaks bud as the frosts end and is in full leaf by
                   mid April; pale new green, darkening by June; green
                   until mid October, gold by the first frost, and gold
                   for a fortnight after it
       mesquite    the last thing on the plains to leaf out, waiting
                   until the frosts are surely over: mid to late April.
                   Light pea-green at first, a uniform dark green by
                   mid June. It stays green up to the frost, yellows
                   after it, and has dropped by December

     Coming into leaf and dropping it each take about ten days, which is
     the only time a tree is shown half-clothed.
     Worked out once, when the footer is set up: it follows the date,
     not the weather. */
  const LEAVES: Record<string, [number, number[], number][]> = {
    mesquite: [
      [0, [157, 180, 90], 0], [105, [157, 180, 90], 0], [117, [157, 180, 90], 1], [166, [116, 140, 74], 1],
      [293, [120, 140, 74], 1], [314, [166, 150, 75], 1], [324, [168, 146, 74], 1], [334, [168, 146, 74], 0],
      [366, [168, 146, 74], 0],
    ],
    cottonwood: [
      [0, [169, 192, 96], 0], [91, [169, 192, 96], 0], [105, [164, 192, 92], 1], [152, [95, 130, 70], 1],
      [288, [105, 134, 69], 1], [309, [198, 165, 58], 1], [324, [201, 166, 58], 1], [334, [192, 154, 58], 0],
      [366, [192, 154, 58], 0],
    ],
  };
  function dressTrees() {
    const footer = footerNow();
    if (!footer) return;
    const now = footerToday();
    const day = (Date.UTC(now.getFullYear(), now.getMonth(), now.getDate()) - Date.UTC(now.getFullYear(), 0, 0)) / 86400000;
    for (const [tree, stops] of Object.entries(LEAVES)) {
      let i = 1;
      while (i < stops.length - 1 && day > stops[i][0]) i++;
      const [d0, c0, l0] = stops[i - 1];
      const [d1, c1, l1] = stops[i];
      const t = d1 > d0 ? Math.min(1, Math.max(0, (day - d0) / (d1 - d0))) : 0;
      const colour = c0.map((v, k) => Math.round(v + (c1[k] - v) * t));
      footer.style.setProperty(`--${tree}`, `rgb(${colour.join(', ')})`);
      footer.style.setProperty(`--${tree}-leaf`, (l0 + (l1 - l0) * t).toFixed(2));
    }
  }

  /* DEV ONLY: says in the browser's console what the season has been
     worked out to be, so that it can be checked without judging colours
     by eye. It reads back what was actually written on the footer. Try
     it with ?debugDate=2026-11-12 (gold), ?debugDate=2026-01-15 (bare)
     or ?debugDate=2026-04-22 (the mesquite half out); the header's
     ?debugTime sets the date here as well. None of this is in the built
     site. */
  function reportSeason() {
    const footer = footerNow();
    if (!footer) return;
    const get = (name: string) => footer.style.getPropertyValue(name).trim() || '(not set)';
    console.info(`[caprock] the season on ${footerToday().toDateString()}`, {
      mesquite: `${get('--mesquite')}, leaf ${get('--mesquite-leaf')}`,
      cottonwood: `${get('--cottonwood')}, leaf ${get('--cottonwood-leaf')}`,
      grass: `${get('--grass-dark')} and ${get('--grass-light')}`,
    });
  }

  let weatherKey = '';
  function readHeader() {
    const footer = footerNow();
    if (!footer) return;
    const header = document.getElementById('horizon-header');
    readSky(footer, header);
    const num = (name: string) => parseFloat(header?.style.getPropertyValue(name) ?? '');
    const mph = Number.isFinite(num('--wind-mph')) ? num('--wind-mph') : 0;
    const from = Number.isFinite(num('--wind-from-deg')) ? num('--wind-from-deg') : 270;
    const playa = Number.isFinite(num('--playa')) ? Math.max(0, Math.min(1, num('--playa'))) : 0;

    // +1 blowing due east, -1 due west
    const eastward = -Math.sin((from * Math.PI) / 180);
    const lean = Math.min(30, mph * 1.1) * eastward;
    const gust = Math.max(1.3, 4.2 - mph * 0.07);
    const weed = mph >= 18 && eastward > 0.5;
    const roll = Math.max(11, 32 - mph * 0.45);

    const green = greenness(playa);
    const key = [lean.toFixed(1), gust.toFixed(2), weed, roll.toFixed(1), playa.toFixed(2), green.toFixed(2)].join('|');
    if (key === weatherKey && footer.dataset.playa) return;
    weatherKey = key;
    // skewX leans to the left for a positive angle, hence the minus
    footer.style.setProperty('--lean', `${(-lean).toFixed(1)}deg`);
    footer.style.setProperty('--gust', `${gust.toFixed(2)}s`);
    footer.style.setProperty('--roll', `${roll.toFixed(1)}s`);
    footer.style.setProperty('--playa', playa.toFixed(2));
    footer.style.setProperty('--grass-dark', coat(COATS.dark, green));
    footer.style.setProperty('--grass-light', coat(COATS.light, green));
    footer.dataset.playa = playa >= 0.15 ? 'wet' : 'dry';
    footer.dataset.weed = weed ? 'on' : 'off';
  }

  /* THE TUMBLEWEED'S ROAD, at the drawing's real size. The road is kept
     on the element in the drawing's own 1440 x 180 units; offset-path
     wants pixels, so every pair of numbers in it is scaled to the box as
     it is now. Redone whenever the box changes size. */
  function layWeedRoad() {
    const footer = footerNow();
    const weed = footer?.querySelector<HTMLElement>('.weed');
    const scarp = footer?.querySelector<SVGElement>('.scarp');
    if (!weed || !scarp) return;
    const box = scarp.getBoundingClientRect();
    if (!box.width) return;
    const sx = box.width / 1440;
    const sy = box.height / 180;
    const road = (weed.dataset.road ?? '').replace(
      /(-?\d+(?:\.\d+)?),(-?\d+(?:\.\d+)?)/g,
      (_m, x: string, y: string) => `${(parseFloat(x) * sx).toFixed(1)},${(parseFloat(y) * sy).toFixed(1)}`
    );
    weed.style.setProperty('offset-path', `path('${road}')`);
  }

  /* IF A PICTURE OF THE ROCK IS MISSING (not yet copied to
     public/images/footer/, say, or blocked), take its empty frame out
     of the way so that the flat tones behind it show cleanly, and not a
     broken-image box. A picture that is merely still loading is left
     alone. */
  function dropMissingRock() {
    footerNow()
      ?.querySelectorAll<HTMLImageElement>('.rock img, .deep img')
      .forEach((img) => {
        const drop = () => {
          img.style.visibility = 'hidden';
        };
        if (img.complete && img.naturalWidth === 0 && img.currentSrc) drop();
        else img.addEventListener('error', drop, { once: true });
      });
  }

  function initCaprock() {
    dropMissingRock();
    fitCaprock();
    trimGrass();
    watchCaprock();
    pumpCaprock();
    readHeader();
    dressTrees();
    layWeedRoad();
    if (import.meta.env.DEV) reportSeason();
  }

  if ('ResizeObserver' in window) {
    new ResizeObserver(() => {
      fitCaprock();
      trimGrass();
      layWeedRoad();
    }).observe(document.documentElement);
  }
  // The header writes the weather when its reading arrives and again
  // every minute with the sky; either way the footer follows.
  const horizon = document.getElementById('horizon-header');
  if (horizon) {
    new MutationObserver(readHeader).observe(horizon, { attributes: true, attributeFilter: ['style'] });
  }
  // The header writes the windmill's speed when the wind reading arrives,
  // which is after this script first runs, so watch for it.
  const windmill = document.getElementById('windmill');
  if (windmill) {
    new MutationObserver(pumpCaprock).observe(windmill, { attributes: true, attributeFilter: ['style'] });
  }

  initCaprock();
  // re-run after client-side navigation: the footer is a new element then
  document.addEventListener('astro:page-load', initCaprock);
</script>