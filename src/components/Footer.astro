/**
 * Footer.astro — "The Caprock"
 *
 * A measured section through the edge of the Llano Estacado at Blanco
 * Canyon, east of Lubbock, looking north: the level plain on the left;
 * the rim, where the caprock breaks off square; the steep slope in the
 * sands under it; a sandstone ledge standing out of the face; the red
 * beds below that; and the low Rolling Plains on the right.
 *
 * WHAT IS SHOWN, from the top down. The rock is Blanco Canyon's, and its
 * colours are the published ones (see THE ROCK'S COLOURS, below):
 *
 *   the cover sands  a thin red sandy loam on the plain (the Blackwater
 *                    Draw Formation), with a pink limy band in it. The
 *                    playa is floored with dark gray clay
 *   the caprock      white caliche under the cover sands. It is the
 *                    hard bed, so at the rim it ends in a small cliff
 *                    of its own, a little undercut. It is missing under
 *                    the middle of the playa, as it is under real ones
 *   the white beds   near the rim, under the caprock: the pale lake
 *                    beds of Mount Blanco (the Blanco Formation), which
 *                    gave the canyon its name
 *   the Ogallala     the sands, in the two parts named in this canyon:
 *                    reddish brown above (Bridwell) and pinkish below
 *                    (Couch), with gravel at the base. The dashed blue
 *                    line is the water table and the sand below it is
 *                    saturated
 *   the ledge        Triassic sandstone, gray weathering brown, which
 *                    the sands rest on. It is hard too, and stands out
 *                    of the face as a narrow bench with a blocky lip,
 *                    undercut where the softer rock below has worn
 *                    back. Under the lip is a small hollow, the plunge
 *                    pool of the falls (see THE WEATHER)
 *   the blocks       what has fallen: pale pieces of the caprock on the
 *                    slope above the ledge, gathering toward its foot,
 *                    and gray-brown pieces of the ledge itself on the
 *                    slope below it
 *   the corner       on the plain near the rim, a survey corner as a
 *                    surveyor left it: a mound of rock with a stake
 *   the trees        what grows changes at the scarp, as it really
 *                    does: shortgrass on the plain above, junipers
 *                    (cedar) on the foot of the slope, mesquite
 *                    scattered over the plains, cottonwoods at the creek
 *   the Rock House   west of the creek, Hank Smith's house at Mount
 *                    Blanco (1877), drawn from photographs: a stone
 *                    house with a steep roof and a chimney at each end,
 *                    a railed gallery along its side, a windmill beside
 *                    it and a dry-laid rock wall in front. Wide screens
 *                    only (see THE PLAINS in the stylesheet)
 *   the red beds     Triassic mudstone: reddish brown, with a little
 *                    red-purple and gray-green. It is also what the
 *                    Rolling Plains stand on, and the footer's words
 *                    are set in it, where it has gone dark with depth
 *   the basement     the dark bar at the foot
 *
 * THE ROCK IS A PAINTING, not flat colour. It is one picture of the beds
 * cut in two, in public/images/footer/:
 *
 *   caprock-strata.webp    the 180 units of the drawing. It lies under
 *                          the drawing (.rock) and is cut to the land's
 *                          profile by a clip made from the same path
 *   caprock-redbeds.webp   the 600 pixels below, behind the words
 *                          (.deep), shown at its own height from the
 *                          top of the section however tall that is
 *
 * and a -phone pair, painted for a narrower section so that the beds are
 * not squeezed sideways on a small screen. Both are ordinary images, so
 * they load only as the footer comes near and only the pair that suits
 * the screen. Until they arrive, flat colours and a gradient in the same
 * tones stand in for them.
 *
 * The line-work (water table, well, surface, grass) is still drawn
 * here, over the painting. The rock's own colours, the caprock's
 * included, are IN the pictures: to change them, the pictures are
 * painted again.
 *
 * THE ROCK'S COLOURS are taken from the geological literature, not
 * chosen by eye. Where a source gives a Munsell notation it was
 * converted directly (the cover sands, from the USDA soil survey's
 * Amarillo series and a study of the Blackwater Draw Formation). Where
 * a source gives only words ("characteristically reddish brown",
 * "pinkish gray", "light greenish-gray, white") the matching chip of the
 * Geological Society of America's rock-colour chart was used. The
 * Ogallala's two parts and the Blanco beds are as the U.S. Geological
 * Survey's lexicon describes them in this canyon; the Triassic beds are
 * as the Bureau of Economic Geology describes them in Garza County, the
 * next county south. Thicknesses are schematic.
 *
 * THE HOUR lies over the rock as two flat washes, the low sun's colour
 * at dawn and dusk and a dark blue at night, both from the header.
 *
 * THE WELL is the one thing here that moves. A bore runs from the plain
 * down to the water table and water rises in it, at a pace taken from
 * the header's windmill: the header turns its wheel by Lubbock's real
 * wind, and this draws water as fast as that wheel is turning. Where
 * the water table meets the face it comes out as a seep, as it does
 * along the real escarpment.
 *
 * THE WEATHER reaches down here too, from the same reading the header
 * takes for Lubbock:
 *
 *   the playa   the shallow dip in the plain. After rain it holds water,
 *               and a trickle of recharge goes down to the water table,
 *               which is how the Ogallala is really fed. In a dry spell
 *               it is a cracked pan.
 *   the falls   after the same rain the seep runs harder, goes off the
 *               ledge's lip as a small fall and fills the pool under
 *               it. The fall stops as the rain is forgotten and the
 *               pool dries after it, as water does at Silver Falls on
 *               the White River, in this canyon.
 *   the grass   along the plain, leaning the way the wind is blowing and
 *               further the harder it blows. Its colour is the season's:
 *               straw through the winter, greening in spring, green in a
 *               wet summer, gold in a dry one and curing again in autumn.
 *               The turf along the plain's surface takes the same coat.
 *   the creek   the same rain puts water in the channel in the plains'
 *               draw, and it dries as the pool does.
 *   the leaves  the mesquite and the cottonwoods keep the calendar,
 *               which is hung on Lubbock's frosts (the last about 2
 *               April, the first about 5 November): bare through the
 *               winter; the cottonwoods out in the first half of April
 *               and the mesquite, always last, in the second; both
 *               green until the frost; then the cottonwoods gold and
 *               the mesquite yellow for a fortnight in November, and
 *               bare again by December. The junipers are evergreen.
 *               (dressTrees() in the script.)
 *   the mill    the wheel of the windmill at the Rock House turns at
 *               the pace of the header's.
 *   the weed    in a strong west wind a tumbleweed comes across the
 *               plain, is blown off the rim, lands on the bench, goes
 *               off that as well and away east.
 *
 * All of it, sky and weather, is driven by readHeader() in the script. Without a
 * reading the plain is calm and the playa dry.
 *
 * THE SKY above the profile is the header's sky. The header is all sky
 * and this is all ground, so the two do not share colours; what they
 * share is the moment. Over the Caprock stands the same sky the header
 * is showing: its blue at midday, its glow low in the west at dusk and
 * in the east at dawn, its navy and its stars at night, rising out of
 * the page above. Under a dark sky the land goes dark too.
 *
 * The home page is the one exception. There the map is carried down
 * behind the profile (index.astro does that), so the land rises out of
 * the map and there is no sky band; the rock still darkens at night,
 * with the map behind it.
 *
 * Nothing is lettered in the sky; the marks all sit inside the rock.
 *
 * THE COLOURS of the type and the line-work are this file's own and are
 * declared in one block at the top of the stylesheet, with the tones
 * that stand in for the painting. They do not read the site's palette.
 *
 * Full-bleed by design. See the break-out note in <style>.
 */

interface Link {
  label: string;
  href: string;
}

interface Props {
  name?: string;
  roles?: string[];
  tagline?: string;
  index?: Link[];
  contact?: Link[];
  location?: string;
  /** Accepted so existing callers keep working; none of these is drawn.
   *  (The two elevations were the ticks of a scale beside the name. The
   *  drawing carries its own elevations now, and the name lies in rock
   *  well below either figure.) */
  coordinates?: string;
  status?: string;
  ledeElevation?: string;
  linksElevation?: string;
  /** Survey marks lettered in the rock, under the plain and under the basin */
  plateauMark?: string;
  basinMark?: string;
}

