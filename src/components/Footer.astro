<footer class:list={['caprock', { 'caprock--map': onMap }]} data-caprock>
  <!-- ── the escarpment ─────────────────────────────────────── -->
  <div class="scarp-wrap">
    <!-- the header's sky, over the land (not on the home page) -->
    <div class="sky" aria-hidden="true">
      <div class="sky-glow"></div>
      <div class="sky-stars" style={`box-shadow:${STARS}`}></div>
    </div>

    <div class="scarp-box">
    <!-- the rock: the painting of the beds, cut to the land's profile and
         lying under the drawing. One image; the screen picks which. -->
    <div class="rock" style={`clip-path:${rockClip};--sand-base:${(OGALLALA_BASE / 1.8).toFixed(1)}%`} aria-hidden="true">
      <picture>
        <source media="(max-width: 680px)" srcset={`${ROCK}/caprock-strata-phone.webp`} />
        <img src={`${ROCK}/caprock-strata.webp`} alt="" width="2880" height="360" loading="lazy" decoding="async" />
      </picture>
    </div>
    <svg class="scarp" viewBox="0 0 1440 180" preserveAspectRatio="none" aria-hidden="true">
      <defs>
        <clipPath id="caprock-ground"><path d={groundPath}></path></clipPath>
      </defs>

      <!-- The ground itself is not drawn here any more: it is the picture
           under this drawing (.rock). Everything in this group is cut off
           by the land surface. -->
      <g clip-path="url(#caprock-ground)">
        <!-- the hour's light on the rock: the low sun's colour, then the night -->
        <rect class="wash wash--warm" x="0" y="0" width="1440" height="180"></rect>
        <rect class="wash wash--night" x="0" y="0" width="1440" height="180"></rect>
        <path class="water" d={`M0,${WATER} H1440`}></path>
        <!-- rain that the playa held, on its way down -->
        <path class="recharge" d={rechargePath}></path>
        <!-- the well: its bore, and the water rising in it -->
        <path class="bore" d={`M${WELL_X},${SURFACE} V${WATER + 9}`}></path>
        <path class="lift" d={`M${WELL_X},${WATER} V${SURFACE + 2}`}></path>
      </g>

      <path class="surface" d={surfacePath}></path>
      <!-- the pool under the ledge, when there has been rain to fill it -->
      <path class="pool" d={poolWater}></path>
      <!-- and the creek in the plains' draw, on the same rain -->
      <path class="creek" d={creekWater}></path>
      <!-- what has fallen: pieces of the caprock on the slope above the
           ledge, pieces of the ledge on the slope below it -->
      <path class="blocks blocks--cap" d={capBlocksPath}></path>
      <path class="blocks" d={ledgeBlocksPath}></path>
      <!-- the seep runs ON the surface, so it is drawn over that line -->
      <path class="seep" d={seepPath}></path>
      <!-- after rain: the seep running harder, and the fall off the lip -->
      <path class="seep-run" d={runPath}></path>
      <path class="fall" d={fallPath}></path>
      <!-- the turf: the plain's surface, in the season's colour -->
      <path class="turf" d={PLATEAU}></path>
      <path class="playa-water" d={playaWater}></path>
      <path class="playa-cracks" d={playaCracks}></path>
      <path class="wellhead" d={`M${WELL_X - 6},${SURFACE} H${WELL_X + 6}`}></path>
    </svg>

    <!-- the grass on the level plain, either side of the playa. These and
         the tumbleweed are ordinary boxes laid over the drawing, sized in
         pixels, because anything drawn inside the stretched box would be
         stretched with it. -->
    <div class="grass grass--west" style={`--blades-dark:${GRASS_DARK};--blades-light:${GRASS_LIGHT}`}></div>
    <div class="grass grass--east" style={`--blades-dark:${GRASS_DARK};--blades-light:${GRASS_LIGHT}`}></div>

    <!-- a survey corner on the plain: a mound of rock and its stake. A
         box in pixels like the grass, so that it keeps its shape. -->
