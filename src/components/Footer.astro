      <path class="stake" d="M7.7,7.4 L8.1,0.9 L9.2,1 L9,7.4 Z"></path>
      <path class="stone stone--shade" d="M5.9,9 L6.5,7 L9.5,6.8 L10.1,9 Z"></path>
      <path class="stone" d="M3.2,11.4 L4.1,9 L7.4,8.7 L8,11.2 Z"></path>
      <path class="stone stone--shade" d="M7.6,11.2 L8.3,8.9 L11.3,8.8 L12.4,11.5 Z"></path>
      <path class="stone stone--shade" d="M0.8,14 L1.6,11.5 L4.5,11 L5.6,14 Z"></path>
      <path class="stone" d="M5.2,14 L5.8,11.3 L9.4,10.9 L10.3,14 Z"></path>
      <path class="stone" d="M9.9,14 L10.8,11.7 L13.7,11.4 L15.1,14 Z"></path>
    </svg>

    <!-- ── the plains ──────────────────────────────────────────
