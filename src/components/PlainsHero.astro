---
// src/components/PlainsHero.astro
// The home page opening: the white head of an arrow against the plains sky, with the title set behind it.
//
// How it is built (no animation):
//   1. the photograph                     public/img/hero/plains-*.webp / .jpg
//   2. the title, drawn in the same coordinates as the photograph, so it always lands in the same place on it
//   3. the arrow alone, cut out of the photograph (transparent everywhere else), laid exactly on top,
//      so the shaft and head stand in front of the letters
//   4. a note pointing to the maker's plate on the head, and the introduction and links
// Wide screens use a panorama made from the photograph (the sky and plains carried out to the left).
// Phones and portrait tablets use the photograph as taken, with the title over the grass.
interface Props {
  arrowCount: number;
  countyCount: number;
}
const { arrowCount, countyCount } = Astro.props;

// Wide layout only when the screen is at least 5:4; below that, the tall photograph
const WIDE = '(min-aspect-ratio: 5/4)';
const BLANK = 'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7';
---
<section class="ph" data-hero aria-labelledby="ph-title">
    <!-- 1. Photograph -->
    <picture class="ph-photo">
        <source media={WIDE} type="image/webp" srcset="/img/hero/plains-wide-1920.webp 1920w, /img/hero/plains-wide-2880.webp 2880w" sizes="100vw" />
        <source media={WIDE} srcset="/img/hero/plains-wide-1920.jpg 1920w" sizes="100vw" />
        <source type="image/webp" srcset="/img/hero/plains-tall-1134.webp 1134w" sizes="100vw" />
        <img src="/img/hero/plains-tall-1134.jpg" width="1134" height="2016" fetchpriority="high" decoding="async"
             alt="The white steel head of a Quanah Parker Trail arrow, set point-down in prairie grass under a blue sky" />
    </picture>

    <!-- 2. Title, in the photograph's own coordinates (wide screens). Each line ends just behind the shaft or the head. -->
    <svg class="ph-art ph-wide" viewBox="0 0 2880 1620" preserveAspectRatio="xMaxYMin slice" aria-hidden="true" focusable="false">
        <g class="ph-t ph-t--a" text-anchor="end">
            <text x="1960" y="500">QUANAH</text>
            <text x="2075" y="815">PARKER</text>
            <text x="1830" y="1125">TRAIL</text>
        </g>
        <g class="ph-t ph-t--b" text-anchor="end">
            <text x="1963" y="470">QUANAH</text>
            <text x="2041" y="707">PARKER</text>
            <text x="1835" y="944">TRAIL</text>
        </g>
    </svg>

    <!-- 3. The arrow alone, on top of the title (wide screens; phones load nothing here) -->
    <picture class="ph-photo ph-front">
        <source media={WIDE} srcset="/img/hero/plains-wide-fg-1920.webp 1920w, /img/hero/plains-wide-fg-2880.webp 2880w" sizes="100vw" type="image/webp" />
        <img src={BLANK} alt="" decoding="async" />
    </picture>

    <!-- 4a. The maker's plate, pointed out like a note on a museum photograph -->
    <svg class="ph-art ph-wide ph-note" viewBox="0 0 2880 1620" preserveAspectRatio="xMaxYMin slice" aria-hidden="true" focusable="false">
        <defs>
            <filter id="ph-soft" x="-10%" y="-40%" width="120%" height="180%">
                <feDropShadow dx="0" dy="2" stdDeviation="6" flood-color="#0a140c" flood-opacity="0.65" />
            </filter>
        </defs>
        <polyline points="2122,955 1960,1240 1600,1240" />
        <circle cx="2130" cy="945" r="15" />
        <g filter="url(#ph-soft)">
            <text class="ph-note-k" x="1600" y="1292">MAKER’S PLATE</text>
            <text class="ph-note-t" x="1600" y="1342">“Quanah Parker Trail 2011 · 37”</text>
            <text class="ph-note-t" x="1600" y="1386">Charles A. Smith, sculptor</text>
        </g>
    </svg>

    <div class="ph-shade" aria-hidden="true"></div>

    <nav class="ph-nav" aria-label="Sections">
        <a href="/story.html">The Story</a>
        <a href="/arrows.html">The Arrows</a>
        <a href="/people.html#people-section">The People</a>
        <a href="/map.html">Map</a>
        <a href="/list/">List</a>
    </nav>

    <div class="ph-copy">
        <!-- The real title. On wide screens it is read aloud here and drawn in the sky above; on phones it shows here. -->
        <h1 class="ph-title" id="ph-title">Quanah <br />Parker <br />Trail</h1>
        <p class="ph-kicker">A heritage trail across the Texas Plains · Est. 2010</p>
        <p class="ph-lede">{arrowCount} steel arrows in {countyCount} counties mark places tied to Quanah Parker and the Comanche people.</p>
        <p class="ph-actions">
            <a class="ph-btn ph-btn--solid" href="#trip">Plan a drive</a>
            <a class="ph-btn" href="/?near#map-section" data-near-me>Find arrows near me</a>
            <a class="ph-btn ph-btn--text" href="#map-section">Explore the map</a>
        </p>
        <p class="ph-sections">
            <a href="/story.html">The Story</a><a href="/arrows.html">The Arrows</a><a href="/people.html#people-section">The People</a>
        </p>
    </div>
    <p class="sr-only">The maker’s plate on this arrow reads: Quanah Parker Trail 2011, 37, Charles A. Smith.</p>
</section>

<style is:global>
    /* The display face for the title, hosted with the site (public/fonts) */
    @font-face {
        font-family: 'Libre Caslon Display';
        src: url('/fonts/libre-caslon-display-400.woff2') format('woff2');
        font-weight: 400; font-style: normal; font-display: swap;
    }
</style>

<style>
    .ph {
        --ink: #132038;
        --red: var(--color-primary, #a92323);
        position: relative; overflow: hidden; isolation: isolate;
        block-size: 100vh; block-size: 100svh; min-block-size: 560px;
        background: #6f9bd6;
        font-family: 'Montserrat', 'Inter', sans-serif;
    }
    .ph-photo, .ph-photo img, .ph-art { position: absolute; inset: 0; inline-size: 100%; block-size: 100%; }
    .ph-photo { z-index: 0; }
    .ph-photo img { object-fit: cover; object-position: 100% 0; } /* same anchoring as the drawings: right edge, top */
    .ph-art { z-index: 1; pointer-events: none; }
    .ph-front { z-index: 2; }
    .ph-note { z-index: 5; } /* above the shade, so the caption stays bright */

    /* Title in the sky */
    .ph-t { font-family: 'Libre Caslon Display', 'Libre Caslon Text', Georgia, serif; letter-spacing: 0.02em; fill: var(--ink); }
    .ph-t--a { font-size: 340px; }
    .ph-t--b { font-size: 255px; display: none; }
    /* Narrower wide screens (between 5:4 and 3:2): a smaller title so it starts on screen */
    @media (max-aspect-ratio: 3/2) { .ph-t--a { display: none; } .ph-t--b { display: inline; } }

    /* Maker's plate note */
    .ph-note polyline { fill: none; stroke: var(--red); stroke-width: 3; }
    .ph-note circle { fill: none; stroke: var(--red); stroke-width: 4; }
    .ph-note text { fill: #fff; }
    .ph-note-k { font-family: 'Montserrat', sans-serif; font-weight: 700; font-size: 24px; letter-spacing: 0.2em; fill: #f1e6cf; }
    .ph-note-t { font-family: 'Libre Caslon Display', Georgia, serif; font-size: 36px; }
    /* very wide screens crop away the grass where it sits, and squarer ones (like a tablet on its side) need the room for the introduction */
    @media (min-aspect-ratio: 2/1), (max-aspect-ratio: 7/5) { .ph-note { display: none; } }

    /* Shade under the text on the grass */
    .ph-shade {
        position: absolute; inset: 0; z-index: 4; pointer-events: none;
        background:
            linear-gradient(to top, rgb(12 22 14 / 0.72) 0%, rgb(12 22 14 / 0.38) 22%, rgb(12 22 14 / 0) 42%),
            linear-gradient(to right, rgb(12 22 14 / 0.25), rgb(12 22 14 / 0) 45%);
    }

    /* Small menu over the sky */
    .ph-nav {
        position: absolute; z-index: 5; inset-block-start: clamp(18px, 3.5vh, 34px); inset-inline-start: clamp(20px, 4vw, 64px);
        display: flex; flex-wrap: wrap; gap: 0.4rem 1.6rem;
    }
    .ph-nav a {
        font-size: 0.74rem; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; text-decoration: none;
        color: var(--ink); padding-block: 4px; border-block-end: 1px solid transparent;
    }
    .ph-nav a:hover { border-block-end-color: currentColor; }

    /* Introduction on the grass */
    .ph-copy {
        position: absolute; z-index: 5; inset-inline-start: clamp(20px, 4vw, 64px); inset-block-end: clamp(22px, 6vh, 64px);
        max-inline-size: 31rem; color: #fff;
    }
    .ph-title {
        /* On wide screens the drawn title in the sky is what people see; this one is for screen readers */
        position: absolute; inline-size: 1px; block-size: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; margin: 0;
    }
    .ph-kicker { margin: 0 0 0.6rem; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; color: #f1e6cf; }
    .ph-lede { margin: 0 0 1.1rem; font-size: clamp(1.02rem, 0.5vw + 0.85rem, 1.22rem); font-weight: 600; line-height: 1.5; text-wrap: pretty; text-shadow: 0 1px 12px rgb(0 0 0 / 0.35); }
    .ph-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem 0.8rem; margin: 0; }
    .ph-btn {
        display: inline-block; padding: 0.7rem 1.2rem; border-radius: 999px; border: 1.5px solid rgb(255 255 255 / 0.85);
        font-size: 0.9rem; font-weight: 700; text-decoration: none; color: #fff; background: rgb(255 255 255 / 0.06); backdrop-filter: blur(4px);
        transition: background-color 0.2s, color 0.2s;
    }
    .ph-btn:hover { background: #fff; color: var(--ink); }
    .ph-btn--solid { background: var(--red); border-color: var(--red); }
    .ph-btn--solid:hover { background: #fff; border-color: #fff; color: var(--red); }
    .ph-btn--text { border-color: transparent; background: none; backdrop-filter: none; padding-inline: 0.4rem; text-decoration: underline; text-underline-offset: 4px; }
    .ph-btn--text:hover { background: none; color: #fff; text-decoration-thickness: 2px; }
    .ph-sections { display: none; }
    .ph a:focus-visible { outline: 3px solid var(--color-accent-gold, #ffc107); outline-offset: 3px; border-radius: 4px; }

    /* ---- Phones and portrait tablets: the photograph as taken, title over the grass ---- */
    @media (max-aspect-ratio: 5/4) {
        .ph-wide, .ph-front, .ph-nav { display: none; }
        .ph-photo img { object-position: 50% 0; }
        .ph-shade { background: linear-gradient(to top, rgb(10 16 24 / 0.86) 0%, rgb(10 16 24 / 0.6) 34%, rgb(10 16 24 / 0) 62%); }
        .ph-copy { inset-inline: 20px; inset-block-end: 26px; max-inline-size: none; }
        .ph-title {
            position: static; inline-size: auto; block-size: auto; overflow: visible; clip-path: none; white-space: normal;
            margin: 0 0 0.9rem; font-family: 'Libre Caslon Display', Georgia, serif; font-weight: 400;
            font-size: clamp(3.2rem, 15vw, 6.5rem); line-height: 0.9; letter-spacing: 0.02em; text-transform: uppercase; color: #fff;
        }
        .ph-btn--text { display: none; }
        .ph-sections { display: flex; flex-wrap: wrap; gap: 0.4rem 1.2rem; margin: 1rem 0 0; }
        .ph-sections a { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: #fff; text-decoration: none; border-block-end: 1px solid rgb(255 255 255 / 0.5); padding-block-end: 2px; }
    }
    @media (prefers-reduced-motion: reduce) { .ph-btn { transition: none; } }
</style>
