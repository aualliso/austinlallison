  }
  }

  @media (max-width: 480px) {
    /* top: half a pitch (see the mobile block above). bottom: 2.25rem
       of catchword target, its 0.4rem offset, and room for the last
       line's descenders, which hang below its box because baselines
       sit on the box's bottom edge. */
    .leaf-body { padding: calc(var(--rule-pitch) / 2) 1.1rem 3.25rem 15%; }
    .reg-tab { padding: 0.55rem 0.2rem; }
    .catchword { font-size: 0.95rem; min-height: 2.25rem; }
    .cover-subtitle { font-size: 0.66rem; letter-spacing: 0.15em; }
    .cover-subtitle:last-child { white-space: nowrap; }
    .cover {
      /* still well past 90deg, but shallower and narrower: there is
         less canvas to swing into */
      --cover-open-deg: 148deg;
      --cover-open-width: clamp(3.25rem, 30vw, 6rem);
    }
    /* a single margin pair on phones. Same tile recipe as the base
       rule, or .pages and the faces above it would disagree. */
    .pages {
      background-image:
        linear-gradient(
          to bottom,
          var(--ledger-rule) 0,
          var(--ledger-rule) 1px,
