        linear-gradient(var(--ledger-accent), var(--ledger-accent));
      background-repeat: repeat, no-repeat, no-repeat;
      background-position: 0 var(--rule-phase, 0px), 8% 0, 13% 0;
      background-size: 100% var(--rule-pitch), 1px 100%, 1px 100%;
    }
  }

  @media (max-width: 360px) {
    .catchword { font-size: 0.85rem; gap: 0.3rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .leaf { transition: none; }
    /* hidden, not display: none, so an inert leaf still has a layout
       for measureLeavesHeight() and snapToRules() to read */
    .leaf[inert] { transform: none; visibility: hidden; transition: none; }
    .leaf.is-turning::after { animation: none; }
    .cover { transition: none; }
    .cover[inert] { transform: none; width: auto; display: none; }
    .register-controls { transition: none; }
    .rake, .photo--develop, .cta::after, .cta::before, .reg-tab::after {
      transition: none;
    }
    .cover-open-cue::after { animation: none; opacity: 0; }
    .catchword,
    .catchword-arrow,
