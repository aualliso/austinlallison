</style>

<script>
  /* THE DESK'S LIGHT comes from the header. The Horizon header works out
     the sun for Lubbock once a minute and publishes it as custom
     properties on #horizon-header; this reads six of them and never
     does any astronomy of its own, so the desk cannot disagree with
     the sky above it (and follows the header's ?debugTime in dev).

       --sun-azimuth-deg   the sun's true bearing, 0 north, 90 east
       --sun-altitude-deg  its height above the horizon
       --night             0 by day, 1 in full dark
       --cloud             how much of the sky is cloud, 0 to 1
       --grazing-light     1 with the sun on the horizon, 0 once it is up
       --grazing-color     the sun's colour when it is low

     The first two are published by Header.astro for this purpose. A
     header without them still lights the desk, from --sun-az and
     --sun-white, but those are squeezed for drawing and the shadow
     then hardly swings from morning to evening.

     THE GEOMETRY. The header looks south, so the desk is the same
     country seen from above with south at the top, which is also how
     the plat is drawn. A sun in the east stands to the left and throws
     the book's shadow to the right; at noon it is ahead and the shadow
     falls short and straight down the page; in the evening it swings
     left. The shadow's length is the book's thickness over the tangent
     of the sun's height, so it is long at sunrise and sunset, and it
     is soft and weak then too, because a low sun is a dim one.

     THE BOOK takes the same light. Its cover brightens toward the sun
     and falls off away from it, the board edge facing the sun catches
     a highlight (--lx and --ly are the unit direction the light
     travels), and its fore-edge, which faces west, is bright with the
     sun in the west, lightly shaded at noon and in full shade with the
     sun in the east. The spine takes
     the cover's own light, carried across; its ridges and their ends
     stand out most in the morning, when the sun is on that side.

     CLOUD takes the edge off all of it. Direct sun is what throws a
     hard shadow and puts one side of a thing in light and the other in
     shade, so under cloud the shadows weaken and spread, and every
     "toward the sun / away from it" difference shrinks (--sun, which
     is 1 under a clear sky and 0 at night). The lamp does not care
     what the sky is doing.

     The values are written onto a few elements that have no children
     to speak of, not onto .register: a custom property set there would
     be inherited by the whole book and restyle it every minute.

     A MutationObserver on the header's style attribute is the clock:
     the desk updates when the header does and at no other time. It
     disconnects itself once this page's DOM has been swapped out. With
     no header on the page the stylesheet's mid-afternoon stands. */
  function initDeskLight(register: HTMLElement) {
    const header = document.getElementById('horizon-header');
    const light = document.getElementById('desk-light');
    const shadow = document.getElementById('desk-shadow');
    const depth = document.getElementById('book-depth');
    const block = document.getElementById('block-depth');
    const cover = document.getElementById('cover-light');
    const spine = document.getElementById('spine');
    const coverSpine = document.getElementById('cover-spine');
    const verso = document.getElementById('cover-verso');
    const page = document.getElementById('page-light');
    const ribbon = document.getElementById('ribbon');
    const slip = document.getElementById('reg-tablist');
    if (!header || !light || !shadow) return;

    // how far the cover stands off the desk, and the longest shadow
    // allowed: together they set the shadow's whole scale
    const BOOK_LIFT_PX = 15;
    const SHADOW_MAX_PX = 66;
    const clamp = (v: number, lo: number, hi: number) => Math.max(lo, Math.min(hi, v));
    const read = (name: string, fallback: number) => {
      const v = parseFloat(header.style.getPropertyValue(name));
      return Number.isFinite(v) ? v : fallback;
    };
    let last = '';

    function syncDeskLight() {
      const night = clamp(read('--night', 0), 0, 1);
      const grazing = clamp(read('--grazing-light', 0), 0, 1);
      const colour = header!.style.getPropertyValue('--grazing-color').trim() || 'rgb(232, 168, 92)';
      const azimuth = read('--sun-azimuth-deg', NaN);
      const altitude = read('--sun-altitude-deg', NaN);

      // BEARING: how far round from straight ahead (south) the sun
      // stands, east negative. Held short of 90deg so a shadow always
      // falls a little toward the reader, never dead sideways.
      // LENGTH: thickness over tan(height), with a floor on the height
      // and a ceiling on the length so sunrise does not throw the
      // shadow off the desk.
      let bearing: number;
      let length: number;
      if (Number.isFinite(azimuth) && Number.isFinite(altitude)) {
        bearing = clamp(azimuth - 180, -82, 82);
        length = Math.min(SHADOW_MAX_PX, BOOK_LIFT_PX / Math.tan((Math.max(altitude, 4) * Math.PI) / 180));
      } else {
        const white = clamp(read('--sun-white', 0.3), 0, 1);
        bearing = clamp((read('--sun-az', 40) - 50) / 50, -1, 1) * 78;
        length = 10 + 54 * grazing + 16 * (1 - white) * (1 - grazing);
      }
      const rad = (bearing * Math.PI) / 180;
      // the fore-edge faces west: in full shade with the sun in the
      // east, lightly shaded at noon, in none with the sun in the west
      const cloud = clamp(read('--cloud', 0), 0, 1);
      const foreShade = (clamp(0.42 - 0.58 * (bearing / 82), 0, 1) * (1 - night) * (1 - 0.5 * cloud)).toFixed(3);
      const cast = clamp(length * 0.3, 2, 6);
      // direct sun: all of it under a clear sky, about a third under
      // full cloud, none at night
      const sun = ((1 - night) * (1 - 0.65 * cloud)).toFixed(3);
      const angle = `${(180 + bearing).toFixed(1)}deg`;
      const warm = (grazing * (1 - night) * (1 - 0.6 * cloud)).toFixed(3);
      // a shadow under cloud is fainter and wider
      const shadowX = `${(-Math.sin(rad) * length).toFixed(1)}px`;
      const shadowY = `${(Math.cos(rad) * length).toFixed(1)}px`;
      const shadowBlur = `${(14 + length * 0.75 + 26 * cloud).toFixed(1)}px`;
      const shadowA = ((0.5 - 0.2 * grazing) * (1 - 0.7 * cloud)).toFixed(3);

      const values: [HTMLElement | null, string, string][] = [
        [light, '--desk-night', night.toFixed(3)],
        [light, '--sun', sun],
        [light, '--light-angle', angle],
        [light, '--light-warm', warm],
        [light, '--light-color', colour],
        [shadow, '--desk-night', night.toFixed(3)],
        [shadow, '--shadow-x', shadowX],
        [shadow, '--shadow-y', shadowY],
        [shadow, '--shadow-blur', shadowBlur],
        [shadow, '--shadow-a', shadowA],
        [depth, '--desk-night', night.toFixed(3)],
        [depth, '--fore-shade', foreShade],
        [block, '--desk-night', night.toFixed(3)],
        [block, '--sun', sun],
        [block, '--fore-shade', foreShade],
        // the page block is lower than the whole book, so its shadow on
        // the board is the desk's at about a third of the length
        [block, '--cast-x', `${(-Math.sin(rad) * cast).toFixed(1)}px`],
        [block, '--cast-y', `${(Math.cos(rad) * cast).toFixed(1)}px`],
        // the open pages and the inside of the opened cover
        [page, '--desk-night', night.toFixed(3)],
        [page, '--sun', sun],
        [page, '--light-angle', angle],
        [page, '--light-warm', warm],
        [page, '--light-color', colour],
        [verso, '--desk-night', night.toFixed(3)],
        [verso, '--sun', sun],
        [verso, '--light-angle', angle],
        [verso, '--shadow-x', shadowX],
        [verso, '--shadow-y', shadowY],
        [verso, '--shadow-blur', shadowBlur],
        [verso, '--shadow-a', shadowA],
        [ribbon, '--desk-night', night.toFixed(3)],
        [cover, '--desk-night', night.toFixed(3)],
        [cover, '--sun', sun],
        [cover, '--light-angle', angle],
        [cover, '--lx', (-Math.sin(rad)).toFixed(3)],
        [cover, '--ly', Math.cos(rad).toFixed(3)],
        // the spine faces east: lit with the sun there, shaded with it west
        [spine, '--desk-night', night.toFixed(3)],
        [spine, '--sun', sun],
        [spine, '--spine-lit', (clamp(-bearing / 82, 0, 1) * (1 - night)).toFixed(3)],
        [spine, '--spine-shade', (clamp(bearing / 82, 0, 1) * (1 - night)).toFixed(3)],
        [spine, '--light-angle', angle],
        [coverSpine, '--desk-night', night.toFixed(3)],
        [coverSpine, '--spine-shade', (clamp(bearing / 82, 0, 1) * (1 - night)).toFixed(3)],
        [slip, '--desk-night', night.toFixed(3)],
      ];
      // the header writes its properties one at a time; only repaint
      // the desk when something it uses has actually moved
      const key = values.map((v) => v[2]).join('|');
      if (key === last) return;
      last = key;
      values.forEach(([el, name, value]) => el?.style.setProperty(name, value));
    }

    syncDeskLight();
    const watch = new MutationObserver(() => {
      if (!register.isConnected) {
        watch.disconnect();
        return;
      }
      syncDeskLight();
    });
    watch.observe(header, { attributes: true, attributeFilter: ['style'] });
  }

  function initRegister() {
    const register = document.getElementById('register');
    const leavesWrap = document.getElementById('leaves');
    const pages = document.getElementById('pages');
    const leafEls = [...document.querySelectorAll<HTMLElement>('.leaf')];
    const tabs = [...document.querySelectorAll<HTMLButtonElement>('.reg-tab')];
    const tablist = document.getElementById('reg-tablist');
    const prevBtn = document.getElementById('reg-prev') as HTMLButtonElement | null;
    const nextBtn = document.getElementById('reg-next') as HTMLButtonElement | null;
    const photoLeaf = document.querySelector<HTMLElement>('.leaf--rake');
    const cover = document.getElementById('cover');
    const book = document.getElementById('book');
    const controls = document.getElementById('register-controls');

    if (!register || !leavesWrap || !pages || !leafEls.length || !tabs.length || !prevBtn || !nextBtn) return;
    if (register.dataset.registerReady === 'true') return;
    register.dataset.registerReady = 'true';

    /* RESTING STATE, applied here as well as in the inline bootstrap
       beside the markup, and both are needed.

       The bootstrap is parser-blocking, so it runs once per document
       PARSE. Astro's client-side navigation swaps the DOM without
       parsing, so on a return to this page it never runs, and the
       leaves come back with none of them inert: the last one in the
       document paints on top while everything below points at leaf 01.

       Setting it here makes the ledger's state a function of
       initRegister() rather than of how the document arrived. The
       readiness guard above means this only touches a DOM that has
       not been set up, so it cannot stamp on a reader mid-book.

       RULE FOR THIS FILE: anything in a parse-time inline script is
       invisible to client-side navigation. State that must survive a
       return visit belongs in here. */
    if (cover && !cover.hasAttribute('inert')) {
      // cover still closed: the pages behind it stay out of reach
      pages.setAttribute('inert', '');
      controls?.setAttribute('inert', '');
    }
    leafEls.forEach((leaf, i) => {
      leaf.toggleAttribute('inert', i !== 0);
      // a swapped-in DOM has no inline transform, but a restored one
      // may still be holding the last turn's rotation
      leaf.style.transform = '';
    });
    tabs.forEach((tab, i) =>
      tab.setAttribute('aria-selected', i === 0 ? 'true' : 'false')
    );

    const EXIT_DEG = 100;
    const TURN_MS = 600; // keep in sync with the .leaf transition/keyframe durations in CSS
    let current = 0;

    // ── Rotating features (leaves 03 and 05) ───────────────────────
    // Reselected at the START of a page turn, never on a timer. At
    // that instant the incoming leaf is still fully covered by the
    // outgoing one, so the new plate is already in place in the first
    // strip the turn uncovers — no fade needed, no flash, and no
    // self-updating region that would need a pause control.
    //
    // Variant 0 of each list is what the server rendered. A random
    // start offset per visit means the book opens on a different
    // plate each time; from there each return to the leaf steps
    // forward, so nothing repeats until the list has been through.
    interface PhotoVariant {
      src: string; srcset?: string; width: number; height: number;
      alt: string; caption: string;
    }
    interface PubVariant { image: string; alt: string; }

    let featurePhotos: PhotoVariant[] = [];
    let featurePubs: PubVariant[] = [];
    try {
      const parsed = JSON.parse(
        document.getElementById('register-features')?.textContent || '{}'
      );
      featurePhotos = parsed.photos ?? [];
      featurePubs = parsed.publications ?? [];
    } catch {}

    const photoImg = document.getElementById('feature-photo') as HTMLImageElement | null;
    const photoCap = document.getElementById('feature-photo-caption');
    const pubRows = [...document.querySelectorAll<HTMLElement>('#pub-entries .entry')];
    const pubImg = document.getElementById('feature-pub-image') as HTMLImageElement | null;

    const startAt = (n: number) => (n > 1 ? Math.floor(Math.random() * n) : 0);
    let photoNext = startAt(featurePhotos.length);
    let pubNext = startAt(featurePubs.length);
    let photoShown = 0;
    let pubShown = 0;

    // The swap is instant and hidden, which only works if the bytes
    // are already there — an uncached image would leave the frame
    // blank in the strip the turn is uncovering. So the NEXT pick is
    // fetched as soon as the current one lands, and both are fetched
    // when the cover opens (see initCover), not on page load: no
    // reason to spend a reader's bandwidth on leaf 03 before they've
    // shown any intent to open the ledger at all.
    function preloadPhoto(i: number) {
      const v = featurePhotos[i];
      if (!v) return;
      const im = new window.Image();
      if (v.srcset) im.srcset = v.srcset;
      im.src = v.src;
    }
    function preloadPub(i: number) {
      const v = featurePubs[i];
      // nothing to warm where the photograph is not shown (narrow pages)
      if (v && pubImg?.offsetParent) new window.Image().src = v.image;
    }

    function showPhoto(i: number) {
      const v = featurePhotos[i];
      if (!v || !photoImg || i === photoShown) return;
      // srcset first, and CLEARED when absent — it outranks src, so a
      // leftover one would keep the previous plate on screen
      if (v.srcset) photoImg.srcset = v.srcset;
      else photoImg.removeAttribute('srcset');
      photoImg.src = v.src;
      photoImg.width = v.width;
      photoImg.height = v.height;
      photoImg.alt = v.alt;
      if (photoCap) photoCap.textContent = v.caption;
      photoShown = i;
    }

    function showPublication(i: number) {
      const v = featurePubs[i];
      if (!v || i === pubShown) return;
      // the rows stay put; the mark moves to the row whose photograph
      // is now tipped in opposite
      if (pubImg) { pubImg.src = v.image; pubImg.alt = v.alt; }
      pubRows.forEach((row, n) => row.classList.toggle('is-featured', n === i));
      pubShown = i;
    }

    // A single-entry list is a deliberate no-op, not an error — that
    // leaf simply never changes, exactly as it behaved before.
    function rotateFeature(index: number) {
      if (index === 2 && featurePhotos.length > 1) {
        showPhoto(photoNext);
        photoNext = (photoNext + 1) % featurePhotos.length;
        preloadPhoto(photoNext);
      } else if (index === 4 && featurePubs.length > 1) {
        showPublication(pubNext);
        pubNext = (pubNext + 1) % featurePubs.length;
        preloadPub(pubNext);
      }
    }

    // The catchwords name their destination. Their text is read off the
    // tab row's own labels minus the "NN · " numbering rather than kept
    // as a second copy of the titles — renaming a leaf in the
    // frontmatter `leaves` array updates the tabs, and the catchwords
    // follow. Empty at either end of the book, where the corresponding
    // button is also disabled (and so invisible).
    const prevLabelEl = document.getElementById('catchword-prev-label');
    const nextLabelEl = document.getElementById('catchword-next-label');

    function shortLabel(i: number) {
      return (tabs[i]?.textContent ?? '').replace(/^\s*\d+\s*\u00B7\s*/, '').trim();
    }

    function syncCatchwords(index: number) {
      if (prevLabelEl) prevLabelEl.textContent = index > 0 ? shortLabel(index - 1) : '';
      if (nextLabelEl) {
        nextLabelEl.textContent = index < leafEls.length - 1 ? shortLabel(index + 1) : '';
      }
    }

    /* The book is as tall as its tallest leaf. Every leaf is inset: 0
       inside .pages, so each is put into normal flow for a moment and
       the largest height becomes --leaves-h. Write, read, restore:
       one layout for all five. */
    function measureLeavesHeight() {
      const fronts = leafEls.map((leaf) => leaf.querySelector<HTMLElement>('.leaf-face--front'));
      leafEls.forEach((leaf, i) => {
        leaf.style.position = 'static';
        // the front face is absolutely positioned for the flip, and
        // would not contribute to its leaf's height
        if (fronts[i]) fronts[i]!.style.position = 'static';
      });
      const max = Math.max(...leafEls.map((leaf) => leaf.offsetHeight));
      leafEls.forEach((leaf, i) => {
        leaf.style.position = '';
        if (fronts[i]) fronts[i]!.style.position = '';
      });
      leavesWrap!.style.setProperty('--leaves-h', `${max}px`);
    }

    /* BASELINE GRID: the script's half. The stylesheet puts every
       gridded box on a common lattice and every baseline within a
       pixel of its rule (see BASELINE GRID there). Two things are left
       that only a measurement can settle:

       EXACT BASELINES. Where a baseline falls inside its line box
       depends on how the browser rounds the font's metrics at that
       size. So one line of type is set in the hidden probe for each
       distinct type style on the page (about ten), its baseline is
       read, and every element in that style gets the exact offset.

       WHERE EACH BLOCK STARTS. The text block is centred, so its top
       edge is arbitrary. It is moved to the nearest rule. Rules are
       counted from .leaf-body's content edge, which the stylesheet
       guarantees is one, so a leaf with no slack is not moved at all
       and a block is never moved further than it has room for.

       Block positions come from offsetTop, not getBoundingClientRect:
       an [inert] leaf is rotated edge-on under perspective, which
       distorts every rect and leaves offsetTop alone. (The probe is
       not inside a leaf, so its rects are true.)

       Both corrections are relative offsets, so no box changes size
       and nothing here can feed back into measureLeavesHeight(). All
       writes, then all reads, then all writes: one layout. */
    function snapToRules() {
      const probe = document.getElementById('rule-probe');
      if (!probe) return;

      const blocks: { flow: HTMLElement; body: HTMLElement }[] = [];
      const printed: { el: HTMLElement; lineHeight: number; line: HTMLElement }[] = [];
      const lines = new Map<string, HTMLElement>();

      leafEls.forEach((leaf) => {
        if (!leaf.classList.contains('leaf--grid')) return;
        const body = leaf.querySelector<HTMLElement>('.leaf-body');
        const flow =
          leaf.querySelector<HTMLElement>('.leaf-text') ??
          leaf.querySelector<HTMLElement>('.leaf-inner');
        if (!body || !flow) return;
        blocks.push({ flow, body });

        // everything printed on this sheet carries .ruled
        leaf.querySelectorAll<HTMLElement>('.ruled').forEach((el) => {
          const cs = getComputedStyle(el);
          if (cs.display === 'none') return;
          const lineHeight = parseFloat(cs.lineHeight);
          if (!Number.isFinite(lineHeight)) return;
          const key = [cs.fontFamily, cs.fontWeight, cs.fontStyle, cs.fontSize, cs.lineHeight].join('|');
          let line = lines.get(key);
          if (!line) {
            line = document.createElement('div');
            line.style.fontFamily = cs.fontFamily;
            line.style.fontWeight = cs.fontWeight;
            line.style.fontStyle = cs.fontStyle;
            line.style.fontSize = cs.fontSize;
            line.style.lineHeight = cs.lineHeight;
            // a zero-height inline-block with hidden overflow sits with
            // its bottom edge on the line's baseline
            const mark = document.createElement('span');
            mark.style.cssText = 'display:inline-block;width:0;height:0;overflow:hidden';
            line.appendChild(mark);
            lines.set(key, line);
          }
          printed.push({ el, lineHeight, line });
        });
      });
      probe.replaceChildren(...lines.values());

      // ── read ──
      const pitch = probe.getBoundingClientRect().width;
      const baseline = new Map<HTMLElement, number>();
      lines.forEach((line) => {
        const mark = line.firstElementChild as HTMLElement;
        baseline.set(line, mark.getBoundingClientRect().bottom - line.getBoundingClientRect().top);
      });
      const moves = blocks.map(({ flow, body }) => {
        // the block's own top edge from the body's content edge, with
        // this function's previous move taken back out
        const y =
          flow.offsetTop -
          (parseFloat(flow.style.top) || 0) -
          (parseFloat(getComputedStyle(body).paddingTop) || 0);
        const up = ((y % pitch) + pitch) % pitch;
        return up <= pitch / 2 ? -up : pitch - up;
      });

      // ── write ──
      probe.replaceChildren();
      if (!pitch) return;
      printed.forEach(({ el, lineHeight, line }) => {
        el.style.top = `${lineHeight - (baseline.get(line) ?? lineHeight)}px`;
      });
      blocks.forEach(({ flow }, i) => { flow.style.top = `${moves[i]}px`; });
    }

    function layoutLeaves() {
      measureLeavesHeight();
      snapToRules();
    }

    function goTo(index: number, focusTab = false) {
      index = Math.max(0, Math.min(index, leafEls.length - 1));
      if (index === current) return;

      const dir = index > current ? 1 : -1;
      const outgoing = leafEls[current];
      const incoming = leafEls[index];
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Before either leaf moves — the incoming one is still [inert],
      // rotated edge-on and visibility:hidden, so this is the one
      // moment in the turn where its content can change unobserved.
      rotateFeature(index);

      if (reduced || dir === -1) {
        // Backward navigation is an instant appearance, no flip —
        // by request, not animated in reverse.
        outgoing.style.transition = 'none';
        incoming.style.transition = 'none';
        outgoing.style.zIndex = '';
        incoming.style.zIndex = '';
        outgoing.style.transform = '';
        incoming.style.transform = '';
        outgoing.classList.remove('is-turning');
        incoming.classList.remove('is-turning');
        void outgoing.offsetHeight;
        outgoing.setAttribute('inert', '');
        incoming.removeAttribute('inert');
        void incoming.offsetHeight;
        outgoing.style.transition = '';
        incoming.style.transition = '';
      } else {
        // The incoming leaf is already lying flat underneath, so it
        // is put at rest INSTANTLY, before anything moves. Only the
        // outgoing leaf animates: it lifts off, arcs past 90deg where
        // backface-visibility hides it, and uncovers a page that has
        // been sitting there the whole time. (Animating the incoming
        // leaf as well is what makes a turn look like a trap door.)
        const angle = dir === 1 ? -EXIT_DEG : EXIT_DEG;

        outgoing.style.zIndex = '2';
        incoming.style.zIndex = '1';

        incoming.style.transition = 'none';
        incoming.removeAttribute('inert');
        incoming.style.transform = 'rotateY(0deg)';
        incoming.classList.remove('is-turning');
        void incoming.offsetHeight;
        incoming.style.transition = '';

        outgoing.classList.remove('is-turning');
        void outgoing.offsetHeight;
        outgoing.style.transform = `rotateY(${angle}deg)`;
        outgoing.setAttribute('inert', '');
        outgoing.classList.add('is-turning');
      }

      tabs[current].setAttribute('aria-selected', 'false');
      tabs[current].setAttribute('tabindex', '-1');
      tabs[index].setAttribute('aria-selected', 'true');
      tabs[index].setAttribute('tabindex', '0');
      if (focusTab) tabs[index].focus();

      // What should arrive WITH the incoming page rather than ahead of
      // it: timed a little before the midpoint, when the outgoing page
      // is going edge-on. That includes the catchwords, which would
      // otherwise announce the next page before it is there.
      const applyContent = () => {
        if (photoLeaf) photoLeaf.classList.toggle('is-developed', index === 2);
        book?.setAttribute('data-active-leaf', String(index));
        prevBtn!.disabled = index === 0;
        nextBtn!.disabled = index === leafEls.length - 1;
        syncCatchwords(index);
      };

      if (reduced || dir === -1) {
        applyContent();
      } else {
        window.setTimeout(applyContent, TURN_MS * 0.4);
      }

      current = index;
      placeRibbon(index);
    }

    prevBtn.addEventListener('click', () => { goTo(current - 1); });
    nextBtn.addEventListener('click', () => { goTo(current + 1); });

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => { goTo(Number(tab.dataset.index)); });
    });

    tablist?.addEventListener('keydown', (event: KeyboardEvent) => {
      const key = event.key;
      if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(key)) return;
      event.preventDefault();
      if (key === 'ArrowLeft') goTo(current - 1, true);
      else if (key === 'ArrowRight') goTo(current + 1, true);
      else if (key === 'Home') goTo(0, true);
      else if (key === 'End') goTo(leafEls.length - 1, true);
    });

    register.addEventListener('keydown', (event: KeyboardEvent) => {
      if (event.target && tablist?.contains(event.target as Node)) return;
      if (event.key === 'ArrowLeft') { event.preventDefault(); goTo(current - 1); }
      else if (event.key === 'ArrowRight') { event.preventDefault(); goTo(current + 1); }
    });

    let touchStartX = 0;
    let touchStartY = 0;
    pages.addEventListener('touchstart', (event: TouchEvent) => {
      touchStartX = event.touches[0].clientX;
      touchStartY = event.touches[0].clientY;
    }, { passive: true });

    pages.addEventListener('touchend', (event: TouchEvent) => {
      const dx = event.changedTouches[0].clientX - touchStartX;
      const dy = event.changedTouches[0].clientY - touchStartY;
      if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) {
        if (dx < 0) goTo(current + 1); else goTo(current - 1);
      }
    }, { passive: true });

    function initRake() {
      const rakeLeaf = document.querySelector<HTMLElement>('[data-rake]');
      const rake = rakeLeaf?.querySelector<HTMLElement>('.rake');
      if (!rakeLeaf || !rake) return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      rakeLeaf.addEventListener('pointermove', (event: PointerEvent) => {
        const rect = rakeLeaf.getBoundingClientRect();
        rake.style.setProperty('--mx', `${((event.clientX - rect.left) / rect.width) * 100}%`);
        rake.style.setProperty('--my', `${((event.clientY - rect.top) / rect.height) * 100}%`);
      });
    }

    /* THE RIBBON. It marks the last leaf the visitor turned to, kept in
       localStorage so it is still there on their next visit, and
       clicking it opens the book at that leaf. With the cover closed
       the leaf is put in place first, under the cover, and then the
       cover is opened, so the book opens AT the page rather than
       opening and then turning to it. A visitor who has never turned a
       page gets the first leaf, which is the same as opening the book.
       Storage that is blocked or full only means the ribbon forgets. */
    const RIBBON_KEY = 'register:ribbon';
    const ribbonEl = document.getElementById('ribbon');
    function ribbonLeaf(): number {
      try {
        const v = parseInt(localStorage.getItem(RIBBON_KEY) ?? '', 10);
        return Number.isFinite(v) ? Math.max(0, Math.min(v, leafEls.length - 1)) : 0;
      } catch {
        return 0;
      }
    }
    function labelRibbon(index: number) {
      const name = tabs[index]?.textContent?.replace(/\s+/g, ' ').trim();
      const text = index > 0 && name ? `Open the ledger at ${name}` : 'Open the ledger at the ribbon';
      ribbonEl?.setAttribute('aria-label', text);
      ribbonEl?.setAttribute('title', text);
    }
    function placeRibbon(index: number) {
      try { localStorage.setItem(RIBBON_KEY, String(index)); } catch { /* the ribbon forgets */ }
      labelRibbon(index);
    }
    function initRibbon() {
      if (!ribbonEl) return;
      labelRibbon(ribbonLeaf());
      ribbonEl.addEventListener('click', () => {
        const target = ribbonLeaf();
        if (cover && !cover.hasAttribute('inert')) {
          goTo(target);
          cover.click();
        } else {
          goTo(target, true);
        }
      });
    }

    /* THE GLINT. Shortly after the page loads, with the cover still
       closed, a highlight crosses the gold once, left to right: the
       label's fillet takes it from --glint on .cover-label, and the
       signature from a second, bright copy of itself whose gradient is
       slid along by gradientTransform (the gradient lives in
       src/data/cover-signature.ts). It is not tied to the pointer; that
       was tried and was a distraction. Under reduced motion it does not
       run at all, and the gold simply rests. */
    function initGlint() {
      const label = document.getElementById('cover-label');
      const band = document.getElementById('cover-signature-glint');
      if (!cover || !label) return;
      const OFF = -0.6;
      let at = OFF;
      const show = (f: number) => {
        at = f;
        label.style.setProperty('--glint', `${(f * 100).toFixed(1)}%`);
        // the signature's own units: its artwork is 2609 wide
        band?.setAttribute('gradientTransform', `translate(${(f * 2609).toFixed(0)} 0) rotate(14)`);
      };
      const sweep = (to: number, ms: number) => {
        const from = at;
        const t0 = performance.now();
        const step = (now: number) => {
          const t = Math.min(1, (now - t0) / ms);
          show(from + (to - from) * (t * t * (3 - 2 * t)));
          if (t < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      };
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        window.setTimeout(() => {
          if (!cover.isConnected || cover.hasAttribute('inert')) return;
          show(OFF);
          sweep(1.7, 1700);
        }, 1400);
      }
    }

    function initCover() {
      if (!cover) return;
      cover.addEventListener('click', () => {
        if (cover.hasAttribute('inert')) return;
        cover.setAttribute('inert', '');
        // the book's edges settle to the open stack as the cover
        // swings (see .book-stack)
        leavesWrap?.classList.add('is-settled');
        controls?.removeAttribute('inert');
        pages?.removeAttribute('inert');
        preloadPhoto(photoNext);
        preloadPub(pubNext);
        const activeHeading = leafEls[current]?.querySelector<HTMLElement>('h1, h2');
        if (activeHeading) {
          if (!activeHeading.hasAttribute('tabindex')) {
            activeHeading.setAttribute('tabindex', '-1');
          }
          activeHeading.focus();
        } else {
          tabs[0]?.focus();
        }
      });
    }

    syncCatchwords(current);
    layoutLeaves();
    /* Mobile browsers fire `resize` whenever the URL bar collapses or
       expands, which is to say during scroll. Nothing here depends on
       the viewport's HEIGHT (leaves are sized by their content), so a
       height-only change is ignored; a real resize is handled once,
       after the dragging stops. The listener removes itself once this
       DOM has been swapped out by client-side navigation. */
    let relayoutTimer = 0;
    let lastLayoutWidth = window.innerWidth;
    const onResize = () => {
      if (!register.isConnected) {
        window.removeEventListener('resize', onResize);
        return;
      }
      if (window.innerWidth === lastLayoutWidth) return;
      lastLayoutWidth = window.innerWidth;
      window.clearTimeout(relayoutTimer);
      relayoutTimer = window.setTimeout(layoutLeaves, 150);
    };
    window.addEventListener('resize', onResize);
    // the display face arriving late moves every baseline
    if (document.fonts?.ready) {
      document.fonts.ready.then(layoutLeaves);
    }
    initRake();
    initCover();
    initRibbon();
    initGlint();
    initDeskLight(register);
  }

  initRegister();
  document.addEventListener('astro:page-load', initRegister);
</script>