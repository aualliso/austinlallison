          </linearGradient>

          <linearGradient id="haze" x1="0" y1="520" x2="0" y2="1230" gradientUnits="userSpaceOnUse">
            <stop offset="0"    stop-color="#9FB0C4" stop-opacity="0"/>
            <stop offset="0.45" stop-color="#9FB0C4" stop-opacity="0"/>
            <stop offset="0.75" stop-color="#A9B7C8" stop-opacity="0.16"/>
            <stop offset="1"    stop-color="#A9B7C8" stop-opacity="0"/>
          </linearGradient>

          <linearGradient id="rimlight" x1="0" y1="0" x2="0" y2="1">
            <stop id="rimStop0" offset="0"   stop-color="#FCE0A8" stop-opacity="0.9"/>
            <stop id="rimStop1" offset="0.4" stop-color="#F0B267" stop-opacity="0.35"/>
