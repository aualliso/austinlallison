<script>
  let cleanupTraverse: (() => void) | null = null;

  function initTraverse(){
    if (cleanupTraverse) cleanupTraverse();

    const wrap = document.getElementById('traverse');
    const stage = document.getElementById('stage');
    const world = document.getElementById('world');
    const sun = document.getElementById('sun');
    const elev = document.getElementById('elev');
    const segName = document.getElementById('seg-name');
    const cue = document.getElementById('cue');
    const blades = document.getElementById('blades');
    const terrainSvg = document.querySelector('.terrain') as SVGSVGElement | null;
    const groundLine = document.getElementById('ground-line') as unknown as SVGPathElement | null;
    const stations = [...document.querySelectorAll<HTMLElement>('.station')];
    const rimStop0 = document.getElementById('rimStop0') as SVGStopElement | null;

    if(!wrap || !stage || !world || !sun || !elev || !segName || !cue || !terrainSvg || !groundLine) return;

    // Cache Layout Metrics to Prevent Layout Thrashing
    let wrapTop = 0;
    let maxScrollDist = 0;

    function measureLayout() {
      const rect = wrap!.getBoundingClientRect();
      wrapTop = window.scrollY + rect.top;
      maxScrollDist = wrap!.offsetHeight - window.innerHeight;
    }

    const vb = terrainSvg.viewBox.baseVal;
    const WORLD_W = vb.width || 6000;
    const WORLD_H = vb.height || 2000;
    world.style.setProperty('--world-w', `${WORLD_W}px`);
    world.style.setProperty('--world-h', `${WORLD_H}px`);

    // Lookup Table (LUT) — ground height by world x, sampled from the
    // same path used for the fill/clip/caliche cap, so camera and
    // geometry can never desync.
    const SAMPLES = 400;
    const total = groundLine.getTotalLength();
    const lut: { x: number; y: number }[] = [];
    for (let i = 0; i <= SAMPLES; i++) {
      const pt = groundLine.getPointAtLength((i / SAMPLES) * total);
      lut.push({ x: pt.x, y: pt.y });
    }
    const TOP_Y = lut[0].y;
    const BOTTOM_Y = lut[lut.length - 1].y;
    const TOP_FT = 3330, BOTTOM_FT = 2700; // real min/max from the transect

    function heightAt(x: number): number {
      if (x <= lut[0].x) return lut[0].y;
      if (x >= lut[lut.length - 1].x) return lut[lut.length - 1].y;
      let lo = 0, hi = lut.length - 1;
      while (hi - lo > 1) {
        const mid = (lo + hi) >> 1;
        if (lut[mid].x < x) lo = mid; else hi = mid;
      }
      const a = lut[lo], b = lut[hi];
      const t = (x - a.x) / (b.x - a.x || 1);
      return a.y + (b.y - a.y) * t;
    }

    function segmentName(x: number): string {
      if(x <= 2000) return 'The Plateau';
      if(x <= 3200) return 'The Rim';
      if(x <= 4424) return 'The Face';
      return 'The Apron';
    }

    // Non-linear scroll -> camera-x remap, re-derived from the real
    // transect: the rim/face runs from world x 2000 to 4424 (33.3% to
    // 73.7% of the transect, a real 630 ft drop over ~2400 world units).
    // Compressing that 40% of world distance into a small scroll window
    // (0.42-0.58) — versus 33% of scroll for the plateau and 42% for the
    // apron — keeps the "long approach, fast real drop, long descent"
    // pacing even though the real face is proportionally wider than the
    // hand-drawn version was.
    const REMAP: [number, number][] = [
      [0,    0],
      [0.42, 0.333],
      [0.58, 0.737],
      [1,    1],
    ];
    function remapProgress(p: number): number {
      for (let i = 0; i < REMAP.length - 1; i++) {
        const [pa, wa] = REMAP[i];
        const [pb, wb] = REMAP[i + 1];
        if (p >= pa && p <= pb) {
          const t = (p - pa) / (pb - pa || 1);
          return wa + (wb - wa) * t;
        }
      }
      return p;
    }

    function hexLerp(a: string, b: string, t: number): string {
      const pa = parseInt(a.slice(1), 16), pb = parseInt(b.slice(1), 16);
      const ar = (pa >> 16) & 255, ag = (pa >> 8) & 255, ab = pa & 255;
      const br = (pb >> 16) & 255, bg = (pb >> 8) & 255, bb = pb & 255;
      const r = Math.round(ar + (br - ar) * t);
      const g = Math.round(ag + (bg - ag) * t);
      const bch = Math.round(ab + (bb - ab) * t);
      return `#${((1 << 24) + (r << 16) + (g << 8) + bch).toString(16).slice(1)}`;
    }

    // Local time-of-day nudges the starting sky tone — a subtle bias
    // applied only near the top of the scroll, so the descent still
    // always resolves to full night at the basin regardless of when
    // the page loads. Computed once at init, not per frame.
    function timeOfDayBias(): number {
      const now = new Date();
      let h = now.getHours() + now.getMinutes() / 60;
      const points: [number, number][] = [
        [5, 0.05], [8, 0], [13, 0.05], [16, 0.15], [18, 0.35],
        [19.5, 0.55], [21, 0.7], [23, 0.8], [29, 0.05],
      ];
      if (h < 5) h += 24;
      for (let i = 0; i < points.length - 1; i++) {
        const [ha, va] = points[i], [hb, vb] = points[i + 1];
        if (h >= ha && h <= hb) {
          const t = (h - ha) / (hb - ha || 1);
          return va + (vb - va) * t;
        }
      }
      return 0.05;
    }
    const skyBias = timeOfDayBias() * 0.32;

    let targetP = 0;
    let displayP = 0;
    let displayFt = TOP_FT;
    let prevCamX = 0;
    let rafId = 0;
    let readyMarked = false;

    function computeTargetP(){
      const scrollY = window.scrollY;
      let raw = maxScrollDist > 0 ? (scrollY - wrapTop) / maxScrollDist : 0;
      targetP = Math.min(Math.max(raw, 0), 1);
    }

    function render(p: number){
      const vw = window.innerWidth, vh = window.innerHeight;
      const maxCamX = Math.max(WORLD_W - vw, 0);
      const camX = remapProgress(p) * maxCamX;

      const surfaceY = heightAt(camX + vw * 0.5);
      let camY = Math.min(Math.max(surfaceY - vh * 0.62, 0), Math.max(WORLD_H - vh, 0));

      world!.style.setProperty('--cam-x', `${-camX}px`);
      world!.style.setProperty('--cam-y', `${-camY}px`);

      const skyP = Math.min(Math.max((camX - 1700) / (WORLD_W - 1700), 0), 1);
      const blendedSky = skyBias + skyP * (1 - skyBias);
      stage!.style.setProperty('--sky-pos', `${blendedSky * 100}%`);

      const ftTarget = Math.min(Math.max((surfaceY - TOP_Y) / (BOTTOM_Y - TOP_Y), 0), 1);
      const targetFt = Math.round(TOP_FT - (TOP_FT - BOTTOM_FT) * ftTarget);
      // odometer-style ease toward the target elevation rather than snapping
      displayFt += (targetFt - displayFt) * 0.15;
      if (Math.abs(targetFt - displayFt) < 0.5) displayFt = targetFt;
      elev!.textContent = `${Math.round(displayFt).toLocaleString()} FT`;

      segName!.textContent = segmentName(camX + vw * 0.5);
      (cue as HTMLElement).style.opacity = p > 0.03 ? '0' : '.75';

      const plateauP = Math.min(Math.max(camX / 2000, 0), 1);
      sun!.style.setProperty('--sun-y', `${50 + plateauP * 16}%`);
      sun!.style.setProperty('--sun-x', `${66 - plateauP * 12}%`);
      sun!.style.setProperty('--sun-op', String(Math.max(1 - plateauP * 1.1, 0)));

      // haze thickens and the rim-light warms as we move past the rim
      const postRimP = Math.min(Math.max((camX - 4424) / Math.max(WORLD_W - 4424, 1), 0), 1);
      stage!.style.setProperty('--haze-far-op', String(0.6 + postRimP * 0.2));
      stage!.style.setProperty('--haze-near-op', String(0.45 + postRimP * 0.3));
      if (rimStop0) rimStop0.setAttribute('stop-color', hexLerp('#FCE0A8', '#F2A65A', postRimP));

      if(blades) blades.setAttribute('transform', `rotate(${camX * 0.25} 20 28)`);

      const dir = camX >= prevCamX ? 1 : -1;
      prevCamX = camX;

      const centerWorldX = camX + vw * 0.5;
      const anchors = [450, 2210, 2730, 4530, 5330];
      let activeIdx = 0, best = Infinity;
      anchors.forEach((ax, i) => {
        const d = Math.abs(ax - centerWorldX);
        if(d < best){ best = d; activeIdx = i; }
      });
      let near = best < vw * 0.7;

      if (p > 0.96) { activeIdx = anchors.length - 1; near = true; }
      else if (p < 0.02) { activeIdx = 0; near = true; }

      stations.forEach((st, i) => {
        st.style.setProperty('--enter-x', dir >= 0 ? '28px' : '-28px');
        st.classList.toggle('active', i === activeIdx && near);
      });

      if (!readyMarked) {
        readyMarked = true;
        stage!.classList.add('is-ready');
      }
    }

    measureLayout();

    // Continuous rAF loop (rather than a scroll-event listener) polls
    // scrollY every frame and lerps the displayed progress toward it —
    // this smooths bursty/erratic wheel & trackpad deltas instead of
    // jumping straight to each event's value.
    function loop(){
      computeTargetP();
      displayP += (targetP - displayP) * 0.2;
      if (Math.abs(targetP - displayP) < 0.0005) displayP = targetP;
      render(displayP);
      rafId = requestAnimationFrame(loop);
    }

    function onResize(){
      measureLayout();
    }

    window.addEventListener('resize', onResize);
    loop();

    cleanupTraverse = () => {
      window.removeEventListener('resize', onResize);
      cancelAnimationFrame(rafId);
    };
  }

  initTraverse();
  document.addEventListener('astro:page-load', initTraverse);
  document.addEventListener('astro:before-swap', () => {
    if (cleanupTraverse) { cleanupTraverse(); cleanupTraverse = null; }
  });
</script>

