    <div class="register-controls" id="register-controls">
      <!-- prev/next now live at the foot of the page as catchwords; what
           remains here is the overview — the numbered tab row and the
           position counter — not the primary way to turn a page. -->
      <div class="reg-tabs" role="tablist" aria-label="Homepage sections" id="reg-tablist">
        {leaves.map((leaf, i) => (
          <button
            role="tab"
            id={`tab-${i}`}
            aria-controls={`leaf-${i}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            data-index={i}
            class="reg-tab"
          >
            {leaf.label}
          </button>
        ))}
      </div>

      <span class="reg-counter" id="reg-counter" aria-hidden="true">01 / 05</span>
    </div>

