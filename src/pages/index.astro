  <script type="application/json" id="register-features" is:inline set:html={featureJson}></script>

  <script is:inline>
    // The ledger's initial `inert` state is applied HERE rather than
    // being written into the markup above, and this is a bug fix, not a
    // refactor: `inert` can only ever be removed by JavaScript, so
    // baking it into the HTML meant that with JS disabled the whole
    // register rendered — cover, leaves, headings, links and all — with
    // nothing in it focusable or clickable. The <noscript> stylesheet
    // below can restyle that fallback but it cannot strip an attribute,
    // so the fallback was unusable rather than merely plain.
    //
    // Inline and parser-blocking, so it runs before first paint: with JS
    // on, nothing changes — no flash of interactive pages behind the
    // closed cover, and initRegister()/initCover() find exactly the
    // state they did before. With JS off it simply never runs, and what
    // is left is a readable stack of sections whose links work.
    //
    // .cover is not in this list: it takes `inert` only once it has been
    // opened, and the noscript stylesheet hides it outright.
    //
    // NOT THE ONLY PLACE THIS HAPPENS, and the duplication is load
    // bearing: this script runs once per document PARSE, and Astro's
    // client-side navigation swaps the DOM without re-parsing, so on a
    // return visit it never runs. initRegister() applies the same
    // resting state again for that path. Keep both — this one is what
    // makes it happen before first paint, that one is what makes it
    // happen at all on a swapped-in DOM.
    (function () {
      document.getElementById('pages')?.setAttribute('inert', '');
      document.getElementById('register-controls')?.setAttribute('inert', '');
      // every leaf but the first — leaf 0 is the one on top when the
      // ledger opens. Sliced from the list rather than matched with
      // :not(:first-of-type), which would silently repoint if a
      // non-leaf div were ever added above them inside .pages.
      Array.prototype.slice
        .call(document.querySelectorAll('#pages .leaf'), 1)
        .forEach(function (leaf) { leaf.setAttribute('inert', ''); });
    })();
  </script>

  <noscript>
