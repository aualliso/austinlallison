      num(groupTotal(g)) +
      ' issues digitized across ' +
      g.items.length +
      ' titles',
    detail: g.group === g.year ? undefined : g.group,
  })),
  ...MAPS.map((m) => ({
    year: m.year,
    kind: 'Maps',
    text: num(m.count) + ' maps digitized',
  })),
];

const eventsByYear = EVENTS.reduce<Record<string, CvEvent[]>>((acc, e) => {
  (acc[e.year] = acc[e.year] || []).push(e);
  return acc;
}, {});
Object.values(eventsByYear).forEach((list) =>
  list.sort((a, b) => KIND_ORDER.indexOf(a.kind) - KIND_ORDER.indexOf(b.kind))
);
const eventYears = Object.keys(eventsByYear).sort().reverse();

const H2 =
  'text-xl font-bold uppercase text-caprock border-b border-sage pb-1 mb-3';
const H3 = 'text-lg font-bold uppercase tracking-wider text-sage pb-1';
---

<RootLayout
  title="Curriculum vitae | Austin Allison"
  description="Curriculum vitae of Austin Allison, cataloging and metadata librarian at the Southwest Collection/Special Collections Library, Texas Tech University: positions, grants, publications, presentations and digitization projects."
  prose={false}
>
  <div class="cv-page max-w-4xl mx-auto px-4 md:px-0 py-6 font-serif text-iron">

    <!-- MASTHEAD -->
    <div class="pb-3 mb-3 border-b border-haze/60 flex flex-col md:flex-row md:justify-between md:items-end gap-3 md:gap-8 text-center md:text-left">
      <div>
        <h1 class="font-serif text-3xl font-medium tracking-tight text-iron">Austin Allison</h1>
        <p class="text-lg font-serif text-sage mt-1">Cataloging and Metadata Librarian</p>
        <p class="text-base text-iron/80 mt-1">Southwest Collection/Special Collections Library | Texas Tech University</p>
      </div>
      <div class="text-sm font-serif text-iron/70 md:text-right space-y-1">
        <p>Lubbock, Texas</p>
        <p><a href={`mailto:${CONTACT.email}`} class={LINK}>{CONTACT.email}</a></p>
        <p>
          <span class="text-iron/50">ORCID</span>
          {' '}<a href={CONTACT.orcidUrl} rel="me noopener" class={LINK}>{CONTACT.orcid}</a>
        </p>
        <p class="text-iron/50">Updated {UPDATED}</p>
      </div>
    </div>

    <!-- Document controls. They belong here, under the rule and above the
         document, because they govern everything BELOW them - in the contact
         block they read as another piece of contact information. -->
    <div class="print:hidden mb-6 flex flex-wrap items-center justify-between gap-3">
      <span data-view-toggle hidden role="group" aria-label="Arrangement" class="inline-flex border border-haze rounded-sm overflow-hidden text-sm font-serif">
        <button type="button" data-view="category" aria-pressed="true" class="px-3 py-1 transition-colors">By category</button>
        <button type="button" data-view="year" aria-pressed="false" class="px-3 py-1 border-l border-haze transition-colors">By year</button>
      </span>
      <button
        type="button"
        data-print-cv
        hidden
        class="text-sm font-serif text-caprock underline underline-offset-2 hover:bg-sage hover:text-canvas hover:no-underline rounded-sm px-1 transition-colors"
      >Print / save as PDF</button>
    </div>

    <div id="cv-by-category" class="cv-view space-y-8">

      <!-- SECTION: EDUCATION -->
      <section>
        <h2 class={H2} id="education">Education</h2>
        <div class="space-y-2 text-base">
          {EDUCATION.map((e) => (
            <div class="cv-entry flex flex-col md:flex-row md:justify-between md:items-baseline gap-0.5">
              <div>
                <span class="font-semibold">{e.school}</span>
                <p class="text-iron/80 pl-0 md:pl-6 mt-0.5">{e.degree}</p>
              </div>
              <span class="text-sm font-serif text-iron/60 whitespace-nowrap">{e.date}</span>
            </div>
          ))}
        </div>
      </section>

      <!-- SECTION: POSITIONS -->
      <section>
        <h2 class={H2} id="positions">Academic and Professional Positions</h2>
        <div class="text-sm">
          <div class="text-lg text-sage uppercase font-semibold mb-1.5">{EMPLOYER}</div>

          <div class="space-y-3">
            {POSITIONS.map((r) => (
              <div class="cv-entry">
                <div class="flex flex-col md:flex-row md:justify-between md:items-baseline">
                  <h3 class="font-semibold text-base text-iron">{r.title}</h3>
                  <span class="text-sm font-serif text-iron/60 whitespace-nowrap">{r.date}</span>
                </div>
                <p class="text-iron/80 leading-snug pl-0 md:pl-6 mt-0.5">{r.body}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- SECTION: TEACHING (was "Instructional Footprint", nested under map digitization) -->
      <section>
        <h2 class={H2} id="teaching">Teaching and Instruction</h2>
        <ul class="space-y-1 text-sm">
          {TEACHING.map((t) => (
            <li class="cv-entry flex flex-col md:flex-row md:justify-between md:items-baseline gap-0.5">
              <span><span class="font-semibold">{t.course}</span> &mdash; {t.role}</span>
              <span class="text-sm font-serif text-iron/60 whitespace-nowrap">{t.term}</span>
            </li>
          ))}
        </ul>
      </section>

      <!-- SECTION: GRANTS -->
      <section>
        <h2 class={H2} id="grants">Contracts, Grants and Sponsored Research</h2>
        <div class="cv-x-scroll overflow-x-auto -mx-4 px-4 md:mx-0 md:px-0">
          <table class="w-full min-w-[560px] text-left text-sm border-collapse">
            <caption class="sr-only">Contracts, grants and sponsored research, most recent first</caption>
            <thead>
              <tr class="border-b border-iron text-sm font-serif text-iron/60 uppercase">
                <th scope="col" class="py-2 pr-4">Year</th>
                <th scope="col" class="py-2 px-4">Funding Entity &amp; Project Frame</th>
                <th scope="col" class="py-2 px-4 text-right">Amount</th>
                <th scope="col" class="py-2 pl-4 text-right">Status</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-haze/60 text-sm">
              {GRANTS.map((g) => (
                <tr>
                  <td class={`py-2 pr-4 font-serif align-top ${g.awarded ? '' : 'text-iron/40'}`}>{g.year}</td>
                  <td class={`py-2 px-4 ${g.awarded ? '' : 'text-iron/50'}`}>
                    <span class={g.awarded ? 'font-semibold' : ''}>{g.funder}</span>{g.role ? ' | ' + g.role : ''}
                    {g.body && <p class="text-sm text-iron/70 mt-1">{g.body}</p>}
                  </td>
                  <td class={`py-2 px-4 text-right font-serif ${g.awarded ? 'font-semibold text-caprock' : 'text-iron/40'}`}>
                    {g.amount ? '$' + num(g.amount) : <Fragment>&mdash;</Fragment>}
                    {g.amountNote ? ' (' + g.amountNote + ')' : ''}
                  </td>
                  <td class="py-2 pl-4 text-right">
                    {g.awarded ? (
                      <span class="px-2 py-0.5 bg-sage/10 text-sage rounded-sm font-medium">Awarded</span>
                    ) : (
                      <span class="text-sm text-iron/40">Not awarded</span>
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
            <tfoot>
              <tr class="border-t-2 border-iron">
                <td class="py-2 pr-4 text-iron uppercase tracking-wider text-sm font-semibold" colspan="2">Total awarded</td>
                <td class="py-2 px-4 text-right font-serif font-semibold text-caprock">${num(grantsAwarded)}</td>
                <td class="py-2 pl-4"></td>
              </tr>
            </tfoot>
          </table>
        </div>
      </section>

      <!-- SECTION: INTELLECTUAL CONTRIBUTIONS -->
      <section>
        <h2 class={H2} id="publications">Intellectual Contributions</h2>

        <div class="space-y-6 text-base">
          <div>
            <h3 class={`${H3} mb-3`}>Journal Articles</h3>
            <ul class="space-y-3 list-none pl-0">
              {ARTICLES.map((w) => (
                <li class="cv-entry pl-4 border-l-2 border-caprock">
                  Allison, Austin.{' '}
                  {w.href ? (
                    <a href={w.href} class={LINK}>&ldquo;{stripDot(w.title)}.&rdquo;</a>
                  ) : (
                    <span>&ldquo;{stripDot(w.title)}.&rdquo;</span>
                  )}{' '}
                  <cite class="italic">{w.container}</cite>{journalTail(w)}
                </li>
              ))}
            </ul>
          </div>

          {IN_PROGRESS.length > 0 && (
            <div>
              <h3 class={`${H3} mb-3`}>Manuscripts in Review</h3>
              <ul class="space-y-3 list-none pl-0">
                {IN_PROGRESS.map((w) => (
                  <li class="cv-entry pl-4 border-l-2 border-haze">
                    Allison, Austin. &ldquo;{stripDot(w.title)}.&rdquo;{' '}
                    <cite class="italic">{w.container}</cite>.
                    <span class="block text-sm text-iron/60 mt-0.5">{w.note}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}

          <div>
            <h3 class={`${H3} border-b border-sage mb-4`}>Book, Chapter in Scholarly Book</h3>
            <p class="cv-entry pl-4 border-l-2 border-caprock">
              Allison, Austin. <a href={CHAPTER.href} class={LINK}>&ldquo;{CHAPTER.title}.&rdquo;</a> In <cite class="italic">{CHAPTER.book}</cite>, edited by {CHAPTER.editors}, {CHAPTER.pages}. {CHAPTER.imprint}.
            </p>
          </div>

          <div>
            <h3 class={`${H3} border-b border-sage mb-4`}>Magazines / Trade Publications</h3>
            <ul class="space-y-2 list-none pl-0">
              {FEATURES.map((w) => (
                <li class="cv-entry pl-4 border-l-2 border-haze text-iron/90">
                  Allison, Austin.{' '}
                  {w.href ? (
                    <a href={w.href} class={LINK}>&ldquo;{stripDot(w.title)}.&rdquo;</a>
                  ) : (
                    <span>&ldquo;{stripDot(w.title)}.&rdquo;</span>
                  )}{' '}
                  <cite class="italic">{w.container}</cite>{featureTail(w)}
                </li>
              ))}
            </ul>
          </div>

          <div>
            <h3 class={`${H3} border-b border-sage mb-4`}>Edited and Compiled Works</h3>
            <ul class="space-y-2 list-none pl-0">
              <li class="cv-entry pl-4 border-l-2 border-haze text-iron/90">
                Compiler, &ldquo;Publications in West Texas History.&rdquo; <cite class="italic">West Texas Historical Review</cite>, West Texas Historical Association, 2014, 2016&ndash;2026.
              </li>
            </ul>
          </div>
        </div>
      </section>

      <!-- SECTION: PRESENTATIONS -->
      <section>
        <h2 class={H2} id="presentations">Presentations</h2>
        <div class="space-y-5 text-sm">
          {talkYears.map((year) => (
            <div>
              <h3 class="text-sm font-serif text-sage uppercase tracking-widest font-semibold border-b border-haze/40 pb-1 mb-2">{year}</h3>
              <div class="space-y-2.5">
                {talksByYear[year].map((t) => (
                  <div class="cv-entry">
                    <span class={`text-sm font-serif font-semibold block ${t.tag ? 'text-caprock' : 'text-iron/50'}`}>
                      {t.date}{t.tag ? <span class="uppercase tracking-wider"> &bull; {t.tag}</span> : null}
                    </span>
                    <p class="text-iron/90">
                      Allison, Austin.{' '}
                      {t.title ? <span>&ldquo;{stripDot(t.title)}.&rdquo;</span> : <span>{t.lead},</span>}{' '}
                      <cite class="italic">{t.venue}</cite>. {t.place}.
                    </p>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>

        {OUTREACH.length > 0 && (
          <div class="mt-5">
            <h3 class="text-sm font-serif text-sage uppercase tracking-widest font-semibold border-b border-haze/40 pb-1 mb-2">Program Exhibits and Outreach</h3>
            <div class="space-y-2.5 text-sm">
              {OUTREACH.map((t) => (
                <div class="cv-entry">
                  <span class="text-sm font-serif text-iron/50 font-semibold block">{t.date}</span>
                  <p class="text-iron/90">
                    Allison, Austin.{' '}
                    {t.title ? <span>&ldquo;{stripDot(t.title)}.&rdquo;</span> : <span>{t.lead},</span>}{' '}
                    <cite class="italic">{t.venue}</cite>. {t.place}.
                  </p>
                </div>
              ))}
            </div>
          </div>
        )}
      </section>

      <!-- SECTION: PERFORMANCE & EXHIBITS -->
      <section>
        <h2 class={H2} id="exhibits">Artistic and Professional Performances and Exhibits</h2>
        <div class="space-y-2 text-sm">
          {EXHIBITS.map((x) => (
            <div class="cv-entry flex flex-col md:flex-row md:justify-between md:items-baseline gap-1 md:gap-4">
              <div>
                <span class="font-semibold">{x.title}</span> &mdash; <span class="italic text-iron/80">{x.venue}</span>
                <p class="text-sm text-iron/70 mt-1">{x.body}</p>
              </div>
              <span class="text-sm font-serif text-iron/60 whitespace-nowrap">{x.date}</span>
            </div>
          ))}
        </div>
      </section>

      <!-- SECTION: CATALOGING & DIGITIZATION -->
      <section>
        <h2 class={H2} id="projects">Cataloging and Metadata Projects</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-sm">

          <div class="space-y-3">
            <h3 class="text-sm font-serif text-sage uppercase tracking-wider font-semibold border-b border-haze/40 pb-1">Map Digitization Project (DSpace)</h3>
            <table class="w-full text-left font-serif text-sm">
              <caption class="sr-only">Maps digitized by year</caption>
              <thead>
                <tr class="text-iron/50 border-b border-haze/40">
                  <th scope="col" class="py-1 pr-3 font-normal">Year</th>
                  <th scope="col" class="py-1 px-3 font-normal text-right">Maps digitized</th>
                  <th scope="col" class="py-1 pl-3 font-normal text-right">Growth</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-haze/30">
                {MAPS.map((m) => (
                  <tr>
                    <th scope="row" class="py-1 pr-3 font-semibold text-iron text-left">{m.year}</th>
                    <td class="py-1 px-3 text-right text-iron/90">{num(m.count)}</td>
                    <td class="py-1 pl-3 text-right text-iron/70">{m.growth}</td>
                  </tr>
                ))}
              </tbody>
              <tfoot>
                <tr class="border-t border-iron">
                  <th scope="row" class="py-1 pr-3 text-left font-semibold text-iron uppercase tracking-wider text-sm">Total</th>
                  <td class="py-1 px-3 text-right font-semibold text-caprock">{num(mapsTotal)}</td>
                  <td class="py-1 pl-3"></td>
                </tr>
              </tfoot>
            </table>
            {GROWTH_BASIS && <p class="text-sm text-iron/60 italic">{GROWTH_BASIS}</p>}
          </div>

          <div class="space-y-3">
            <h3 class="text-sm font-serif text-sage uppercase tracking-wider font-semibold border-b border-haze/40 pb-1">Cataloging Projects Volume</h3>
            <dl class="space-y-2 text-sm">
              {CATALOGING.map((c) => (
                <div class="cv-entry">
                  <dt class="font-serif font-semibold text-iron">{c.label}</dt>
                  <dd class="font-serif text-iron/70">{c.value}</dd>
                </div>
              ))}
            </dl>
          </div>

        </div>

        <div class="cv-panel mt-6 bg-haze/20 border border-haze/60 p-5 rounded-sm">
          <h3 class="text-sm font-serif text-iron uppercase tracking-widest font-semibold mb-1">Newspaper Digitization Projects</h3>
          <p class="text-sm text-iron/70 mb-3">{num(issuesTotal)} issues across {titleCount} titles since 2022, at the largest archive of digitized West Texas newspapers.</p>
          <div class="cv-x-scroll overflow-x-auto -mx-2 px-2">
            <table class="w-full min-w-[460px] text-left text-sm border-collapse font-serif">
              <caption class="sr-only">Newspaper digitization projects by year, with issue counts</caption>
              <thead>
                <tr class="border-b border-haze text-iron/60 uppercase text-sm">
                  <th scope="col" class="py-1.5 pr-3">Newspaper</th>
                  <th scope="col" class="py-1.5 px-3">Years</th>
                  <th scope="col" class="py-1.5 px-3 text-right">Issues</th>
                  <th scope="col" class="py-1.5 pl-3 text-right">Status</th>
                </tr>
              </thead>
              {NEWSPAPERS.map((g) => (
                <tbody class="divide-y divide-haze/40">
                  <tr>
                    <th scope="colgroup" colspan="4" class="pt-3 pb-1 text-left text-caprock font-semibold tracking-wider uppercase text-sm">{g.group}</th>
                  </tr>
                  {g.items.map((p) => (
                    <tr>
                      <td class="py-1.5 pr-3 text-iron/90">{p.title}</td>
                      <td class="py-1.5 px-3 text-iron/60">{p.span ?? ''}</td>
                      <td class="py-1.5 px-3 text-right text-iron/90">{num(p.issues)}</td>
                      <td class="py-1.5 pl-3 text-right text-iron/60">{p.status ?? ''}</td>
                    </tr>
                  ))}
                  <tr class="border-t border-haze">
                    <td class="py-1.5 pr-3 text-iron/60 italic" colspan="2">Subtotal</td>
                    <td class="py-1.5 px-3 text-right text-iron font-semibold">{num(groupTotal(g))}</td>
                    <td class="py-1.5 pl-3"></td>
                  </tr>
                </tbody>
              ))}
              <tfoot>
                <tr class="border-t-2 border-iron">
                  <td class="py-2 pr-3 text-iron font-semibold uppercase tracking-wider text-sm" colspan="2">Issues, listed projects</td>
                  <td class="py-2 px-3 text-right text-caprock font-semibold">{num(issuesTotal)}</td>
                  <td class="py-2 pl-3"></td>
                </tr>
              </tfoot>
            </table>
          </div>
        </div>
      </section>

      <!-- SECTION: SERVICE -->
      <section>
        <h2 class={H2} id="service">Professional Service</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-sm">
          <div>
            <h3 class="text-sm font-serif text-sage uppercase tracking-wider font-semibold mb-2">Department / School</h3>
            <ul class="space-y-1 text-sm text-iron/90 list-disc list-inside">
              <li>University Research Committee (Chair 2026&ndash;2027, Member 2025&ndash;2027)</li>
              <li>Assistant Archivist Search (Chair 2024)</li>
              <li>Rare Books Search Committee (Member 2023)</li>
              <li>University Libraries' Executive Committee (Member 2022&ndash;2024, Secretary 2022&ndash;2023)</li>
              <li>Public Programming/Outreach (Member 2016&ndash;2024)</li>
              <li>HEB Fuel For Finals Volunteer (2022, 2024)</li>
            </ul>
          </div>
          <div>
            <h3 class="text-sm font-serif text-sage uppercase tracking-wider font-semibold mb-2">University</h3>
            <ul class="space-y-1 text-sm text-iron/90 list-disc list-inside">
              <li>Graduate School 3MT Competition Judge (2025, 2022)</li>
              <li>President's Faculty Book Award Reviewer (2024)</li>
              <li>Student Research Poster Competition Judge (2024, 2023)</li>
              <li>School of Art Search Consultant (2022)</li>
            </ul>
          </div>
          <div>
            <h3 class="text-sm font-serif text-sage uppercase tracking-wider font-semibold mb-2">Professional / Public</h3>
            <ul class="space-y-1 text-sm text-iron/90 list-disc list-inside">
              <li>WTHA Annual Events Coordinator (2017&ndash;Present)</li>
              <li>WTHA Rupert N. Richardson Book Award Committee (2017&ndash;Present)</li>
              <li>Texas Plains Trail Region Board Chair &amp; President (2022&ndash;Present)</li>
              <li>Texas Plains Trail Region Board Member (2021&ndash;Present)</li>
            </ul>
          </div>
        </div>
      </section>

      <!-- SECTION: HONORS & AWARDS -->
      <section>
        <h2 class={H2} id="awards">Fellowships, Scholarships, and Awards</h2>
        <div class="space-y-3">
          {AWARDS.map((a) => (
            <div class="cv-entry text-sm border-l-2 border-caprock pl-4 py-1">
              <span class="text-sm font-serif text-caprock font-semibold block">{a.date}</span>
              <strong class="text-iron">{a.title}</strong>
              <p class="text-sm text-iron/80 mt-1">{a.body}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- SECTION: MEDIA CONTRIBUTIONS -->
      <section>
        <h2 class={H2} id="media">Media Contributions</h2>
        <div class="space-y-3 text-sm">
          {MEDIA.map((m) => (
            <div class="cv-entry">
              <span class="text-sm font-serif text-iron/50 block">{m.date}</span>
              <span class="font-semibold">{m.title}</span>
              <p class="text-sm text-iron/80 mt-0.5">{m.body}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- SECTION: CREDENTIALS -- renders only when the arrays are filled in -->
      {(CREDENTIALS.length > 0 || MEMBERSHIPS.length > 0) && (
        <section>
          <h2 class={H2} id="credentials">Certifications and Memberships</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-sm">
            {CREDENTIALS.length > 0 && (
              <ul class="space-y-1 text-iron/90 list-disc list-inside">
                {CREDENTIALS.map((c) => (
                  <li><span class="font-semibold">{c.label}</span> &mdash; {c.detail}</li>
                ))}
              </ul>
            )}
            {MEMBERSHIPS.length > 0 && (
              <ul class="space-y-1 text-iron/90 list-disc list-inside">
                {MEMBERSHIPS.map((m) => <li>{m}</li>)}
              </ul>
            )}
          </div>
        </section>
      )}

    </div>

    <!-- THE YEAR VIEW. Derived from the same arrays as everything above;
         hidden until the toggle is wired, so a visitor without JS gets the
         category view and nothing broken. Never printed. -->
    <div id="cv-by-year" class="cv-view" hidden>
      <ol class="cv-rail list-none pl-0 m-0">
        {eventYears.map((year) => (
          <li class="cv-rail-year grid grid-cols-[4.25rem_minmax(0,1fr)] md:grid-cols-[5.5rem_minmax(0,1fr)] gap-4" data-year={year}>
            <div class="cv-rail-gutter border-r border-haze">
              <span class="cv-rail-label font-serif text-sm text-iron/50 block sticky top-20 pr-5 text-right whitespace-nowrap transition-colors">{year}</span>
            </div>
            <ul class="cv-rail-events list-none pl-0 py-2 space-y-2.5">
              {eventsByYear[year].map((e) => (
                <li class="cv-entry text-sm">
                  <span class="cv-kind block text-sm font-serif uppercase tracking-widest text-sage">{e.kind}</span>
                  <span class="text-iron/90">
                    {e.href ? <a href={e.href} class={LINK}>{e.text}</a> : e.text}
                  </span>
                  {e.detail && <span class="block text-sm text-iron/60 italic">{e.detail}</span>}
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ol>
    </div>

    <!-- Printed only; invisible on screen -->
    <p class="print-only">Austin Allison &mdash; Curriculum vitae &mdash; updated {UPDATED} &mdash; austinlallison.com/cv</p>

  </div>
</RootLayout>

<script is:inline>
  // The print button is hidden in markup and revealed here, so it never renders
  // as a dead control when JS is off. Wired on astro:page-load rather than at
  // parse time: ClientRouter swaps the DOM without re-parsing, so a parse-time
  // listener would be lost on the second visit to this page.
  (() => {
    const wirePrint = () => {
      const btn = document.querySelector('[data-print-cv]');
      if (!btn || btn.dataset.wired) return;
      btn.dataset.wired = '1';
      btn.hidden = false;
      btn.addEventListener('click', () => window.print());
    };

    // Two views over one document. The toggle is revealed here rather than in
    // markup, so with JS off the category view is simply the page.
    const wireViews = () => {
      const toggle = document.querySelector('[data-view-toggle]');
      const category = document.getElementById('cv-by-category');
      const year = document.getElementById('cv-by-year');
      if (!toggle || !category || !year || toggle.dataset.wired) return;
      toggle.dataset.wired = '1';
      toggle.hidden = false;

      const setView = (v) => {
        category.hidden = v !== 'category';
        year.hidden = v !== 'year';
        toggle.querySelectorAll('button[data-view]').forEach((b) => {
          b.setAttribute('aria-pressed', String(b.dataset.view === v));
        });
      };
      toggle.addEventListener('click', (ev) => {
        const b = ev.target.closest('button[data-view]');
        if (b) setView(b.dataset.view);
      });
      setView('category');

      // Light the year the reader is in. Cheap on purpose: no filters, no
      // blend modes, no scroll listener - one observer and a class.
      const rows = Array.from(year.querySelectorAll('.cv-rail-year'));
      if (!rows.length || !('IntersectionObserver' in window)) return;
      const seen = new Set();
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) seen.add(e.target);
            else seen.delete(e.target);
          });
          const current = rows.find((r) => seen.has(r));
          rows.forEach((r) => r.classList.toggle('is-current', r === current));
        },
        { rootMargin: '-15% 0px -60% 0px' }
      );
      rows.forEach((r) => io.observe(r));
    };

    const wire = () => {
      wirePrint();
      wireViews();
    };
    document.addEventListener('astro:page-load', wire);
    if (document.readyState !== 'loading') wire();
    else document.addEventListener('DOMContentLoaded', wire);
  })();
</script>

<style is:global>
  /* Screen: the printed running foot is hidden. */
  .cv-page .print-only { display: none; }

  /* Every section heading is now an anchor target (/cv#publications and so on).
     Keeps a landed heading clear of the top of the viewport. */
  .cv-page h2[id] { scroll-margin-top: 5rem; }

  /* --- the year rail ------------------------------------------------
     A tick per year on a ruled gutter, the year you are reading lit.
     Colour only - no filter, blend mode, mask or clip-path anywhere on
     this page, deliberately. */
  .cv-page .cv-rail-label::after {
    content: '';
    position: absolute;
    right: -1px;
    top: 50%;
    width: 10px;
    border-top: 1px solid currentColor;
    opacity: 0.3;
    transition: width 120ms linear, opacity 120ms linear;
  }
  .cv-page .cv-rail-year.is-current .cv-rail-label::after {
    width: 14px;
    border-top-width: 2px;
    border-top-color: #9C5B3F;
    opacity: 1;
  }
  .cv-page .cv-rail-year.is-current .cv-rail-label {
    color: #9C5B3F;
  }
  .cv-page [data-view-toggle] button[aria-pressed='true'] {
    background: #9C5B3F;
    color: #FFFFFF;
  }
  @media (prefers-reduced-motion: reduce) {
    .cv-page .cv-rail-label::after { transition: none; }
  }

  @media print {
    @page { margin: 0.75in; }

    /* The CV prints as the document, never as the chronology - and prints
       it even if the reader was looking at the year view. */
    .cv-page #cv-by-year,
    .cv-page [data-view-toggle] { display: none !important; }
    .cv-page #cv-by-category[hidden] { display: block !important; }

    /* Site chrome. This block must be is:global -- a scoped style block only
       matches elements declared in THIS component, so the old
       `header, footer { display: none }` rule never matched the site header
       or the caprock footer and the printed CV carried both. */
    header, footer, nav { display: none !important; }

    body {
      background: #fff !important;
      color: #111 !important;
    }

    .cv-page {
      max-width: none !important;
      margin: 0 !important;
      padding: 0 !important;
      font-size: 10.5pt;
      line-height: 1.35;
    }

    .cv-page .print-only {
      display: block;
      margin-top: 1.5em;
      padding-top: 0.5em;
      border-top: 1px solid #bbb;
      font-size: 8.5pt;
      color: #555;
    }

    /* Links print as text with their destination spelled out. */
    .cv-page a {
      color: #111 !important;
      background: none !important;
      text-decoration: none !important;
    }
    .cv-page a::after {
      font-size: 0.85em;
      color: #555;
      word-break: break-all;
    }
    .cv-page a[href^='/']::after { content: ' (austinlallison.com' attr(href) ')'; }
    .cv-page a[href^='http']::after { content: ' (' attr(href) ')'; }
    .cv-page a[href^='mailto:']::after { content: none; }

    /* Anything that scrolls on screen must open out on paper, or the printed
       CV silently loses whatever was below the fold of the scroll box. */
    .cv-page .cv-x-scroll {
      overflow: visible !important;
      margin: 0 !important;
      padding: 0 !important;
    }
    .cv-page table { min-width: 0 !important; width: 100% !important; }

    /* Ink economy: drop tinted panels, keep the rules. */
    .cv-page .cv-panel {
      background: none !important;
      border: 0 !important;
      border-top: 1px solid #ccc !important;
      padding: 0.5em 0 0 0 !important;
      border-radius: 0 !important;
    }

    /* Pagination. */
    .cv-page h1,
    .cv-page h2,
    .cv-page h3 { break-after: avoid-page; }
    .cv-page .cv-entry,
    .cv-page li,
    .cv-page tr,
    .cv-page dl > div { break-inside: avoid; }
    .cv-page thead { display: table-header-group; }
  }
</style>