/* ------------------------------------------------------------------ *
 * PUBLICATIONS
 * Sorted by `sort` (descending). Punctuation is produced by the two
 * formatters below, so every entry is Chicago-consistent by construction.
 * When src/lib/citation.ts grows an index over the publication data
 * modules, these arrays get replaced by one import and nothing else.
 * ------------------------------------------------------------------ */
type Work = {
  sort: string;
  title: string;
  href?: string;
  container: string;
  volume?: string;
  issue?: string;
  date?: string;
  pages?: string;
  status?: 'published' | 'review' | 'declined';
  note?: string;
};

// Author. "Title." Container vol, no. N (Date): pp.
function journalTail(w: Work) {
  let s = '';
  if (w.volume) s += ' ' + w.volume;
  if (w.issue) s += ', no. ' + w.issue;
  if (w.date) s += ' (' + w.date + ')';
  s += w.pages ? ': ' + w.pages + '.' : '.';
  return s;
}

// Author. "Title." Container, Issue, Season Year, pp.
function featureTail(w: Work) {
  let s = '';
  if (w.volume) {
    s += ' ' + w.volume;
    if (w.issue) s += ', no. ' + w.issue;
    if (w.date) s += ' (' + w.date + ')';
    if (w.pages) s += ': ' + w.pages;
  } else {
    if (w.date) s += ', ' + w.date;
    if (w.pages) s += ', ' + w.pages;
  }
  return s + '.';
}

// Titles are stored without terminal punctuation; the period goes inside the
// closing quotation mark, once, for every entry.
const stripDot = (t: string) => t.replace(/[.]+$/, '');
const byDateDesc = (a: Work, b: Work) => b.sort.localeCompare(a.sort);

