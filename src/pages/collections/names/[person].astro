---
// src/pages/collections/names/[person].astro
//
// ONE AUTHORITY RECORD, read two ways. As a cataloguer's record: the
// established heading, its status, see-from forms, sources, and links to the
// same person on other sites. As a person: their face in every photograph
// where it is placed, in date order, with their age at the time; a line of
// their life with the photographs set along it; a view that puts faces side
// by side so an identification can be weighed; and their family.
//
// WHAT FEEDS IT
//   FACES        every depiction with a `region` (index.ts). Each is a small
//                crop file cut by scripts/faces.mjs (`npm run faces`).
//   relationsOf  relations from BOTH records, so a relation entered once
//                appears on both pages.
//
// HOW IT LOOKS (2026-09 redesign)
//   THE CABINET CARD. The page opens on the person, not the record: their
//   portrait in a mount with a bevelled window and the name set where a
//   studio set its imprint, on a full-width band of desk paper. The window
//   is cut from the PLATE (the photograph behind an overflow window), not
//   from the small face crop, so it stays sharp at card size.
//   FACES ALONG THE LIFE. Each placed, dated face stands above the life
//   chart at its date, on a stem down to the years.
//   THE SHELF. The photographs stand on a hairline at their true
//   proportions, as on the collections guide; the list beneath keeps the
//   grounds for each identification.
//   Kin faces and the card window share transition:name, so a relative's
//   face grows into their portrait on the way to their page.
//
// 2026-09-28 PASS. Everything is shown once.
//   FACES: every marked face, large, in date order, each with its date,
//   age, confidence and grounds. COMPARE is there only when asked for: a
//   quiet "Compare faces" button opens a panel above the gallery, already
//   holding the pair most worth weighing, and puts a small toggle on each
//   face. "Done" or Escape puts it all away. The comparison is kept in the
//   address (#compare=id,id) so it can be sent to someone.
//   THE SHELF and THE LIST are one list: each photograph's row carries its
//   print at true proportions beside its title, date, age and grounds.
//   THE RECORD replaces the typed catalogue card: a plain two-column list
//   (heading, status, also found as, sources, permalink), with THIS PERSON
//   ELSEWHERE at its foot (2026-10): a link to their Find a Grave memorial
//   and their FamilySearch tree entry, made from `identifiers` on the record
//   in people.ts. It took the place of the MARC 21 view, which is gone.
//   The same links also stand in the header, under the tally, as two words
//   each - the foot of a long page is no place to find the way out.
//   VOCABULARY follows the collections guide: an item's optional `kind`
//   (default photograph) decides whether this person is "in 3 photographs"
//   or "in 2 photographs and 1 journal".
//
// ALBUMS (2026-10). In a photograph album the thing a person appears in is
//   one PRINT on one page, not the album. So each such appearance takes the
//   print's title (or the album's, with the page), the print's own date where
//   it has one, and the print's address - the album opens on that page with
//   the print outlined, never on the front cover. Its picture in the list is
//   the page image framed by the print's box, as on the album's own page.
//   Each print counts as a photograph in the tally. And where a face is so
//   small in its scan that the plate cannot fill the cabinet card's window,
//   the window takes the face crop instead, which is cut from the full scan.
//
// 2026-10 FAMILY FIRST. Who a person belongs to is part of who they are,
//   and kin are the links from one person's page to the next, so:
//   THE KINSHIP LINE stands in the header under the dates - whose child,
//   whom they married, whose parent, each name a link ("Child of", "Parent
//   of": the records do not say son or daughter, and it is not guessed).
//   FAMILY is the second thing on the page, above the life chart.
//   THE TREE is the direct line only - parents, the person and spouse,
//   children - as mounted portraits like the guide's roll, joined by drawn
//   lines (see the stylesheet for how, without script). Brothers and
//   sisters stand in a smaller row under it. "How each relationship is
//   known" is folded behind a toggle, so the section can sit this high.
//   HALF-SIBLINGS: a sibling relation marked `half: true` in people.ts (on
//   either record) reads "Half-sibling" in that row and in the list of
//   grounds. It is stated, never worked out from the parents.
//
// STANDING CONSTRAINTS
//   No filter, blend, mask, clip-path or 3D. Motion is opacity and
//   transform, and none of it runs under reduced motion. Listeners register
//   against an AbortController that aborts on astro:before-swap.

import RootLayout from '../../../layouts/RootLayout.astro';
import {
  PEOPLE,
  personById,
  appearancesOf,
  personHref,
  relationsOf,
  spanOf,
  spanOfDate,
  pageHref,
  FACES,
  FACE_W,
  FACE_H,
  faceHref,
  collectionBySlug,
} from '../../../data/collections/index';
import type { Face, YearSpan } from '../../../data/collections/index';
import { heading, headingDates, naturalName } from '../../../data/collections/types';
import { plate } from '../../../data/collections/images';

export function getStaticPaths() {
  return PEOPLE.map((p) => ({ params: { person: p.id }, props: { id: p.id } }));
}

const { id } = Astro.props as { id: string };
const p = personById.get(id)!;

const EN = '\u2013';
const site = Astro.site ?? Astro.url;
const abs = (path: string) => new URL(path, site).href;
const permalink = abs(personHref(p.id));
const name = naturalName(p);
const status = p.status ?? 'provisional';

const RANK: Record<string, number> = { certain: 0, probable: 1, possible: 2, unidentified: 3 };
const firm = (c: string) => c === 'certain' || c === 'probable';
const label = (c: string) => (c === 'certain' ? '' : c.charAt(0).toUpperCase() + c.slice(1));
const cap1 = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const plural = (n: number, one: string) => `${n} ${n === 1 ? one : `${one}s`}`;

/* ------------------------------------------------------------------ *
 * Life dates, as numbers
 * ------------------------------------------------------------------ */
const year = (v?: string) => (v && /^\d{3,4}$/.test(v.trim()) ? Number(v) : undefined);
const born = year(p.birth);
const died = year(p.death);
const dateKind = p.dateType ?? 'exact';
const dates = headingDates(p).replace(/(\d)-/g, `$1${EN}`);

const lifeLine = (() => {
  if (born === undefined && died === undefined) return '';
  if (dateKind === 'active') return `Active ${born ?? ''}${EN}${died ?? ''}`;
  const about = dateKind === 'approximate' ? 'about ' : '';
  const parts = [];
  if (born !== undefined) parts.push(`Born ${about}${born}`);
  if (died !== undefined) parts.push(`died ${about}${died}`);
  return cap1(parts.join(', '));
})();

// AGE AT THE TIME. A photograph dated 1885-1900 of someone born in 1834 was
// taken at about 51 to 66. Only for exact or approximate birth years, never
// for an 'active' span, and never for an open-ended date.
const ageAt = (s: YearSpan | null): string => {
  if (!s || born === undefined || dateKind === 'active' || s.openStart || s.openEnd) return '';
  if (died !== undefined && s.from > died) return '';
  const lo = Math.max(0, s.from - born);
  const hi = Math.max(0, (died !== undefined ? Math.min(s.to, died) : s.to) - born);
  if (hi < 1) return 'in infancy';
  return lo === hi ? `aged about ${lo}` : `aged about ${lo}${EN}${hi}`;
};

/* ------------------------------------------------------------------ *
 * Photographs, in date order (undated last)
 * ------------------------------------------------------------------ */
// WHAT AN APPEARANCE IS CALLED, WHEN IT WAS, AND WHERE IT LEADS. For a loose
// photograph: the item's title, date and page. For a print in an album: the
// print's own title where it has one, otherwise the album's with the page;
// the print's own date where it has one, otherwise the album's; and the
// print's address. Everything below reads title / when / href and never
// has to know which kind it is looking at.
const pageWords = (s: string) => s.replace(/^Page /, 'page ');
const appearances = appearancesOf(p.id)
  .map((a, n) => {
    const pr = a.print;
    // The album page a pictured person is on: their print's, or - boxed on a
    // page but inside no print - the page of the box itself.
    const leaf = a.named ? undefined : a.item.faces.find((f) => f.page && f.key === (pr?.page ?? a.region?.face));
    const onLeaf = leaf ? `${a.item.title}, ${pageWords(leaf.label)}` : a.item.title;
    return {
      ...a,
      n,
      key: `a${n}`,
      leaf,
      span: pr?.date ? spanOfDate(pr.date) : spanOf(a.item),
      title: pr?.title ?? onLeaf,
      when: pr?.date?.display ?? a.item.date.display,
      href: pr?.href ?? (leaf?.page ? pageHref(a.item, leaf.page) : a.item.href),
    };
  })
  .sort((a, b) => {
    const x = a.span ? a.span.from : Infinity;
    const y = b.span ? b.span.from : Infinity;
    return x - y || a.n - b.n;
  });

const thumbs = new Map(
  await Promise.all(
    appearances.map(
      async (a) => [a.item.slug, await plate(a.item.collection, a.item.recto.file, a.item.recto)] as const
    )
  )
);
const collectionsHere = new Set(appearances.map((a) => a.item.collection));

// A PRINT IN AN ALBUM is shown as the page image framed by the print's box:
// the image is scaled until the box fills a window of the print's own shape,
// and shifted so the box's corner sits at the window's corner. One plate per
// page, however many of its prints this person is in.
const leafKey = (a: (typeof appearances)[number]) => `${a.item.slug}#${a.leaf?.key}`;
const leafPlates = new Map(
  await Promise.all(
    [...new Map(appearances.filter((a) => a.print && a.leaf).map((a) => [leafKey(a), a] as const)).values()].map(
      async (a) => [leafKey(a), await plate(a.item.collection, a.leaf!.surrogate.file, a.leaf!.surrogate)] as const
    )
  )
);
const PRINT_BOX_W = 144; // px: the row's picture column (9rem)
const PRINT_BOX_H = 112; // px: the tallest a picture stands there (7rem)
// The arithmetic stays on lines of its own, outside the template strings:
// see the note on cropOf() in [collection]/[item].astro.
const printCrop = (a: (typeof appearances)[number]) => {
  const src = a.print && a.leaf ? leafPlates.get(leafKey(a)) : undefined;
  if (!src || !a.print) return null;
  const r = a.print.region;
  const ratio = (r.w * src.width) / (r.h * src.height);
  const scale = 10000 / r.w;
  const left = (-r.x / r.w) * 100;
  const top = (-r.y / r.h) * 100;
  const shown = Math.min(PRINT_BOX_W, PRINT_BOX_H * ratio);
  const drawn = Math.min(2400, Math.round((shown * 100) / r.w));
  return {
    src: src.view,
    srcset: src.viewSrcset,
    sizes: `${drawn}px`,
    ar: ratio.toFixed(4),
    style: `width:${scale.toFixed(2)}%;left:${left.toFixed(2)}%;top:${top.toFixed(2)}%`,
  };
};

// WHAT KIND OF THING each appearance is in. Read loosely, as on the
// collections guide: `kind` is optional and a photograph by default. One
// object counts once, however many times the person is in it - and in an
// album the object is the PRINT: a child pictured in thirty prints of one
// album is in thirty photographs, not one.
const kindOf = (i: object) =>
  ((i as { kind?: string }).kind ?? 'photograph').trim().toLowerCase() || 'photograph';
const unitOf = (a: (typeof appearances)[number]) => (a.print ? `${a.item.slug}#${a.print.id}` : a.item.slug);
const kindCounts = new Map<string, number>();
for (const unit of new Set(appearances.map(unitOf))) {
  const item = appearances.find((a) => unitOf(a) === unit)!.item;
  kindCounts.set(kindOf(item), (kindCounts.get(kindOf(item)) ?? 0) + 1);
}
const allPhotos = [...kindCounts.keys()].every((k) => k === 'photograph');
const NOUN = allPhotos ? 'photograph' : 'item';
const objectCount = [...kindCounts.values()].reduce((a, b) => a + b, 0);
const inWhat = [...kindCounts.entries()]
  .sort((a, b) => b[1] - a[1])
  .map(([k, n]) => plural(n, k));
const inWhatLine =
  inWhat.length <= 1 ? inWhat.join('') : `${inWhat.slice(0, -1).join(', ')} and ${inWhat[inWhat.length - 1]}`;
// Each collection this person appears in, with a link to its inventory
// already filtered to them (the collection page reads ?q=).
const inventories = [...collectionsHere].map((slug) => ({
  title: collectionBySlug.get(slug)?.title ?? slug,
  n: new Set(appearances.filter((a) => a.item.collection === slug).map((a) => a.item.slug)).size,
  href: `/collections/${slug}?q=${encodeURIComponent(name)}`,
}));

/* ------------------------------------------------------------------ *
 * Faces
 * ------------------------------------------------------------------ */
// The link from a face opens the item's viewer framed on it - the shareable
// view URL the item page reads on arrival. The frame is the region grown so
// the face sits in its surroundings rather than filling the screen.
const viewLink = (f: Face) => {
  const g = 2.4;
  const w = Math.min(100, f.region.w * g);
  const h = Math.min(100, f.region.h * g);
  const x = Math.min(100 - w, Math.max(0, f.region.x + f.region.w / 2 - w / 2));
  const y = Math.min(100 - h, Math.max(0, f.region.y + f.region.h / 2 - h / 2));
  const r = (v: number) => Math.round(v * 10) / 10;
  return `${f.item.href}#face=${encodeURIComponent(f.view)}&xywh=percent:${r(x)},${r(y)},${r(w)},${r(h)}`;
};

const faces = await Promise.all(
  appearances
    .filter((a) => a.face)
    .map(async (a) => {
      const f = a.face!;
      const src = await plate(f.collection, f.file);
      return {
        f,
        key: a.key,
        span: a.span,
        age: ageAt(a.span),
        title: a.title,
        when: a.when,
        href: a.href,
        // Size of the region in source pixels: the bigger the face was
        // photographed, the better it serves as the portrait.
        area: (f.region.w / 100) * src.width * ((f.region.h / 100) * src.height),
        link: viewLink(f),
        src,
      };
    })
);

const portrait = faces
  .filter((x) => firm(x.f.confidence))
  .sort((a, b) => RANK[a.f.confidence] - RANK[b.f.confidence] || b.area - a.area)[0];

/* ------------------------------------------------------------------ *
 * The cabinet card: the portrait, cut from the photograph itself
 * ------------------------------------------------------------------ */
// The window is cut from the PLATE behind an overflow window, not from the
// face crop, which is sized for thumbnails and would go soft at card size.
// The region is grown to take in the shoulders and set in the upper part of
// the window, where a portrait sitter's head sits. The photograph's own
// srcset serves it, with `sizes` scaled by how much wider the whole
// photograph is than the window.
//
// WHEN THE PLATE IS TOO COARSE. The largest plate file is 2600px across the
// WHOLE scan. A face on an album page, or far back in a large group, can be
// so small a part of it that the window would be filled from fewer pixels
// than it is wide, and go soft. The face crop is cut from the full scan at
// twice FACE_W, so below WIN_MIN_PX the window shows that instead: tighter
// on the head than the usual cut, and sharp. Set WIN_MIN_PX to 0 to always
// cut from the plate.
const WIN_AR = 0.78; // window width / height, about a cabinet card's
const WIN_MAX = 240; // px: the window at its widest (15rem)
const WIN_MIN_PX = WIN_MAX; // px of plate across the window, below which the face crop is used
const hero = (() => {
  if (!portrait) return null;
  const { f, src } = portrait;
  const W = src.width;
  const H = src.height;
  const r = f.region;
  let ch = Math.max((r.h / 100) * H * 2.3, ((r.w / 100) * W * 2.1) / WIN_AR);
  let cw = ch * WIN_AR;
  if (cw > W) {
    cw = W;
    ch = cw / WIN_AR;
  }
  if (ch > H) {
    ch = H;
    cw = ch * WIN_AR;
  }
  const cx = ((r.x + r.w / 2) / 100) * W;
  const cy = ((r.y + r.h / 2) / 100) * H + ch * 0.14;
  const x0 = Math.min(W - cw, Math.max(0, cx - cw / 2));
  const y0 = Math.min(H - ch, Math.max(0, cy - ch / 2));
  const pc = (v: number) => `${(v * 100).toFixed(3)}%`;
  const scale = W / cw;
  const detailW = Math.min(2600, W);
  const bestFile = detailW > 1900 ? detailW : Math.min(1900, W);
  const across = (cw / W) * bestFile;
  if (across < WIN_MIN_PX) {
    return {
      src: faceHref(f.id, 2),
      srcset: undefined as string | undefined,
      sizes: undefined as string | undefined,
      style: 'width:100%;height:100%;left:0;top:0;object-fit:cover',
      w: FACE_W * 2,
      h: FACE_H * 2,
    };
  }
  return {
    src: src.view,
    srcset: `${src.viewSrcset}${src.detail && detailW > 1900 ? `, ${src.detail} ${detailW}w` : ''}`,
    sizes: `${Math.ceil(WIN_MAX * scale)}px`,
    // left is a share of the window's width, top of its height.
    style: `width:${pc(scale)};left:${pc(-x0 / cw)};top:${pc(-y0 / ch)}`,
    w: W,
    h: H,
  };
})();

// The dates, set large. The sentence form (lifeLine) goes to screen readers.
const T = '\u2009';
const bigDates = (() => {
  if (born === undefined && died === undefined) return '';
  if (dateKind === 'active') return `active ${born ?? ''}${T}${EN}${T}${died ?? ''}`;
  const c = dateKind === 'approximate' ? `c.${T}` : '';
  return `${born !== undefined ? c + born : ''}${T}${EN}${T}${died !== undefined ? c + died : ''}`;
})();

// WHAT TO COMPARE FIRST, when a reader asks to compare. If any placement is
// only possible, the strongest placement beside the first possible one:
// that is the question the page can help answer. Otherwise the earliest and
// latest faces, which show a life.
const COMPARE_MAX = 4;
const doubtful = faces.filter((x) => !firm(x.f.confidence));
const datedFaces = faces.filter((x) => x.span);
let suggest: string[] = [];
let suggestNote = '';
if (faces.length >= 2) {
  if (doubtful.length && portrait) {
    suggest = [portrait.f.id, doubtful[0].f.id];
    suggestNote = 'A possible placement beside the strongest one.';
  } else if (datedFaces.length >= 2) {
    suggest = [datedFaces[0].f.id, datedFaces[datedFaces.length - 1].f.id];
    suggestNote = 'The earliest and the latest.';
  } else {
    suggest = [faces[0].f.id, faces[1].f.id];
    suggestNote = 'Two faces side by side.';
  }
}

/* ------------------------------------------------------------------ *
 * A life in photographs
 * ------------------------------------------------------------------ */
const OPEN_REACH = 15;
const PAD = 5;
const dated = appearances.filter((a) => a.span);
const life = (() => {
  if (!dated.length) return null;
  const draw = dated.map((a) => {
    const s = a.span!;
    return { a, from: s.openStart ? s.to - OPEN_REACH : s.from, to: s.openEnd ? s.from + OPEN_REACH : s.to };
  });
  const lows = [...draw.map((d) => d.from), ...(born !== undefined ? [born] : [])];
  const highs = [...draw.map((d) => d.to), ...(died !== undefined ? [died] : [])];
  const lo = Math.floor((Math.min(...lows) - PAD) / 10) * 10;
  let hi = Math.ceil((Math.max(...highs) + PAD + 1) / 10) * 10;
  if (hi - lo < 40) hi = lo + 40;
  const P = (y: number) => ((y - lo) / (hi - lo)) * 100;

  const laneEnds: number[] = [];
  const bars = draw
    .sort((x, y) => x.from - y.from || x.to - y.to)
    .map((d) => {
      let lane = laneEnds.findIndex((end) => end + 2 <= d.from);
      if (lane === -1) {
        lane = laneEnds.length;
        laneEnds.push(0);
      }
      laneEnds[lane] = d.to + 1;
      return { ...d, lane, x: P(d.from), w: P(d.to + 1) - P(d.from) };
    });

  // The band of the life itself, behind the photographs. Exact dates get hard
  // edges; approximate ones fade across five years either side; a missing
  // death fades out toward the end of the axis rather than inventing one.
  let band: { x: number; w: number; fl: number; fr: number; kind: string } | null = null;
  if (born !== undefined || died !== undefined) {
    const soft = dateKind !== 'exact';
    const start = born !== undefined ? born - (soft ? PAD : 0) : lo;
    const end = died !== undefined ? died + 1 + (soft ? PAD : 0) : hi;
    const span = Math.max(1, end - start);
    const fadeYears = (known: boolean) => (known ? (soft ? PAD * 2 : 0) : Math.min(30, span * 0.4));
    band = {
      x: P(start),
      w: P(end) - P(start),
      fl: (fadeYears(born !== undefined) / span) * 100,
      fr: (fadeYears(died !== undefined) / span) * 100,
      kind: dateKind,
    };
  }

  const step = hi - lo > 120 ? 20 : 10;
  const ticks = [];
  for (let y = lo; y <= hi; y += 10) {
    const labelled = (y - lo) % step === 0;
    const age = born !== undefined && dateKind !== 'active' ? y - born : null;
    const ageShown = age !== null && age >= 0 && (died === undefined || y <= died + PAD) && age <= 110;
    ticks.push({ y, x: P(y), labelled, minor: labelled && ((y - lo) / step) % 2 === 1, age: ageShown ? age : null });
  }
  // FACES ALONG THE LIFE. Each placed, dated face stands above the chart at
  // the middle of its date span. Faces go into at most three rows, spaced
  // so none overlaps at the narrowest width the rail shows (40rem, where a
  // 3rem face is about 9% of the chart). One that will not fit stays off the
  // rail; it is still among the faces below.
  const RAIL_GAP = 9;
  const RAIL_ROWS = 3;
  const rowEnds: number[] = [];
  const rail = faces
    .filter((x) => x.span)
    .map((x) => {
      const s = x.span!;
      const from = s.openStart ? s.to - OPEN_REACH : s.from;
      const to = s.openEnd ? s.from + OPEN_REACH : s.to;
      return { x, at: Math.min(96.5, Math.max(3.5, P((from + to + 1) / 2))) };
    })
    .sort((a, b) => a.at - b.at)
    .flatMap((r) => {
      let row = rowEnds.findIndex((end) => r.at - end >= RAIL_GAP);
      if (row === -1 && rowEnds.length < RAIL_ROWS) {
        row = rowEnds.length;
        rowEnds.push(r.at);
      }
      if (row === -1) return [];
      rowEnds[row] = r.at;
      return [{ ...r, row }];
    });

  // THE CHART KEEPS ITS HEIGHT. Up to sixteen lanes each is 14px; past
  // that the lanes close up, down to 5px, so a person in sixty photographs
  // gets a denser chart rather than a taller one.
  const lanes = Math.max(1, laneEnds.length);
  const pitch = lanes <= 16 ? 14 : Math.max(5, Math.round(224 / lanes));
  return {
    lo,
    hi,
    bars,
    lanes,
    pitch,
    rail,
    railRows: rowEnds.length,
    band,
    ticks,
    birthX: born !== undefined ? P(born) : null,
    deathX: died !== undefined ? P(died + 1) : null,
  };
})();

/* ------------------------------------------------------------------ *
 * Family
 * ------------------------------------------------------------------ */
const bestFaceOf = (pid: string) =>
  FACES.filter((f) => f.person === pid && firm(f.confidence)).sort(
    (a, b) => RANK[a.confidence] - RANK[b.confidence] || b.region.w * b.region.h - a.region.w * a.region.h
  )[0];

const kin = relationsOf(p.id)
  .filter((k) => personById.has(k.person))
  .map((k) => {
    const other = personById.get(k.person)!;
    return { ...k, other, face: bestFaceOf(k.person), dates: headingDates(other).replace(/(\d)-/g, `$1${EN}`) };
  })
  .sort((a, b) => (year(a.other.birth) ?? 9999) - (year(b.other.birth) ?? 9999) || naturalName(a.other).localeCompare(naturalName(b.other)));
const kinOf = (type: string) => kin.filter((k) => k.type === type);
const parents = kinOf('parent');
const spouses = kinOf('spouse');
const siblings = kinOf('sibling');
const children = kinOf('child');
const KIN_LABEL: Record<string, string> = { parent: 'Parent', child: 'Child', spouse: 'Spouse', sibling: 'Sibling' };
// A sibling relation marked `half` on either record (types.ts) is named as
// one; an unmarked one is a "sibling", which claims neither half nor full.
const kinLabel = (k: (typeof kin)[number]) => (k.type === 'sibling' && k.half ? 'Half-sibling' : KIN_LABEL[k.type]);
// THE KINSHIP LINE under the name: whose child, whom they married, whose
// parent - each name a link. The words are neutral ("Child of", "Parent
// of") because the records do not say son or daughter and it is not guessed
// from a name. A relationship that is not certain says so in brackets. Six
// names at most in a group; the rest are counted and linked to the tree.
const KIN_SAY_MAX = 6;
const kinSay = [
  { lead: 'Child of', list: parents },
  { lead: 'Married', list: spouses },
  { lead: 'Parent of', list: children },
]
  .filter((g) => g.list.length > 0)
  .map((g) => ({ lead: g.lead, shown: g.list.slice(0, KIN_SAY_MAX), more: Math.max(0, g.list.length - KIN_SAY_MAX) }));

/* ------------------------------------------------------------------ *
 * This person elsewhere: links out, made from `identifiers` in people.ts
 * ------------------------------------------------------------------ */
// A record carries the bare identifier - a Find a Grave memorial number, a
// FamilySearch person ID - and the address is made here, so the site keeps
// its links if either service changes its URLs: one line below changes, not
// every record. A whole address (https://...) is also accepted and used as
// it stands. `shape` is what a well-formed identifier looks like: one that
// does not match still gets its link, with a warning in the build log naming
// the person, since a mistyped identifier makes a dead link and nothing else
// would say so.
const ids = p.identifiers ?? {};
const isUrl = (v: string) => /^https?:\/\//.test(v);
type Elsewhere = { label: string; what: string; value: string; href: string };
const elsewhereOf = (
  raw: string | undefined,
  label: string,
  what: string,
  shape: RegExp,
  make: (x: string) => string,
  tidy: (x: string) => string = (x) => x
): Elsewhere | null => {
  if (!raw || !String(raw).trim()) return null;
  const typed = String(raw).trim();
  const v = isUrl(typed) ? typed : tidy(typed);
  if (isUrl(v)) {
    // Show the identifier at the end of the address, if there is one.
    const tail = v.replace(/[/?#]+$/, '').split('/').filter((x) => shape.test(x)).pop();
    return { label, what: tail ? what : '', value: tail ?? '', href: v };
  }
  if (!shape.test(v)) {
    console.warn(`[people] ${p.id}: ${label} identifier '${v}' does not look like ${what ? `a ${what} identifier` : 'one'}; check the link.`);
  }
  return { label, what, value: v, href: make(v) };
};
const identifiers = [
  elsewhereOf(ids.findagrave, 'Find a Grave', 'memorial', /^\d+$/, (x) => `https://www.findagrave.com/memorial/${x}`),
  elsewhereOf(
    ids.familysearch,
    'FamilySearch',
    'Family Tree',
    /^[A-Z0-9]{4}-[A-Z0-9]{3,4}$/,
    (x) => `https://www.familysearch.org/tree/person/details/${x}`,
    // FamilySearch IDs are capitals; one typed in lower case is the same ID.
    (x) => x.toUpperCase()
  ),
  elsewhereOf(ids.lccn, 'Library of Congress', 'name authority', /^[a-z]{1,3}\s?\d{8,10}$/, (x) => `https://id.loc.gov/authorities/names/${x.replace(/\s+/g, '')}.html`),
  elsewhereOf(ids.viaf, 'VIAF', '', /^\d+$/, (x) => `https://viaf.org/viaf/${x}`),
].filter((x): x is Elsewhere => !!x);

/* ------------------------------------------------------------------ *
 * Neighbours, share image, structured data
 * ------------------------------------------------------------------ */
const ordered = [...PEOPLE].sort((a, b) => heading(a).localeCompare(heading(b)));
const at = ordered.findIndex((x) => x.id === p.id);
const prev = at > 0 ? ordered[at - 1] : null;
const next = at < ordered.length - 1 ? ordered[at + 1] : null;

const json = (v: unknown) => JSON.stringify(v).replace(/</g, '\\u003c');
const personRef = (pid: string) => {
  const o = personById.get(pid)!;
  return { '@type': 'Person', name: naturalName(o), url: abs(personHref(pid)) };
};
const structured = json({
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': permalink,
  url: permalink,
  name,
  alternateName: [heading(p), ...(p.variants ?? [])],
  ...(dateKind === 'exact' && born !== undefined ? { birthDate: String(born) } : {}),
  ...(dateKind === 'exact' && died !== undefined ? { deathDate: String(died) } : {}),
  ...(p.scopeNote ? { description: p.scopeNote } : {}),
  ...(portrait ? { image: abs(faceHref(portrait.f.id, 2)) } : {}),
  ...(identifiers.length ? { sameAs: identifiers.map((i) => i.href) } : {}),
  ...Object.fromEntries(
    (['parent', 'children', 'spouse', 'sibling'] as const)
      .map((prop) => {
        const type = prop === 'children' ? 'child' : prop;
        const list = kin.filter((k) => k.type === type && firm(k.confidence)).map((k) => personRef(k.person));
        return [prop, list] as const;
      })
      .filter(([, list]) => list.length)
  ),
  // Once per object: thirty prints in one album are one album to a machine.
  subjectOf: [...new Map(appearances.filter((a) => firm(a.confidence)).map((a) => [a.item.slug, a.item] as const)).values()].map(
    (i) => ({ '@type': 'Photograph', name: i.title, url: abs(i.href) })
  ),
});

const pageData = json({
  prev: prev ? personHref(prev.id) : null,
  next: next ? personHref(next.id) : null,
  max: COMPARE_MAX,
  suggest,
  suggestNote,
});

// What the status means, in a sentence, where it needs one.
const STATUS_GLOSS: Record<string, string> = {
  provisional: 'The heading rests on the collection\u2019s own objects.',
};

const H2 = 'sec-h mb-3';
const MONO = 'font-mono text-[0.7rem] uppercase tracking-[0.12em] text-sage';
const QUAL = 'font-mono text-[0.7rem] uppercase tracking-[0.12em] text-caprock';
const LINK = 'text-caprock hover:underline';
---

<RootLayout
  title={`${heading(p)} | Names | Austin Allison`}
  description={`Authority record for ${heading(p)}: established heading, variant forms, sources, and the photographs in which the person appears.`}
  image={portrait ? faceHref(portrait.f.id, 2) : undefined}
  prose={false}
>
  <script type="application/ld+json" is:inline set:html={structured} />
  <script type="application/json" id="person-data" is:inline set:html={pageData} />
  <noscript>
    <style is:inline>
      [data-js-only] { display: none !important; }
    </style>
  </noscript>

  <div class="person-page max-w-4xl mx-auto py-6 text-iron font-serif" data-person-page>
    <div class="topline">
      <nav class={MONO} aria-label="Breadcrumb">
        <a href="/collections" class={LINK}>Collections</a>
        <span class="opacity-50 mx-1.5" aria-hidden="true">/</span>
        <a href="/collections/names" class={LINK}>Names</a>
      </nav>
      {ordered.length > 1 && (
        <nav class={`pager ${MONO}`} aria-label="In the name authority file">
          {prev ? (
            <a href={personHref(prev.id)} class={LINK} rel="prev" data-astro-prefetch="viewport" title={heading(prev)}>
              <span aria-hidden="true">&larr;</span> Previous
            </a>
          ) : (
            <span class="opacity-40"><span aria-hidden="true">&larr;</span> Previous</span>
          )}
          <span class="opacity-80">{at + 1} of {ordered.length}</span>
          {next ? (
            <a href={personHref(next.id)} class={LINK} rel="next" data-astro-prefetch="viewport" title={heading(next)}>
              Next <span aria-hidden="true">&rarr;</span>
            </a>
          ) : (
            <span class="opacity-40">Next <span aria-hidden="true">&rarr;</span></span>
          )}
        </nav>
      )}
    </div>

    <!-- THE CABINET CARD -->
    <header class:list={['hero', 'bleed', { 'has-card': !!hero }]}>
      {hero && portrait && (
        <a
          href={portrait.link}
          class="cabinet"
          title={`${portrait.title}${portrait.span ? `, ${portrait.when}` : ''}`}
        >
          <span class="cab-window" transition:name={`person-${p.id}`}>
            <img
              src={hero.src}
              srcset={hero.srcset}
              sizes={hero.sizes}
              width={hero.w}
              height={hero.h}
              style={hero.style}
              alt={`${name}, from ${portrait.title}`}
              fetchpriority="high"
              decoding="async"
            />
          </span>
          <span class="cab-imprint" aria-hidden="true">
            <span class="cab-name">{name}</span>
            {bigDates && <span class="cab-dates">{bigDates.replace(/c\.\u2009/g, '').replace(/active /, '')}</span>}
          </span>
        </a>
      )}
      <div class="hero-text">
        <h1 class="name">{name}</h1>
        {bigDates ? (
          <p class="dates">
            <span aria-hidden="true">{bigDates}</span>
            <span class="sr-only">{lifeLine}</span>
          </p>
        ) : (
          <p class="dates dates--none">Life dates not established</p>
        )}
        {p.qualifier && <p class="qualifier">{p.qualifier}</p>}
        {p.variants && p.variants.length > 0 && (
          <p class="aka">
            Also found as{' '}
            {p.variants.map((v, n) => (
              <>
                {n > 0 && (n === p.variants!.length - 1 ? ' and ' : ', ')}
                <i>{v}</i>
              </>
            ))}
          </p>
        )}
        {kinSay.length > 0 && (
          <p class="kinline">
            {kinSay.map((g, gi) => (
              <>
                {gi > 0 && ' '}
                <span class="kin-say">
                  {g.lead}{' '}
                  {g.shown.map((k, n) => (
                    <>
                      {n > 0 && (n === g.shown.length - 1 && g.more === 0 ? ' and ' : ', ')}
                      <a href={personHref(k.person)} class={LINK}>{naturalName(k.other)}</a>
                      {label(k.confidence) && ` (${label(k.confidence).toLowerCase()})`}
                    </>
                  ))}
                  {g.more > 0 && (
                    <>
                      {' '}and <a href="#family-h" class={LINK}>{g.more} more</a>
                    </>
                  )}
                  .
                </span>
              </>
            ))}
          </p>
        )}
        <p class="tally">
          {objectCount === 0 ? `No ${NOUN} known yet` : `In ${inWhatLine}`}
          {collectionsHere.size > 1 && <> &middot; {collectionsHere.size} collections</>}
          {faces.length > 0 && <> &middot; face marked in {faces.length}</>}
        </p>
        {/* THE WAY OUT, where it is seen: the same links as "This person
            elsewhere" at the foot of the record, as two words each. The
            identifier itself stays down there, with the record. */}
        {identifiers.length > 0 && (
          <ul class="hero-links" aria-label="This person on other sites">
            {identifiers.map((i) => (
              <li>
                <a href={i.href} class="hero-link" rel="external noopener">
                  {i.label}
                  <span class="hero-link-arrow" aria-hidden="true">&nearr;</span>
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>
    </header>

    {p.scopeNote && <p class="lede">{p.scopeNote}</p>}

    <!-- FAMILY -->
    {/* Second on the page: who this person belongs to is part of who they
        are, and these are the links between one person's page and the next.
        THE TREE is the direct line only - parents above, the person (and
        whom they married) in the middle, children below - so it can be
        drawn with true connecting lines whatever the size of the family.
        Brothers and sisters stand in a row of their own under it. */}
    {kin.length > 0 && (
      <section class="section family" aria-labelledby="family-h">
        <h2 id="family-h" class={H2}>Family</h2>
        <div
          class:list={['tree', { 'has-parents': parents.length > 0, 'has-children': children.length > 0 }]}
          style={`--face-ar:${(FACE_H / FACE_W).toFixed(4)}`}
        >
          {parents.length > 0 && (
            <div class="gen gen--parents" role="list" aria-label="Parents">
              {parents.map((k) => (
                <a href={personHref(k.person)} class="kin" role="listitem">
                  <span class="kin-frame">
                  {k.face ? (
                    <img src={faceHref(k.face.id)} srcset={`${faceHref(k.face.id)} 1x, ${faceHref(k.face.id, 2)} 2x`} width={FACE_W} height={FACE_H} alt="" loading="lazy" decoding="async" class="kin-face" transition:name={`person-${k.person}`} />
                  ) : (
                    <span class="kin-face kin-face--none" aria-hidden="true">{k.other.surname.charAt(0)}</span>
                  )}
                  </span>
                  <span class="kin-role">Parent{label(k.confidence) && <> &middot; {label(k.confidence)}</>}</span>
                  <span class="kin-name">{naturalName(k.other)}</span>
                  {k.dates && <span class="kin-dates">{k.dates}</span>}
                </a>
              ))}
            </div>
          )}
          <div class="gen gen--self">
            <div class="kin kin--self" aria-current="page">
              <span class="kin-frame">
                {portrait ? (
                  <img src={faceHref(portrait.f.id)} srcset={`${faceHref(portrait.f.id)} 1x, ${faceHref(portrait.f.id, 2)} 2x`} width={FACE_W} height={FACE_H} alt="" loading="lazy" decoding="async" class="kin-face" />
                ) : (
                  <span class="kin-face kin-face--none" aria-hidden="true">{p.surname.charAt(0)}</span>
                )}
              </span>
              <span class="kin-name">{name}</span>
              {dates && <span class="kin-dates">{dates}</span>}
            </div>
            {spouses.length > 0 && (
              <div class="side side--spouses" role="list" aria-label="Spouses">
                {spouses.map((k) => (
                  <a href={personHref(k.person)} class="kin" role="listitem">
                  <span class="kin-frame">
                  {k.face ? (
                    <img src={faceHref(k.face.id)} srcset={`${faceHref(k.face.id)} 1x, ${faceHref(k.face.id, 2)} 2x`} width={FACE_W} height={FACE_H} alt="" loading="lazy" decoding="async" class="kin-face" transition:name={`person-${k.person}`} />
                  ) : (
                    <span class="kin-face kin-face--none" aria-hidden="true">{k.other.surname.charAt(0)}</span>
                  )}
                  </span>
                  <span class="kin-role">Spouse{label(k.confidence) && <> &middot; {label(k.confidence)}</>}</span>
                  <span class="kin-name">{naturalName(k.other)}</span>
                  {k.dates && <span class="kin-dates">{k.dates}</span>}
                </a>
                ))}
              </div>
            )}
          </div>
          {children.length > 0 && (
            <div class="gen gen--children" role="list" aria-label="Children">
              {children.map((k) => (
                <a href={personHref(k.person)} class="kin" role="listitem">
                  <span class="kin-frame">
                  {k.face ? (
                    <img src={faceHref(k.face.id)} srcset={`${faceHref(k.face.id)} 1x, ${faceHref(k.face.id, 2)} 2x`} width={FACE_W} height={FACE_H} alt="" loading="lazy" decoding="async" class="kin-face" transition:name={`person-${k.person}`} />
                  ) : (
                    <span class="kin-face kin-face--none" aria-hidden="true">{k.other.surname.charAt(0)}</span>
                  )}
                  </span>
                  <span class="kin-role">Child{label(k.confidence) && <> &middot; {label(k.confidence)}</>}</span>
                  <span class="kin-name">{naturalName(k.other)}</span>
                  {k.dates && <span class="kin-dates">{k.dates}</span>}
                </a>
              ))}
            </div>
          )}
        </div>

        {siblings.length > 0 && (
          <div class="sibs">
            <h3 class={MONO}>{siblings.length === 1 ? 'Brother or sister' : 'Brothers and sisters'}</h3>
            <div class="sib-row" role="list" aria-label="Siblings">
              {siblings.map((k) => (
                <a href={personHref(k.person)} class="kin kin--small" role="listitem">
                  <span class="kin-frame">
                  {k.face ? (
                    <img src={faceHref(k.face.id)} srcset={`${faceHref(k.face.id)} 1x, ${faceHref(k.face.id, 2)} 2x`} width={FACE_W} height={FACE_H} alt="" loading="lazy" decoding="async" class="kin-face" transition:name={`person-${k.person}`} />
                  ) : (
                    <span class="kin-face kin-face--none" aria-hidden="true">{k.other.surname.charAt(0)}</span>
                  )}
                  </span>
                  <span class="kin-role">{kinLabel(k)}{label(k.confidence) && <> &middot; {label(k.confidence)}</>}</span>
                  <span class="kin-name">{naturalName(k.other)}</span>
                  {k.dates && <span class="kin-dates">{k.dates}</span>}
                </a>
              ))}
            </div>
          </div>
        )}

        <details class="grounds-fold">
          <summary>
            <span class={MONO}>How each relationship is known</span>
          </summary>
          <ul class="grounds">
            {kin.map((k) => (
              <li>
                <span class="grounds-who">{kinLabel(k)}: <a href={personHref(k.person)} class={LINK}>{naturalName(k.other)}</a></span>
                <span class="grounds-why">
                  {label(k.confidence) && <span class={QUAL}>{label(k.confidence)}</span>}
                  {label(k.confidence) && <> &mdash; </>}
                  {k.basis}
                  {!k.stated && <span class="opacity-60"> (recorded under {naturalName(k.other)})</span>}
                </span>
              </li>
            ))}
          </ul>
        </details>
      </section>
    )}

    <div class="bleed bleed--life">
    <!-- A LIFE IN PHOTOGRAPHS -->
    {life && (
      <section class="section" aria-labelledby="life-h">
        <h2 id="life-h" class={H2}>A life in photographs</h2>
        <div class="life" style={`--lanes:${life.lanes};--pitch:${life.pitch}px;--rows:${life.railRows};--face-ar:${(FACE_H / FACE_W).toFixed(4)}`} data-life>
          <div class="life-rules" aria-hidden="true">
            {life.ticks.map((t) => (
              <span class:list={['tick', { minor: t.minor }]} style={`--x:${t.x}%`}>
                {t.labelled && <b class="tick-year">{t.y}</b>}
                {t.labelled && t.age !== null && <i class="tick-age">{t.age}</i>}
              </span>
            ))}
          </div>
          {life.band && (
            <div
              class:list={['band', `band--${life.band.kind}`]}
              style={`--x:${life.band.x}%;--w:${life.band.w}%;--fl:${life.band.fl}%;--fr:${life.band.fr}%`}
              aria-hidden="true"
            ></div>
          )}
          {life.birthX !== null && dateKind === 'exact' && (
            <span class="mark mark--birth" style={`--x:${life.birthX}%`} aria-hidden="true"><b>b. {born}</b></span>
          )}
          {life.deathX !== null && dateKind === 'exact' && (
            <span class="mark mark--death" style={`--x:${life.deathX}%`} aria-hidden="true"><b>d. {died}</b></span>
          )}
          {life.rail.length > 0 && (
            <div class="rail" aria-hidden="true">
              {life.rail.map((r) => (
                <a
                  href={r.x.link}
                  tabindex="-1"
                  class:list={['rail-face', { soft: !firm(r.x.f.confidence) }]}
                  style={`--x:${r.at.toFixed(3)}%;--row:${r.row}`}
                  data-key={r.x.key}
                  title={`${r.x.title}, ${r.x.when}${r.x.age ? `, ${r.x.age}` : ''}`}
                >
                  <img
                    src={faceHref(r.x.f.id)}
                    srcset={`${faceHref(r.x.f.id)} 1x, ${faceHref(r.x.f.id, 2)} 2x`}
                    width={FACE_W}
                    height={FACE_H}
                    alt=""
                    loading="lazy"
                    decoding="async"
                  />
                </a>
              ))}
            </div>
          )}
          {/* A visual index: the same photographs are listed, with links, below.
              Pointing at a line lights its face and its row. */}
          <div class="life-bars" aria-hidden="true">
            {life.bars.map((b) => (
              <a
                href={b.a.href}
                tabindex="-1"
                class:list={['bar', firm(b.a.confidence) ? 'firm' : 'soft', { 'open-start': b.a.span!.openStart, 'open-end': b.a.span!.openEnd }]}
                style={`--x:${b.x}%;--w:${b.w}%;--y:${b.lane}`}
                data-key={b.a.key}
                title={`${b.a.title}, ${b.a.when}`}
              ></a>
            ))}
          </div>
        </div>
        <div class="legend">
          <span><i class="swatch"></i>Identified</span>
          <span><i class="swatch soft"></i>Possibly this person</span>
          {life.band && <span><i class="swatch-band"></i>{dateKind === 'active' ? 'Years active' : 'Lifetime'}</span>}
          {life.ticks.some((t) => t.age !== null) && <span>Years, with age beneath</span>}
          {appearances.length > dated.length && <span>{appearances.length - dated.length} undated, not drawn</span>}
        </div>
      </section>
    )}

    <!-- FACES -->
    {/* Every marked face, large and in date order, each with the grounds
        for placing it. In date order they already stand side by side, so
        this is also where an identification is weighed. */}
    {faces.length > 0 && (
      <section class="section faces-sec" aria-labelledby="faces-h" data-faces>
        <div class="faces-head">
          <h2 id="faces-h" class={H2}>{faces.length === 1 ? 'The face' : 'Faces, by date'}</h2>
          {faces.length > 1 && (
            <button
              type="button"
              class="cmp-toggle"
              aria-expanded="false"
              aria-controls="cmp-panel"
              data-cmp-toggle
              data-js-only
            >Compare faces</button>
          )}
        </div>
        <p class="note">
          Cut from each {NOUN} where this person is marked, and never retouched.
          {faces.length > 1 && ' In date order, so they can be weighed against one another.'}
        </p>

        {/* THE COMPARISON. Not there until asked for. Every face has its
            figure here, hidden; the script shows the chosen ones. They sit
            in date order because the figures are in date order. */}
        {faces.length > 1 && (
          <div id="cmp-panel" class="cmp-panel" role="region" aria-label="Faces side by side" hidden data-cmp-panel>
            <div class="cmp-head">
              <p class="cmp-note" tabindex="-1" data-cmp-note>{suggestNote}</p>
              <button type="button" class="cmp-done" data-cmp-done>Done</button>
            </div>
            <div class="cmp-grid">
              {faces.map((x) => (
                <figure class:list={['cmp', { 'cmp--doubt': !firm(x.f.confidence) }]} data-cmp={x.f.id} data-key={x.key} hidden>
                  <a href={x.link} class="cmp-face" aria-label={`${name} in ${x.title}. Open it at this face.`}>
                    <img src={faceHref(x.f.id, 2)} width={FACE_W} height={FACE_H} alt="" loading="lazy" decoding="async" />
                  </a>
                  <figcaption>
                    <span class="fc-when">
                      <span class="fc-date">{x.when}</span>
                      {x.age && <span class="fc-age">{cap1(x.age)}</span>}
                    </span>
                    <span class="cmp-title"><a href={x.href} class={LINK}>{x.title}</a></span>
                    <span class="cmp-basis">
                      {label(x.f.confidence) && <span class={QUAL}>{label(x.f.confidence)}</span>}
                      {label(x.f.confidence) && x.f.basis && <> &mdash; </>}
                      {x.f.basis}
                    </span>
                    <button type="button" class="cmp-remove" data-unpick={x.f.id}>Remove</button>
                  </figcaption>
                </figure>
              ))}
            </div>
            <p class="sr-only" aria-live="polite" data-cmp-status></p>
          </div>
        )}

        <ol class="faces">
          {faces.map((x) => (
            <li class:list={['fc', { 'fc--doubt': !firm(x.f.confidence) }]} data-key={x.key}>
              <a href={x.link} class="fc-face" aria-label={`${name} in ${x.title}. Open it at this face.`}>
                <img
                  src={faceHref(x.f.id, 2)}
                  width={FACE_W}
                  height={FACE_H}
                  alt=""
                  loading="lazy"
                  decoding="async"
                />
                {!firm(x.f.confidence) && <span class="fc-flag">{label(x.f.confidence)}</span>}
              </a>
              {faces.length > 1 && (
                <button
                  type="button"
                  class="fc-pick"
                  aria-pressed="false"
                  aria-label={`Compare the face in ${x.title}`}
                  data-pick={x.f.id}
                  hidden
                >
                  <svg viewBox="0 0 16 16" aria-hidden="true">
                    <path class="fc-pick-plus" d="M8 3.5v9M3.5 8h9" />
                    <path class="fc-pick-tick" d="M3.5 8.4l3 3 6-6.6" />
                  </svg>
                </button>
              )}
              <p class="fc-when">
                <span class="fc-date">{x.when}</span>
                {x.age && <span class="fc-age">{cap1(x.age)}</span>}
              </p>
              <p class="fc-title"><a href={x.href} class={LINK}>{x.title}</a></p>
              {x.f.basis && <p class="fc-basis">{x.f.basis}</p>}
            </li>
          ))}
        </ol>
      </section>
    )}

    </div>

    <!-- PHOTOGRAPHS -->
    {/* One row per object: the print at its true proportions, then what it
        is, when, where it is kept, the person's age, and the grounds. */}
    <section class="section" aria-labelledby="photos-h">
      <h2 id="photos-h" class={H2}>{allPhotos ? 'Photographs' : 'Where this person appears'}</h2>
      {inventories.length === 1 && appearances.length > 0 && (
        <p class="note">
          See {appearances.length === 1 ? 'it' : 'them'} in the inventory of the{' '}
          <a href={inventories[0].href} class={LINK}>{inventories[0].title}</a>, filtered to {name}.
        </p>
      )}
      {inventories.length > 1 && (
        <p class="note">
          See them in each collection's inventory, filtered to {name}:{' '}
          {inventories.map((c, n) => (
            <>
              {n > 0 && <span aria-hidden="true"> &middot; </span>}
              <a href={c.href} class={LINK}>{c.title}</a> ({c.n})
            </>
          ))}
        </p>
      )}
      {appearances.length === 0 ? (
        <p class="m-0 italic opacity-60">No {NOUN} of this person is known yet.</p>
      ) : (
        <ul class="photos">
          {appearances.map((a) => {
            const t = thumbs.get(a.item.slug)!;
            const coll = collectionBySlug.get(a.item.collection)?.title ?? '';
            const age = ageAt(a.span);
            const crop = printCrop(a);
            return (
              <li class="photo" data-key={a.key}>
                <a href={a.href} class="photo-print" tabindex="-1" aria-hidden="true">
                  {crop ? (
                    <span class="photo-crop" style={`--ar:${crop.ar}`}>
                      <img src={crop.src} srcset={crop.srcset} sizes={crop.sizes} style={crop.style} alt="" loading="lazy" decoding="async" />
                    </span>
                  ) : (
                    <img src={t.index} srcset={t.indexSrcset} width={t.width} height={t.height} alt="" loading="lazy" decoding="async" />
                  )}
                </a>
                <div class="photo-text">
                  <a href={a.href} class={`${LINK} photo-title`}>{a.title}</a>
                  <div class={`${MONO} mt-1`}>
                    {a.when}
                    {coll && <> &middot; {coll}</>}
                    {a.position && <> &middot; {a.position}</>}
                  </div>
                  {/* A print with a title of its own still says which album
                      it is in, and where. */}
                  {a.print?.title && a.leaf && (
                    <div class="photo-basis">
                      In <a href={a.item.href} class={LINK}>{a.item.title}</a>, {pageWords(a.leaf.label)}
                    </div>
                  )}
                  {age && <div class="photo-age">{cap1(age)}</div>}
                  <div class="photo-basis">
                    {label(a.confidence) && <span class={QUAL}>{label(a.confidence)}</span>}
                    {label(a.confidence) && <> &mdash; </>}
                    {a.basis}
                  </div>
                  {a.named && a.note && <div class="photo-basis">{a.note}</div>}
                  {a.face && (
                    <a href={viewLink(a.face)} class="photo-find">Find the face <span aria-hidden="true">&rarr;</span></a>
                  )}
                  {a.named && a.page && (
                    <a href={a.page.href} class="photo-find">
                      Named on {a.page.label.replace(/^Page /, 'page ')} <span aria-hidden="true">&rarr;</span>
                    </a>
                  )}
                </div>
              </li>
            );
          })}
        </ul>
      )}
    </section>

    <!-- THE RECORD -->
    {/* The authority record, set plainly: what a cataloguer would check,
        in the order they would check it. Links to the same person on other
        sites stand at its foot. */}
    <section class="section record" aria-labelledby="record-h">
      <h2 id="record-h" class={H2}>The record</h2>
      <dl class="rec">
        <div class="rec-row">
          <dt>Heading</dt>
          <dd class="rec-heading">{heading(p)}</dd>
        </div>
        <div class="rec-row">
          <dt>Status</dt>
          <dd>
            <span class:list={['rec-status', `rec-status--${status}`]}>{cap1(status)}</span>
            {STATUS_GLOSS[status] && <span class="rec-gloss">{STATUS_GLOSS[status]}</span>}
          </dd>
        </div>
        {p.variants && p.variants.length > 0 && (
          <div class="rec-row">
            <dt>Also found as</dt>
            <dd>
              <ul class="rec-list">
                {p.variants.map((v) => <li>{v}</li>)}
              </ul>
            </dd>
          </div>
        )}
        <div class="rec-row">
          <dt>Sources</dt>
          <dd>
            {(p.sources ?? []).length > 0 ? (
              <ol class="rec-list rec-sources">
                {p.sources!.map((src) => <li>{src}</li>)}
              </ol>
            ) : (
              <span class="rec-empty">None recorded for this heading yet.</span>
            )}
          </dd>
        </div>
        <div class="rec-row">
          <dt>Permalink</dt>
          <dd class="rec-link">
            <a href={permalink} class={LINK}>{permalink.replace(/^https?:\/\//, '')}</a>
            <button type="button" class="rec-copy" data-copy-link={permalink} data-js-only>Copy</button>
          </dd>
        </div>
      </dl>

      {/* THIS PERSON ELSEWHERE. Where the same person is recorded on other
          sites: each link is made from an identifier on the record. Shown
          only when the record carries one. */}
      {identifiers.length > 0 && (
        <div class="elsewhere">
          <h3 class={MONO}>This person elsewhere</h3>
          <ul class="else-list">
            {identifiers.map((i) => (
              <li>
                <a href={i.href} class="else-link" rel="external noopener">
                  <span class="else-site">{i.label}</span>
                  {(i.what || i.value) && (
                    <span class="else-id">
                      {i.what} {i.value}
                    </span>
                  )}
                  <span class="else-arrow" aria-hidden="true">&nearr;</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}
      <p class="sr-only" aria-live="polite" data-copy-status></p>
    </section>
  </div>
</RootLayout>

<style>
  .person-page {
    --c-caprock: var(--color-caprock, #9c5b3f);
    --c-sage: var(--color-sage, #7a8471);
    --c-haze: var(--color-haze, #dad3c4);
    --c-dust: var(--color-dust, #ede7da);
    --c-iron: var(--color-iron, #3b3833);
    --c-canvas: var(--color-canvas, #f7f4ec);
    /* Mounts and mats are pale paper. They were --c-dust, which the theme
       defines as a dark sandy tan, so every face sat on a muddy ground. */
    --c-mount: var(--color-caliche, #e8e1d1);
    --c-desk: var(--color-desk, #f5f3ed);
  }

  /* FULL-WIDTH BANDS without a 100vw element: the band is painted by
     border-image outset, which is ink overflow - it reaches the window
     edges and never adds a horizontal scrollbar. */
  .bleed {
    border-image: conic-gradient(var(--c-desk) 0 0) fill 0 / / 0 100vmax;
  }
  .bleed--life {
    margin-top: 2.75rem;
    padding: 2.25rem 0 2.5rem;
  }
  .bleed--life > .section:first-child {
    margin-top: 0;
  }
  /* No life chart and no faces: no empty band. */
  .bleed--life:not(:has(> *)) {
    display: none;
  }

  .topline {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    margin-bottom: 1.25rem;
  }
  .pager {
    display: flex;
    gap: 0.9rem;
    white-space: nowrap;
  }

  /* The cabinet card ---------------------------------------------- */
  .hero {
    display: grid;
    gap: 1.75rem 2.75rem;
    align-items: center;
    padding: 2.25rem 0 2.5rem;
    margin-bottom: 2rem;
  }
  @media (min-width: 36rem) {
    .hero.has-card {
      grid-template-columns: auto minmax(0, 1fr);
    }
  }
  /* A mount of pale board with a hairline rule inset like a gilt edge, the
     window bevelled into it, and the imprint below. Rounded corners, as
     cabinet cards had; set down on the desk a degree off square, and
     straightened when you reach for it. */
  .cabinet {
    position: relative;
    display: block;
    justify-self: center;
    width: clamp(11rem, 44vw, 15rem);
    padding: 0.85rem 0.85rem 0;
    border-radius: 5px;
    background:
      linear-gradient(155deg, rgb(255 255 255 / 0.4), rgb(255 255 255 / 0) 45%),
      var(--c-mount);
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.45),
      0 1px 1px rgb(26 25 25 / 0.14),
      0 22px 34px -20px rgb(26 25 25 / 0.6);
    color: inherit;
    text-decoration: none;
    transform: rotate(-1.2deg);
    transition: transform 0.35s ease;
  }
  .cabinet::before {
    content: '';
    position: absolute;
    inset: 0.4rem;
    border: 1px solid rgb(184 90 56 / 0.4);
    border-radius: 3px;
    pointer-events: none;
  }
  .cabinet:hover,
  .cabinet:focus-visible {
    transform: rotate(0deg) translateY(-3px);
  }
  .cabinet:focus-visible {
    outline: 2px solid var(--c-caprock);
    outline-offset: 4px;
  }
  .cab-window {
    position: relative;
    display: block;
    aspect-ratio: 0.78;
    overflow: hidden;
    background: #d6cebd;
  }
  /* The whole photograph, placed behind the window by the style the page
     computes. max-width: none, or Tailwind's img rule squeezes it back to
     the window and the crop is lost. */
  .cab-window img {
    position: absolute;
    max-width: none;
    height: auto;
  }
  /* The bevel: a dark inner edge top and left, a light one bottom and
     right, drawn over the photograph. */
  .cab-window::after {
    content: '';
    position: absolute;
    inset: 0;
    box-shadow:
      inset 0 0 0 1px rgb(26 25 25 / 0.35),
      inset 2px 2px 3px rgb(26 25 25 / 0.3),
      inset -1px -1px 0 rgb(255 255 255 / 0.35);
    pointer-events: none;
  }
  .cab-imprint {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0.75rem 0.4rem 0.9rem;
    text-align: center;
  }
  .cab-name {
    font-family: var(--font-serif);
    font-size: 0.98rem;
    font-variant-caps: all-small-caps;
    letter-spacing: 0.14em;
    line-height: 1.15;
    color: var(--c-caprock);
    text-wrap: balance;
  }
  .cab-dates {
    margin-top: 0.3rem;
    font: 0.6rem/1 ui-monospace, monospace;
    letter-spacing: 0.32em;
    color: var(--c-sage);
  }

  .hero-text {
    min-width: 0;
  }
  .name {
    margin: 0;
    font-size: clamp(2.4rem, 1.5rem + 3.6vw, 4rem);
    font-weight: 500;
    line-height: 0.98;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }
  .dates {
    margin: 0.65rem 0 0;
    color: var(--c-caprock);
    font-size: clamp(1.4rem, 1rem + 1.5vw, 2rem);
    font-variant-numeric: oldstyle-nums proportional-nums;
    letter-spacing: 0.02em;
    line-height: 1.1;
  }
  .dates--none {
    color: inherit;
    font-size: 1.05rem;
    font-style: italic;
    opacity: 0.6;
  }
  .qualifier {
    margin: 0.4rem 0 0;
    font-style: italic;
    opacity: 0.8;
  }
  .aka {
    margin: 1rem 0 0;
    font-size: 1.08rem;
  }
  .kinline {
    max-width: 34rem;
    margin: 0.9rem 0 0;
    font-size: 1.08rem;
    line-height: 1.45;
  }
  .tally {
    margin: 1.1rem 0 0;
    color: var(--c-sage);
    font: 0.7rem/1.5 ui-monospace, monospace;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  /* Links out, under the tally: small ruled buttons in the page's mono. */
  .hero-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.05rem 0 0;
    padding: 0;
    list-style: none;
  }
  .hero-link {
    display: inline-flex;
    align-items: baseline;
    gap: 0.55rem;
    padding: 0.42rem 0.7rem 0.44rem;
    border: 1px solid rgb(59 56 51 / 0.3);
    color: var(--c-iron);
    font: 0.7rem/1.3 ui-monospace, monospace;
    letter-spacing: 0.12em;
    text-decoration: none;
    text-transform: uppercase;
    transition:
      border-color 0.2s ease,
      color 0.2s ease,
      background-color 0.2s ease;
  }
  .hero-link-arrow {
    color: var(--c-caprock);
  }
  .hero-link:hover,
  .hero-link:focus-visible {
    border-color: var(--c-caprock);
    background: rgb(247 244 236 / 0.7);
    color: var(--c-caprock);
  }
  .hero-link:focus-visible {
    outline: 2px solid var(--c-caprock);
    outline-offset: 2px;
  }
  .lede {
    max-width: 40rem;
    margin: 0 0 0.5rem;
    font-size: 1.2rem;
    line-height: 1.55;
    text-wrap: pretty;
  }

  /* Not `.block`: that is also a Tailwind utility, and a scoped rule of the
     same name gave every `block` element on the page a section's margin. */
  .section {
    margin-top: 2.75rem;
  }
  .note {
    max-width: 40rem;
    margin: -0.25rem 0 1rem;
    font-size: 0.95rem;
    opacity: 0.78;
    text-wrap: pretty;
  }

  /* A life in photographs ------------------------------------------ */
  .life {
    --pitch: 14px;
    --rows: 0;
    --face-ar: 1.25;
    --face-w: 3rem;
    /* one rail row: the face, its 2px mat and border, and a gap */
    --slot: calc(var(--face-w) * var(--face-ar) + 6px + 0.6rem);
    --rail: calc(var(--rows) * var(--slot));
    --top: calc(1.35rem + var(--rail) + 0.35rem);
    --axis: 2.4rem;
    position: relative;
    height: calc(var(--top) + var(--lanes) * var(--pitch) + var(--axis));
  }
  .life-rules {
    position: absolute;
    inset: 0;
  }
  .tick {
    position: absolute;
    top: var(--top);
    bottom: calc(var(--axis) - 0.35rem);
    left: var(--x);
    border-left: 1px solid rgb(218 211 196 / 0.9);
  }
  .tick-year,
  .tick-age {
    position: absolute;
    left: 0;
    transform: translateX(-50%);
    font-family: ui-monospace, monospace;
    white-space: nowrap;
  }
  .tick-year {
    bottom: -1.05rem;
    font-size: 0.66rem;
    font-weight: 500;
    color: var(--c-sage);
  }
  .tick-age {
    bottom: -1.95rem;
    font-size: 0.64rem;
    font-style: normal;
    color: var(--c-caprock);
    opacity: 0.8;
  }
  .tick:first-child .tick-year,
  .tick:first-child .tick-age {
    transform: none;
  }
  .tick:last-child .tick-year,
  .tick:last-child .tick-age {
    transform: translateX(-100%);
  }
  @media (max-width: 40rem) {
    .tick.minor .tick-year,
    .tick.minor .tick-age {
      visibility: hidden;
    }
  }
  .band {
    position: absolute;
    top: var(--top);
    left: var(--x);
    width: var(--w);
    height: calc(var(--lanes) * var(--pitch));
    background: linear-gradient(
      to right,
      rgb(156 91 63 / 0) 0%,
      rgb(156 91 63 / 0.1) var(--fl),
      rgb(156 91 63 / 0.1) calc(100% - var(--fr)),
      rgb(156 91 63 / 0) 100%
    );
  }
  .band--active {
    background: linear-gradient(
      to right,
      rgb(122 132 113 / 0) 0%,
      rgb(122 132 113 / 0.14) var(--fl),
      rgb(122 132 113 / 0.14) calc(100% - var(--fr)),
      rgb(122 132 113 / 0) 100%
    );
  }
  .mark {
    position: absolute;
    top: 0;
    left: var(--x);
    height: calc(var(--top) + var(--lanes) * var(--pitch));
    border-left: 1px solid var(--c-caprock);
  }
  .mark b {
    position: absolute;
    top: 0;
    font: 500 0.66rem/1 ui-monospace, monospace;
    color: var(--c-caprock);
    white-space: nowrap;
  }
  .mark--birth b {
    left: 0.3rem;
  }
  .mark--death b {
    right: 0.3rem;
  }
  /* Faces along the life. */
  .rail {
    position: absolute;
    top: 1.35rem;
    left: 0;
    right: 0;
    height: var(--rail);
  }
  .rail-face {
    position: absolute;
    top: calc(var(--row) * var(--slot));
    left: var(--x);
    z-index: 1;
    width: var(--face-w);
    padding: 2px;
    background: var(--c-mount);
    border: 1px solid var(--c-haze);
    box-shadow: 0 6px 10px -8px rgb(26 25 25 / 0.6);
    transform: translateX(-50%);
    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      opacity 0.2s ease;
  }
  .rail-face img {
    display: block;
    width: 100%;
    height: auto;
  }
  /* The stem, down to where the bars begin. */
  .rail-face::after {
    content: '';
    position: absolute;
    top: 100%;
    left: 50%;
    height: calc((var(--rows) - 1 - var(--row)) * var(--slot) + 0.95rem);
    border-left: 1px solid rgb(184 90 56 / 0.55);
  }
  .rail-face.soft::after {
    border-left: 1px dashed var(--c-sage);
  }
  .rail-face:hover,
  .rail-face.is-lit {
    z-index: 2;
    border-color: var(--c-caprock);
    transform: translateX(-50%) translateY(-2px);
  }
  .life[data-dim] .rail-face:not(.is-lit) {
    opacity: 0.35;
  }
  @media (max-width: 40rem) {
    .life {
      --rail: 0px;
    }
    .rail {
      display: none;
    }
  }
  .life-bars {
    position: absolute;
    top: var(--top);
    left: 0;
    right: 0;
    height: calc(var(--lanes) * var(--pitch));
  }
  .bar {
    --stripe: linear-gradient(currentColor, currentColor) 0 50% / 100% 2px no-repeat;
    --dash: repeating-linear-gradient(90deg, currentColor 0 3px, transparent 3px 6px) 0 50% / 100% 2px no-repeat;
    --cap-l: linear-gradient(currentColor, currentColor) 0 50% / 1.5px 8px no-repeat;
    --cap-r: linear-gradient(currentColor, currentColor) 100% 50% / 1.5px 8px no-repeat;
    position: absolute;
    left: var(--x);
    top: calc(var(--y) * var(--pitch));
    width: var(--w);
    min-width: 5px;
    height: var(--pitch);
    color: var(--c-caprock);
    background: var(--stripe), var(--cap-l), var(--cap-r);
    transition: opacity 0.2s ease;
  }
  .bar.soft {
    color: var(--c-sage);
  }
  .bar.open-start {
    background: var(--dash), var(--cap-r);
  }
  .bar.open-end {
    background: var(--dash), var(--cap-l);
  }
  .life[data-dim] .bar {
    opacity: 0.15;
  }
  .life[data-dim] .bar.is-lit {
    opacity: 1;
    color: var(--c-iron);
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.2rem;
    margin-top: 0.4rem;
    font: 0.7rem/1.4 ui-monospace, monospace;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c-sage);
  }
  .swatch {
    display: inline-block;
    width: 1.6rem;
    height: 10px;
    margin-right: 0.4rem;
    vertical-align: -1px;
    color: var(--c-caprock);
    background:
      linear-gradient(currentColor, currentColor) 0 50% / 100% 2px no-repeat,
      linear-gradient(currentColor, currentColor) 0 50% / 1.5px 8px no-repeat,
      linear-gradient(currentColor, currentColor) 100% 50% / 1.5px 8px no-repeat;
  }
  .swatch.soft {
    color: var(--c-sage);
  }
  .swatch-band {
    display: inline-block;
    width: 1.6rem;
    height: 10px;
    margin-right: 0.4rem;
    vertical-align: -1px;
    background: rgb(156 91 63 / 0.16);
  }

  /* Faces, by date -------------------------------------------------- */
  /* Large enough to weigh one against another: two across on a phone,
     as many as fit at about 11rem on a wider screen. Each in a pale mount,
     with the date and age under it, then the photograph and the grounds. */
  .faces {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.75rem 1rem;
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 40rem) {
    .faces {
      grid-template-columns: repeat(auto-fill, minmax(10.5rem, 1fr));
      gap: 2rem 1.25rem;
    }
  }
  .fc {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .fc-face {
    position: relative;
    display: block;
    padding: 0.4rem;
    background: var(--c-mount);
    border: 1px solid var(--c-haze);
    box-shadow: 0 14px 24px -20px rgb(59 56 51 / 0.65);
    transition:
      border-color 0.2s ease,
      transform 0.25s ease;
  }
  .fc-face img {
    display: block;
    width: 100%;
    height: auto;
  }
  .fc-face:hover,
  .fc-face:focus-visible,
  .fc.is-lit .fc-face {
    border-color: var(--c-caprock);
    transform: translateY(-3px);
    outline: none;
  }
  .fc-face:focus-visible {
    box-shadow: 0 0 0 2px var(--c-caprock);
  }
  /* A placement that is only possible reads as one: a dashed mount. */
  .fc--doubt .fc-face {
    border-style: dashed;
    border-color: var(--c-sage);
  }
  .fc-flag {
    position: absolute;
    left: 0.4rem;
    bottom: 0.4rem;
    padding: 0.1rem 0.35rem;
    background: rgb(23 21 15 / 0.78);
    color: #f0ead9;
    font: 0.62rem/1.3 ui-monospace, monospace;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .fc-when {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.5rem;
    margin: 0.6rem 0 0;
  }
  .fc-date {
    color: var(--c-sage);
    font: 0.7rem/1.4 ui-monospace, monospace;
    letter-spacing: 0.04em;
  }
  .fc-age {
    font-size: 0.92rem;
    font-style: italic;
    line-height: 1.3;
  }
  .fc-title {
    margin: 0.15rem 0 0;
    font-size: 0.98rem;
    line-height: 1.3;
  }
  .fc-basis {
    margin: 0.3rem 0 0;
    font-size: 0.86rem;
    line-height: 1.45;
    opacity: 0.78;
  }

  /* Compare, when asked for ---------------------------------------- */
  .faces-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1rem;
  }
  .cmp-toggle,
  .cmp-done {
    padding: 0.3rem 0.7rem;
    border: 1px solid var(--c-haze);
    background: transparent;
    color: var(--c-iron);
    font: 500 0.66rem/1.3 ui-monospace, monospace;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
    transition: border-color 0.2s ease;
  }
  .cmp-toggle:hover,
  .cmp-done:hover {
    border-color: var(--c-caprock);
  }
  .cmp-toggle[aria-expanded='true'] {
    border-color: var(--c-caprock);
    background: var(--c-caprock);
    color: var(--c-canvas);
  }
  .cmp-toggle:focus-visible,
  .cmp-done:focus-visible,
  .cmp-remove:focus-visible,
  .fc-pick:focus-visible {
    outline: 2px solid var(--c-caprock);
    outline-offset: 2px;
  }
  .cmp-panel[hidden],
  .cmp[hidden],
  .fc-pick[hidden] {
    display: none;
  }
  /* The panel: a pale ground ruled top and bottom, so it reads as laid over
     the gallery rather than as another section. */
  .cmp-panel {
    margin: 1rem 0 2rem;
    padding: 1rem 1rem 1.25rem;
    border-block: 1px solid var(--c-haze);
    background: rgb(218 211 196 / 0.2);
  }
  .cmp-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.4rem 1rem;
    margin-bottom: 1rem;
  }
  .cmp-note {
    margin: 0;
    font-size: 0.98rem;
    font-style: italic;
    outline: none;
  }
  /* Two across even on a phone: a comparison is only one if the faces are
     side by side. Larger than the gallery on a wide screen. */
  .cmp-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem 1rem;
  }
  @media (min-width: 40rem) {
    .cmp-grid {
      grid-template-columns: repeat(auto-fill, minmax(12.5rem, 15rem));
      gap: 1.5rem 1.25rem;
    }
  }
  .cmp {
    margin: 0;
    min-width: 0;
  }
  .cmp-face {
    display: block;
    padding: 0.45rem;
    background: var(--c-mount);
    border: 1px solid var(--c-haze);
    box-shadow: 0 14px 26px -20px rgb(59 56 51 / 0.65);
  }
  .cmp--doubt .cmp-face {
    border-style: dashed;
    border-color: var(--c-sage);
  }
  .cmp.is-lit .cmp-face {
    border-color: var(--c-caprock);
  }
  .cmp-face img {
    display: block;
    width: 100%;
    height: auto;
  }
  .cmp figcaption {
    display: flex;
    flex-direction: column;
    margin-top: 0.6rem;
  }
  .cmp-title {
    margin-top: 0.15rem;
    font-size: 0.98rem;
    line-height: 1.3;
  }
  .cmp-basis {
    margin-top: 0.3rem;
    font-size: 0.86rem;
    line-height: 1.45;
    opacity: 0.8;
  }
  .cmp-remove {
    align-self: flex-start;
    margin-top: 0.45rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--c-sage);
    font: 0.66rem/1.3 ui-monospace, monospace;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
  }
  .cmp-remove:hover {
    color: var(--c-caprock);
  }
  /* The toggle on each face, only while comparing: a small round mark in
     the mount's corner - a plus, or a tick once chosen. */
  .fc-pick {
    position: absolute;
    top: 0.65rem;
    right: 0.65rem;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.9rem;
    height: 1.9rem;
    padding: 0;
    border: 1px solid rgb(247 244 236 / 0.8);
    border-radius: 50%;
    background: rgb(23 21 15 / 0.62);
    color: #f7f4ec;
    cursor: pointer;
  }
  .fc-pick svg {
    width: 0.95rem;
    height: 0.95rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .fc-pick-tick,
  .fc-pick[aria-pressed='true'] .fc-pick-plus {
    display: none;
  }
  .fc-pick[aria-pressed='true'] .fc-pick-tick {
    display: inline;
  }
  .fc-pick[aria-pressed='true'] {
    border-color: var(--c-caprock);
    background: var(--c-caprock);
  }
  .fc-pick:hover {
    border-color: #fff;
  }
  .faces-sec.is-comparing .fc:has(.fc-pick[aria-pressed='true']) .fc-face {
    border-color: var(--c-caprock);
  }

  /* Family --------------------------------------------------------- */
  /* THE TREE is the direct line: parents, the person and whom they
     married, children. Everyone is a mounted portrait with the name under
     it, as on the guide's roll; the person is larger and ruled in iron.
     HOW THE LINES ARE DRAWN, with no script and no measuring. Every row
     takes the tree's full width and centres its people, and the person's
     row is a three-column grid with the person alone in the middle column,
     so the centre of every row is the same line down the page:
       - each parent drops a stem, the stems are joined by a rail, and the
         rail drops one stem at the centre, onto the person;
       - the person's card runs a line from under its text to its foot (a
         flex filler, so it is as long as the row needs), and the children's
         row carries it on to their rail;
       - each child hangs from that rail by a stem of its own.
     A rail is drawn piece by piece: each card owns the piece above (or
     below) itself and half the gap either side, and the first and last
     cards own only the inner half. If a row wraps, each line keeps a rail
     of its own. --stem is one stem's length; a join is two. */
  .tree {
    --stem: 1.4rem;
    --gap: 1.1rem;
    --line: rgb(59 56 51 / 0.4);
    display: flex;
    flex-direction: column;
    align-items: stretch;
    margin-top: 0.75rem;
  }
  .gen {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: calc(var(--stem) + 1rem) var(--gap);
  }
  .gen + .gen {
    margin-top: calc(var(--stem) * 2);
  }
  /* The person's row: [ room | the person | spouses ]. */
  .gen--self {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    column-gap: var(--gap);
    align-items: stretch;
  }
  .kin--self {
    grid-column: 2;
  }
  .side--spouses {
    grid-column: 3;
    display: flex;
    flex-wrap: wrap;
    align-content: flex-start;
    gap: 1rem var(--gap);
  }

  /* One relative: a mounted face, then role, name and dates. */
  .kin {
    --kin-w: 6.5rem;
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: var(--kin-w);
    color: inherit;
    text-align: center;
    text-decoration: none;
  }
  .kin--self {
    --kin-w: 8.25rem;
  }
  .kin--small {
    --kin-w: 5.25rem;
  }
  /* A phone: everyone a little smaller, so three children stand abreast
     and a spouse fits beside the person. */
  @media (max-width: 30rem) {
    .tree {
      --gap: 0.7rem;
    }
    .kin {
      --kin-w: 5.3rem;
    }
    .kin--self {
      --kin-w: 6.4rem;
    }
    .kin--small {
      --kin-w: 4.6rem;
    }
  }
  .kin-frame {
    display: block;
    width: 100%;
    padding: 3px;
    background: var(--c-mount);
    border: 1px solid var(--c-haze);
    box-shadow: 0 8px 14px -12px rgb(26 25 25 / 0.6);
    transition:
      transform 0.2s ease,
      border-color 0.2s ease;
  }
  .kin--self .kin-frame {
    border-color: var(--c-iron);
    box-shadow:
      0 0 0 3px rgb(218 211 196 / 0.6),
      0 10px 16px -12px rgb(26 25 25 / 0.6);
  }
  .kin-face {
    display: block;
    width: 100%;
    height: auto;
    margin: 0;
  }
  /* No face marked yet: the mount stands empty, with an initial. */
  .kin-face--none {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 1 / var(--face-ar, 1.2);
    background: rgb(218 211 196 / 0.35);
    color: var(--c-sage);
    font-size: 1.5rem;
  }
  .kin--small .kin-face--none {
    font-size: 1.2rem;
  }
  a.kin:hover .kin-frame,
  a.kin:focus-visible .kin-frame {
    border-color: var(--c-caprock);
    transform: translateY(-2px);
  }
  a.kin:focus-visible {
    outline: 2px solid var(--c-caprock);
    outline-offset: 3px;
  }
  .kin-role {
    margin-top: 0.55rem;
    font: 0.62rem/1.3 ui-monospace, monospace;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c-iron);
    opacity: 0.7;
  }
  .kin-name {
    margin-top: 0.15rem;
    font-size: 1rem;
    line-height: 1.18;
    color: var(--c-caprock);
    text-wrap: balance;
  }
  .kin--self .kin-name {
    margin-top: 0.6rem;
    font-size: 1.12rem;
    font-weight: 600;
    color: var(--c-iron);
  }
  .kin--small .kin-name {
    font-size: 0.92rem;
  }
  /* Closer set, so "Half-sibling" stays on one line in the smaller card. */
  .kin--small .kin-role {
    letter-spacing: 0.05em;
  }
  .kin-dates {
    margin-top: 0.1rem;
    font-size: 0.85rem;
    font-variant-numeric: oldstyle-nums;
    opacity: 0.7;
  }

  /* THE LINES. Parents: a stem down from each, a rail, one stem on. */
  .gen--parents .kin::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 100%;
    height: var(--stem);
    border-left: 1px solid var(--line);
  }
  .gen--parents .kin::before {
    content: '';
    position: absolute;
    top: calc(100% + var(--stem));
    left: calc(var(--gap) / -2);
    right: calc(var(--gap) / -2);
    border-top: 1px solid var(--line);
  }
  .gen--parents .kin:first-child::before {
    left: 50%;
  }
  .gen--parents .kin:last-child::before {
    right: 50%;
  }
  .gen--parents .kin:only-child::before {
    display: none;
  }
  .gen--parents::after {
    content: '';
    position: absolute;
    left: 50%;
    top: calc(100% + var(--stem));
    height: var(--stem);
    border-left: 1px solid var(--line);
  }
  /* The person to their children: the line from under the name to the foot
     of the card, as long as the row makes it. */
  .has-children .kin--self::after {
    content: '';
    flex: 1 0 0.6rem;
    width: 0;
    margin-top: 0.5rem;
    border-left: 1px solid var(--line);
  }
  /* Children: the stem on from the person, the rail, a stem to each. */
  .gen--children::before {
    content: '';
    position: absolute;
    left: 50%;
    top: calc(var(--stem) * -2);
    height: var(--stem);
    border-left: 1px solid var(--line);
  }
  .gen--children .kin::before {
    content: '';
    position: absolute;
    left: 50%;
    top: calc(var(--stem) * -1);
    height: var(--stem);
    border-left: 1px solid var(--line);
  }
  .gen--children .kin::after {
    content: '';
    position: absolute;
    top: calc(var(--stem) * -1);
    left: calc(var(--gap) / -2);
    right: calc(var(--gap) / -2);
    border-top: 1px solid var(--line);
  }
  .gen--children .kin:first-child::after {
    left: 50%;
  }
  .gen--children .kin:last-child::after {
    right: 50%;
  }
  .gen--children .kin:only-child::after {
    display: none;
  }
  /* Married: a short double rule from the person to the first spouse, at
     the middle of the spouse's portrait. */
  .side--spouses .kin:first-child .kin-frame {
    position: relative;
  }
  .side--spouses .kin:first-child .kin-frame::before {
    content: '';
    position: absolute;
    right: 100%;
    top: 50%;
    width: var(--gap);
    height: 4px;
    margin-top: -2px;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  /* Brothers and sisters: a row of their own, smaller, in order of birth. */
  .sibs {
    margin-top: 2.25rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--c-haze);
  }
  .sib-row {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem 1rem;
    margin-top: 0.8rem;
  }

  /* How each relationship is known: folded, and one click away. */
  .grounds-fold {
    margin-top: 1.75rem;
  }
  .grounds-fold summary {
    cursor: pointer;
  }
  .grounds-fold summary:focus-visible {
    outline: 2px solid var(--c-caprock);
    outline-offset: 2px;
  }
  .grounds-fold .grounds {
    margin-top: 0.75rem;
  }
  .grounds {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .grounds li {
    display: grid;
    gap: 0.1rem 1rem;
    padding: 0.5rem 0;
    border-top: 1px solid var(--c-haze);
  }
  @media (min-width: 40rem) {
    .grounds li {
      grid-template-columns: 15rem minmax(0, 1fr);
    }
  }
  .grounds-why {
    font-size: 0.92rem;
    opacity: 0.8;
  }

  /* Photographs ---------------------------------------------------- */
  /* One row each. The print keeps its own shape: every print is the same
     HEIGHT and as wide as it is, up to a limit, so a cabinet card and a
     wide group photograph sit in the same column at their true shapes. */
  .photos {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .photo {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    padding: 1.1rem 0.5rem 1.1rem 0;
    border-top: 1px solid var(--c-haze);
    transition: background-color 0.2s ease;
  }
  .photo.is-lit {
    background: rgb(218 211 196 / 0.22);
  }
  .photo-print {
    flex: none;
    display: flex;
    justify-content: flex-start;
    width: 9rem;
  }
  .photo-print img {
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 7rem;
    box-shadow:
      0 1px 1px rgb(26 25 25 / 0.18),
      0 10px 16px -10px rgb(26 25 25 / 0.55);
    transition: transform 0.25s ease;
  }
  .photo:hover .photo-print img,
  .photo.is-lit .photo-print img {
    transform: translateY(-3px);
  }
  /* A PRINT IN AN ALBUM: a window the shape of the print, with the page
     image behind it, placed by the style the page computes. The window
     takes the shadow and the lift; the image inside it stays put. Plain
     overflow - no clip-path, no mask. */
  .photo-crop {
    position: relative;
    display: block;
    overflow: hidden;
    width: min(100%, calc(7rem * var(--ar, 1.5)));
    aspect-ratio: var(--ar, 1.5);
    box-shadow:
      0 1px 1px rgb(26 25 25 / 0.18),
      0 10px 16px -10px rgb(26 25 25 / 0.55);
    transition: transform 0.25s ease;
  }
  .photo-print .photo-crop img {
    position: absolute;
    max-width: none;
    max-height: none;
    box-shadow: none;
    transition: none;
  }
  .photo:hover .photo-crop,
  .photo.is-lit .photo-crop {
    transform: translateY(-3px);
  }
  .photo:hover .photo-print .photo-crop img,
  .photo.is-lit .photo-print .photo-crop img {
    transform: none;
  }
  @media (max-width: 40rem) {
    .photo {
      gap: 0.9rem;
    }
    .photo-print {
      width: 5.5rem;
    }
    .photo-print img {
      max-height: 5.5rem;
    }
    .photo-crop {
      width: min(100%, calc(5.5rem * var(--ar, 1.5)));
    }
    .photo-print .photo-crop img {
      max-height: none;
    }
  }
  .photo-text {
    min-width: 0;
    flex: 1;
  }
  .photo-title {
    font-size: 1.08rem;
  }
  .photo-age {
    margin-top: 0.3rem;
    font-style: italic;
  }
  .photo-basis {
    margin-top: 0.3rem;
    font-size: 0.92rem;
    opacity: 0.8;
  }
  .photo-find {
    display: inline-block;
    margin-top: 0.45rem;
    color: var(--c-caprock);
    font: 500 0.7rem/1.3 ui-monospace, monospace;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
  }
  .photo-find:hover {
    text-decoration: underline;
  }

  /* The record ----------------------------------------------------- */
  /* Two columns on a wide screen - the field, then its value - ruled like
     the rest of the site's lists. On a phone the field sits over its
     value. */
  .rec {
    margin: 0.25rem 0 0;
  }
  .rec-row {
    display: grid;
    gap: 0.2rem 1.5rem;
    padding: 0.7rem 0;
    border-top: 1px solid var(--c-haze);
  }
  .rec-row:last-child {
    border-bottom: 1px solid var(--c-haze);
  }
  @media (min-width: 40rem) {
    .rec-row {
      grid-template-columns: 9.5rem minmax(0, 1fr);
      align-items: baseline;
    }
  }
  .rec dt {
    color: var(--c-sage);
    font: 0.7rem/1.5 ui-monospace, monospace;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .rec dd {
    margin: 0;
    min-width: 0;
    font-size: 0.98rem;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }
  .rec-heading {
    font-size: 1.15rem !important;
    font-weight: 600;
  }
  .rec-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .rec-list li + li {
    margin-top: 0.3rem;
  }
  /* Sources are citations: a hanging indent keeps each one together. */
  .rec-sources li {
    padding-left: 1.25rem;
    text-indent: -1.25rem;
  }
  .rec-status {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-weight: 600;
  }
  .rec-status::before {
    content: '';
    width: 0.55rem;
    height: 0.55rem;
    border: 1.5px solid var(--c-sage);
    border-radius: 50%;
  }
  .rec-status--established::before {
    border-color: var(--c-caprock);
    background: var(--c-caprock);
  }
  .rec-gloss {
    display: block;
    margin-top: 0.15rem;
    font-size: 0.9rem;
    font-style: italic;
    opacity: 0.75;
  }
  .rec-empty {
    font-style: italic;
    opacity: 0.6;
  }
  .rec-link {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
  }
  .rec-copy {
    padding: 0.15rem 0.5rem;
    border: 1px solid var(--c-haze);
    background: transparent;
    color: var(--c-iron);
    font: 500 0.64rem/1.3 ui-monospace, monospace;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
  }
  .rec-copy:hover {
    border-color: var(--c-caprock);
  }
  .rec-copy:focus-visible {
    outline: 2px solid var(--c-caprock);
    outline-offset: 2px;
  }

  /* THIS PERSON ELSEWHERE. Each link is one plain ruled box: the site's
     name in the serif, what the identifier is and the identifier itself in
     mono beneath it, and an arrow that says the link leaves the site. The
     boxes sit side by side and wrap; the hairline firms and the name turns
     caprock under the pointer. */
  .elsewhere {
    margin-top: 1.6rem;
  }
  .else-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 0.6rem 0 0;
    padding: 0;
    list-style: none;
  }
  .else-link {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: 1.25rem;
    align-items: start;
    min-width: 13.5rem;
    padding: 0.7rem 0.9rem 0.75rem;
    border: 1px solid var(--c-haze);
    color: inherit;
    text-decoration: none;
    transition:
      border-color 0.2s ease,
      background-color 0.2s ease;
  }
  .else-site {
    grid-column: 1;
    font-size: 1.12rem;
    font-weight: 600;
    line-height: 1.25;
    transition: color 0.2s ease;
  }
  .else-id {
    grid-column: 1;
    margin-top: 0.15rem;
    font: 0.7rem/1.5 ui-monospace, monospace;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.74;
    overflow-wrap: anywhere;
  }
  .else-arrow {
    grid-column: 2;
    grid-row: 1;
    color: var(--c-caprock);
    font: 0.95rem/1.4 ui-monospace, monospace;
    transition: transform 0.2s ease;
  }
  .else-link:hover,
  .else-link:focus-visible {
    border-color: var(--c-caprock);
    background: rgb(218 211 196 / 0.2);
  }
  .else-link:hover .else-site,
  .else-link:focus-visible .else-site {
    color: var(--c-caprock);
  }
  .else-link:hover .else-arrow,
  .else-link:focus-visible .else-arrow {
    transform: translate(2px, -2px);
  }
  .else-link:focus-visible {
    outline: 2px solid var(--c-caprock);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .bar,
    .fc-face,
    .kin-frame,
    .photo,
    .photo-print img,
    .photo-crop,
    .cabinet,
    .rail-face,
    .else-link,
    .else-site,
    .else-arrow,
    .hero-link {
      transition: none;
    }
    .else-link:hover .else-arrow,
    .else-link:focus-visible .else-arrow {
      transform: none;
    }
    .cabinet:hover,
    .cabinet:focus-visible,
    a.kin:hover .kin-frame,
    a.kin:focus-visible .kin-frame,
    .photo:hover .photo-crop,
    .photo.is-lit .photo-crop,
    .photo:hover .photo-print img,
    .photo.is-lit .photo-print img,
    .fc-face:hover,
    .fc-face:focus-visible,
    .fc.is-lit .fc-face {
      transform: none;
    }
  }

  @media print {
    .bleed {
      border-image: none;
    }
    .cabinet {
      transform: none;
      box-shadow: none;
    }
    .rail {
      display: none;
    }
    .life {
      --rail: 0px;
    }
    .pager,
    .rec-copy,
    .cmp-toggle,
    .cmp-panel,
    .fc-pick {
      display: none !important;
    }
    .faces {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .fc,
    .photo,
    .rec-row {
      break-inside: avoid;
    }
    .elsewhere {
      break-inside: avoid;
    }
    /* On paper a link is its address. */
    .else-link::after {
      content: attr(href);
      grid-column: 1 / -1;
      margin-top: 0.2rem;
      font: 0.7rem/1.4 ui-monospace, monospace;
      overflow-wrap: anywhere;
    }
    .else-arrow {
      display: none;
    }
  }
</style>

<script>
  import { navigate } from 'astro:transitions/client';

  function wire() {
    const root = document.querySelector<HTMLElement>('[data-person-page]');
    const dataEl = document.getElementById('person-data');
    if (!root || !dataEl || root.dataset.wired) return;
    root.dataset.wired = '1';

    const ac = new AbortController();
    const signal = ac.signal;
    document.addEventListener('astro:before-swap', () => ac.abort(), { once: true });

    const data = JSON.parse(dataEl.textContent || '{}') as {
      prev: string | null;
      next: string | null;
      max: number;
      suggest: string[];
      suggestNote: string;
    };
    const $$ = <T extends Element = HTMLElement>(sel: string) => Array.from(root.querySelectorAll<T>(sel));

    /* One photograph, lit everywhere it appears ------------------------- */
    const keyed = $$('[data-key]');
    const life = root.querySelector<HTMLElement>('[data-life]');
    const light = (key: string | null) => {
      keyed.forEach((el) => el.classList.toggle('is-lit', !!key && el.dataset.key === key));
      life?.toggleAttribute('data-dim', !!key && keyed.some((el) => el.classList.contains('bar') && el.dataset.key === key));
    };
    keyed.forEach((el) => {
      const key = el.dataset.key || null;
      el.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') light(key); }, { signal });
      el.addEventListener('pointerleave', (e) => { if (e.pointerType === 'mouse') light(null); }, { signal });
      el.addEventListener('focusin', () => light(key), { signal });
      el.addEventListener('focusout', () => light(null), { signal });
    });

    /* Compare, when asked for ----------------------------------------- *
     * Off until the reader presses "Compare faces". Then the panel opens
     * holding the suggested pair, and each face in the gallery shows a
     * toggle. Up to `max` faces; choosing one more lets the oldest choice
     * go. The choice is kept in the address as #compare=id,id so it can be
     * sent to someone, and read back on arrival.
     * ------------------------------------------------------------------ */
    const sec = root.querySelector<HTMLElement>('[data-faces]');
    const panel = root.querySelector<HTMLElement>('[data-cmp-panel]');
    const cmpToggle = root.querySelector<HTMLButtonElement>('[data-cmp-toggle]');
    if (sec && panel && cmpToggle) {
      const picks = $$<HTMLButtonElement>('[data-pick]');
      const figs = $$('[data-cmp]');
      const note = panel.querySelector<HTMLElement>('[data-cmp-note]');
      const status = panel.querySelector<HTMLElement>('[data-cmp-status]');
      const known = new Set(figs.map((f) => f.dataset.cmp!));
      // A Set keeps the order faces were chosen in, so the oldest choice is
      // the one that makes room when the comparison is full.
      let chosen = new Set<string>();
      let touched = false;
      let comparing = false;

      const HASH = 'compare=';
      const writeHash = () => {
        const base = `${location.pathname}${location.search}`;
        const ids = [...chosen].map(encodeURIComponent).join(',');
        history.replaceState(history.state, '', comparing && ids ? `${base}#${HASH}${ids}` : base);
      };
      const readHash = () => {
        const h = location.hash.slice(1);
        if (!h.startsWith(HASH)) return [];
        return h
          .slice(HASH.length)
          .split(',')
          .map((x) => decodeURIComponent(x))
          .filter((x) => known.has(x))
          .slice(0, data.max);
      };

      const render = () => {
        figs.forEach((f) => (f.hidden = !chosen.has(f.dataset.cmp!)));
        picks.forEach((b) => b.setAttribute('aria-pressed', String(chosen.has(b.dataset.pick!))));
        if (note) {
          note.textContent =
            chosen.size === 0
              ? 'Choose faces below to set them side by side.'
              : chosen.size === 1
                ? 'Choose another face below to set beside this one.'
                : touched
                  ? `${chosen.size} faces side by side, in date order.`
                  : data.suggestNote;
        }
        writeHash();
      };

      const open = (ids: string[], focus: boolean) => {
        comparing = true;
        chosen = new Set(ids);
        touched = false;
        sec.classList.add('is-comparing');
        panel.hidden = false;
        picks.forEach((b) => (b.hidden = false));
        cmpToggle.setAttribute('aria-expanded', 'true');
        render();
        if (focus) note?.focus({ preventScroll: true });
      };
      const close = () => {
        comparing = false;
        chosen = new Set();
        sec.classList.remove('is-comparing');
        panel.hidden = true;
        picks.forEach((b) => (b.hidden = true));
        cmpToggle.setAttribute('aria-expanded', 'false');
        writeHash();
        cmpToggle.focus();
      };
      const toggle = (id: string) => {
        touched = true;
        if (chosen.has(id)) chosen.delete(id);
        else {
          if (chosen.size >= data.max) chosen.delete(chosen.values().next().value as string);
          chosen.add(id);
        }
        render();
        if (status) status.textContent = `${chosen.size} ${chosen.size === 1 ? 'face' : 'faces'} in the comparison.`;
      };

      cmpToggle.addEventListener('click', () => (comparing ? close() : open(data.suggest, true)), { signal });
      panel.querySelector('[data-cmp-done]')?.addEventListener('click', close, { signal });
      picks.forEach((b) => b.addEventListener('click', () => toggle(b.dataset.pick!), { signal }));
      $$<HTMLButtonElement>('[data-unpick]').forEach((b) =>
        b.addEventListener('click', () => toggle(b.dataset.unpick!), { signal })
      );
      sec.addEventListener(
        'keydown',
        (e) => {
          if (e.key === 'Escape' && comparing) {
            e.preventDefault();
            close();
          }
        },
        { signal }
      );

      // Arriving on a shared comparison: open it and bring it into view.
      const shared = readHash();
      if (shared.length) {
        open(shared, false);
        requestAnimationFrame(() => panel.scrollIntoView({ block: 'start' }));
      }
    }

    /* Copy the permalink --------------------------------------------- */
    const copyStatus = root.querySelector<HTMLElement>('[data-copy-status]');
    $$<HTMLButtonElement>('[data-copy-link]').forEach((b) =>
      b.addEventListener(
        'click',
        async () => {
          const text = b.dataset.copyLink ?? location.href;
          let ok = false;
          try {
            await navigator.clipboard.writeText(text);
            ok = true;
          } catch {
            // No clipboard permission: select the link so a copy is one key away.
            const a = b.previousElementSibling;
            if (a) {
              const range = document.createRange();
              range.selectNodeContents(a);
              const sel = window.getSelection();
              sel?.removeAllRanges();
              sel?.addRange(range);
            }
          }
          b.textContent = ok ? 'Copied' : 'Selected';
          if (copyStatus) copyStatus.textContent = ok ? 'Link copied.' : 'Link selected; press Ctrl+C to copy it.';
          window.setTimeout(() => (b.textContent = 'Copy'), 1800);
        },
        { signal }
      )
    );

    /* Previous / next --------------------------------------------------- */
    document.addEventListener(
      'keydown',
      (e) => {
        if (e.defaultPrevented || e.altKey || e.ctrlKey || e.metaKey || e.shiftKey) return;
        if ((e.target as Element).closest('input, textarea, select, [contenteditable], pre')) return;
        const href = e.key === 'ArrowLeft' ? data.prev : e.key === 'ArrowRight' ? data.next : null;
        if (href) {
          e.preventDefault();
          navigate(href);
        }
      },
      { signal }
    );
  }

  document.addEventListener('astro:page-load', wire);
</script>