---
// src/pages/collections/family.astro
//
// FAMILY SIGN-IN: /collections/family
//
// Photographs of living people are private (see WHO SEES WHAT in
// src/data/collections/index.ts). Relatives see them by typing one shared
// password here. This page is only the form. The password is checked by
// functions/collections/[[path]].js on Cloudflare, which is also what serves
// the private pages and pictures afterwards - nothing private is in this
// file, or in any file the public site is made of.
//
// HOW IT GOES
//   The form POSTs the password to this same address. The function answers:
//     right   a cookie that lasts 14 days, and on to `next` - the page the
//             relative was trying to reach, or the collections guide
//     wrong   back here with ?e=1, which shows the message under the field
//   /collections/family/out signs out.
//
// THE ADDRESS DOES THE WORK. A relative sent a link to a private photograph
// lands here with ?next=<that address>, and the script below puts it in the
// form so signing in takes them straight to it. Without script the form
// still signs in; it goes to the guide.
//
// THE PASSWORD ITSELF is not here and not in the repository. It is the
// FAMILY_PASSWORD secret on the Cloudflare Pages project. Change it there
// and everyone is signed out.
//
// IN `npm run dev` there is no function, so the form cannot sign anyone in;
// the dev server already shows the family view.
//
// 'family' is reserved as a collection slug in index.ts, since this static
// route would win over [collection].astro.
import RootLayout from '../../layouts/RootLayout.astro';
import { FAMILY_SIGN_IN } from '../../data/collections/index';

const CONTACT = 'hello@austinlallison.com';
const DAYS = 14; // keep equal to DAYS in functions/collections/[[path]].js
---

<RootLayout
  title="Family sign-in | Collections | Austin Allison"
  description="Sign-in for family, to see the photographs that are private because they show living people."
  prose={false}
>
  <meta slot="head" name="robots" content="noindex" />
  <noscript>
    <style is:inline>
      [data-js-only] { display: none !important; }
    </style>
  </noscript>

  <div class="signin max-w-4xl mx-auto py-6 text-iron font-serif" data-signin>
    <div class="signin-text">
      <p class="eyebrow">Collections &middot; Family access</p>
      <h1 class="signin-title">Family sign-in</h1>
      <p class="lede">
        Some photographs in these collections show people who are still living.
        They are kept out of public view and open to family with a password.
      </p>

      {/* Shown by the script when the address carries ?next=: the relative
          followed a link to something private. */}
      <p class="from-link" hidden data-from-link>
        You followed a link to a private photograph. Sign in and you will be taken straight to it.
      </p>

      {/* Shown by the script to someone already signed in. */}
      <p class="from-link" hidden data-signed-in>
        You are signed in on this device.{' '}
        <a href="/collections">Go to the collections</a> or{' '}
        <a href={`${FAMILY_SIGN_IN}/out`} data-astro-reload>sign out</a>.
      </p>

      {/* data-astro-reload: an ordinary form post, not one the page router
          carries out, so the browser itself follows the answer and keeps
          the cookie. */}
      <form method="post" action={FAMILY_SIGN_IN} class="form" data-astro-reload data-form>
        <input type="hidden" name="next" value="/collections" data-next />
        <label for="family-password" class="label">Password</label>
        <div class="field">
          <input
            id="family-password"
            name="password"
            type="password"
            autocomplete="current-password"
            autocapitalize="none"
            spellcheck="false"
            required
            aria-describedby="family-error"
            data-password
          />
          <button type="button" class="show" aria-pressed="false" data-show data-js-only>Show</button>
        </div>
        <p id="family-error" class="error" role="alert" hidden data-error>
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
            <circle cx="10" cy="10" r="8.5"></circle>
            <path d="M10 5.5v5.5"></path>
            <path d="M10 14.2v.3"></path>
          </svg>
          <span data-error-text>That password did not match. Check it with whoever sent it to you.</span>
        </p>
        <div class="go">
          <button type="submit" class="submit">Sign in</button>
          <span class="stay">This device stays signed in for {DAYS} days.</span>
        </div>
      </form>

      <div class="foot">
        <p>Family, but no password? Write to <a href={`mailto:${CONTACT}`}>{CONTACT}</a>.</p>
        <p><a href="/collections" class="back">Back to Collections</a></p>
      </div>
    </div>

    {/* An empty window mat: what a withheld photograph looks like here. */}
    <div class="mat" role="img" aria-label="An empty window mat, standing for a withheld photograph">
      <div class="mat-window">Image withheld</div>
    </div>
  </div>
</RootLayout>

<style>
  .signin {
    display: flex;
    flex-wrap: wrap;
    gap: 3rem 4rem;
    align-items: flex-start;
    justify-content: space-between;
    padding-top: 2.5rem;
    padding-bottom: 4rem;
  }
  .signin-text {
    flex: 1 1 24rem;
    min-width: 0;
    max-width: 32rem;
  }
  .eyebrow,
  .label,
  .back,
  .show,
  .submit,
  .mat-window {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    text-transform: uppercase;
  }
  .eyebrow {
    margin: 0 0 1rem;
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    color: var(--color-caprock);
  }
  .signin-title {
    margin: 0 0 1.25rem;
    font-size: clamp(2.5rem, 7vw, 3.75rem);
    line-height: 1;
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  .lede {
    margin: 0;
    font-size: 1.35rem;
    line-height: 1.4;
  }
  /* These two are shown and hidden with the `hidden` attribute, so the
     rule gives them their look only while they are NOT hidden. */
  .from-link:not([hidden]) {
    display: block;
    margin: 1.25rem 0 0;
    padding: 0.8rem 1rem;
    background: var(--color-haze);
    font-size: 1.2rem;
    line-height: 1.35;
  }
  .from-link a,
  .foot a {
    color: var(--color-caprock);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
  .form {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-haze);
  }
  .label {
    display: block;
    margin-bottom: 0.6rem;
    font-size: 0.7rem;
    letter-spacing: 0.14em;
  }
  .field {
    display: flex;
    gap: 0.5rem;
  }
  .field input {
    flex: 1 1 auto;
    min-width: 0;
    height: 3.25rem;
    padding: 0 0.9rem;
    border: 1px solid var(--color-iron);
    border-radius: 2px;
    background: #fff;
    color: var(--color-iron);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 1.1rem;
  }
  .form.is-wrong .field input {
    border: 2px solid #8a2b1e;
  }
  .show {
    flex-shrink: 0;
    height: 3.25rem;
    min-width: 4.5rem;
    padding: 0 1rem;
    border: 1px solid var(--color-iron);
    border-radius: 2px;
    background: transparent;
    color: var(--color-iron);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    cursor: pointer;
  }
  .error:not([hidden]) {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
    margin: 0.75rem 0 0;
    color: #8a2b1e;
    font-size: 1.2rem;
    line-height: 1.3;
    font-weight: 600;
  }
  .error svg {
    flex-shrink: 0;
    margin-top: 0.2rem;
  }
  .go {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
    align-items: center;
    margin-top: 1.25rem;
  }
  .submit {
    height: 3.25rem;
    padding: 0 2rem;
    border: 0;
    border-radius: 2px;
    background: #9a4829; /* caprock, a step darker: white text needs 4.5:1 */
    color: #fff;
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    cursor: pointer;
  }
  .submit:hover {
    background: #7e3a20;
  }
  .field input:focus-visible,
  .show:focus-visible,
  .submit:focus-visible {
    outline: 2px solid var(--color-sky);
    outline-offset: 2px;
  }
  .stay {
    font-size: 1.1rem;
    opacity: 0.75;
  }
  .foot {
    margin-top: 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-haze);
    font-size: 1.2rem;
    line-height: 1.35;
  }
  .foot p {
    margin: 0 0 0.25rem;
  }
  .back {
    display: inline-block;
    padding: 0.75rem 0;
    font-size: 0.75rem;
    letter-spacing: 0.06em;
  }
  .mat {
    flex: 0 1 20rem;
    min-width: 14rem;
    aspect-ratio: 4 / 5;
    box-sizing: border-box;
    padding: 2.5rem;
    display: flex;
    background: #fbf9f3;
    border: 1px solid var(--color-haze);
    box-shadow: 0 18px 40px rgb(26 25 25 / 0.14);
  }
  .mat-window {
    flex: 1 1 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #cfc7b6;
    box-shadow: inset 0 2px 6px rgb(26 25 25 / 0.3);
    color: #3b3833;
    font-size: 0.7rem;
    letter-spacing: 0.14em;
  }
  @media (max-width: 47.99rem) {
    .mat {
      display: none;
    }
  }
</style>

<script>
  // Runs once per full load; astro:page-load then fires on every arrival,
  // including the ones the page router makes. The listeners are bound to
  // elements of the page, which the router replaces, so none pile up.
  const setUp = () => {
    const root = document.querySelector<HTMLElement>('[data-signin]');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = '1';

    const q = new URLSearchParams(location.search);
    const form = root.querySelector<HTMLFormElement>('[data-form]');
    const input = root.querySelector<HTMLInputElement>('[data-password]');
    const next = root.querySelector<HTMLInputElement>('[data-next]');
    const show = root.querySelector<HTMLButtonElement>('[data-show]');
    const error = root.querySelector<HTMLElement>('[data-error]');
    const errorText = root.querySelector<HTMLElement>('[data-error-text]');
    const fromLink = root.querySelector<HTMLElement>('[data-from-link]');
    const signedIn = root.querySelector<HTMLElement>('[data-signed-in]');

    // Where to go afterwards. Only an address inside the collections is
    // taken (the function checks again); anything else is the guide.
    const want = q.get('next') ?? '';
    const inside = /^\/collections(\/|$)/.test(want) && !want.startsWith('/collections/family');
    if (inside && next) next.value = want;

    const on = /(?:^|;\s*)fam_ui=1(?:;|$)/.test(document.cookie);
    if (signedIn) signedIn.hidden = !on;
    if (fromLink) fromLink.hidden = on || !inside || want === '/collections';

    const e = q.get('e');
    if (e && error && errorText && form) {
      if (e === 'setup') errorText.textContent = 'Sign-in is not set up yet. Please write to the address below.';
      error.hidden = false;
      form.classList.add('is-wrong');
      input?.focus();
    }

    show?.addEventListener('click', () => {
      if (!input) return;
      const showing = input.type === 'text';
      input.type = showing ? 'password' : 'text';
      show.textContent = showing ? 'Show' : 'Hide';
      show.setAttribute('aria-pressed', String(!showing));
    });
  };
  document.addEventListener('astro:page-load', setUp);
  setUp();
</script>
