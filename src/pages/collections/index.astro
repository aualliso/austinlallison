  /* The histogram. Everything here is a positioned box or an SVG path. */
  .hist-plot {
    position: relative;
    height: clamp(11rem, 19vw, 17rem);
    padding-bottom: 1.5rem;
    cursor: crosshair;
    touch-action: pan-y;
