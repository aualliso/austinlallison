---
// src/pages/collections/index.astro
//
// THE GUIDE TO THE COLLECTIONS. Five parts, each derived from the data so
// nothing on this page is hand-maintained:
//
//   1. Descriptive summary  extent, inclusive and bulk dates, names, surnames
//   2. Finder               names (INCLUDING variant forms) from a small
//                           inline index; photographs from Pagefind, with
//                           years matched against date INTERVALS
//   3. Holdings             one card per collection, its key photographs laid
//                           with one photograph shown whole
//   4. Chronology           a histogram: each dated photograph spread evenly
//                           across the years it could have been made in, so a
//                           date as an interval still shapes the chart. Pick
//                           a decade to see its photographs.
//   5. Surnames             a crosswalk of families against collections,
//                           which is what "arranged by custody, not by
//                           family" looks like in practice
//
// STANDING CONSTRAINTS HONOURED HERE (see the collections notes):
//   - No filter, blend, mask, backdrop or 3D. Everything that moves animates
//     transform or opacity only, and nothing moves under reduced motion.
//   - No Tailwind arbitrary values with commas or parentheses for layout.
//     Layout lives in the <style> block below, where plain CSS is safe.
//   - Nothing whose visibility rides on `hidden` gets a `display` rule.
//   - Script is wired on astro:page-load and guarded, so it survives
//     ClientRouter navigation.
//
// HOW IT LOOKS (2026-09 redesign). The page opens on the PEOPLE: a band
// of desk paper with the title, one line of lede, a wall of faces - one per
// person, their best identified face, in order of birth - and the finder.
// Each face shares its transition name with the cabinet card on that
// person's page, so it grows into it. The chronology sits on a second desk
// band; holdings and surnames on the canvas between. The surname table shows
// the twenty most photographed and folds the rest behind a button.
//
// SCALE. Rewritten 2026-09 for thousands of items. The page no longer
// carries a line, a thumbnail or an index entry per photograph: the chart is
// one path per series, and photographs are found through PAGEFIND, whose
// index is built after `astro build` and fetched in small pieces as someone
// types. The item pages declare what Pagefind reads (see [item].astro:
// data-pagefind-body, the collection / surname / year filters, the start
// sort). In `astro dev` there is no index, so photograph search and the
// decade panel say so and names still work.
//
// BUILD: package.json needs  "build": "astro build && pagefind --site dist"
// and  npm i -D pagefind.  Cloudflare runs `npm run build`, so that is all.
//
// The surname crosswalk (5) is still one row per surname; at several hundred
// surnames it will want the same treatment.

import RootLayout from '../../layouts/RootLayout.astro';
import {
  COLLECTIONS,
  ALL_ITEMS,
  PEOPLE_WITH_ITEMS,
  itemsOf,
  keyItemsOf,
  spanOf,
  extentOf,
  personHref,
  naturalName,
  headingDates,
  FACES,
  FACE_W,
  FACE_H,
  faceHref,
} from '../../data/collections/index';
import type { Face } from '../../data/collections/index';
import { plate } from '../../data/collections/images';
import type { Rendered } from '../../data/collections/images';

const EN = '\u2013';
const years = (a: number, b: number) => (a === b ? `${a}` : `${a}${EN}${b}`);
const plural = (n: number, one: string, many = `${one}s`) =>
  `${n.toLocaleString('en-US')} ${n === 1 ? one : many}`;

const H2 =
  'sec-h border-b border-haze pb-1.5 mb-4';

/* ---------------------------------------------------------------- *
 * Images. Rendered once per item; the item pages ask getImage() for the
 * same transforms, so this page adds no files to the build.
 * ---------------------------------------------------------------- */
// Only the photographs this page actually shows are rendered: each
// collection's key items, and one fallback for the share image. It used to
// render every item for the chronology's loupe - at thousands of items that
// was thousands of getImage() calls for pictures nobody saw here.
const keysOf = new Map(COLLECTIONS.map((c) => [c.slug, keyItemsOf(c.slug, 4)]));
const shown = new Map(
  [...[...keysOf.values()].flat(), ...(ALL_ITEMS[0] ? [ALL_ITEMS[0]] : [])].map((i) => [i.slug, i])
);
const renders = new Map<string, Rendered>(
  await Promise.all(
    [...shown.values()].map(async (i) => [i.slug, await plate(i.collection, i.recto.file, i.recto)] as const)
  )
);
const renderOf = (slug: string) => renders.get(slug) as Rendered;

/* ---------------------------------------------------------------- *
 * 1. Summary
 * ---------------------------------------------------------------- */
const extent = extentOf(ALL_ITEMS);
const established = PEOPLE_WITH_ITEMS.filter(
  (p) => p.person.status === 'established'
).length;

/* ---------------------------------------------------------------- *
 * 5. Surnames (computed early: the summary and the facets use it)
 * ---------------------------------------------------------------- */
const surnameRows = new Map<
  string,
  { surname: string; people: Set<string>; items: Set<string> }
>();
const surnamesOnItem = new Map<string, Set<string>>();
for (const { person, appearances } of PEOPLE_WITH_ITEMS) {
  const surname = person.surname.trim();
  const key = surname.toLowerCase();
  const row = surnameRows.get(key) ?? { surname, people: new Set(), items: new Set() };
  row.people.add(person.id);
  for (const a of appearances) {
    row.items.add(a.item.slug);
    const on = surnamesOnItem.get(a.item.slug) ?? new Set<string>();
    on.add(key);
    surnamesOnItem.set(a.item.slug, on);
  }
  surnameRows.set(key, row);
}
const itemCollection = new Map(ALL_ITEMS.map((i) => [i.slug, i.collection]));
const surnames = [...surnameRows.entries()]
  .map(([key, r]) => ({
    key,
    surname: r.surname,
    people: r.people.size,
    items: r.items.size,
    perCollection: COLLECTIONS.map(
      (c) => [...r.items].filter((s) => itemCollection.get(s) === c.slug).length
    ),
  }))
  .sort((a, b) => a.surname.localeCompare(b.surname));
const maxCell = Math.max(1, ...surnames.flatMap((r) => r.perCollection));
// The table lists the most photographed first, and shows XW_SHOW of them
// until asked for the rest; the chronology's surname menu stays alphabetical.
const XW_SHOW = 20;
const xwRows = [...surnames].sort((a, b) => b.items - a.items || a.surname.localeCompare(b.surname));

/* ---------------------------------------------------------------- *
 * 0. The people: the wall of faces that opens the page
 * ---------------------------------------------------------------- */
// One face per person, their best: identified as certain or probable, and
// the largest share of its photograph. Up to WALL_MAX people, chosen for
// established headings and then the most photographs, and laid out in
// order of birth so the wall reads as the generations. People with no
// birth year follow, in order of their earliest photograph.
const WALL_MAX = 32;
const FIRM: Record<string, number> = { certain: 0, probable: 1 };
const faceArea = (f: Face) => f.region.w * f.region.h;
const bestFace = new Map<string, Face>();
for (const f of FACES) {
  if (!(f.confidence in FIRM)) continue;
  const cur = bestFace.get(f.person);
  if (
    !cur ||
    FIRM[f.confidence] < FIRM[cur.confidence] ||
    (FIRM[f.confidence] === FIRM[cur.confidence] && faceArea(f) > faceArea(cur))
  ) {
    bestFace.set(f.person, f);
  }
}
const yearOf = (v?: string) => (v && /^\d{3,4}$/.test(v.trim()) ? Number(v) : undefined);
const wall = PEOPLE_WITH_ITEMS.filter(({ person }) => bestFace.has(person.id))
  .map(({ person: p, appearances }) => {
    const froms = appearances.map((a) => spanOf(a.item)?.from).filter((y): y is number => y !== undefined);
    const n = new Set(appearances.map((a) => a.item.slug)).size;
    const dates = headingDates(p).replace(/(\d)-/g, `$1${EN}`);
    return {
      p,
      face: bestFace.get(p.id)!,
      born: yearOf(p.birth),
      first: froms.length ? Math.min(...froms) : Infinity,
      n,
      name: naturalName(p),
      caption: `${naturalName(p)}${dates ? `, ${dates}` : ''} \u00b7 ${plural(n, 'photograph')}`,
    };
  })
  .sort((a, b) => Number(b.p.status === 'established') - Number(a.p.status === 'established') || b.n - a.n)
  .slice(0, WALL_MAX)
  .sort((a, b) => {
    if (a.born !== undefined && b.born !== undefined) return a.born - b.born || a.name.localeCompare(b.name);
    if (a.born !== undefined) return -1;
    if (b.born !== undefined) return 1;
    return a.first - b.first || a.name.localeCompare(b.name);
  });
const WALL_NOTE = 'The people in the photographs, in order of birth';
const crossing = surnames.filter((r) => r.perCollection.filter(Boolean).length > 1).length;

/* ---------------------------------------------------------------- *
 * 3. Holdings. One ENTRY per collection, and the photographs stand on a
 * SHELF: the key print large, the other key items beside it, all of them at
 * their true proportions and aligned along one hairline, the way objects sit
 * on a viewing table. The mixed shapes are the point - a cabinet card, a
 * snapshot and a tintype are not the same size, and a grid of equal boxes
 * spends its time hiding that. The record reads above the shelf: title and
 * scope at the left, the figures flush right in mono.
 * ---------------------------------------------------------------- */
const cards = COLLECTIONS.map((c) => {
  const items = itemsOf(c.slug);
  const keys = keysOf.get(c.slug) ?? [];
  return {
    c,
    count: items.length,
    extent: extentOf(items),
    key: keys[0] ? { item: keys[0], r: renderOf(keys[0].slug) } : null,
    strip: keys.slice(1, 4).map((item) => ({ item, r: renderOf(item.slug) })),
  };
});

/* ---------------------------------------------------------------- *
 * 4. Chronology
 * ---------------------------------------------------------------- */
// How far an open-ended date ("after 1890") is spread past its one known
// year. Not a claim about when it ends - just a reach, so an open date adds a
// thin wash over the years after it rather than a spike on its one year.
const OPEN_REACH = 15;
let axis: { lo: number; hi: number } | null = null;
if (extent) {
  const lo = Math.floor(extent.from / 10) * 10;
  let hi = Math.ceil((extent.to + 1) / 10) * 10;
  if (hi - lo < 30) hi = lo + 30;
  axis = { lo, hi };
}
const pct = (y: number) => (axis ? ((y - axis.lo) / (axis.hi - axis.lo)) * 100 : 0);

// THE WEIGHTED HISTOGRAM. A photograph dated 1885-1894 adds a tenth of a
// photograph to each of those ten years; one dated 1890 adds a whole one to
// 1890. The height of a year is therefore an ESTIMATE of how many were made
// in it, and a loosely dated print cannot fake a spike. `cover` counts, per
// year, every photograph that COULD date from it - the other honest number.
const collIndex = new Map(COLLECTIONS.map((c, n) => [c.slug, n]));
const surnameIndex = new Map(surnames.map((r, n) => [r.key, n]));
const spreads = axis
  ? ALL_ITEMS.flatMap((i) => {
      const s = spanOf(i);
      if (!s || !axis) return [];
      const from = Math.max(axis.lo, s.openStart ? s.to - OPEN_REACH : s.from);
      const to = Math.min(axis.hi - 1, s.openEnd ? s.from + OPEN_REACH : s.to);
      if (to < from) return [];
      const firm = i.date.confidence === 'certain' || i.date.confidence === 'probable';
      const sn = [...(surnamesOnItem.get(i.slug) ?? [])]
        .map((k) => surnameIndex.get(k))
        .filter((n): n is number => n !== undefined);
      return [{ from, to, firm, c: collIndex.get(i.collection) ?? -1, s: sn }];
    })
  : [];
const undated = ALL_ITEMS.length - spreads.length;
const YEARS = axis ? axis.hi - axis.lo : 0;
const firmW = new Array<number>(YEARS).fill(0);
const softW = new Array<number>(YEARS).fill(0);
const cover = new Array<number>(YEARS).fill(0);
for (const sp of spreads) {
  const share = 1 / (sp.to - sp.from + 1);
  for (let y = sp.from; y <= sp.to; y++) {
    const k = y - (axis as { lo: number }).lo;
    (sp.firm ? firmW : softW)[k] += share;
    cover[k] += 1;
  }
}
const peak = Math.max(0.0001, ...firmW.map((f, k) => f + softW[k]));
// One path per series in a 0..YEARS x 0..100 box, drawn with
// preserveAspectRatio="none" so it fills whatever width the page gives it.
const H = 100;
const BAR = YEARS > 160 ? 1 : 0.86;
const r2 = (v: number) => Math.round(v * 100) / 100;
const histPath = (base: number[], top: number[]) =>
  top
    .map((v, k) => {
      if (v <= 0) return '';
      const y0 = H - (base[k] / peak) * H;
      const h = (v / peak) * H;
      return `M${k} ${r2(y0)}v${r2(-h)}h${BAR}v${r2(h)}z`;
    })
    .join('');
const zeros = new Array<number>(YEARS).fill(0);
const firmPath = histPath(zeros, firmW);
const softPath = histPath(firmW, softW);
const decades = axis
  ? Array.from({ length: YEARS / 10 }, (_, n) => {
      const from = (axis as { lo: number }).lo + n * 10;
      let est = 0;
      let could = 0;
      for (let k = n * 10; k < n * 10 + 10; k++) est += firmW[k] + softW[k];
      could = spreads.filter((sp) => sp.to >= from && sp.from <= from + 9).length;
      return { from, est: Math.round(est), could, x: pct(from), w: pct(from + 10) - pct(from) };
    })
  : [];
const ticks: { year: number; x: number; label: boolean; minor: boolean }[] = [];
if (axis) {
  const step = axis.hi - axis.lo > 120 ? 20 : 10;
  for (let y = axis.lo; y <= axis.hi; y += 10) {
    const label = (y - axis.lo) % step === 0;
    ticks.push({ year: y, x: pct(y), label, minor: label && ((y - axis.lo) / step) % 2 === 1 });
  }
}
// For the client: enough to redraw the histogram for any collection or
// surname, and to read a year's figures under the pointer. Compact on
// purpose - [from, to, firm, collection, surnames] per photograph, no titles,
// no images; those come from Pagefind when someone asks for a decade.
const chronJson = JSON.stringify({
  lo: axis?.lo ?? 0,
  n: YEARS,
  peak,
  bar: BAR,
  firm: firmW.map(r2),
  soft: softW.map(r2),
  cover,
  items: spreads.map((sp) => [sp.from, sp.to, sp.firm ? 1 : 0, sp.c, sp.s]),
}).replace(/</g, '\\u003c');

/* ---------------------------------------------------------------- *
 * 2. Finder index. Short keys because it ships in the page.
 * ---------------------------------------------------------------- */
// Names stay inline: the authority file is hundreds of records, not
// thousands, and name search has to work in dev and on the first keystroke.
// Photographs moved to Pagefind.
const finder = {
  people: PEOPLE_WITH_ITEMS.map(({ person: p, appearances }) => ({
    n: naturalName(p),
    d: headingDates(p),
    h: personHref(p.id),
    c: new Set(appearances.map((a) => a.item.slug)).size,
    // [heading, reading order, ...see-from forms]. Index 0-1 are the
    // person's own name; a hit at 2+ came through a variant.
    f: [p.authorized, naturalName(p), ...(p.variants ?? [])],
  })),
};
const finderJson = JSON.stringify(finder).replace(/</g, '\\u003c');

const busiest = [...surnames].sort((a, b) => b.items - a.items)[0];
const exampleDecade = extent
  ? Math.floor(((extent.bulk ?? extent).from + (extent.bulk ?? extent).to) / 20) * 10
  : null;
const placeholder =
  busiest && exampleDecade
    ? `Try ${busiest.surname}, or ${exampleDecade}s`
    : 'A name, a title, or a year';

/* ---------------------------------------------------------------- *
 * Share image and structured data
 * ---------------------------------------------------------------- */
const shareImage =
  cards.find((c) => c.key)?.key?.r.view ??
  (ALL_ITEMS[0] ? renderOf(ALL_ITEMS[0].slug).view : undefined);

const site = Astro.site ?? Astro.url;
const abs = (path: string) => new URL(path, site).href;
const DESCRIPTION =
  'Family photographs described as archival collections: what each object is, who is in it, and how we know.';
const structured = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Collections',
  url: abs('/collections'),
  description: DESCRIPTION,
  hasPart: cards.map(({ c, count, extent: e }) => ({
    '@type': ['Collection', 'ArchiveComponent'],
    name: c.title,
    url: abs(`/collections/${c.slug}`),
    description: c.scope,
    collectionSize: count,
    ...(e ? { temporalCoverage: `${e.from}/${e.to}` } : {}),
    ...(c.places.length
      ? { spatialCoverage: c.places.map((name) => ({ '@type': 'Place', name })) }
      : {}),
  })),
};
const structuredJson = JSON.stringify(structured).replace(/</g, '\\u003c');
---

<RootLayout
  title="Collections | Austin Allison"
  description={DESCRIPTION}
  image={shareImage}
  prose={false}
>
  <script type="application/ld+json" is:inline set:html={structuredJson} />
  <script type="application/json" id="guide-finder" is:inline set:html={finderJson} />
  <script type="application/json" id="guide-chron" is:inline set:html={chronJson} />
  <noscript>
    <style is:inline>
      [data-js-only] { display: none !important; }
    </style>
  </noscript>

  <div class="guide max-w-4xl mx-auto py-6 text-iron font-serif" data-guide>
    <!-- 0. The front: title, people, finder -->
    <header class="front bleed">
      <p class="front-eyebrow">Guide to the collections</p>
      <h1 class="front-title">Collections</h1>
      <p class="lede">
        These are photographs that I have collected or have had access to
        through the years, and most of them are in my possession.
      </p>

      {wall.length > 0 && (
        <figure class="wall-fig">
          <ol class="wall" aria-label={`${WALL_NOTE}.`}>
            {wall.map((w) => (
              <li>
                <a
                  href={personHref(w.p.id)}
                  class="wall-face"
                  aria-label={w.caption}
                  data-caption={w.caption}
                >
                  <img
                    src={faceHref(w.face.id)}
                    srcset={`${faceHref(w.face.id)} 1x, ${faceHref(w.face.id, 2)} 2x`}
                    width={FACE_W}
                    height={FACE_H}
                    alt=""
                    decoding="async"
                    transition:name={`person-${w.p.id}`}
                  />
                </a>
              </li>
            ))}
          </ol>
          <figcaption class="wall-cap">
            <span class="wall-read" aria-hidden="true" data-wall-read>{WALL_NOTE}</span>
            <a href="/collections/names" class="wall-all">
              All {PEOPLE_WITH_ITEMS.length.toLocaleString('en-US')} names <span aria-hidden="true">&rarr;</span>
            </a>
          </figcaption>
        </figure>
      )}

      <!-- 2. Finder -->
      <div class="finder" data-finder>
        <label for="finder-input" class="finder-label">Find a name, a photograph, or a year</label>
        <div class="finder-field">
          <svg class="finder-icon" viewBox="0 0 20 20" aria-hidden="true">
            <circle cx="8.5" cy="8.5" r="5.5" fill="none" stroke="currentColor" stroke-width="1.5" />
            <path d="M12.6 12.6 17 17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
          </svg>
          <input
            id="finder-input"
            type="search"
            role="combobox"
            aria-expanded="false"
            aria-controls="finder-list"
            aria-autocomplete="list"
            autocomplete="off"
            spellcheck="false"
            placeholder={placeholder}
            data-finder-input
          />
        </div>
        <ul id="finder-list" class="finder-list" role="listbox" aria-label="Matches" hidden data-finder-list></ul>
        <p class="sr-only" aria-live="polite" data-finder-status></p>
      </div>
    </header>

    <!-- 1. Descriptive summary -->
    <dl class="ledger">
      <div>
        <dt>Photographs</dt>
        <dd class="fig">{ALL_ITEMS.length.toLocaleString('en-US')}</dd>
        <dd class="sub">in {plural(COLLECTIONS.length, 'collection')}</dd>
      </div>
      <div>
        <dt>Dates</dt>
        <dd class="fig">{extent ? years(extent.from, extent.to) : 'Undated'}</dd>
        <dd class="sub">
          {extent?.bulk
            ? `bulk ${years(extent.bulk.from, extent.bulk.to)}`
            : extent && extent.undated > 0
              ? `${extent.undated} undated`
              : 'inclusive'}
        </dd>
      </div>
      <div>
        <dt>People named</dt>
        <dd class="fig">{PEOPLE_WITH_ITEMS.length.toLocaleString('en-US')}</dd>
        <dd class="sub">{established} with established headings</dd>
      </div>
      <div>
        <dt>Surnames</dt>
        <dd class="fig">{surnames.length.toLocaleString('en-US')}</dd>
        <dd class="sub">
          {COLLECTIONS.length > 1 ? `${crossing} in more than one collection` : 'in the collection'}
        </dd>
      </div>
    </dl>

    <!-- 3. Holdings -->
    <section aria-labelledby="holdings-h" class="mt-12">
      <h2 id="holdings-h" class={H2}>Holdings</h2>
      <p class="note">
        Each collection is a group of photographs that came to me together,
        so a collection is not the same thing as a family: one box can hold
        several families, and one family can turn up in several boxes. The
        people in them are gathered across every collection in the <a
          href="/collections/names"
          class="text-caprock hover:underline">name authority file</a>.
      </p>
      <div class="entries">
        {cards.map(({ c, count, extent: e, key, strip }, n) => (
          <article class="entry" data-collection={c.slug}>
            <div class="entry-mark" aria-hidden="true">{String(n + 1).padStart(2, '0')}</div>
            <div class="entry-head">
              <div class="entry-text">
                <h3 class="entry-title">
                  <a href={`/collections/${c.slug}`} class="entry-link">{c.title}</a>
                </h3>
                <p class="entry-scope">{c.scope}</p>
              </div>

              <div class="entry-figures">
                <p class="fig-line"><b>{count.toLocaleString('en-US')}</b> {count === 1 ? 'photograph' : 'photographs'}</p>
                {e && <p class="fig-line"><b>{years(e.from, e.to)}</b></p>}
                {e?.bulk && <p class="fig-line fig-quiet">bulk <b>{years(e.bulk.from, e.bulk.to)}</b></p>}
                {e && axis && (
                  /* The collection's span drawn on the same axis as the
                     chronology below, so the entries can be read against one
                     another at a glance. */
                  <span class="spark" aria-hidden="true">
                    <span class="spark-run" style={`--x:${pct(e.from).toFixed(2)}%;--w:${(pct(e.to + 1) - pct(e.from)).toFixed(2)}%`}></span>
                    {e.bulk && (
                      <span class="spark-bulk" style={`--x:${pct(e.bulk.from).toFixed(2)}%;--w:${(pct(e.bulk.to + 1) - pct(e.bulk.from)).toFixed(2)}%`}></span>
                    )}
                  </span>
                )}
                {c.places.length > 0 && <p class="fig-line fig-quiet">{c.places.join('; ')}</p>}
              </div>
            </div>

            <div class="shelf">
              {key ? (
                <img
                  class="plate plate--key"
                  style={`--ar:${(key.r.width / key.r.height).toFixed(4)}`}
                  src={key.r.view}
                  srcset={key.r.viewSrcset}
                  sizes="(min-width: 48rem) 340px, 62vw"
                  width={key.r.width}
                  height={key.r.height}
                  alt=""
                  loading="lazy"
                  decoding="async"
                  transition:name={`plate-${key.item.slug}`}
                />
              ) : (
                <span class="plate-empty">Nothing described yet</span>
              )}
              {strip.map(({ item, r }) => (
                <img
                  class="plate plate--small"
                  style={`--ar:${(r.width / r.height).toFixed(4)}`}
                  src={r.index}
                  srcset={r.indexSrcset}
                  sizes="(min-width: 48rem) 150px, 26vw"
                  width={r.width}
                  height={r.height}
                  alt=""
                  loading="lazy"
                  decoding="async"
                  transition:name={`plate-${item.slug}`}
                />
              ))}
            </div>

            <p class="entry-foot">
              <span>{c.lines.length > 0 ? c.lines.join(', ') : ''}</span>
              <span class="entry-go">Browse the collection <span class="entry-arrow" aria-hidden="true">&rarr;</span></span>
            </p>
          </article>
        ))}
      </div>
    </section>

    <!-- 4. Chronology -->
    {axis && spreads.length > 0 && (
      <section aria-labelledby="chron-h" class="bleed chron-band" data-chron>
        <h2 id="chron-h" class={H2}>Chronology</h2>
        <p class="note">
          How many photographs were made in each year, as far as the dates
          allow. A photograph dated only to a span of years is spread evenly
          across it, so a loosely dated print adds a little to many years
          rather than all of itself to one. Choose a decade to see its
          photographs.
        </p>

        <div class="facets" data-js-only>
          {COLLECTIONS.length > 1 && (
            <div class="facet-row" role="group" aria-label="Show photographs from a collection">
              <span class="facet-label" aria-hidden="true">Collection</span>
              <button type="button" class="facet" aria-pressed="true" data-facet="c" data-value="" data-label="All collections">All</button>
              {COLLECTIONS.map((c, n) => (
                <button type="button" class="facet" aria-pressed="false" data-facet="c" data-value={String(n)} data-slug={c.slug} data-label={c.title}>
                  {c.title}
                </button>
              ))}
            </div>
          )}
          {surnames.length > 0 && (
            <div class="facet-row">
              {/* A native select, not a row of buttons: it holds three
                  surnames or three hundred in the same space, and it is
                  already keyboard- and screen-reader-complete. */}
              <label for="chron-surname" class="facet-label">Surname</label>
              <select id="chron-surname" class="facet-select" data-surname>
                <option value="">All surnames</option>
                {surnames.map((r, n) => (
                  <option value={String(n)} data-key={r.key}>{r.surname} ({r.items})</option>
                ))}
              </select>
            </div>
          )}
        </div>

        <div class="hist" data-hist>
          <div class="hist-plot">
            <div class="rules" aria-hidden="true">
              {ticks.map((t) => (
                <span class:list={['tick', { minor: t.minor }]} style={`--x:${t.x.toFixed(3)}%`}>
                  {t.label && <b>{t.year}</b>}
                </span>
              ))}
            </div>
            <svg
              class="hist-svg"
              viewBox={`0 0 ${YEARS} ${H}`}
              preserveAspectRatio="none"
              role="img"
              aria-label={`Photographs by year, ${axis.lo} to ${axis.hi - 1}. The decade list below gives the figures.`}
              data-hist-svg
            >
              <path class="h-firm" d={firmPath} data-h-firm />
              <path class="h-soft" d={softPath} data-h-soft />
              <path class="h-lit" d="" data-h-lit />
            </svg>
            <span class="hist-cursor" aria-hidden="true" hidden data-hist-cursor></span>
          </div>
          <p class="hist-readout" aria-hidden="true" data-hist-readout>&nbsp;</p>
        </div>

        <div class="legend">
          <span><i class="swatch firm"></i>Certain or probable date</span>
          <span><i class="swatch soft"></i>Possible date</span>
          {undated > 0 && <span>{plural(undated, 'photograph')} undated, not counted</span>}
        </div>

        {/* The decades are the way in, for every kind of reader: real buttons
            with real figures, so the chart itself can stay a picture. */}
        <div class="decades" role="group" aria-label="Browse by decade">
          {decades.map((d) => (
            <button
              type="button"
              class="decade"
              aria-pressed="false"
              aria-controls="decade-panel"
              data-decade={d.from}
              disabled={d.could === 0}
            >
              <span class="decade-y">{d.from}s</span>
              <span class="decade-n" data-decade-n>{d.could > 0 ? `~${d.est}` : '\u2013'}</span>
            </button>
          ))}
        </div>

        <div id="decade-panel" class="panel" hidden data-panel>
          <div class="panel-head">
            <h3 class="panel-title" data-panel-title></h3>
            <button type="button" class="panel-close" data-panel-close aria-label="Close the decade">&#10005;</button>
          </div>
          <ul class="panel-grid" data-panel-grid></ul>
          <p class="panel-note" data-panel-note hidden></p>
          <button type="button" class="panel-more" data-panel-more hidden>Show more</button>
        </div>

        <p class="sr-only" aria-live="polite" data-chron-status></p>
      </section>
    )}

    <!-- 5. Surnames -->
    {surnames.length > 0 && COLLECTIONS.length > 0 && (
      <section aria-labelledby="surnames-h" class="mt-14">
        <h2 id="surnames-h" class={H2}>Surnames across the collections</h2>
        <p class="note">
          Collections follow where the photographs came from, so families run
          across them. Figures are photographs; the most photographed
          surnames come first.
        </p>
        <div class="xwalk-wrap">
          <table class="xwalk" data-xw>
            <thead>
              <tr>
                <th scope="col">Surname</th>
                {COLLECTIONS.map((c) => <th scope="col" class="num">{c.title}</th>)}
                <th scope="col" class="num">People</th>
              </tr>
            </thead>
            <tbody>
              {xwRows.map((r, i) => (
                <tr class:list={[{ 'xw-more': i >= XW_SHOW }]}>
                  <th scope="row">{r.surname}</th>
                  {r.perCollection.map((n) => (
                    <td class="num">
                      {n > 0 ? (
                        <span class="tally" style={`--v:${(n / maxCell).toFixed(3)}`}>{n}</span>
                      ) : (
                        <>
                          <span class="nil" aria-hidden="true">&ndash;</span>
                          <span class="sr-only">none</span>
                        </>
                      )}
                    </td>
                  ))}
                  <td class="num">{r.people}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        {xwRows.length > XW_SHOW && (
          <button
            type="button"
            class="xw-toggle"
            aria-expanded="false"
            data-xw-toggle
            data-more={`Show all ${xwRows.length.toLocaleString('en-US')} surnames`}
            data-less={`Show the first ${XW_SHOW}`}
            data-js-only
          >
            Show all {xwRows.length.toLocaleString('en-US')} surnames
          </button>
        )}
      </section>
    )}
  </div>
</RootLayout>

<style>
  .guide {
    --c-caprock: var(--color-caprock, #9c5b3f);
    --c-sage: var(--color-sage, #7a8471);
    --c-haze: var(--color-haze, #dad3c4);
    --c-dust: var(--color-dust, #ede7da);
    --c-iron: var(--color-iron, #3b3833);
    --c-canvas: var(--color-canvas, #f7f4ec);
    --mono: var(--font-mono, ui-monospace, 'IBM Plex Mono', monospace);
  }
  .guide [hidden] {
    display: none !important;
  }
  .guide {
    --c-mount: var(--color-caliche, #e8e1d1);
    --c-desk: var(--color-desk, #f5f3ed);
  }
  /* FULL-WIDTH BANDS without a 100vw element: painted by border-image
     outset, which is ink overflow - it reaches the window edges and never
     adds a horizontal scrollbar. The same device as the person pages. */
  .bleed {
    border-image: conic-gradient(var(--c-desk) 0 0) fill 0 / / 0 100vmax;
  }

  /* 0. The front ---------------------------------------------------- */
  .front {
    padding: 2.5rem 0 2.5rem;
  }
  .front-eyebrow {
    margin: 0;
    color: var(--c-sage);
    font: 0.7rem/1.4 var(--mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .front-title {
    margin: 0.3rem 0 0;
    font-size: clamp(2.7rem, 1.6rem + 4.2vw, 4.5rem);
    font-weight: 500;
    line-height: 0.95;
    letter-spacing: -0.02em;
  }
  .front .lede {
    max-width: 36rem;
    margin: 1rem 0 0;
    font-size: 1.2rem;
    line-height: 1.5;
  }
  .front .finder {
    margin-top: 2rem;
  }

  /* The wall of faces: small mounted crops in a grid, like cartes de
     visite laid out on the desk. Point at one and the rest step back. */
  .wall-fig {
    margin: 2.25rem 0 0;
  }
  .wall {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(4.4rem, 1fr));
    gap: 0.7rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (max-width: 40rem) {
    .wall {
      grid-template-columns: repeat(auto-fill, minmax(3.4rem, 1fr));
      gap: 0.5rem;
    }
    /* A phone gets four or five rows, not seven. */
    .wall li:nth-child(n + 21) {
      display: none;
    }
  }
  .wall-face {
    display: block;
    padding: 3px;
    background: var(--c-mount);
    border: 1px solid var(--c-haze);
    box-shadow: 0 8px 14px -12px rgb(26 25 25 / 0.6);
    transition:
      transform 0.25s ease,
      border-color 0.25s ease,
      opacity 0.25s ease;
  }
  .wall-face img {
    display: block;
    width: 100%;
    height: auto;
  }
  .wall-face:hover,
  .wall-face:focus-visible {
    border-color: var(--c-caprock);
    transform: translateY(-3px);
  }
  .wall-face:focus-visible {
    outline: 2px solid var(--c-caprock);
    outline-offset: 2px;
  }
  .wall:has(.wall-face:hover) .wall-face:not(:hover) {
    opacity: 0.5;
  }
  .wall-cap {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.3rem 1.25rem;
    margin-top: 0.9rem;
    color: var(--c-sage);
    font: 0.7rem/1.5 var(--mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .wall-read {
    min-height: 1.5em;
  }
  .wall-read.is-reading {
    color: var(--c-iron);
  }
  .wall-all {
    color: var(--c-caprock);
    text-decoration: none;
    white-space: nowrap;
  }
  .wall-all:hover {
    text-decoration: underline;
  }

  /* The chronology's band. */
  .chron-band {
    margin-top: 3.5rem;
    padding: 2.5rem 0 2.75rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .wall-face {
      transition: none;
    }
    .wall-face:hover,
    .wall-face:focus-visible {
      transform: none;
    }
  }
  @media print {
    .bleed {
      border-image: none;
    }
  }

  .lede,
  .note {
    text-wrap: pretty;
  }
  .note {
    max-width: 40rem;
    font-size: 0.98rem;
    opacity: 0.8;
  }

  /* 1. Summary ---------------------------------------------------- */
  .ledger {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 2.25rem 0 0;
    border-bottom: 1px solid var(--c-haze);
  }
  .ledger > div {
    padding: 0.85rem 0.75rem 0.95rem 0;
    border-top: 1px solid var(--c-haze);
  }
  @media (min-width: 48rem) {
    .ledger {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .ledger > div + div {
      padding-left: 1rem;
      border-left: 1px solid var(--c-haze);
    }
  }
  .ledger dt {
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c-sage);
  }
  .ledger .fig {
    margin: 0.3rem 0 0;
    font-size: clamp(1.75rem, 1.2rem + 2vw, 2.4rem);
    font-weight: 500;
    line-height: 1;
    font-variant-numeric: oldstyle-nums proportional-nums;
    white-space: nowrap;
  }
  .ledger .sub {
    margin: 0.35rem 0 0;
    font-size: 0.92rem;
    font-style: italic;
    opacity: 0.75;
  }

  /* 2. Finder ----------------------------------------------------- */
  .finder {
    position: relative;
    max-width: 34rem;
    margin-top: 2rem;
  }
  .finder-label {
    display: block;
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c-sage);
  }
  .finder-field {
    position: relative;
  }
  .finder-icon {
    position: absolute;
    left: 0.1rem;
    top: 50%;
    width: 1.1rem;
    height: 1.1rem;
    transform: translateY(-50%);
    color: var(--c-sage);
    pointer-events: none;
  }
  .finder input {
    width: 100%;
    padding: 0.5rem 0.25rem 0.45rem 1.75rem;
    border: 0;
    border-bottom: 1.5px solid var(--c-iron);
    border-radius: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    font-size: 1.2rem;
    -webkit-appearance: none;
    appearance: none;
  }
  .finder input::-webkit-search-cancel-button,
  .finder input::-webkit-search-decoration {
    -webkit-appearance: none;
    appearance: none;
  }
  .finder input::placeholder {
    color: var(--c-sage);
    font-style: italic;
    opacity: 0.9;
  }
  .finder input:focus {
    outline: none;
    border-bottom-color: var(--c-caprock);
    box-shadow: 0 1.5px 0 0 var(--c-caprock);
  }
  .finder-list {
    position: absolute;
    z-index: 30;
    left: 0;
    right: 0;
    top: calc(100% + 0.35rem);
    max-height: 22rem;
    margin: 0;
    padding: 0.25rem 0;
    overflow-y: auto;
    list-style: none;
    background: var(--c-canvas);
    border: 1px solid var(--c-haze);
    border-top: 2px solid var(--c-caprock);
    box-shadow: 0 14px 30px -14px rgb(59 56 51 / 0.4);
  }
  .finder-list :global(.opt) {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.5rem 0.8rem;
    cursor: pointer;
  }
  .finder-list :global(.opt[aria-selected='true']),
  .finder-list :global(.opt:hover) {
    background: var(--c-mount);
  }
  .finder-list :global(.opt-main) {
    display: block;
    line-height: 1.25;
  }
  .finder-list :global(.opt-see) {
    display: block;
    font-size: 0.88rem;
    font-style: italic;
    opacity: 0.75;
  }
  .finder-list :global(.opt-meta),
  .finder-list :global(.opt-kind) {
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c-sage);
  }
  .finder-list :global(.opt-kind) {
    flex-shrink: 0;
  }
  .finder-list :global(.opt-empty) {
    padding: 0.6rem 0.8rem;
    font-style: italic;
    opacity: 0.75;
  }

  /* 3. Holdings --------------------------------------------------- */
  .entries {
    border-top: 1px solid var(--c-haze);
  }
  /* A folder number in the gutter, the record and the shelf indented from
     it: the entry has a left edge to read from, and nothing runs into the
     margins of the page. */
  .entry {
    position: relative;
    display: grid;
    gap: 0 1.5rem;
    padding: 2.5rem 1.25rem 1.75rem;
    border-bottom: 1px solid var(--c-haze);
    transition: background-color 0.25s ease;
  }
  @media (min-width: 48rem) {
    .entry {
      grid-template-columns: 4.25rem minmax(0, 1fr);
      padding: 2.75rem 1.75rem 2rem;
    }
  }
  .entry > :not(.entry-mark) {
    grid-column: -2;
  }
  .entry-mark {
    grid-row: 1 / span 3;
    margin-bottom: 0.5rem;
    font-size: clamp(1.6rem, 1rem + 2vw, 2.6rem);
    font-weight: 500;
    line-height: 0.9;
    font-variant-numeric: lining-nums tabular-nums;
    color: var(--c-haze);
    letter-spacing: -0.02em;
  }
  .entry:hover .entry-mark {
    color: rgb(156 91 63 / 0.55);
  }
  @media (max-width: 47.99rem) {
    .entry-mark {
      grid-row: auto;
      grid-column: 1;
      margin-bottom: 0.25rem;
    }
  }
  .entry:hover,
  .entry:focus-within {
    background: rgb(218 211 196 / 0.14);
  }
  .entry:focus-within {
    outline: 2px solid var(--c-caprock);
    outline-offset: 4px;
  }

  .entry-head {
    display: grid;
    gap: 0.75rem 2.5rem;
  }
  @media (min-width: 48rem) {
    .entry-head {
      grid-template-columns: minmax(0, 1fr) 14rem;
      align-items: end;
    }
  }
  .entry-title {
    margin: 0 0 0.4rem;
    font-size: clamp(1.7rem, 1.1rem + 2vw, 2.5rem);
    font-weight: 500;
    line-height: 1.04;
    letter-spacing: -0.012em;
    text-wrap: balance;
  }
  .entry-link {
    color: var(--c-iron);
    text-decoration: none;
  }
  .entry-link::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .entry-link:focus {
    outline: none;
  }
  .entry:hover .entry-link {
    color: var(--c-caprock);
  }
  .entry-scope {
    max-width: 46ch;
    margin: 0;
    font-size: 1.02rem;
    line-height: 1.5;
    opacity: 0.88;
    text-wrap: pretty;
  }
  /* The figures, flush right and set in mono, read as a column of record
     values rather than a sentence. */
  .entry-figures {
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    line-height: 1.9;
    text-transform: uppercase;
    color: var(--c-sage);
  }
  @media (min-width: 48rem) {
    .entry-figures {
      text-align: right;
    }
  }
  .fig-line {
    margin: 0;
  }
  .fig-line b {
    color: var(--c-iron);
    font-weight: 500;
    font-variant-numeric: lining-nums tabular-nums;
  }
  .fig-quiet b {
    color: var(--c-sage);
  }
  .spark {
    position: relative;
    display: block;
    height: 7px;
    margin: 0.35rem 0 0.5rem;
    border-bottom: 1px solid var(--c-haze);
  }
  .spark-run,
  .spark-bulk {
    position: absolute;
    left: var(--x);
    width: var(--w);
    min-width: 3px;
  }
  .spark-run {
    top: 2px;
    height: 3px;
    background: rgb(156 91 63 / 0.5);
  }
  .spark-bulk {
    top: 0;
    height: 7px;
    background: var(--c-caprock);
  }

  /* THE SHELF. Objects of different shapes standing on one line. A margin
     from a site-wide img rule would push them off it, so these are pinned. */
  .shelf {
    display: flex;
    align-items: flex-end;
    gap: clamp(0.75rem, 2.2vw, 2rem);
    margin-top: 1.9rem;
    padding-bottom: 1.6rem;
    border-bottom: 1px solid var(--c-haze);
    overflow-x: auto;
    scrollbar-width: none;
  }
  .shelf::-webkit-scrollbar {
    display: none;
  }
  .plate {
    display: block;
    flex: none;
    margin: 0;
    width: auto;
    border: 1px solid rgb(59 56 51 / 0.16);
    background: rgb(247 244 236 / 0.6);
    box-shadow:
      0 1px 1px rgb(59 56 51 / 0.14),
      0 14px 24px -18px rgb(59 56 51 / 0.5);
    transition:
      transform 0.35s ease,
      box-shadow 0.35s ease;
  }
  /* WIDTH IS CAPPED THROUGH THE HEIGHT, never with max-width. Give a
     replaced element a fixed height and a max-width and the browser does not
     rebalance: it squashes the picture to the narrower box and keeps the
     height, so a landscape print comes out the same shape as a portrait one.
     Each plate carries its own ratio as --ar, and the height is lowered until
     the width fits - so nothing is ever stretched, and a wide print simply
     stands shorter on the shelf, as it would on a table. */
  .plate--key {
    height: min(clamp(11rem, 30vw, 20.5rem), calc(min(21rem, 40vw) / var(--ar, 1)));
  }
  .plate--small {
    height: min(clamp(6rem, 15vw, 10rem), calc(min(7.5rem, 14vw) / var(--ar, 1)));
  }
  .entry:hover .plate,
  .entry:focus-within .plate {
    transform: translateY(-3px);
    box-shadow:
      0 1px 1px rgb(59 56 51 / 0.16),
      0 20px 30px -20px rgb(59 56 51 / 0.55);
  }
  .plate-empty {
    align-self: center;
    font-style: italic;
    opacity: 0.6;
  }

  .entry-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.3rem 1.5rem;
    margin: 0.75rem 0 0;
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--c-sage);
  }
  .entry-go {
    color: var(--c-caprock);
  }
  .entry-arrow {
    display: inline-block;
    transition: transform 0.3s ease;
  }
  .entry:hover .entry-arrow {
    transform: translateX(0.3rem);
  }

  /* 4. Chronology ------------------------------------------------- */
  .facets {
    display: grid;
    gap: 0.6rem;
    margin: 1.1rem 0 1.25rem;
  }
  .facet-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 0.4rem;
  }
  .facet-label {
    width: 5.5rem;
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c-sage);
  }
  .facet {
    padding: 0.2rem 0.6rem 0.25rem;
    border: 1px solid var(--c-haze);
    background: transparent;
    color: inherit;
    font: inherit;
    font-size: 0.95rem;
    line-height: 1.2;
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease;
  }
  .facet:hover {
    border-color: var(--c-caprock);
  }
  .facet[aria-pressed='true'] {
    background: var(--c-iron);
    border-color: var(--c-iron);
    color: var(--c-canvas);
  }
  .facet:focus-visible,
  .facet-select:focus-visible,
  .decade:focus-visible,
  .panel-close:focus-visible,
  .panel-more:focus-visible {
    outline: 2px solid var(--c-caprock);
    outline-offset: 2px;
  }
  .facet-select {
    min-width: 14rem;
    max-width: 100%;
    padding: 0.25rem 0.5rem;
    border: 1px solid var(--c-haze);
    border-radius: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    font-size: 0.95rem;
  }

  /* The histogram. Everything here is a positioned box or an SVG path. */
  .hist-plot {
    position: relative;
    height: 11rem;
    padding-bottom: 1.5rem;
    cursor: crosshair;
    touch-action: pan-y;
  }
  .rules {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .tick {
    position: absolute;
    top: 0;
    bottom: 1.5rem;
    left: var(--x);
    border-left: 1px solid var(--c-haze);
  }
  .tick b {
    position: absolute;
    bottom: -1.3rem;
    left: 0;
    transform: translateX(-50%);
    font-family: var(--mono);
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--c-sage);
    white-space: nowrap;
  }
  .tick:first-child b {
    transform: none;
  }
  .tick:last-child b {
    transform: translateX(-100%);
  }
  @media (max-width: 40rem) {
    .tick.minor b {
      visibility: hidden;
    }
  }
  .hist-svg {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
    border-bottom: 1px solid var(--c-iron);
  }
  .h-firm {
    fill: var(--c-caprock);
  }
  .h-soft {
    fill: var(--c-caprock);
    fill-opacity: 0.38;
  }
  .h-lit {
    fill: var(--c-caprock);
  }
  /* With a collection or surname chosen, the whole run steps back to a
     ground and the chosen share is drawn over it in full colour. */
  .hist[data-dim] .h-firm,
  .hist[data-dim] .h-soft {
    fill: var(--c-haze);
    fill-opacity: 1;
  }
  .hist-cursor {
    position: absolute;
    top: 0;
    bottom: 1.5rem;
    left: var(--x);
    width: var(--w);
    background: rgb(59 56 51 / 0.1);
    border-left: 1px solid rgb(59 56 51 / 0.45);
    pointer-events: none;
  }
  .hist-readout {
    min-height: 1.4em;
    margin: 0.35rem 0 0;
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--c-iron);
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
    margin-top: 0.6rem;
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c-sage);
  }
  .swatch {
    display: inline-block;
    width: 0.8rem;
    height: 0.8rem;
    margin-right: 0.45rem;
    vertical-align: -1px;
    background: var(--c-caprock);
  }
  .swatch.soft {
    background: rgb(156 91 63 / 0.38);
  }

  /* Decades: the way in. */
  .decades {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 1.1rem;
  }
  .decade {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    min-width: 4.5rem;
    padding: 0.3rem 0.55rem 0.35rem;
    border: 1px solid var(--c-haze);
    background: transparent;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease;
  }
  .decade:hover:not(:disabled) {
    border-color: var(--c-caprock);
  }
  .decade:disabled {
    opacity: 0.4;
    cursor: default;
  }
  .decade[aria-pressed='true'] {
    background: var(--c-iron);
    border-color: var(--c-iron);
    color: var(--c-canvas);
  }
  .decade-y {
    font-size: 1rem;
    line-height: 1.15;
  }
  .decade-n {
    font-family: var(--mono);
    font-size: 0.66rem;
    letter-spacing: 0.04em;
    opacity: 0.75;
  }

  .panel {
    margin-top: 1.25rem;
    padding: 1rem 0 0;
    border-top: 2px solid var(--c-caprock);
  }
  .panel-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.9rem;
  }
  .panel-title {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 500;
  }
  .panel-close {
    padding: 0.15rem 0.45rem;
    border: 1px solid var(--c-haze);
    background: transparent;
    color: inherit;
    font-size: 0.8rem;
    cursor: pointer;
  }
  .panel-close:hover {
    border-color: var(--c-caprock);
  }
  .panel-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(8.5rem, 1fr));
    gap: 1rem 0.9rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .panel-grid :global(.pcard) {
    display: block;
    color: inherit;
    text-decoration: none;
  }
  /* The same fixed sleeve as the inventory: a cabinet card and a wide group
     print read as one size of object, and the grid never jumps as images
     arrive. */
  .panel-grid :global(.pcard-sleeve) {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 4 / 5;
    padding: 0.4rem;
    background: rgb(218 211 196 / 0.4);
    border: 1px solid var(--c-haze);
    transition: border-color 0.2s ease;
  }
  .panel-grid :global(.pcard:hover .pcard-sleeve),
  .panel-grid :global(.pcard:focus-visible .pcard-sleeve) {
    border-color: var(--c-caprock);
  }
  .panel-grid :global(.pcard:focus-visible) {
    outline: 2px solid var(--c-caprock);
    outline-offset: 2px;
  }
  .panel-grid :global(.pcard img) {
    display: block;
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
  }
  .panel-grid :global(.pcard-title) {
    display: block;
    margin-top: 0.4rem;
    font-size: 0.95rem;
    line-height: 1.25;
  }
  .panel-grid :global(.pcard:hover .pcard-title) {
    color: var(--c-caprock);
  }
  .panel-grid :global(.pcard-meta) {
    display: block;
    margin-top: 0.15rem;
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--c-sage);
  }
  .panel-note {
    margin: 0.75rem 0 0;
    font-style: italic;
    opacity: 0.8;
  }
  .panel-more {
    margin-top: 1rem;
    padding: 0.35rem 0.9rem;
    border: 1px solid var(--c-haze);
    background: transparent;
    color: var(--c-iron);
    font: 500 0.7rem/1.2 var(--mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
  }
  .panel-more:hover {
    border-color: var(--c-caprock);
  }

  /* 5. Surnames --------------------------------------------------- */
  .xwalk.is-collapsed .xw-more {
    display: none;
  }
  .xw-toggle {
    margin-top: 0.9rem;
    padding: 0.35rem 0.9rem;
    border: 1px solid var(--c-haze);
    background: transparent;
    color: var(--c-iron);
    font: 500 0.7rem/1.2 var(--mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
  }
  .xw-toggle:hover {
    border-color: var(--c-caprock);
  }
  .xw-toggle:focus-visible {
    outline: 2px solid var(--c-caprock);
    outline-offset: 2px;
  }
  .xwalk-wrap {
    margin-top: 1rem;
    overflow-x: auto;
  }
  .xwalk {
    width: 100%;
    border-collapse: collapse;
    font-variant-numeric: oldstyle-nums tabular-nums;
  }
  .xwalk th,
  .xwalk td {
    padding: 0.45rem 0.7rem 0.45rem 0;
    border-bottom: 1px solid var(--c-haze);
    text-align: left;
    vertical-align: baseline;
  }
  .xwalk thead th {
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--c-iron);
    vertical-align: bottom;
    font-family: var(--mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c-sage);
  }
  .xwalk tbody th {
    font-size: 1.05rem;
    font-weight: 500;
  }
  .xwalk .num {
    text-align: right;
  }
  .xwalk tbody tr:hover {
    background: rgb(218 211 196 / 0.16);
  }
  .tally {
    display: inline-block;
    min-width: 2.5rem;
    padding-bottom: 3px;
    background: linear-gradient(var(--c-caprock), var(--c-caprock)) 100% 100% / calc(var(--v) * 100%) 2px no-repeat;
  }
  .nil {
    color: var(--c-haze);
  }

  @media (prefers-reduced-motion: reduce) {
    .entry,
    .plate,
    .entry-arrow,
    .facet,
    .decade,
    .panel-grid :global(.pcard img) {
      transition: none;
    }
    .entry:hover .plate,
    .entry:focus-within .plate,
    .entry:hover .entry-arrow {
      transform: none;
    }
  }
</style>

<script>
  import { navigate } from 'astro:transitions/client';

  type PersonEntry = { n: string; d: string; h: string; c: number; f: string[] };
  type Result = { kind: string; main: string; see: string; meta: string; href: string };
  type Chron = {
    lo: number;
    n: number;
    peak: number;
    bar: number;
    firm: number[];
    soft: number[];
    cover: number[];
    items: [number, number, number, number, number[]][];
  };

  const norm = (s: string) =>
    s
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, ' ')
      .trim();

  const count = (n: number, one: string, many = `${one}s`) =>
    `${n.toLocaleString('en-US')} ${n === 1 ? one : many}`;

  /* ---------------------------------------------------------------- *
   * PAGEFIND. Loaded on first use, never on page load. The index only
   * exists after `astro build && pagefind --site dist`, so in `astro dev`
   * the import fails and everything that needs it says so plainly.
   * ---------------------------------------------------------------- */
  type PFData = { url: string; meta: Record<string, string | undefined> };
  type PFResult = { id: string; data: () => Promise<PFData> };
  type PFSearch = { results: PFResult[] };
  type Pagefind = {
    options?: (o: Record<string, unknown>) => Promise<void>;
    search: (q: string | null, o?: Record<string, unknown>) => Promise<PFSearch | null>;
  };
  const PAGEFIND_URL = '/pagefind/pagefind.js';
  let pfLoad: Promise<Pagefind | null> | null = null;
  const pagefind = () => {
    if (!pfLoad) {
      pfLoad = import(/* @vite-ignore */ PAGEFIND_URL)
        .then(async (m: Pagefind) => {
          await m.options?.({ baseUrl: '/' });
          return m;
        })
        .catch(() => null);
    }
    return pfLoad;
  };

  // "1890" is one year; "1890s" is ten. Each is matched against the YEAR
  // filter every item page carries for every year its date interval covers,
  // so a photograph dated 1885-1900 is found by 1890 though no year on it
  // reads 1890 - the same rule the inline finder used to apply itself.
  const yearsOf = (w: string) => {
    const from = Number(w.slice(0, 4));
    const n = w.endsWith('s') ? 10 : 1;
    return Array.from({ length: n }, (_, k) => String(from + k));
  };
  const dateFilter = (dates: string[]) =>
    dates.length === 1
      ? { year: { any: yearsOf(dates[0]) } }
      : { all: dates.map((d) => ({ year: { any: yearsOf(d) } })) };

  const el = (tag: string, cls: string, text = '') => {
    const node = document.createElement(tag);
    node.className = cls;
    node.textContent = text;
    return node;
  };

  /* ---------------------------------------------------------------- *
   * 4. Chronology
   * ---------------------------------------------------------------- */
  function initChronology(root: HTMLElement) {
    const hist = root.querySelector<HTMLElement>('[data-hist]');
    const src = document.getElementById('guide-chron');
    if (!hist || !src) return;
    let C: Chron;
    try {
      C = JSON.parse(src.textContent || '{}');
    } catch {
      return;
    }
    if (!C.n) return;

    const plot = hist.querySelector<HTMLElement>('.hist-plot')!;
    const svg = hist.querySelector<SVGSVGElement>('[data-hist-svg]')!;
    const lit = hist.querySelector<SVGPathElement>('[data-h-lit]')!;
    const cursor = hist.querySelector<HTMLElement>('[data-hist-cursor]')!;
    const readout = hist.querySelector<HTMLElement>('[data-hist-readout]')!;
    const status = root.querySelector<HTMLElement>('[data-chron-status]');
    const collBtns = [...root.querySelectorAll<HTMLButtonElement>('[data-facet="c"]')];
    const surSel = root.querySelector<HTMLSelectElement>('[data-surname]');
    const decadeBtns = [...root.querySelectorAll<HTMLButtonElement>('[data-decade]')];
    const panel = root.querySelector<HTMLElement>('[data-panel]')!;
    const pTitle = panel.querySelector<HTMLElement>('[data-panel-title]')!;
    const pGrid = panel.querySelector<HTMLUListElement>('[data-panel-grid]')!;
    const pNote = panel.querySelector<HTMLElement>('[data-panel-note]')!;
    const pMore = panel.querySelector<HTMLButtonElement>('[data-panel-more]')!;
    const pClose = panel.querySelector<HTMLButtonElement>('[data-panel-close]')!;

    // Committed facet state. Collection is an index into COLLECTIONS, surname
    // an index into the surnames list; '' means all.
    let coll = '';
    let sur = '';
    const collBtn = (v: string) => collBtns.find((b) => (b.dataset.value ?? '') === v);
    const surOpt = () => (surSel && sur ? surSel.selectedOptions[0] : null);
    const filterLabel = () =>
      [coll ? collBtn(coll)?.dataset.label : '', sur ? surOpt()?.textContent?.replace(/\s*\(\d+\)$/, '') : '']
        .filter(Boolean)
        .join(', ');

    // The year arrays under the current facets. With none set they are the
    // server's own figures; otherwise they are rebuilt from the compact item
    // list, spread by exactly the same rule.
    let W = C.firm.map((f, k) => f + C.soft[k]);
    let COV = C.cover;
    const rebuild = (c: string, s: string) => {
      if (!c && !s) {
        W = C.firm.map((f, k) => f + C.soft[k]);
        COV = C.cover;
        return false;
      }
      W = new Array(C.n).fill(0);
      COV = new Array(C.n).fill(0);
      for (const [from, to, , ci, sn] of C.items) {
        if (c && ci !== Number(c)) continue;
        if (s && !sn.includes(Number(s))) continue;
        const share = 1 / (to - from + 1);
        for (let y = from; y <= to; y++) {
          W[y - C.lo] += share;
          COV[y - C.lo] += 1;
        }
      }
      return true;
    };
    const r2 = (v: number) => Math.round(v * 100) / 100;
    const draw = (c: string, s: string) => {
      const on = rebuild(c, s);
      hist.toggleAttribute('data-dim', on);
      lit.setAttribute(
        'd',
        on
          ? W.map((v, k) => {
              if (v <= 0) return '';
              const h = (v / C.peak) * 100;
              return `M${k} 100v${r2(-h)}h${C.bar}v${r2(h)}z`;
            }).join('')
          : ''
      );
      decadeBtns.forEach((b) => {
        const k0 = Number(b.dataset.decade) - C.lo;
        let est = 0;
        let could = 0;
        for (let k = k0; k < k0 + 10; k++) est += W[k] ?? 0;
        for (const [from, to, , ci, sn] of C.items) {
          if (c && ci !== Number(c)) continue;
          if (s && !sn.includes(Number(s))) continue;
          if (to >= k0 + C.lo && from <= k0 + C.lo + 9) could++;
        }
        const n = b.querySelector<HTMLElement>('[data-decade-n]');
        if (n) n.textContent = could ? `~${Math.round(est)}` : '\u2013';
        b.disabled = could === 0;
        b.setAttribute(
          'aria-label',
          could
            ? `${b.dataset.decade}s: about ${Math.round(est)} made, ${count(could, 'photograph')} could date from it`
            : `${b.dataset.decade}s: none`
        );
      });
    };

    /* The readout under the pointer --------------------------------- */
    const about = (v: number) => (v <= 0 ? 'none' : v < 1 ? 'under one' : `about ${Math.round(v)}`);
    const yearAt = (clientX: number) => {
      const r = svg.getBoundingClientRect();
      const k = Math.floor(((clientX - r.left) / r.width) * C.n);
      return Math.max(0, Math.min(C.n - 1, k));
    };
    plot.addEventListener('pointermove', (e) => {
      const k = yearAt(e.clientX);
      cursor.style.setProperty('--x', `${(k / C.n) * 100}%`);
      cursor.style.setProperty('--w', `${(1 / C.n) * 100}%`);
      cursor.hidden = false;
      readout.textContent = `${C.lo + k}: ${about(W[k])} made; ${count(COV[k], 'photograph')} could date from it`;
    });
    plot.addEventListener('pointerleave', () => {
      cursor.hidden = true;
      readout.textContent = '\u00a0';
    });
    plot.addEventListener('click', (e) => {
      const y = C.lo + yearAt(e.clientX);
      const d = Math.floor(y / 10) * 10;
      const b = decadeBtns.find((x) => Number(x.dataset.decade) === d);
      if (b && !b.disabled) openDecade(d);
    });

    /* The decade panel, from Pagefind ------------------------------- */
    const PAGE = 24;
    let openAt: number | null = null;
    let found: PFResult[] = [];
    let shown = 0;
    let seq = 0;
    const card = (d: PFData) => {
      const li = document.createElement('li');
      const a = el('a', 'pcard') as HTMLAnchorElement;
      a.href = d.url;
      const sleeve = el('span', 'pcard-sleeve');
      if (d.meta.image) {
        const img = document.createElement('img');
        img.src = d.meta.image;
        img.alt = '';
        img.loading = 'lazy';
        img.decoding = 'async';
        sleeve.append(img);
      }
      a.append(sleeve, el('span', 'pcard-title', d.meta.title ?? ''));
      a.append(el('span', 'pcard-meta', [d.meta.date, coll ? '' : d.meta.collection].filter(Boolean).join(' \u00b7 ')));
      li.append(a);
      return li;
    };
    const more = async (mine: number) => {
      const batch = await Promise.all(found.slice(shown, shown + PAGE).map((r) => r.data()));
      if (mine !== seq) return;
      pGrid.append(...batch.map(card));
      shown += batch.length;
      pMore.hidden = shown >= found.length;
      pMore.textContent = `Show more (${(found.length - shown).toLocaleString('en-US')})`;
    };
    const openDecade = async (from: number) => {
      const mine = ++seq;
      openAt = from;
      decadeBtns.forEach((b) => b.setAttribute('aria-pressed', String(Number(b.dataset.decade) === from)));
      panel.hidden = false;
      pGrid.replaceChildren();
      pNote.hidden = true;
      pMore.hidden = true;
      const label = filterLabel();
      pTitle.textContent = `The ${from}s${label ? ` \u00b7 ${label}` : ''}`;
      const pf = await pagefind();
      if (mine !== seq) return;
      if (!pf) {
        pNote.textContent =
          'The photograph index is made when the site is built, so the decades open on the published site, not in development.';
        pNote.hidden = false;
        return;
      }
      const filters: Record<string, unknown> = { year: { any: yearsOf(`${from}s`) } };
      if (coll) filters.collection = collBtn(coll)?.dataset.slug ?? '';
      if (sur) filters.surname = surOpt()?.dataset.key ?? '';
      const res = await pf.search(null, { filters, sort: { start: 'asc' } });
      if (mine !== seq) return;
      found = res?.results ?? [];
      shown = 0;
      pTitle.textContent = `The ${from}s${label ? ` \u00b7 ${label}` : ''} \u00b7 ${count(found.length, 'photograph')}`;
      if (status) status.textContent = `The ${from}s: ${count(found.length, 'photograph')}.`;
      if (!found.length) {
        pNote.textContent = 'Nothing described from this decade yet.';
        pNote.hidden = false;
        return;
      }
      await more(mine);
    };
    const closePanel = () => {
      seq++;
      const was = decadeBtns.find((b) => Number(b.dataset.decade) === openAt);
      openAt = null;
      panel.hidden = true;
      decadeBtns.forEach((b) => b.setAttribute('aria-pressed', 'false'));
      was?.focus();
    };
    decadeBtns.forEach((b) =>
      b.addEventListener('click', () => {
        const d = Number(b.dataset.decade);
        if (openAt === d) closePanel();
        else openDecade(d);
      })
    );
    pMore.addEventListener('click', () => more(seq));
    pClose.addEventListener('click', closePanel);

    /* Facets ---------------------------------------------------------- */
    const commit = () => {
      draw(coll, sur);
      const label = filterLabel();
      if (status) status.textContent = label ? `Chronology showing ${label}.` : 'Chronology showing every photograph.';
      if (openAt !== null) {
        const b = decadeBtns.find((x) => Number(x.dataset.decade) === openAt);
        if (b && !b.disabled) openDecade(openAt);
        else closePanel();
      }
    };
    collBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        coll = btn.dataset.value ?? '';
        collBtns.forEach((f) => f.setAttribute('aria-pressed', String(f === btn)));
        commit();
      });
      // Hover previews; only a click commits. Mouse only - on touch a
      // preview would stick with no way to leave it.
      btn.addEventListener('pointerenter', (e) => {
        if (e.pointerType === 'mouse') draw(btn.dataset.value ?? '', sur);
      });
      btn.addEventListener('pointerleave', (e) => {
        if (e.pointerType === 'mouse') draw(coll, sur);
      });
    });
    surSel?.addEventListener('change', () => {
      sur = surSel.value;
      commit();
    });

    draw('', '');
  }

  /* ---------------------------------------------------------------- *
   * 2. Finder
   * ---------------------------------------------------------------- */
  function initFinder(root: HTMLElement) {
    const input = root.querySelector<HTMLInputElement>('[data-finder-input]');
    const list = root.querySelector<HTMLUListElement>('[data-finder-list]');
    const status = root.querySelector<HTMLElement>('[data-finder-status]');
    const source = document.getElementById('guide-finder');
    if (!input || !list || !source) return;

    let data: { people: PersonEntry[] };
    try {
      data = JSON.parse(source.textContent || '{}');
    } catch {
      return;
    }
    const people = (data.people ?? []).map((p) => ({ ...p, keys: p.f.map(norm) }));

    // Every query word must begin some word in the target.
    const matches = (hay: string, words: string[]) => {
      const w = hay.split(' ');
      return words.every((q) => w.some((x) => x.startsWith(q)));
    };

    const namesFor = (text: string[]): Result[] => {
      const out: Result[] = [];
      for (const p of people) {
        const hit = p.keys.findIndex((k) => matches(k, text));
        if (hit === -1) continue;
        out.push({
          kind: 'Name',
          main: p.d ? `${p.n}, ${p.d}` : p.n,
          see: hit >= 2 ? `found as ${p.f[hit]}` : '',
          meta: count(p.c, 'photograph'),
          href: p.h,
        });
      }
      return out;
    };

    const MAX = 10;
    let results: Result[] = [];
    let active = -1;
    let seq = 0;
    let timer = 0;

    const close = () => {
      list.hidden = true;
      input.setAttribute('aria-expanded', 'false');
      input.removeAttribute('aria-activedescendant');
      active = -1;
    };
    const go = (href: string) => {
      close();
      navigate(href);
    };
    const highlight = (n: number) => {
      const opts = [...list.querySelectorAll<HTMLElement>('[role="option"]')];
      if (!opts.length) return;
      active = (n + opts.length) % opts.length;
      opts.forEach((o, i) => o.setAttribute('aria-selected', String(i === active)));
      input.setAttribute('aria-activedescendant', opts[active].id);
      opts[active].scrollIntoView({ block: 'nearest' });
    };
    const paint = (rs: Result[], note: string) => {
      results = rs;
      active = -1;
      list.replaceChildren();
      input.removeAttribute('aria-activedescendant');
      rs.forEach((r, n) => {
        const li = el('li', 'opt');
        li.id = `finder-opt-${n}`;
        li.setAttribute('role', 'option');
        li.setAttribute('aria-selected', 'false');
        const left = el('span', '');
        left.append(el('span', 'opt-main', r.main));
        if (r.see) left.append(el('span', 'opt-see', r.see));
        left.append(el('span', 'opt-meta', r.meta));
        li.append(left, el('span', 'opt-kind', r.kind));
        li.addEventListener('mousedown', (e) => e.preventDefault());
        li.addEventListener('click', () => go(r.href));
        list.append(li);
      });
      if (note) list.append(el('li', 'opt-empty', note));
      list.hidden = false;
      input.setAttribute('aria-expanded', 'true');
    };

    const run = async () => {
      const mine = ++seq;
      const q = input.value;
      const words = norm(q).split(' ').filter(Boolean);
      if (!words.length) {
        close();
        if (status) status.textContent = '';
        return;
      }
      const dates = words.filter((w) => /^\d{4}s?$/.test(w));
      const text = words.filter((w) => !dates.includes(w));
      // A date is not a name, so a query with a year in it is photographs only.
      const names = dates.length ? [] : namesFor(text);
      // Names first, at once, while Pagefind is fetched.
      paint(names.slice(0, MAX), 'Searching the photographs\u2026');

      const pf = await pagefind();
      if (mine !== seq) return;
      let photos: Result[] = [];
      let total = 0;
      let note = '';
      if (!pf) {
        note = 'Photograph search opens on the published site.';
      } else {
        const opts: Record<string, unknown> = {};
        if (dates.length) opts.filters = dateFilter(dates);
        if (!text.length) opts.sort = { start: 'asc' };
        const res = await pf.search(text.length ? text.join(' ') : null, opts);
        if (mine !== seq) return;
        const found = res?.results ?? [];
        total = found.length;
        // Share the ten places: names keep at least five if they have them.
        const nNames = Math.min(names.length, Math.max(5, MAX - total));
        const nPhotos = Math.min(total, MAX - nNames);
        const top = await Promise.all(found.slice(0, nPhotos).map((r) => r.data()));
        if (mine !== seq) return;
        photos = top.map((d) => ({
          kind: 'Photograph',
          main: d.meta.title ?? d.url,
          see: '',
          meta: [d.meta.date, d.meta.collection].filter(Boolean).join(' \u00b7 '),
          href: d.url,
        }));
        const shownNames = names.slice(0, nNames);
        if (total > photos.length) note = `${count(total - photos.length, 'more photograph')} \u2014 add a word or a year to narrow it.`;
        const all = [...shownNames, ...photos];
        paint(all, all.length ? note : 'Nothing found under that name, title or date.');
        if (status) {
          status.textContent = all.length
            ? `${count(shownNames.length, 'name')} and ${count(total, 'photograph')}.`
            : 'No matches.';
        }
        return;
      }
      paint(names.slice(0, MAX), names.length ? note : `Nothing found among the names. ${note}`);
      if (status) status.textContent = `${count(names.length, 'name')}.`;
    };

    input.addEventListener('input', () => {
      window.clearTimeout(timer);
      timer = window.setTimeout(run, 120);
    });
    input.addEventListener('focus', () => {
      pagefind(); // start fetching the index before the first keystroke lands
      if (input.value.trim()) run();
    });
    input.addEventListener('blur', close);
    input.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        if (list.hidden) run();
        highlight(active + 1);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        highlight(active - 1);
      } else if (e.key === 'Enter') {
        const pick = results[active >= 0 ? active : 0];
        if (pick) {
          e.preventDefault();
          go(pick.href);
        }
      } else if (e.key === 'Escape') {
        e.preventDefault();
        if (!list.hidden) close();
        else input.value = '';
      }
    });
  }

  /* ---------------------------------------------------------------- *
   * 0. The wall: the line under it names the face you are on
   * ---------------------------------------------------------------- */
  function initWall(root: HTMLElement) {
    const read = root.querySelector<HTMLElement>('[data-wall-read]');
    if (!read) return;
    const rest = read.textContent ?? '';
    const say = (text: string | null) => {
      read.textContent = text ?? rest;
      read.classList.toggle('is-reading', !!text);
    };
    root.querySelectorAll<HTMLElement>('.wall-face').forEach((a) => {
      const text = a.dataset.caption ?? null;
      a.addEventListener('pointerenter', () => say(text));
      a.addEventListener('pointerleave', () => say(null));
      a.addEventListener('focus', () => say(text));
      a.addEventListener('blur', () => say(null));
    });
  }

  /* ---------------------------------------------------------------- *
   * 5. Surnames: fold the table to its first rows until asked. Folded by
   * script, so without it every row shows.
   * ---------------------------------------------------------------- */
  function initCrosswalk(root: HTMLElement) {
    const table = root.querySelector<HTMLElement>('[data-xw]');
    const btn = root.querySelector<HTMLButtonElement>('[data-xw-toggle]');
    if (!table || !btn) return;
    table.classList.add('is-collapsed');
    btn.addEventListener('click', () => {
      const open = table.classList.toggle('is-collapsed') === false;
      btn.setAttribute('aria-expanded', String(open));
      btn.textContent = (open ? btn.dataset.less : btn.dataset.more) ?? btn.textContent;
    });
  }

  function initGuide() {
    const root = document.querySelector<HTMLElement>('[data-guide]');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = '1';
    initWall(root);
    initChronology(root);
    initFinder(root);
    initCrosswalk(root);
  }

  document.addEventListener('astro:page-load', initGuide);
</script>