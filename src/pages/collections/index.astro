  .xwalk-wrap {
    position: relative;
    margin-top: 1rem;
    overflow-x: auto;
  }
  .xwalk {
    width: 100%;
    border-collapse: collapse;
    font-variant-numeric: oldstyle-nums tabular-nums;
  }
  .xwalk th,
  .xwalk td {
    padding: 0.45rem 0.7rem 0.45rem 0;
    border-bottom: 1px solid var(--c-haze);
