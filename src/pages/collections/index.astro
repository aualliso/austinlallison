    }
  }
  .hist-svg {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
    border-bottom: 1px solid var(--c-iron);
  }
  .h-firm {
    fill: var(--c-caprock);
  }
  .h-soft {
    fill: var(--c-caprock);
    fill-opacity: 0.38;
  }
  .h-lit {
    fill: var(--c-caprock);
  }
  /* With a collection or surname chosen, the whole run steps back to a
     ground and the chosen share is drawn over it in full colour. */
  .hist[data-dim] .h-firm,
  .hist[data-dim] .h-soft {
    fill: var(--c-haze);
    fill-opacity: 1;
  }
  .hist-cursor {
    position: absolute;
    top: 0;
    bottom: 1.5rem;
    left: var(--x);
    width: var(--w);
    background: rgb(59 56 51 / 0.1);
    border-left: 1px solid rgb(59 56 51 / 0.45);
    pointer-events: none;
  }
  /* The open decade, held on the chart while its panel is open. */
  .hist-sel {
    position: absolute;
    top: 0;
    bottom: 1.5rem;
    left: var(--x);
    width: var(--w);
    background: rgb(156 91 63 / 0.1);
