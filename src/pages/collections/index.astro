  .panel {
    margin-top: 1.25rem;
    padding: 1rem 0 0;
    border-top: 2px solid var(--c-caprock);
  }
  .panel-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.9rem;
  }
  .panel-title {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 500;
  }
  .panel-close {
    padding: 0.15rem 0.45rem;
    border: 1px solid var(--c-haze);
    background: transparent;
    color: inherit;
    font-size: 0.8rem;
    cursor: pointer;
  }
  .panel-close:hover {
    border-color: var(--c-caprock);
  }
  .panel-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(8.5rem, 1fr));
    gap: 1rem 0.9rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .panel-grid :global(.pcard) {
    display: block;
    color: inherit;
    text-decoration: none;
  }
  /* The same fixed sleeve as the inventory: a cabinet card and a wide group
     print read as one size of object, and the grid never jumps as images
     arrive. */
  .panel-grid :global(.pcard-sleeve) {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 4 / 5;
    padding: 0.4rem;
    background: rgb(218 211 196 / 0.4);
    border: 1px solid var(--c-haze);
    transition: border-color 0.2s ease;
  }
  .panel-grid :global(.pcard:hover .pcard-sleeve),
  .panel-grid :global(.pcard:focus-visible .pcard-sleeve) {
    border-color: var(--c-caprock);
  }
  .panel-grid :global(.pcard:focus-visible) {
    outline: 2px solid var(--c-caprock);
    outline-offset: 2px;
  }
  .panel-grid :global(.pcard img) {
    display: block;
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
  }
  .panel-grid :global(.pcard-title) {
    display: block;
    margin-top: 0.4rem;
    font-size: 0.95rem;
    line-height: 1.25;
  }
  .panel-grid :global(.pcard:hover .pcard-title) {
    color: var(--c-caprock);
  }
  .panel-grid :global(.pcard-meta) {
    display: block;
    margin-top: 0.15rem;
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--c-sage);
  }
  .panel-note {
    margin: 0.75rem 0 0;
    font-style: italic;
    opacity: 0.8;
  }
  .panel-more {
    margin-top: 1rem;
    padding: 0.35rem 0.9rem;
    border: 1px solid var(--c-haze);
    background: transparent;
    color: var(--c-iron);
    font: 500 0.7rem/1.2 var(--mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
  }
  .panel-more:hover {
    border-color: var(--c-caprock);
  }

  /* 5. Surnames --------------------------------------------------- */
  .xwalk.is-collapsed .xw-more {
    display: none;
  }
  .xw-toggle {
    margin-top: 0.9rem;
    padding: 0.35rem 0.9rem;
    border: 1px solid var(--c-haze);
    background: transparent;
    color: var(--c-iron);
    font: 500 0.7rem/1.2 var(--mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
  }
  .xw-toggle:hover {
    border-color: var(--c-caprock);
  }
  .xw-toggle:focus-visible {
    outline: 2px solid var(--c-caprock);
    outline-offset: 2px;
  }
  /* On a wide screen: the note (and the button that opens the rest) at the
     left, the table at the right - the same record-and-object split as the
     holdings above it. */
  @media (min-width: 64rem) {
    .xw-grid {
      display: grid;
      grid-template-columns: clamp(16rem, 27vw, 20rem) minmax(0, 1fr);
      gap: 0 clamp(2.5rem, 5vw, 4.5rem);
