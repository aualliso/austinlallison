  /* Decades: the way in. */
  .decades {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 1.1rem;
  }
  .decade {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    min-width: 4.5rem;
    padding: 0.3rem 0.55rem 0.35rem;
    border: 1px solid var(--c-haze);
