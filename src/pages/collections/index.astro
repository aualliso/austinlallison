  .xwalk thead th {
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--c-iron);
    vertical-align: bottom;
    font-family: var(--mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c-sage);
  }
  .xwalk tbody th {
    font-size: 1.05rem;
    font-weight: 500;
  }
  .xwalk .num {
    text-align: right;
  }
  .xwalk tbody tr:hover {
    background: rgb(218 211 196 / 0.16);
  }
  .tally {
    display: inline-block;
    min-width: 2.5rem;
    padding-bottom: 3px;
    background: linear-gradient(var(--c-caprock), var(--c-caprock)) 100% 100% / calc(var(--v) * 100%) 2px no-repeat;
  }
  .nil {
    color: var(--c-haze);
  }

  @media (prefers-reduced-motion: reduce) {
    .entry,
    .plate,
    .entry-arrow,
    .facet,
    .decade,
    .panel-grid :global(.pcard img) {
      transition: none;
    }
    .entry:hover .plate,
    .entry:focus-within .plate,
    .entry:hover .entry-arrow {
      transform: none;
    }
  }
</style>

<script>
  import { navigate } from 'astro:transitions/client';
  import { lightAt, drawDesk, washFor, castFor } from '../../lib/print-room';
  import type { Box } from '../../lib/print-room';

  type PersonEntry = { n: string; d: string; h: string; c: number; f: string[] };
  type Result = { kind: string; main: string; see: string; meta: string; href: string };
  type Chron = {
    lo: number;
    n: number;
    peak: number;
    bar: number;
    firm: number[];
    soft: number[];
    cover: number[];
    items: [number, number, number, number, number[]][];
  };

  const norm = (s: string) =>
    s
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, ' ')
      .trim();

  const count = (n: number, one: string, many = `${one}s`) =>
    `${n.toLocaleString('en-US')} ${n === 1 ? one : many}`;

  // "photograph" until anything else is described; set by the page.
  let NOUN = 'photograph';

  /* ---------------------------------------------------------------- *
   * PAGEFIND. Loaded on first use, never on page load. The index only
   * exists after `astro build && pagefind --site dist`, so in `astro dev`
   * the import fails and everything that needs it says so plainly.
   * ---------------------------------------------------------------- */
  type PFData = { url: string; meta: Record<string, string | undefined> };
  type PFResult = { id: string; data: () => Promise<PFData> };
  type PFSearch = { results: PFResult[] };
  type Pagefind = {
    options?: (o: Record<string, unknown>) => Promise<void>;
    search: (q: string | null, o?: Record<string, unknown>) => Promise<PFSearch | null>;
  };
  const PAGEFIND_URL = '/pagefind/pagefind.js';
  let pfLoad: Promise<Pagefind | null> | null = null;
  const pagefind = () => {
    if (!pfLoad) {
      pfLoad = import(/* @vite-ignore */ PAGEFIND_URL)
        .then(async (m: Pagefind) => {
          await m.options?.({ baseUrl: '/' });
          return m;
        })
        .catch(() => null);
    }
    return pfLoad;
  };

  // "1890" is one year; "1890s" is ten. Each is matched against the YEAR
  // filter every item page carries for every year its date interval covers,
  // so a photograph dated 1885-1900 is found by 1890 though no year on it
  // reads 1890 - the same rule the inline finder used to apply itself.
  const yearsOf = (w: string) => {
    const from = Number(w.slice(0, 4));
    const n = w.endsWith('s') ? 10 : 1;
    return Array.from({ length: n }, (_, k) => String(from + k));
  };
  const dateFilter = (dates: string[]) =>
    dates.length === 1
      ? { year: { any: yearsOf(dates[0]) } }
      : { all: dates.map((d) => ({ year: { any: yearsOf(d) } })) };

  const el = (tag: string, cls: string, text = '') => {
    const node = document.createElement(tag);
    node.className = cls;
    node.textContent = text;
    return node;
  };

  /* ---------------------------------------------------------------- *
   * 4. Chronology
   * ---------------------------------------------------------------- */
  function initChronology(root: HTMLElement) {
    const hist = root.querySelector<HTMLElement>('[data-hist]');
    const src = document.getElementById('guide-chron');
    if (!hist || !src) return;
    let C: Chron;
    try {
      C = JSON.parse(src.textContent || '{}');
    } catch {
      return;
    }
    if (!C.n) return;

    const plot = hist.querySelector<HTMLElement>('.hist-plot')!;
    const svg = hist.querySelector<SVGSVGElement>('[data-hist-svg]')!;
    const lit = hist.querySelector<SVGPathElement>('[data-h-lit]')!;
    const cursor = hist.querySelector<HTMLElement>('[data-hist-cursor]')!;
    const readout = hist.querySelector<HTMLElement>('[data-hist-readout]')!;
    const sel = hist.querySelector<HTMLElement>('[data-hist-sel]');
    // A decade's span on the chart, as the --x / --w the overlays read.
    const spanStyle = (node: HTMLElement, from: number) => {
      node.style.setProperty('--x', `${((from - C.lo) / C.n) * 100}%`);
      node.style.setProperty('--w', `${(Math.min(10, C.n - (from - C.lo)) / C.n) * 100}%`);
    };
    const status = root.querySelector<HTMLElement>('[data-chron-status]');
    const collBtns = [...root.querySelectorAll<HTMLButtonElement>('[data-facet="c"]')];
    const surSel = root.querySelector<HTMLSelectElement>('[data-surname]');
    const decadeBtns = [...root.querySelectorAll<HTMLButtonElement>('[data-decade]')];
    const panel = root.querySelector<HTMLElement>('[data-panel]')!;
    const pTitle = panel.querySelector<HTMLElement>('[data-panel-title]')!;
    const pGrid = panel.querySelector<HTMLUListElement>('[data-panel-grid]')!;
    const pNote = panel.querySelector<HTMLElement>('[data-panel-note]')!;
    const pMore = panel.querySelector<HTMLButtonElement>('[data-panel-more]')!;
    const pClose = panel.querySelector<HTMLButtonElement>('[data-panel-close]')!;

    // Committed facet state. Collection is an index into COLLECTIONS, surname
    // an index into the surnames list; '' means all.
    let coll = '';
    let sur = '';
    const collBtn = (v: string) => collBtns.find((b) => (b.dataset.value ?? '') === v);
    const surOpt = () => (surSel && sur ? surSel.selectedOptions[0] : null);
    const filterLabel = () =>
      [coll ? collBtn(coll)?.dataset.label : '', sur ? surOpt()?.textContent?.replace(/\s*\(\d+\)$/, '') : '']
        .filter(Boolean)
        .join(', ');

    // The year arrays under the current facets. With none set they are the
    // server's own figures; otherwise they are rebuilt from the compact item
    // list, spread by exactly the same rule.
    let W = C.firm.map((f, k) => f + C.soft[k]);
    let COV = C.cover;
    const rebuild = (c: string, s: string) => {
      if (!c && !s) {
        W = C.firm.map((f, k) => f + C.soft[k]);
        COV = C.cover;
        return false;
      }
      W = new Array(C.n).fill(0);
      COV = new Array(C.n).fill(0);
      for (const [from, to, , ci, sn] of C.items) {
        if (c && ci !== Number(c)) continue;
        if (s && !sn.includes(Number(s))) continue;
        const share = 1 / (to - from + 1);
        for (let y = from; y <= to; y++) {
          W[y - C.lo] += share;
          COV[y - C.lo] += 1;
        }
      }
      return true;
    };
    const r2 = (v: number) => Math.round(v * 100) / 100;
    const draw = (c: string, s: string) => {
      const on = rebuild(c, s);
      hist.toggleAttribute('data-dim', on);
      lit.setAttribute(
        'd',
        on
          ? W.map((v, k) => {
              if (v <= 0) return '';
              const h = (v / C.peak) * 100;
              return `M${k} 100v${r2(-h)}h${C.bar}v${r2(h)}z`;
            }).join('')
          : ''
      );
      decadeBtns.forEach((b) => {
        const k0 = Number(b.dataset.decade) - C.lo;
        let est = 0;
        let could = 0;
        for (let k = k0; k < k0 + 10; k++) est += W[k] ?? 0;
        for (const [from, to, , ci, sn] of C.items) {
          if (c && ci !== Number(c)) continue;
          if (s && !sn.includes(Number(s))) continue;
          if (to >= k0 + C.lo && from <= k0 + C.lo + 9) could++;
        }
        const n = b.querySelector<HTMLElement>('[data-decade-n]');
        if (n) n.textContent = could ? `~${Math.round(est)}` : '\u2013';
        b.disabled = could === 0;
        b.setAttribute(
          'aria-label',
          could
            ? `${b.dataset.decade}s: about ${Math.round(est)} made, ${count(could, NOUN)} could date from it`
            : `${b.dataset.decade}s: none`
        );
      });
    };

    /* The readout under the pointer --------------------------------- */
    const about = (v: number) => (v <= 0 ? 'none' : v < 1 ? 'under one' : `about ${Math.round(v)}`);
    const yearAt = (clientX: number) => {
      const r = svg.getBoundingClientRect();
      const k = Math.floor(((clientX - r.left) / r.width) * C.n);
      return Math.max(0, Math.min(C.n - 1, k));
    };
    plot.addEventListener('pointermove', (e) => {
      const k = yearAt(e.clientX);
      cursor.style.setProperty('--x', `${(k / C.n) * 100}%`);
      cursor.style.setProperty('--w', `${(1 / C.n) * 100}%`);
      cursor.hidden = false;
      readout.textContent = `${C.lo + k}: ${about(W[k])} made; ${count(COV[k], NOUN)} could date from it`;
    });
    plot.addEventListener('pointerleave', () => {
      cursor.hidden = true;
      readout.textContent = '\u00a0';
    });
    plot.addEventListener('click', (e) => {
      const y = C.lo + yearAt(e.clientX);
      const d = Math.floor(y / 10) * 10;
      const b = decadeBtns.find((x) => Number(x.dataset.decade) === d);
      if (b && !b.disabled) openDecade(d);
    });

    /* The decade panel, from Pagefind ------------------------------- */
    const PAGE = 24;
    let openAt: number | null = null;
    let found: PFResult[] = [];
    let shown = 0;
    let seq = 0;
    const card = (d: PFData) => {
      const li = document.createElement('li');
      const a = el('a', 'pcard') as HTMLAnchorElement;
      a.href = d.url;
      const sleeve = el('span', 'pcard-sleeve');
      if (d.meta.image) {
        const img = document.createElement('img');
        img.src = d.meta.image;
        img.alt = '';
        img.loading = 'lazy';
        img.decoding = 'async';
        sleeve.append(img);
      }
      a.append(sleeve, el('span', 'pcard-title', d.meta.title ?? ''));
      a.append(el('span', 'pcard-meta', [d.meta.date, coll ? '' : d.meta.collection].filter(Boolean).join(' \u00b7 ')));
      li.append(a);
      return li;
    };
    const more = async (mine: number) => {
      const batch = await Promise.all(found.slice(shown, shown + PAGE).map((r) => r.data()));
      if (mine !== seq) return;
      pGrid.append(...batch.map(card));
      shown += batch.length;
      pMore.hidden = shown >= found.length;
      pMore.textContent = `Show more (${(found.length - shown).toLocaleString('en-US')})`;
    };
    const openDecade = async (from: number) => {
      const mine = ++seq;
      openAt = from;
      decadeBtns.forEach((b) => b.setAttribute('aria-pressed', String(Number(b.dataset.decade) === from)));
      if (sel) {
        spanStyle(sel, from);
        sel.hidden = false;
      }
      panel.hidden = false;
      pGrid.replaceChildren();
      pNote.hidden = true;
      pMore.hidden = true;
      const label = filterLabel();
      pTitle.textContent = `The ${from}s${label ? ` \u00b7 ${label}` : ''}`;
      const pf = await pagefind();
      if (mine !== seq) return;
      if (!pf) {
        pNote.textContent =
          'The search index is made when the site is built, so the decades open on the published site, not in development.';
        pNote.hidden = false;
        return;
      }
      const filters: Record<string, unknown> = { year: { any: yearsOf(`${from}s`) } };
      if (coll) filters.collection = collBtn(coll)?.dataset.slug ?? '';
      if (sur) filters.surname = surOpt()?.dataset.key ?? '';
      const res = await pf.search(null, { filters, sort: { start: 'asc' } });
      if (mine !== seq) return;
      found = res?.results ?? [];
      shown = 0;
      pTitle.textContent = `The ${from}s${label ? ` \u00b7 ${label}` : ''} \u00b7 ${count(found.length, NOUN)}`;
      if (status) status.textContent = `The ${from}s: ${count(found.length, NOUN)}.`;
      if (!found.length) {
        pNote.textContent = 'Nothing described from this decade yet.';
        pNote.hidden = false;
        return;
      }
      await more(mine);
    };
    const closePanel = () => {
      seq++;
      const was = decadeBtns.find((b) => Number(b.dataset.decade) === openAt);
      openAt = null;
      panel.hidden = true;
      if (sel) sel.hidden = true;
      decadeBtns.forEach((b) => b.setAttribute('aria-pressed', 'false'));
      was?.focus();
    };
    decadeBtns.forEach((b) => {
      b.addEventListener('click', () => {
        const d = Number(b.dataset.decade);
        if (openAt === d) closePanel();
        else openDecade(d);
      });
      // Pointing at a decade lights its span on the chart and reads its
      // figures, the same as pointing at the bars.
      const light = () => {
        if (b.disabled) return;
        spanStyle(cursor, Number(b.dataset.decade));
        cursor.hidden = false;
        readout.textContent = b.getAttribute('aria-label') ?? '\u00a0';
      };
      const unlight = () => {
        cursor.hidden = true;
        readout.textContent = '\u00a0';
      };
      b.addEventListener('pointerenter', (e) => {
        if (e.pointerType === 'mouse') light();
      });
      b.addEventListener('pointerleave', (e) => {
        if (e.pointerType === 'mouse') unlight();
      });
      b.addEventListener('focus', light);
      b.addEventListener('blur', unlight);
    });
    pMore.addEventListener('click', () => more(seq));
    pClose.addEventListener('click', closePanel);

    /* Facets ---------------------------------------------------------- */
    const commit = () => {
      draw(coll, sur);
      const label = filterLabel();
      if (status) status.textContent = label ? `Chronology showing ${label}.` : 'Chronology showing every photograph.';
      if (openAt !== null) {
        const b = decadeBtns.find((x) => Number(x.dataset.decade) === openAt);
        if (b && !b.disabled) openDecade(openAt);
        else closePanel();
      }
    };
    collBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        coll = btn.dataset.value ?? '';
        collBtns.forEach((f) => f.setAttribute('aria-pressed', String(f === btn)));
        commit();
      });
      // Hover previews; only a click commits. Mouse only - on touch a
      // preview would stick with no way to leave it.
      btn.addEventListener('pointerenter', (e) => {
        if (e.pointerType === 'mouse') draw(btn.dataset.value ?? '', sur);
      });
      btn.addEventListener('pointerleave', (e) => {
        if (e.pointerType === 'mouse') draw(coll, sur);
      });
    });
    surSel?.addEventListener('change', () => {
      sur = surSel.value;
      commit();
    });

    draw('', '');
  }

  /* ---------------------------------------------------------------- *
   * 2. Finder
   * ---------------------------------------------------------------- */
  function initFinder(root: HTMLElement) {
    const input = root.querySelector<HTMLInputElement>('[data-finder-input]');
    const list = root.querySelector<HTMLUListElement>('[data-finder-list]');
    const status = root.querySelector<HTMLElement>('[data-finder-status]');
    const source = document.getElementById('guide-finder');
    if (!input || !list || !source) return;

    let data: { people: PersonEntry[] };
    try {
      data = JSON.parse(source.textContent || '{}');
    } catch {
      return;
    }
    const people = (data.people ?? []).map((p) => ({ ...p, keys: p.f.map(norm) }));

    // Every query word must begin some word in the target.
    const matches = (hay: string, words: string[]) => {
      const w = hay.split(' ');
      return words.every((q) => w.some((x) => x.startsWith(q)));
    };

    const namesFor = (text: string[]): Result[] => {
      const out: Result[] = [];
      for (const p of people) {
        const hit = p.keys.findIndex((k) => matches(k, text));
        if (hit === -1) continue;
        out.push({
          kind: 'Name',
          main: p.d ? `${p.n}, ${p.d}` : p.n,
          see: hit >= 2 ? `found as ${p.f[hit]}` : '',
          meta: count(p.c, NOUN),
          href: p.h,
        });
      }
      return out;
    };

    const MAX = 10;
    let results: Result[] = [];
    let active = -1;
    let seq = 0;
    let timer = 0;

    const close = () => {
      list.hidden = true;
      input.setAttribute('aria-expanded', 'false');
      input.removeAttribute('aria-activedescendant');
      active = -1;
    };
    const go = (href: string) => {
      close();
      navigate(href);
    };
    const highlight = (n: number) => {
      const opts = [...list.querySelectorAll<HTMLElement>('[role="option"]')];
      if (!opts.length) return;
      active = (n + opts.length) % opts.length;
      opts.forEach((o, i) => o.setAttribute('aria-selected', String(i === active)));
      input.setAttribute('aria-activedescendant', opts[active].id);
      opts[active].scrollIntoView({ block: 'nearest' });
    };
    const paint = (rs: Result[], note: string) => {
      results = rs;
      active = -1;
      list.replaceChildren();
      input.removeAttribute('aria-activedescendant');
      rs.forEach((r, n) => {
        const li = el('li', 'opt');
        li.id = `finder-opt-${n}`;
        li.setAttribute('role', 'option');
        li.setAttribute('aria-selected', 'false');
        const left = el('span', '');
        left.append(el('span', 'opt-main', r.main));
        if (r.see) left.append(el('span', 'opt-see', r.see));
        left.append(el('span', 'opt-meta', r.meta));
        li.append(left, el('span', 'opt-kind', r.kind));
        li.addEventListener('mousedown', (e) => e.preventDefault());
        li.addEventListener('click', () => go(r.href));
        list.append(li);
      });
      if (note) list.append(el('li', 'opt-empty', note));
      list.hidden = false;
      input.setAttribute('aria-expanded', 'true');
    };

    const run = async () => {
      const mine = ++seq;
      const q = input.value;
      const words = norm(q).split(' ').filter(Boolean);
      if (!words.length) {
        close();
        if (status) status.textContent = '';
        return;
      }
      const dates = words.filter((w) => /^\d{4}s?$/.test(w));
      const text = words.filter((w) => !dates.includes(w));
      // A date is not a name, so a query with a year in it is photographs only.
      const names = dates.length ? [] : namesFor(text);
      // Names first, at once, while Pagefind is fetched.
      paint(names.slice(0, MAX), `Searching the ${NOUN}s\u2026`);

      const pf = await pagefind();
      if (mine !== seq) return;
      let photos: Result[] = [];
      let total = 0;
      let note = '';
      if (!pf) {
        note = `${NOUN[0].toUpperCase()}${NOUN.slice(1)} search opens on the published site.`;
      } else {
        const opts: Record<string, unknown> = {};
        if (dates.length) opts.filters = dateFilter(dates);
        if (!text.length) opts.sort = { start: 'asc' };
        const res = await pf.search(text.length ? text.join(' ') : null, opts);
        if (mine !== seq) return;
        const found = res?.results ?? [];
        total = found.length;
        // Share the ten places: names keep at least five if they have them.
        const nNames = Math.min(names.length, Math.max(5, MAX - total));
        const nPhotos = Math.min(total, MAX - nNames);
        const top = await Promise.all(found.slice(0, nPhotos).map((r) => r.data()));
        if (mine !== seq) return;
        photos = top.map((d) => ({
          kind: NOUN[0].toUpperCase() + NOUN.slice(1),
          main: d.meta.title ?? d.url,
          see: '',
          meta: [d.meta.date, d.meta.collection].filter(Boolean).join(' \u00b7 '),
          href: d.url,
        }));
        const shownNames = names.slice(0, nNames);
        if (total > photos.length) note = `${count(total - photos.length, `more ${NOUN}`)} \u2014 add a word or a year to narrow it.`;
        const all = [...shownNames, ...photos];
        paint(all, all.length ? note : 'Nothing found under that name, title or date.');
        if (status) {
          status.textContent = all.length
            ? `${count(shownNames.length, 'name')} and ${count(total, NOUN)}.`
            : 'No matches.';
        }
        return;
      }
      paint(names.slice(0, MAX), names.length ? note : `Nothing found among the names. ${note}`);
      if (status) status.textContent = `${count(names.length, 'name')}.`;
    };

    input.addEventListener('input', () => {
      window.clearTimeout(timer);
      timer = window.setTimeout(run, 120);
    });
    input.addEventListener('focus', () => {
      pagefind(); // start fetching the index before the first keystroke lands
      if (input.value.trim()) run();
    });
    input.addEventListener('blur', close);
    input.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        if (list.hidden) run();
        highlight(active + 1);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        highlight(active - 1);
      } else if (e.key === 'Enter') {
        const pick = results[active >= 0 ? active : 0];
        if (pick) {
          e.preventDefault();
          go(pick.href);
        }
      } else if (e.key === 'Escape') {
        e.preventDefault();
        if (!list.hidden) close();
        else input.value = '';
      }
    });

    // "/" from anywhere on the page puts the cursor in the finder - unless
    // the visitor is already typing somewhere, or holding a modifier. The
    // listener is on the document, so it is taken off when the page is
    // swapped out.
    const keys = new AbortController();
    document.addEventListener(
      'keydown',
      (e) => {
        if (e.key !== '/' || e.ctrlKey || e.metaKey || e.altKey || e.defaultPrevented) return;
        const t = e.target as HTMLElement | null;
        if (t && (t.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName))) return;
        e.preventDefault();
        input.focus();
        input.scrollIntoView({ block: 'center', behavior: 'smooth' });
      },
      { signal: keys.signal }
    );
    document.addEventListener('astro:before-swap', () => keys.abort(), { once: true });
  }

  /* ---------------------------------------------------------------- *
   * 0. The light: the table, and the strips of desk in the holdings, lit
   * for the sun over Lubbock now
   * ---------------------------------------------------------------- */
  // Drawn once on arrival; again on resize and when the fonts settle
  // (either moves the table); and every five minutes while the page is
  // open. Nothing animates between draws.
  //
  // THE TABLE is the one canvas. Each print is given to the room where it
  // RESTS - its layout box, not its bounding box - so a print still being
  // dealt, or lifted under the pointer, casts from where it lies:
  // `left`/`top` put its CENTRE at a point of the table (the transform
  // carries it back by half its size), and --r is its turn.
  //
  // THE HOLDINGS have no canvas: each strip takes a gradient (--wash, the
  // light on that collection's own mount tint) and each print its shadows
  // (--cast, --cast-up), as custom properties the stylesheet already reads.
  function initRoom(root: HTMLElement) {
    const band = root.querySelector<HTMLElement>('[data-room]');
    const canvas = band?.querySelector<HTMLCanvasElement>('[data-room-canvas]') ?? null;
    const spread = band?.querySelector<HTMLElement>('[data-table]') ?? null;
    const prints = spread ? Array.from(spread.querySelectorAll<HTMLElement>('.spread-print')) : [];
    const shelves = Array.from(root.querySelectorAll<HTMLElement>('[data-shelf]'));
    const hasTable = !!(band && canvas && spread && prints.length);
    if (!hasTable && !shelves.length) return;
    const work = document.createElement('canvas');
    const ac = new AbortController();
    let queued = 0;

    const lightTable = (L: ReturnType<typeof lightAt>, tint: string) => {
      if (!canvas || !spread) return;
      const cr = canvas.getBoundingClientRect();
      const sr = spread.getBoundingClientRect();
      const ox = sr.left - cr.left;
      const oy = sr.top - cr.top;
      const boxes: Box[] = prints.map((el) => {
        const w = el.offsetWidth;
        const h = el.offsetHeight;
        return {
          x: ox + el.offsetLeft - w / 2,
          y: oy + el.offsetTop - h / 2,
          w,
          h,
          rot: parseFloat(el.style.getPropertyValue('--r')) || 0,
        };
      });
      const casts = drawDesk(canvas, { x: ox, y: oy, w: sr.width, h: sr.height }, boxes, tint, L, work);
      casts.forEach((c, i) => {
        prints[i].style.setProperty('--cast', c.rest);
        prints[i].style.setProperty('--cast-up', c.lift);
      });
      if (casts.length) canvas.classList.add('is-lit');
    };

    const lightShelves = (L: ReturnType<typeof lightAt>, tint: string) => {
      // Every measurement first, then every write: one layout for the pass.
      const jobs = shelves.map((shelf) => ({
        shelf,
        tint: getComputedStyle(shelf).getPropertyValue('--m-tint').trim() || tint,
        plates: Array.from(shelf.querySelectorAll<HTMLElement>('.plate')).map((el) => ({ el, h: el.offsetHeight })),
      }));
      for (const job of jobs) {
        job.shelf.style.setProperty('--wash', washFor(L, job.tint));
        for (const { el, h } of job.plates) {
          const c = castFor(L, h);
          el.style.setProperty('--cast', c.rest);
          el.style.setProperty('--cast-up', c.lift);
        }
      }
    };

    const paint = () => {
      queued = 0;
      if (ac.signal.aborted) return;
      const L = lightAt(Date.now());
      const tint = getComputedStyle(root).getPropertyValue('--c-desk').trim();
      // Either may fail without the other: what is not lit stays its flat
      // ground, and nothing else depends on this.
      if (hasTable) {
        try {
          lightTable(L, tint);
        } catch {
          /* the desk stays flat */
        }
      }
      try {
        lightShelves(L, tint);
      } catch {
        /* the strips stay flat */
      }
    };
    const soon = () => {
      if (!queued) queued = requestAnimationFrame(paint);
    };
    const ro = new ResizeObserver(soon);
    if (band) ro.observe(band);
    // The strips are sized from the window's width; a change of height alone
    // (a phone's address bar) moves nothing here.
    let lastW = window.innerWidth;
    window.addEventListener(
      'resize',
      () => {
        if (window.innerWidth === lastW) return;
        lastW = window.innerWidth;
        soon();
      },
      { signal: ac.signal }
    );
    document.fonts?.ready.then(soon);
    const timer = window.setInterval(soon, 5 * 60 * 1000);
    document.addEventListener('astro:before-swap', () => ac.abort(), { once: true });
    ac.signal.addEventListener('abort', () => {
      ro.disconnect();
      window.clearInterval(timer);
      if (queued) cancelAnimationFrame(queued);
    });
    soon();
  }

  /* ---------------------------------------------------------------- *
   * 0. The people: say that the row scrolls, and where you are in it
   * ---------------------------------------------------------------- */
  // Only does anything where the roll is one row wider than its box. It
  // keeps three things on the section for the stylesheet to read:
  //   data-at      none | start | mid | end   (which edge fades show)
  //   data-swiped  set at the first real scroll (the word "Swipe" retires)
  //   .is-seen     set once the row is on screen (the one slide)
  // and writes the count ("1-3 of 16") of the portraits at least half in
  // view. Scroll work is one pass per frame, on a passive listener.
  function initPeople(root: HTMLElement) {
    const sec = root.querySelector<HTMLElement>('[data-people]');
    const row = sec?.querySelector<HTMLElement>('[data-people-row]');
    if (!sec || !row) return;
    const count = sec.querySelector<HTMLElement>('[data-people-count]');
    const cells = Array.from(row.children) as HTMLElement[];
    const ac = new AbortController();
    let queued = 0;
    const update = () => {
      queued = 0;
      if (ac.signal.aborted) return;
      const max = row.scrollWidth - row.clientWidth;
      if (max <= 4) {
        sec.dataset.at = 'none';
        return;
      }
      const x = row.scrollLeft;
      sec.dataset.at = x <= 2 ? 'start' : x >= max - 2 ? 'end' : 'mid';
      if (x > 12) sec.dataset.swiped = '1';
      if (!count) return;
      const box = row.getBoundingClientRect();
      let first = -1;
      let last = -1;
      cells.forEach((c, i) => {
        const r = c.getBoundingClientRect();
        const mid = r.left + r.width / 2;
        if (mid >= box.left && mid <= box.right) {
          if (first < 0) first = i;
          last = i;
        }
      });
      if (first >= 0) {
        count.textContent =
          first === last ? `${first + 1} of ${cells.length}` : `${first + 1}\u2013${last + 1} of ${cells.length}`;
      }
    };
    const soon = () => {
      if (!queued) queued = requestAnimationFrame(update);
    };
    row.addEventListener('scroll', soon, { passive: true, signal: ac.signal });
    const ro = new ResizeObserver(soon);
    ro.observe(row);
    const io = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        sec.classList.add('is-seen');
        io.disconnect();
      },
      { threshold: 0.6 }
    );
    io.observe(row);
    document.addEventListener('astro:before-swap', () => ac.abort(), { once: true });
    ac.signal.addEventListener('abort', () => {
      ro.disconnect();
      io.disconnect();
      if (queued) cancelAnimationFrame(queued);
    });
    soon();
  }

  /* ---------------------------------------------------------------- *
   * 0. The table: the line under it names the print you are on
   * ---------------------------------------------------------------- */
  // A line under a group of links that names the one you are on. Used by
  // the spread of prints (the portraits carry their names in the open).
  function initReadout(root: HTMLElement, lineSel: string, linkSel: string, attr: string) {
    const read = root.querySelector<HTMLElement>(lineSel);
    if (!read) return;
    const rest = read.textContent ?? '';
    const say = (text: string | null) => {
      read.textContent = text ?? rest;
      read.classList.toggle('is-reading', !!text);
    };
    root.querySelectorAll<HTMLElement>(linkSel).forEach((a) => {
      const text = a.getAttribute(attr);
      a.addEventListener('pointerenter', () => say(text));
      a.addEventListener('pointerleave', () => say(null));
      a.addEventListener('focus', () => say(text));
      a.addEventListener('blur', () => say(null));
    });
  }

  /* ---------------------------------------------------------------- *
   * 5. Surnames: fold the table to its first rows until asked. Folded by
   * script, so without it every row shows.
   * ---------------------------------------------------------------- */
  function initCrosswalk(root: HTMLElement) {
    const table = root.querySelector<HTMLElement>('[data-xw]');
    const btn = root.querySelector<HTMLButtonElement>('[data-xw-toggle]');
    if (!table || !btn) return;
    table.classList.add('is-collapsed');
    btn.addEventListener('click', () => {
      const open = table.classList.toggle('is-collapsed') === false;
      btn.setAttribute('aria-expanded', String(open));
      btn.textContent = (open ? btn.dataset.less : btn.dataset.more) ?? btn.textContent;
    });
  }

  function initGuide() {
    const root = document.querySelector<HTMLElement>('[data-guide]');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = '1';
    NOUN = root.dataset.noun || 'photograph';
    initRoom(root);
    initPeople(root);
    initReadout(root, '[data-table-read]', '.spread-print', 'data-label');
    initChronology(root);
    initFinder(root);
    initCrosswalk(root);
  }

  document.addEventListener('astro:page-load', initGuide);
</script>