---
// src/pages/collections/[collection]/[item].astro
//
// THE ITEM RECORD. The plate on the left, the record on the right, and an
// Examine viewer that opens over both.
//
// WHAT THIS PAGE DOES THAT A PHOTO PAGE USUALLY DOES NOT
//   - REGIONS. A person, an inscription or a named detail can carry a box on
//     the image. Point at the name and the face is outlined on the plate;
//     press its number and Examine flies there. Identifications are tied to a
//     place in the picture, not just listed beside it.
//   - SHAREABLE VIEWS. Examine keeps its state in the URL as a W3C Media
//     Fragment (#face=verso&xywh=percent:22,31,14,9), so "is this Bud?" can
//     be sent as a link that opens on the face in question.
//   - ?regions. An authoring mode: drag a box on the plate, or Shift+drag in
//     Examine, and the finished `region: {...}` line is on the clipboard.
//     Nobody should type percentages by eye again.
//   - EXAMINE behaves like a modern photo viewer: it opens instantly on the
//     image the page already holds and sharpens when the detail file is
//     decoded; pinch, wheel and trackpad each do what that device does
//     elsewhere (two-finger scroll pans; Safari's trackpad pinch included);
//     zooms and fly-tos animate and a flung pan glides; a swipe down closes
//     and a swipe across turns to the next view; R rotates (for sideways
//     inscriptions), F goes full screen, and an overview shows where you
//     are once zoomed. Reduced motion lands everything instantly.
//   - Front and back side by side, other photographs of the same people,
//     the date drawn as an interval, a citation, and previous/next.
//   - LAYOUT BY ORIENTATION. Portrait items sit beside the record (7:5, the
//     plate sticky); landscape items take the full width above it. Either
//     way the plate is capped to the window's height (--plate-max-h).
//
// STANDING CONSTRAINTS
//   - No filter, mix-blend-mode, mask-image, clip-path or 3D anywhere. The
//     viewer moves on transform and commits to layout size when it settles;
//     outlines are plain positioned boxes.
//   - The viewer is a native <dialog> opened with showModal(). That gives
//     focus containment, Escape, focus return and the top layer for free, and
//     it retires the "id selector sets display on a [hidden] element" bug
//     this project has hit twice: nothing here styles the dialog's display.
//   - Every listener is registered against an AbortController that aborts on
//     astro:before-swap. ClientRouter keeps `window` and `document` across
//     navigations, so listeners added there on each visit used to pile up.

import RootLayout from '../../../layouts/RootLayout.astro';
import {
  ALL_ITEMS,
  collectionBySlug,
  itemBySlug,
  itemsOf,
  personById,
  personHref,
  appearancesOf,
  spanOf,
  inscriptionFace,
} from '../../../data/collections/index';
import { naturalName, naturalNameWithDates, RIGHTS } from '../../../data/collections/types';
import type { Region } from '../../../data/collections/types';
import { plate } from '../../../data/collections/images';

export function getStaticPaths() {
  return ALL_ITEMS.map((i) => ({
    params: { collection: i.collection, item: i.slug },
    props: { slug: i.slug },
  }));
}

const { slug } = Astro.props as { slug: string };
const item = itemBySlug.get(slug)!;
const c = collectionBySlug.get(item.collection)!;

const EN = '\u2013';
const EM = '\u2014';
const site = Astro.site ?? Astro.url;
const abs = (path: string) => new URL(path, site).href;
const permalink = abs(item.href);

/* ------------------------------------------------------------------ *
 * Faces
 * ------------------------------------------------------------------ */
const faces = await Promise.all(
  item.faces.map(async (f, n) => {
    const img = await plate(item.collection, f.surrogate.file, f.surrogate);
    return {
      ...f,
      n,
      img,
      alt: n === 0 ? (item.description ?? item.title) : `${f.label}: ${item.title}`,
      title: n === 0 ? item.title : `${f.label} ${EM} ${item.title}`,
    };
  })
);

// THE LAYOUT FOLLOWS THE OBJECT. A portrait card sits beside its record, the
// plate held in place while the record scrolls. A landscape print gets the
// full width above the record: in a half-width column a wide group
// photograph was about 300px tall, which is no way to look for a face.
// Decided by the recto, the view the item is represented by. 1.2 keeps
// near-square prints beside the record, where they sat before.
const WIDE_AT = 1.2;
const wide = faces[0].img.width >= faces[0].img.height * WIDE_AT;
// A seven-line record has no description, people, details or inscriptions.
// Then the facts stand alone rather than in the narrow half of a split.
const hasMain = !!item.description || item.depicts.length > 0 || (item.details ?? []).length > 0 || item.inscriptions.length > 0;

// Upper bounds, from the container (max-w-6xl, 72rem) less the page's own
// 4.5rem of side padding and, when split, the 2.5rem gap and the 7:5 split.
// A tall portrait is often held narrower still by the height cap (see
// --plate-max-h), so these can overshoot by a rung on a short laptop screen;
// sizes cannot express that cap without per-image media queries.
const SIZES = wide
  ? '(min-width: 1224px) 1152px, calc(100vw - 4.5rem)'
  : '(min-width: 1224px) 650px, (min-width: 1024px) calc((100vw - 7rem) * 0.58), calc(100vw - 4.5rem)';

/* ------------------------------------------------------------------ *
 * People, and the marks every region becomes
 * ------------------------------------------------------------------ */
const label = (conf: string) => (conf === 'certain' ? '' : conf.charAt(0).toUpperCase() + conf.slice(1));

// Reading order: a list of who is in the picture, not an index.
const nameOf = (d: { person?: string; as?: string }) =>
  d.person ? naturalNameWithDates(personById.get(d.person)!) : (d.as as string);

// A SHARED BASIS IS PRINTED ONCE, not once per person (see the note in the
// People section below).
const bases = [...new Set(item.depicts.map((d) => d.basis))];
const sharedBasis = item.depicts.length > 1 && bases.length === 1 ? bases[0] : null;

type Mark = Region & {
  id: string;
  kind: 'detail' | 'person' | 'inscription';
  face: string;
  tag: string;
  caption: string;
  /** Person marks: the name as a label carries it, with no dates. */
  name: string;
  /** 'Possible' or 'Unidentified' - only doubt is spelled out on a label. */
  qual: string;
  doubtful: boolean;
};
const marks: Mark[] = [];
(item.details ?? []).forEach((d, n) =>
  marks.push({ id: `detail-${n + 1}`, kind: 'detail', face: d.face, x: d.x, y: d.y, w: d.w, h: d.h, tag: `${n + 1}`, caption: d.caption, name: '', qual: '', doubtful: false })
);
let personNo = 0;
const personMark = new Map<number, Mark>();
item.depicts.forEach((d, n) => {
  if (!d.region) return;
  const conf = label(d.confidence);
  const m: Mark = {
    id: `person-${n + 1}`,
    kind: 'person',
    face: d.region.face ?? 'recto',
    x: d.region.x,
    y: d.region.y,
    w: d.region.w,
    h: d.region.h,
    tag: `${++personNo}`,
    caption: `${nameOf(d)}${conf ? ` ${EM} ${conf}` : ''}. ${d.basis.charAt(0).toUpperCase()}${d.basis.slice(1)}`,
    name: d.person ? naturalName(personById.get(d.person)!) : (d.as as string),
    qual: d.confidence === 'certain' || d.confidence === 'probable' ? '' : conf,
    doubtful: !(d.confidence === 'certain' || d.confidence === 'probable'),
  };
  marks.push(m);
  personMark.set(n, m);
});
const inscriptionMark = new Map<number, Mark>();
item.inscriptions.forEach((ins, n) => {
  if (!ins.region) return;
  const m: Mark = {
    id: `inscription-${n + 1}`,
    kind: 'inscription',
    face: inscriptionFace(ins),
    x: ins.region.x,
    y: ins.region.y,
    w: ins.region.w,
    h: ins.region.h,
    tag: '',
    caption: ins.text,
    name: '',
    qual: '',
    doubtful: false,
  };
  marks.push(m);
  inscriptionMark.set(n, m);
});
const faceLabel = new Map(faces.map((f) => [f.key, f.label]));
const box = (m: Region) => `--x:${m.x}%;--y:${m.y}%;--w:${m.w}%;--h:${m.h}%`;

/* ------------------------------------------------------------------ *
 * The date, as words and as an interval
 * ------------------------------------------------------------------ */
const span = spanOf(item);
const approx = item.date.confidence === 'probable' || item.date.confidence === 'possible';
const dateWords = !span
  ? 'Undated'
  : span.openStart
    ? `In or before ${span.to}`
    : span.openEnd
      ? `In or after ${span.from}`
      : span.from === span.to
        ? `${approx ? 'About' : 'In'} ${span.from}`
        : `Between ${span.from} and ${span.to}`;
const OPEN_REACH = 15;
const glyph = span
  ? (() => {
      const from = span.openStart ? span.to - OPEN_REACH : span.from;
      const to = span.openEnd ? span.from + OPEN_REACH : span.to;
      const lo = Math.floor(from / 10) * 10 - 10;
      const hi = Math.ceil((to + 1) / 10) * 10 + 10;
      const P = (y: number) => ((y - lo) / (hi - lo)) * 100;
      const ticks = [];
      for (let y = lo; y <= hi; y += 10) ticks.push({ y, x: P(y) });
      return { lo, hi, x: P(from), w: P(to + 1) - P(from), ticks };
    })()
  : null;

/* ------------------------------------------------------------------ *
 * Citation, contact, neighbours
 * ------------------------------------------------------------------ */
const citeDate = !span
  ? 'n.d.'
  : span.openStart
    ? `before ${span.to}`
    : span.openEnd
      ? `after ${span.from}`
      : span.from === span.to
        ? `${approx ? 'ca. ' : ''}${span.from}`
        : `${span.from}${EN}${span.to}`;
const maker = item.photographer
  ? `${item.photographer.name}${item.photographer.confidence === 'certain' ? '' : ' (attributed)'}`
  : item.studio;
const citeTitle = item.title.replace(/\.$/, '');
const citeRest = [
  citeDate,
  item.format ? item.format.charAt(0).toUpperCase() + item.format.slice(1) : null,
  item.controlNumber ? `Control no. ${item.controlNumber}` : null,
  `${c.title}, collection of Austin Allison`,
].filter(Boolean) as string[];

const mailto =
  'mailto:hello@austinlallison.com' +
  `?subject=${encodeURIComponent(`About ${item.controlNumber ? `${item.controlNumber}: ` : ''}${item.title}`)}` +
  `&body=${encodeURIComponent(`I have something to add about this photograph.\n\n${item.title}\n${permalink}\n\n`)}`;

const siblings = itemsOf(item.collection);
const at = siblings.findIndex((i) => i.slug === item.slug);
const prev = at > 0 ? siblings[at - 1] : null;
const next = at >= 0 && at < siblings.length - 1 ? siblings[at + 1] : null;

/* ------------------------------------------------------------------ *
 * Other photographs of the same people, from any collection
 * ------------------------------------------------------------------ */
const ALSO_MAX = 6;
const alsoIn = (
  await Promise.all(
    [...new Set(item.depicts.map((d) => d.person).filter((p): p is string => !!p))].map(async (pid) => {
      const p = personById.get(pid)!;
      const others = [
        ...new Map(
          appearancesOf(pid)
            .filter((a) => a.item.slug !== item.slug)
            .map((a) => [a.item.slug, a] as const)
        ).values(),
      ];
      const thumbs = await Promise.all(
        others.slice(0, ALSO_MAX).map(async (a) => ({
          a,
          r: await plate(a.item.collection, a.item.recto.file, a.item.recto),
          coll: collectionBySlug.get(a.item.collection)?.title ?? '',
        }))
      );
      return { pid, p, total: others.length, thumbs };
    })
  )
).filter((x) => x.total > 0);

/* ------------------------------------------------------------------ *
 * What the script needs, and what machines read
 * ------------------------------------------------------------------ */
const json = (v: unknown) => JSON.stringify(v).replace(/</g, '\\u003c');
const pageData = json({
  note: item.description ?? '',
  prev: prev?.href ?? null,
  next: next?.href ?? null,
  faces: faces.map((f) => ({
    key: f.key,
    label: f.label,
    title: f.title,
    alt: f.alt,
    view: f.img.view,
    big: f.img.detail,
    study: f.img.study,
    studyW: f.img.studyWidth,
    w: f.img.width,
    h: f.img.height,
  })),
  marks: marks.map(({ id, kind, face, x, y, w, h, caption }) => ({ id, kind, face, x, y, w, h, caption })),
});

const rights = RIGHTS[item.rights.status];
const reliable = (conf: string) => conf === 'certain' || conf === 'probable';
const structured = json({
  '@context': 'https://schema.org',
  '@type': 'Photograph',
  '@id': permalink,
  url: permalink,
  name: item.title,
  ...(item.description ? { description: item.description } : {}),
  image: abs(faces[0].img.view),
  ...(item.controlNumber ? { identifier: item.controlNumber } : {}),
  ...(span
    ? {
        temporalCoverage: span.openStart
          ? `../${span.to}`
          : span.openEnd
            ? `${span.from}/..`
            : span.from === span.to
              ? `${span.from}`
              : `${span.from}/${span.to}`,
      }
    : {}),
  ...(item.place ? { contentLocation: { '@type': 'Place', name: item.place } } : {}),
  ...(maker ? { creator: { '@type': item.photographer ? 'Person' : 'Organization', name: maker } } : {}),
  about: item.depicts
    .filter((d) => d.person && reliable(d.confidence))
    .map((d) => ({
      '@type': 'Person',
      name: naturalName(personById.get(d.person!)!),
      url: abs(personHref(d.person!)),
    })),
  isPartOf: {
    '@type': ['Collection', 'ArchiveComponent'],
    name: c.title,
    url: abs(`/collections/${c.slug}`),
  },
  license: rights.uri,
});

/* ------------------------------------------------------------------ *
 * Search: the filters and extra text Pagefind indexes from this page
 * ------------------------------------------------------------------ */
// Every year the date interval covers, so a search for 1890 finds a
// photograph dated 1885-1900. Open ends reach 15 years, the same reach the
// guide's chronology spreads them over.
const PF_REACH = 15;
const pfYears = span
  ? (() => {
      const from = span.openStart ? span.to - PF_REACH : span.from;
      const to = span.openEnd ? span.from + PF_REACH : span.to;
      return Array.from({ length: Math.max(0, to - from + 1) }, (_, k) => from + k);
    })()
  : [];
// Surname keys as the guide builds them: trimmed, lower case.
const pfSurnames = [
  ...new Set(
    item.depicts.flatMap((d) => (d.person ? [personById.get(d.person)!.surname.trim().toLowerCase()] : [])).filter(Boolean)
  ),
];
const pfVariants = [
  ...new Set(item.depicts.flatMap((d) => (d.person ? personById.get(d.person)!.variants ?? [] : []))),
];

const H2 = 'sec-h';
const DT = 'font-mono text-[0.7rem] uppercase tracking-[0.12em] text-sage sm:w-36 sm:shrink-0 sm:pt-1';
const ROW = 'flex flex-col sm:flex-row sm:gap-4 border-b border-haze py-2';
const LINK = 'text-caprock hover:underline';
const QUAL = 'font-mono text-[0.7rem] uppercase tracking-[0.12em] text-caprock';
const MONO = 'font-mono text-[0.7rem] uppercase tracking-[0.12em] text-sage';
---

<RootLayout
  title={`${item.title} | ${c.title} | Austin Allison`}
  description={item.description ?? `${item.format ?? 'Photograph'} in ${c.title}.`}
  image={faces[0].img.view}
  prose={false}
>
  <script type="application/ld+json" is:inline set:html={structured} />
  <script type="application/json" id="item-data" is:inline set:html={pageData} />
  <noscript>
    <style is:inline>
      .stack { display: block !important; }
      .face { visibility: visible !important; opacity: 1 !important; margin-bottom: 1.25rem; }
      [data-js-only] { display: none !important; }
    </style>
  </noscript>

  <div class="item-page max-w-6xl mx-auto py-6 text-iron font-serif" data-item-page data-pagefind-body>
    {/* THE CATALOGUE SHEET. Screen readers and browsers ignore these; they
        appear only on paper, where a printed record needs to say where it
        came from and how to get back to it. */}
    <div class="sheet-head" aria-hidden="true" data-pagefind-ignore>
      <div class="sheet-rule">
        <span>{c.title}</span>
        <span>Collection of Austin Allison</span>
      </div>
      <div class="sheet-title">
        <h2>{item.title}</h2>
        {item.controlNumber && <span class="sheet-no">{item.controlNumber}</span>}
      </div>
    </div>
    <!-- Where you are, and where the neighbours are -->
    <div class="topline" data-pagefind-ignore>
      <nav class={`${MONO} min-w-0`} aria-label="Breadcrumb">
        <a href="/collections" class={LINK}>Collections</a>
        <span class="opacity-50 mx-1.5" aria-hidden="true">/</span>
        <a href={`/collections/${c.slug}`} class={LINK}>{c.title}</a>
      </nav>
      {siblings.length > 1 && (
        <nav class={`pager ${MONO}`} aria-label="In this collection">
          {prev ? (
            <a href={prev.href} class={LINK} rel="prev" data-astro-prefetch="viewport" title={prev.title}>
              <span aria-hidden="true">&larr;</span> Previous
            </a>
          ) : (
            <span class="opacity-40"><span aria-hidden="true">&larr;</span> Previous</span>
          )}
          <span class="pager-count">{at + 1} of {siblings.length}</span>
          {next ? (
            <a href={next.href} class={LINK} rel="next" data-astro-prefetch="viewport" title={next.title}>
              Next <span aria-hidden="true">&rarr;</span>
            </a>
          ) : (
            <span class="opacity-40">Next <span aria-hidden="true">&rarr;</span></span>
          )}
        </nav>
      )}
    </div>

    {/* The title leads, above both columns. Below the photograph on a phone,
        or under a full-width landscape print, it arrived after the thing it
        names. */}
    <h1 class="text-3xl font-medium tracking-tight leading-tight mb-6 title">{item.title}</h1>

    {/* WHAT PAGEFIND READS, and nothing else sees. Pagefind builds the site's
        photograph search from these pages after `astro build`: the h1 is the
        result's title, the text of the record is what is searched, and this
        block carries the rest. Ignored for indexing, but its metadata,
        filters and sort key still count. See collections/index.astro. */}
    <div hidden data-pagefind-ignore>
      <span data-pagefind-meta={`image:${faces[0].img.index}`}></span>
      <span data-pagefind-meta={`date:${item.date.display}`}></span>
      <span data-pagefind-meta={`collection:${c.title}`}></span>
      <span data-pagefind-filter={`collection:${c.slug}`}></span>
      {pfSurnames.map((k) => <span data-pagefind-filter={`surname:${k}`}></span>)}
      {pfYears.map((y) => <span data-pagefind-filter={`year:${y}`}></span>)}
      {pfYears.length > 0 && <span data-pagefind-sort={`start:${pfYears[0]}`}></span>}
    </div>
    {/* See-from forms, so a search for "Bud" finds the photographs of M. B.
        Thomas. In the text Pagefind indexes, invisible to everyone else. */}
    {pfVariants.length > 0 && <span class="sr-only" aria-hidden="true">{pfVariants.join('; ')}</span>}

    <div class:list={['layout', wide ? 'layout--wide' : 'layout--split']}>
      <!-- THE PLATE -->
      <div class="plate-col">
        <div class="mat" data-mat>
          <div class="stack">
            {faces.map((f) => {
              const attrs = {
                src: f.img.view,
                srcset: f.img.viewSrcset,
                sizes: f.n === 0 ? SIZES : `auto, ${SIZES}`,
                width: f.img.width,
                height: f.img.height,
                alt: f.alt,
                loading: (f.n === 0 ? 'eager' : 'lazy') as 'eager' | 'lazy',
                decoding: 'async' as const,
                fetchpriority: (f.n === 0 ? 'high' : 'auto') as 'high' | 'auto',
                draggable: 'false' as const,
              };
              return (
                <figure class:list={['face', { 'is-on': f.n === 0 }]} data-face={f.key}>
                  <figcaption class="face-cap" aria-hidden="true">{f.label}</figcaption>
                  <div class="face-box" data-face-box={f.key} style={`--ar:${(f.img.width / f.img.height).toFixed(4)}`}>
                    {f.n === 0 ? <img {...attrs} transition:name={`plate-${item.slug}`} /> : <img {...attrs} />}
                    {marks
                      .filter((m) => m.face === f.key)
                      .map((m) => (
                        <span class:list={['region-box', `region-box--${m.kind}`, { 'is-doubtful': m.doubtful }]} data-mark={m.id} style={box(m)} aria-hidden="true">
                          {m.tag && (
                            <b class="region-tag">
                              <span class="tag-n">{m.tag}</span>
                              {m.doubtful && <span class="tag-qmark">?</span>}
                              {m.name && <span class="tag-name">{m.name}</span>}
                              {m.qual && <span class="tag-q">{m.qual}</span>}
                            </b>
                          )}
                        </span>
                      ))}
                  </div>
                </figure>
              );
            })}
          </div>
        </div>

        {/* One row of controls under the plate. Examine used to float at the
            mat's corner, which is the column's corner - once the height cap
            holds a portrait narrower than its column, that left the button
            stranded in empty space beside the print. */}
        <div class="plate-tools" data-js-only data-pagefind-ignore>
          <button type="button" class="examine-btn" data-examine>
            <svg viewBox="0 0 20 20" aria-hidden="true">
              <circle cx="8.5" cy="8.5" r="5.5" fill="none" stroke="currentColor" stroke-width="1.5" />
              <path d="M12.6 12.6 17 17M8.5 6v5M6 8.5h5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
            </svg>
            Examine
          </button>
          {faces.length > 1 && (
            <div class="seg" role="group" aria-label="View">
              {faces.map((f) => (
                <button type="button" class="seg-btn" data-face-btn={f.key} aria-pressed={f.n === 0 ? 'true' : 'false'}>
                  {f.label}
                </button>
              ))}
            </div>
          )}
          {personMark.size > 0 && (
            <button type="button" class="seg-btn seg-solo" data-names aria-pressed="false">
              Names on the photograph
            </button>
          )}
        </div>
      </div>

      <!-- THE RECORD -->
      <div class:list={['record', { 'record--solo': !hasMain }]}>
        {/* READING ORDER. Who is in the photograph is why almost anyone
            arrives, so the description, the people, the details and the
            inscriptions come first; the catalogue facts, the date and its
            evidence, and the apparatus follow. Two groups, so a landscape
            item can set them side by side under its full-width plate. */}
        {hasMain && (
        <div class="record-main">
          {item.description && (
            <section class="mb-7" aria-labelledby="desc-h">
              <h2 id="desc-h" class={H2}>Description</h2>
              <p class="m-0 prose-line">{item.description}</p>
            </section>
          )}

          {item.depicts.length > 0 && (
            <section class="mb-7" aria-labelledby="people-h">
              <h2 id="people-h" class={H2}>People</h2>

              {/* A shared basis is printed once. item.identificationBasis
                  inherits to every depiction that sets none, which is right in
                  the data and unreadable on the page - fourteen names off one
                  verso would be the same sentence fourteen times. */}
              {sharedBasis && (
                <p class="text-sm opacity-75 m-0 mb-2.5">
                  <span class={QUAL}>All identifications</span> &mdash; {sharedBasis}
                </p>
              )}

              <ul class="list-none p-0 m-0">
                {item.depicts.map((d, n) => {
                  const m = personMark.get(n);
                  return (
                    <li class="person" data-hover-mark={m?.id}>
                      <div class="person-line">
                        {m && (
                          <button
                            type="button"
                            class="pin"
                            data-locate={m.id}
                            aria-label={`Show ${nameOf(d)} on the photograph`}
                          >{m.tag}</button>
                        )}
                        {d.person ? (
                          <a href={personHref(d.person)} class={LINK}>{nameOf(d)}</a>
                        ) : (
                          <span class="italic opacity-60">{nameOf(d)}</span>
                        )}
                        {/* The qualifier reads as part of the name, not as a
                            line of its own: a column of PROBABLE under every
                            name turned a list of people into a data dump. */}
                        {label(d.confidence) && <span class={QUAL}>{label(d.confidence)}</span>}
                        {d.position && <span class={MONO}>{d.position}</span>}
                      </div>
                      {d.basis !== sharedBasis && (
                        <div class="text-sm opacity-75 mt-0.5">{d.basis}</div>
                      )}
                    </li>
                  );
                })}
              </ul>
            </section>
          )}

          {(item.details ?? []).length > 0 && (
            <section class="mb-7" aria-labelledby="details-h">
              {/* A heading now: the list sits in the record, after the h1. In
                  the plate column it made the sticky column taller than a
                  laptop screen, so its last entries could not be reached. */}
              <h2 id="details-h" class={H2}>Details</h2>
              <ol class="locs" aria-labelledby="details-h">
                {(item.details ?? []).map((d, n) => (
                  <li data-hover-mark={`detail-${n + 1}`}>
                    <button type="button" class="loc" data-locate={`detail-${n + 1}`}>
                      <span class="loc-n">{n + 1}</span>
                      <span class="loc-cap">{d.caption}</span>
                      {faces.length > 1 && <span class="loc-face">{faceLabel.get(d.face)}</span>}
                    </button>
                  </li>
                ))}
              </ol>
            </section>
          )}

          {item.inscriptions.length > 0 && (
            <section class="mb-7" aria-labelledby="ins-h">
              <h2 id="ins-h" class={H2}>Inscriptions</h2>
              <ul class="list-none p-0 m-0">
                {item.inscriptions.map((ins, n) => {
                  const m = inscriptionMark.get(n);
                  return (
                    <li class="inscription" data-hover-mark={m?.id}>
                      <div class="ins-head">
                        <span class={MONO}>{ins.location} &middot; {ins.medium}</span>
                        {m && (
                          <button type="button" class="ins-show" data-locate={m.id}>
                            Read against the {(faceLabel.get(m.face) ?? m.face).toLowerCase()}
                          </button>
                        )}
                      </div>
                      <blockquote class="ins-text">{ins.text}</blockquote>
                      {ins.hand && <div class="text-sm opacity-75 mt-1.5">Hand: {ins.hand}</div>}
                      {ins.note && <div class="text-sm opacity-75 mt-1.5">{ins.note}</div>}
                      {ins.datesSubjectNotObject && (
                        <div class="text-sm opacity-75 mt-1">
                          <span class={QUAL}>Note</span> &mdash; this dates the subject, not the photograph.
                        </div>
                      )}
                    </li>
                  );
                })}
              </ul>
            </section>
          )}
        </div>
        )}

        <div class="record-side">
          <dl class="border-t border-haze mb-7">
            {item.controlNumber && (
              <div class={ROW}>
                <dt class={DT}>Control number</dt>
                <dd class="m-0 min-w-0 flex-1 font-mono text-sm">{item.controlNumber}</dd>
              </div>
            )}
            {item.format && (
              <div class={ROW}>
                <dt class={DT}>Format</dt>
                <dd class="m-0 min-w-0 flex-1">{item.format}</dd>
              </div>
            )}
            {item.dimensions && (
              <div class={ROW}>
                <dt class={DT}>Dimensions</dt>
                <dd class="m-0 min-w-0 flex-1">{item.dimensions}</dd>
              </div>
            )}
            {maker && (
              <div class={ROW}>
                <dt class={DT}>{item.photographer ? 'Photographer' : 'Studio'}</dt>
                <dd class="m-0 min-w-0 flex-1">{maker}</dd>
              </div>
            )}
            {item.place && (
              <div class={ROW}>
                <dt class={DT}>Place</dt>
                <dd class="m-0 min-w-0 flex-1">{item.place}</dd>
              </div>
            )}
            <div class={ROW}>
              <dt class={DT}>Date</dt>
              <dd class="m-0 min-w-0 flex-1">
                <span class="date-words">{dateWords}</span>
                {span && label(item.date.confidence) && <span class={`${QUAL} ml-2`}>{label(item.date.confidence)}</span>}
                <span class="date-display font-mono">{item.date.display}</span>
                {glyph && span && (
                  <span class="glyph" aria-hidden="true">
                    <span class="glyph-track">
                      {glyph.ticks.map((t) => <i class="glyph-tick" style={`--x:${t.x}%`}></i>)}
                      <i
                        class:list={['glyph-bar', { soft: item.date.confidence === 'possible', 'open-start': span.openStart, 'open-end': span.openEnd }]}
                        style={`--x:${glyph.x}%;--w:${glyph.w}%`}
                      ></i>
                    </span>
                    <span class="glyph-ends font-mono"><span>{glyph.lo}</span><span>{glyph.hi}</span></span>
                  </span>
                )}
                {/* The grounds sit under the date they support, open rather
                    than behind a disclosure: a claim with its grounds hidden is
                    the thing this collection is built not to do, and a closed
                    <details> would also drop them from the printed sheet. */}
                {item.date.basis.length > 0 && (
                  <div class="evidence">
                    <p class={`${MONO} evidence-h`}>Evidence</p>
                    <ul class="list-none p-0 m-0">
                      {item.date.basis.map((b) => (
                        <li class="basis-line">{b}</li>
                      ))}
                    </ul>
                  </div>
                )}
              </dd>
            </div>
            <div class={ROW}>
              <dt class={DT}>Collection</dt>
              <dd class="m-0 min-w-0 flex-1"><a href={`/collections/${c.slug}`} class={LINK}>{c.title}</a></dd>
            </div>
          </dl>


          {item.related && item.related.length > 0 && (
            <section class="mb-7" aria-labelledby="related-h" data-pagefind-ignore>
              <h2 id="related-h" class={H2}>Related</h2>
              <ul class="list-none p-0 m-0">
                {item.related.map((r) => {
                  const other = itemBySlug.get(r.slug)!;
                  return (
                    <li class="border-t border-haze first:border-t-0 py-2.5 first:pt-0">
                      <a href={other.href} class={LINK}>{other.title}</a>
                      <div class="text-sm opacity-75 mt-0.5">{r.relation}</div>
                    </li>
                  );
                })}
              </ul>
            </section>
          )}

          {alsoIn.length > 0 && (
            <section class="mb-7" aria-labelledby="also-h" data-pagefind-ignore>
              <h2 id="also-h" class={H2}>Also in the collections</h2>
              {alsoIn.map(({ pid, p, total, thumbs }) => (
                <div class="also">
                  <p class="also-name">
                    <a href={personHref(pid)} class={LINK}>{naturalName(p)}</a>
                    <span class={`${MONO} ml-2`}>{total} more</span>
                  </p>
                  <ul class="also-row">
                    {thumbs.map(({ a, r, coll }) => (
                      <li>
                        <a href={a.item.href} class="also-thumb" title={`${a.item.title} (${coll})`}>
                          <img
                            src={r.index}
                            srcset={r.indexSrcset}
                            width={r.width}
                            height={r.height}
                            alt={a.item.title}
                            loading="lazy"
                            decoding="async"
                          />
                        </a>
                        <span class="also-date font-mono">{a.item.date.display}</span>
                      </li>
                    ))}
                  </ul>
                  {total > thumbs.length && (
                    <a href={personHref(pid)} class={`${LINK} text-sm`}>All photographs of {naturalName(p)}</a>
                  )}
                </div>
              ))}
            </section>
          )}

          {item.provenance && (
            <section class="mb-7" aria-labelledby="prov-h">
              <h2 id="prov-h" class={H2}>Provenance</h2>
              <p class="m-0">{item.provenance}</p>
            </section>
          )}

          <section class="mb-7" aria-labelledby="rights-h" data-pagefind-ignore>
            <h2 id="rights-h" class={H2}>Rights</h2>
            <p class="m-0">
              {rights.label}
              {item.rights.note && <span> {item.rights.note}</span>}
            </p>
            <p class="m-0 mt-1 text-sm">
              <a href={rights.uri} class={LINK} rel="license">{rights.statement}</a>
            </p>
          </section>

          <section class="mb-7" aria-labelledby="cite-h" data-pagefind-ignore>
            <h2 id="cite-h" class={H2}>Cite this photograph</h2>
            <p class="cite" data-cite>
              {maker && <>{maker}. </>}{item.titleSource === 'inscribed' ? <i>{citeTitle}</i> : citeTitle}. {citeRest.join('. ')}. {permalink}<span data-accessed></span>.
            </p>
            <div class="cite-tools" data-js-only>
              <button type="button" class="seg-btn" data-copy="cite">Copy citation</button>
              <button type="button" class="seg-btn" data-copy="link">Copy link</button>
              <span class={`${MONO} copy-note`} role="status" data-copy-note></span>
            </div>
          </section>

          <p class="mt-8 pt-3 border-t border-haze text-[0.92rem] opacity-70" data-pagefind-ignore>
            Can you add anything to this record? <a href={mailto} class={LINK}>Write to me</a>.
          </p>

          <p class={`${MONO} mt-4 record-json`} data-pagefind-ignore>
            <a href={`${item.href}/record.json`} class={LINK}>This record as JSON</a>
          </p>
        </div>

      </div>
    </div>

    <div class="sheet-foot" aria-hidden="true" data-pagefind-ignore>
      <span>{item.controlNumber ? `${item.controlNumber} \u00b7 ` : ''}{item.title}</span>
      <span>{permalink}</span>
    </div>
  </div>

  <!-- EXAMINE -->
  <dialog id="examine" class="ex" aria-label="Examine the photograph">
    <div class="ex-stage" id="ex-stage" tabindex="-1">
      <div class="ex-frame" id="ex-frame">
        <img id="ex-img" alt="" draggable="false" />
        <div class="ex-marks">
          {marks.map((m) => (
            <span class:list={['ex-region', `region-box--${m.kind}`, { 'is-doubtful': m.doubtful }]} data-ex-mark={m.id} data-face={m.face} style={box(m)} aria-hidden="true">
              {m.tag && (
                <b class="region-tag">
                  <span class="tag-n">{m.tag}</span>
                  {m.doubtful && <span class="tag-qmark">?</span>}
                  {m.name && <span class="tag-name">{m.name}</span>}
                  {m.qual && <span class="tag-q">{m.qual}</span>}
                </b>
              )}
            </span>
          ))}
        </div>
      </div>
    </div>

    {faces.length > 1 && (
      <aside class="ex-aside" aria-label="The other view">
        <p class="ex-aside-label" id="ex-aside-label"></p>
        <button type="button" class="ex-aside-btn" data-ex="swap" aria-label="Switch to this view">
          <img id="ex-aside-img" alt="" draggable="false" />
        </button>
      </aside>
    )}

    <div class="ex-top" id="ex-top">
      <p class="ex-title" id="ex-title"></p>
      <div class="ex-ctl">
        {faces.length > 1 && (
          <span class="ex-group">
            {faces.map((f) => (
              <button type="button" data-ex-face={f.key} aria-pressed="false">{f.label}</button>
            ))}
          </span>
        )}
        {faces.length > 1 && (
          <button type="button" data-ex="compare" aria-pressed="false">Side by side</button>
        )}
        <span class="ex-group ex-zoom">
          <button type="button" data-ex="out" aria-label="Zoom out">&minus;</button>
          <span id="ex-pct" class="ex-pct">100%</span>
          <button type="button" data-ex="in" aria-label="Zoom in">+</button>
        </span>
        <button type="button" data-ex="fit">Fit</button>
        <button type="button" data-ex="rotate" aria-label="Rotate a quarter turn" title="Rotate (R)">
          <svg viewBox="0 0 20 20" aria-hidden="true" class="ex-ico">
            <path d="M15.5 10a5.5 5.5 0 1 1-1.9-4.15" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
            <path d="M14.4 2.6v3.6h-3.6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
        {personMark.size > 0 && (
          <button type="button" data-ex="names" aria-pressed="false">Names</button>
        )}
        <button type="button" data-ex="link">Copy link</button>
        <button type="button" data-ex="info" aria-expanded="false" aria-controls="ex-note">Note</button>
        <button type="button" data-ex="full" aria-pressed="false" aria-label="Full screen" title="Full screen (F)" hidden>
          <svg viewBox="0 0 20 20" aria-hidden="true" class="ex-ico">
            <path d="M3.5 7.5v-4h4M12.5 3.5h4v4M16.5 12.5v4h-4M7.5 16.5h-4v-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
        <button type="button" data-ex="close" aria-label="Close">&#10005;</button>
      </div>
    </div>

    <div id="ex-note" class="ex-note" hidden><p id="ex-cap"></p></div>

    {/* The overview: where on the print the zoomed view is. Outside the
        stage, so pressing it never starts a pan. */}
    <div id="ex-map" class="ex-map" hidden aria-hidden="true">
      <div id="ex-map-inner" class="ex-map-inner">
        <img id="ex-map-img" alt="" draggable="false" />
        <span id="ex-map-view" class="ex-map-view"></span>
      </div>
    </div>

    <p class="ex-load" aria-hidden="true">Loading detail</p>
    <p class="ex-toast" id="ex-toast" role="status"></p>
    <p id="ex-sr" class="sr-only" role="status"></p>
  </dialog>
</RootLayout>

<style>
  .item-page {
    --c-caprock: var(--color-caprock, #9c5b3f);
    --c-sage: var(--color-sage, #7a8471);
    --c-haze: var(--color-haze, #dad3c4);
    --c-dust: var(--color-dust, #ede7da);
    --c-iron: var(--color-iron, #3b3833);
    --c-canvas: var(--color-canvas, #f7f4ec);
    /* THE PLATE NEVER OUTGROWS THE WINDOW. The whole photograph, plus the
       tool row under it, fits on screen - which also keeps the sticky plate
       from hiding its own bottom edge. 6rem = sticky offset + tool row +
       breathing room. svh, not dvh: dvh changes as a phone's URL bar slides,
       and that would resize the plate while you scroll. 18rem is a floor for
       very short windows. */
    --plate-max-h: max(18rem, calc(100vh - var(--header-h, 4.5rem) - 6rem));
    --plate-max-h: max(18rem, calc(100svh - var(--header-h, 4.5rem) - 6rem));
  }

  /* Top line ------------------------------------------------------ */
  .topline {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    margin-bottom: 1rem;
  }
  .pager {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    white-space: nowrap;
  }
  .pager-count {
    opacity: 0.8;
  }

  .layout {
    display: grid;
    gap: 2.5rem;
    align-items: start;
  }
  /* Split (portrait): 7:5 in the plate's favour - the photograph is the
     subject, the record is about it. Wide (landscape): the plate takes the
     full width, and the record below splits into reading and facts. */
  @media (min-width: 1024px) {
    .layout--split {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }
    .layout--split .plate-col {
      position: sticky;
      top: calc(var(--header-h, 4.5rem) + 1rem);
    }
    .layout--wide .record {
      display: grid;
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: 3rem;
      align-items: start;
    }
    .layout--wide .record--solo {
      display: block;
      max-width: 44rem;
    }
  }

  /* Section headings (.sec-h) live in src/styles/global.css, shared by
     every collections page. */

  /* The plate ----------------------------------------------------- */
  /* The photograph on the paper, with its own hairline and a shallow
     shadow - the same treatment as the plates on the collections guide. A
     tinted mat behind a print that already carries a mount was two frames
     arguing. */
  .mat {
    position: relative;
  }
  /* Every face in ONE grid cell, so the mat is as tall as the tallest face
     and switching views never moves the page. The fade is opacity, and
     visibility follows it so a hidden face leaves the accessibility tree and
     takes no pointer events. */
  .stack {
    display: grid;
  }
  .face {
    grid-area: 1 / 1;
    align-self: center;
    margin: 0;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.35s ease,
      visibility 0s linear 0.35s;
  }
  .face.is-on {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.35s ease;
  }
  /* Held to the window's height through its width, so the image box and
     the photograph stay the same rectangle and every region - positioned in
     percent of this box - stays on its face. object-fit would letterbox the
     picture inside the img and throw every box off. */
  .face-box {
    position: relative;
    width: min(100%, calc(var(--plate-max-h) * var(--ar, 1)));
  }
  .face-box img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid rgb(59 56 51 / 0.16);
    box-shadow:
      0 1px 1px rgb(59 56 51 / 0.14),
      0 14px 24px -18px rgb(59 56 51 / 0.5);
    user-select: none;
    -webkit-user-drag: none;
  }

  /* Marks. Plain positioned boxes: no clip-path, no mask. */
  /* NAMED region-box, not mark: a short, common class name is exactly the
     kind a site-wide stylesheet may already use for something else, and a
     global rule that sets visibility or display would win on properties this
     block never mentions. */
  .region-box,
  .ex-region {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: var(--w);
    height: var(--h);
    /* Two-tone, so it reads on a dark print AND on a pale albumen one: a
       light line between two dark ones. A light line alone vanished into
       cream mounts and faded sepia. */
    border: 2px solid #f7f4ec;
    box-shadow:
      0 0 0 1.5px rgb(23 21 15 / 0.85),
      inset 0 0 0 1px rgb(23 21 15 / 0.6);
    border-radius: 2px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease;
  }
  .region-box--detail,
  .region-box--inscription {
    border-style: dashed;
  }
  /* On by a class set on the box itself, not by a class on an ancestor: the
     toggle then depends on nothing but the box and this rule. */
  .region-box.is-lit,
  .region-box.is-named,
  .regions-mode .region-box {
    opacity: 1;
  }
  /* LABELS. A number always; the name as well wherever it has room - see
     placeTags() in the script, which decides per box. A label sits above its
     box, or below it when there is no room above. */
  .region-tag {
    position: absolute;
    left: -2px;
    bottom: calc(100% + 2px);
    display: flex;
    align-items: baseline;
    gap: 0.35em;
    min-width: 1.1rem;
    padding: 0.08rem 0.32rem 0.1rem;
    background: #17150f;
    color: #f7f4ec;
    font: 500 0.6rem/1.3 ui-monospace, monospace;
    white-space: nowrap;
    pointer-events: none;
  }
  .tag-below > .region-tag {
    bottom: auto;
    top: calc(100% + 2px);
  }
  .tag-qmark {
    margin-left: -0.3em;
    color: #e2a15c;
  }
  .tag-name,
  .tag-q {
    display: none;
  }
  .tag-full > .region-tag .tag-name,
  .is-open > .region-tag .tag-name {
    display: inline;
    font: 500 0.82rem/1.1 var(--font-serif, 'Cormorant Garamond', Georgia, serif);
    letter-spacing: 0.01em;
  }
  .tag-full > .region-tag .tag-q,
  .is-open > .region-tag .tag-q {
    display: inline;
    color: #e2a15c;
    font-size: 0.55rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .tag-full > .region-tag .tag-qmark,
  .is-open > .region-tag .tag-qmark {
    display: none;
  }
  /* A face that is only possibly this person gets a broken outline, so doubt
     reads even at a glance and in number-only labels. */
  .region-box--person.is-doubtful {
    border-style: dashed;
  }
  .region-box.is-open,
  .ex-region.is-open {
    z-index: 6;
  }
  /* With names showing, a box can be pointed at (its name opens) and pressed
     (Examine opens on that face). Otherwise it stays out of the way. */
  .region-box.is-named {
    pointer-events: auto;
    cursor: zoom-in;
  }
  .person.is-lit {
    background: rgb(218 211 196 / 0.35);
    box-shadow: -0.5rem 0 0 rgb(218 211 196 / 0.35);
  }

  .examine-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem 0.6rem;
    background: var(--c-canvas);
    border: 1px solid var(--c-haze);
    border-radius: 2px;
    color: var(--c-iron);
    font: 500 0.7rem/1 ui-monospace, monospace;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
  }
  .examine-btn svg {
    width: 0.9rem;
    height: 0.9rem;
  }
  .examine-btn:hover {
    border-color: var(--c-caprock);
    color: var(--c-caprock);
  }

  .plate-tools {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }
  .seg {
    display: inline-flex;
  }
  .seg-btn {
    padding: 0.3rem 0.75rem;
    border: 1px solid var(--c-haze);
    background: transparent;
    color: var(--c-iron);
    font: 500 0.7rem/1.2 ui-monospace, monospace;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
  }
  .seg .seg-btn + .seg-btn {
    margin-left: -1px;
  }
  .seg-btn:hover {
    border-color: var(--c-caprock);
    position: relative;
  }
  .seg-btn[aria-pressed='true'] {
    background: var(--c-caprock);
    border-color: var(--c-caprock);
    color: var(--c-canvas);
    position: relative;
  }
  .seg-btn:focus-visible,
  .loc:focus-visible,
  .pin:focus-visible,
  .ins-show:focus-visible {
    outline: 2px solid var(--c-caprock);
    outline-offset: 2px;
  }

  /* Details list: the caption IS the button. */
  .locs {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .loc {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    width: 100%;
    padding: 0.35rem 0.25rem;
    border: 0;
    border-top: 1px solid var(--c-haze);
    background: none;
    color: inherit;
    font: inherit;
    font-size: 0.95rem;
    text-align: left;
    cursor: pointer;
  }
  .locs li:first-child .loc {
    border-top: 0;
  }
  .loc:hover .loc-cap {
    color: var(--c-caprock);
  }
  .loc-n {
    flex-shrink: 0;
    width: 1rem;
    font: 500 0.72rem/1 ui-monospace, monospace;
    color: var(--c-caprock);
  }
  .loc-cap {
    flex: 1;
  }
  .loc-face {
    flex-shrink: 0;
    font: 0.68rem/1 ui-monospace, monospace;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--c-sage);
  }

  /* The record ---------------------------------------------------- */
  .title,
  .prose-line {
    text-wrap: pretty;
  }
  .date-words {
    font-size: 1.05rem;
  }
  .date-display {
    display: block;
    margin-top: 0.1rem;
    font-size: 0.72rem;
    opacity: 0.6;
  }
  .glyph {
    display: block;
    max-width: 17rem;
    margin-top: 0.45rem;
  }
  .glyph-track {
    position: relative;
    display: block;
    height: 12px;
    border-bottom: 1px solid var(--c-haze);
  }
  .glyph-tick {
    position: absolute;
    left: var(--x);
    bottom: -1px;
    height: 5px;
    border-left: 1px solid var(--c-haze);
  }
  /* The same interval glyph as the guide's chronology: a rule between caps. */
  .glyph-bar {
    --stripe: linear-gradient(currentColor, currentColor) 0 50% / 100% 2px no-repeat;
    --dash: repeating-linear-gradient(90deg, currentColor 0 3px, transparent 3px 6px) 0 50% / 100% 2px no-repeat;
    --cap-l: linear-gradient(currentColor, currentColor) 0 50% / 1.5px 8px no-repeat;
    --cap-r: linear-gradient(currentColor, currentColor) 100% 50% / 1.5px 8px no-repeat;
    position: absolute;
    left: var(--x);
    top: 0;
    width: var(--w);
    min-width: 5px;
    height: 12px;
    color: var(--c-caprock);
    background: var(--stripe), var(--cap-l), var(--cap-r);
  }
  .glyph-bar.soft {
    color: var(--c-sage);
  }
  .glyph-bar.open-start {
    background: var(--dash), var(--cap-r);
  }
  .glyph-bar.open-end {
    background: var(--dash), var(--cap-l);
  }
  .glyph-ends {
    display: flex;
    justify-content: space-between;
    margin-top: 0.2rem;
    font-size: 0.66rem;
    color: var(--c-sage);
  }

  .evidence {
    margin-top: 0.75rem;
  }
  .evidence-h {
    margin: 0 0 0.35rem;
  }
  .evidence .basis-line {
    font-size: 0.9rem;
  }

  .basis-line {
    position: relative;
    margin-bottom: 0.4rem;
    padding-left: 1rem;
    font-size: 0.95rem;
    opacity: 0.85;
  }
  .basis-line::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.75em;
    width: 0.5rem;
    border-top: 1px solid currentColor;
    opacity: 0.6;
  }

  .person,
  .inscription {
    padding: 0.6rem 0;
    border-top: 1px solid var(--c-haze);
  }
  .person:first-child,
  .inscription:first-child {
    padding-top: 0;
    border-top: 0;
  }
  .person-line {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.2rem 0.5rem;
    font-size: 1.05rem;
  }
  /* Outlined, not filled: the number is a reference mark, and a column of
     solid black squares carried more weight than the names beside them. */
  .pin {
    align-self: center;
    min-width: 1.5rem;
    height: 1.5rem;
    padding: 0 0.3rem;
    border: 1px solid var(--c-haze);
    border-radius: 2px;
    background: transparent;
    color: var(--c-sage);
    font: 500 0.7rem/1 ui-monospace, monospace;
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease;
  }
  .pin:hover,
  .person:hover .pin,
  .person.is-lit .pin {
    background: var(--c-caprock);
    border-color: var(--c-caprock);
    color: var(--c-canvas);
  }
  .ins-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    margin-bottom: 0.4rem;
  }
  .ins-show {
    padding: 0;
    border: 0;
    background: none;
    color: var(--c-caprock);
    font: inherit;
    font-size: 0.85rem;
    cursor: pointer;
  }
  .ins-show:hover {
    text-decoration: underline;
  }
  .ins-text {
    margin: 0;
    padding: 0.65rem 0.9rem;
    background: rgb(218 211 196 / 0.25);
    border-left: 2px solid var(--c-caprock);
    font-size: 1.02rem;
    line-height: 1.4;
    white-space: pre-line;
  }
  [data-hover-mark]:hover .ins-text {
    background: rgb(218 211 196 / 0.45);
  }

  .also + .also {
    margin-top: 1.1rem;
  }
  .also-name {
    margin: 0 0 0.45rem;
  }
  .also-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 0 0 0.35rem;
    padding: 0;
    list-style: none;
  }
  .also-row li {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 4.75rem;
  }
  .also-thumb {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 4.75rem;
    height: 5.5rem;
    padding: 0.3rem;
    background: var(--c-dust);
    border: 1px solid var(--c-haze);
    transition: border-color 0.2s ease;
  }
  .also-thumb:hover,
  .also-thumb:focus-visible {
    border-color: var(--c-caprock);
    outline: none;
  }
  .also-thumb img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
  }
  .also-date {
    max-width: 100%;
    margin-top: 0.2rem;
    overflow: hidden;
    font-size: 0.66rem;
    color: var(--c-sage);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .cite {
    margin: 0;
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--c-haze);
    font-size: 0.95rem;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }
  .cite-tools {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }
  .copy-note {
    color: var(--c-caprock);
  }

  /* Examine ------------------------------------------------------- */
  /* THE GROUND IS DARK: against ink the photograph is the only lit thing on
     the screen, and its paper whites read as highlights instead of competing
     with the page's own paper. Nothing below sets `display` on the dialog -
     its visibility belongs to the [open] attribute alone. */
  .ex {
    --ex-pad: clamp(0.55rem, 2vw, 1.1rem);
    --ex-chrome: 3.7rem;
    --ex-aside: 0px;
    --ex-aside-b: 0px;
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    overflow: hidden;
    background: #17150f;
    color: #e8e2d6;
    color-scheme: dark;
  }
  .ex::backdrop {
    background: #17150f;
  }
  /* Everything in the viewer that hides by the `hidden` attribute stays
     hidden, whatever else styles it. */
  .ex [hidden] {
    display: none !important;
  }
  /* A swipe down fades the furniture as the photograph is pulled away. */
  .ex-top,
  .ex-note,
  .ex-map {
    opacity: calc(1 - var(--pull, 0));
  }
  .ex-ico {
    display: block;
    width: 1rem;
    height: 1rem;
  }
  /* Name labels would read sideways on a turned photograph; the outlines
     turn with it and stay. */
  .ex[data-rot] .ex-region .region-tag {
    visibility: hidden;
  }

  .ex-map {
    position: absolute;
    right: calc(var(--ex-pad) + var(--ex-aside));
    bottom: calc(var(--ex-pad) + var(--ex-aside-b));
    z-index: 2;
    overflow: hidden;
    border: 1px solid rgb(247 244 236 / 0.35);
    background: rgb(10 9 6 / 0.9);
    box-shadow: 0 6px 18px rgb(0 0 0 / 0.5);
    cursor: crosshair;
    touch-action: none;
  }
  .ex-map-inner {
    position: absolute;
    left: 50%;
    top: 50%;
  }
  .ex-map-inner img {
    display: block;
    width: 100%;
    height: 100%;
    user-select: none;
    -webkit-user-drag: none;
  }
  /* The view: a lit rectangle, the rest of the print dimmed around it. */
  .ex-map-view {
    position: absolute;
    border: 1.5px solid #e2a15c;
    box-shadow: 0 0 0 100vmax rgb(10 9 6 / 0.5);
    pointer-events: none;
  }
  @media (max-width: 640px) {
    .ex.note-open .ex-map {
      display: none;
    }
  }

  /* Shown only if the sharper file takes more than a moment. */
  .ex-load {
    position: absolute;
    top: calc(var(--ex-chrome) + 0.4rem);
    left: 50%;
    margin: 0;
    padding: 0.3rem 0.6rem;
    border-radius: 2px;
    background: rgb(10 9 6 / 0.8);
    color: #a79d89;
    font: 0.66rem/1 ui-monospace, monospace;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0;
    transform: translateX(-50%);
    transition: opacity 0.2s ease;
    pointer-events: none;
  }
  .ex.is-sharpening .ex-load {
    opacity: 1;
    transition-delay: 0.45s;
  }
  .ex-stage {
    position: absolute;
    inset: 0;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--ex-chrome) calc(var(--ex-pad) + var(--ex-aside)) calc(var(--ex-pad) + var(--ex-aside-b)) var(--ex-pad);
    overflow: hidden;
    touch-action: none;
    outline: none;
  }
  .ex-stage.can-pan {
    cursor: grab;
  }
  .ex-stage.can-pan:active {
    cursor: grabbing;
  }
  .ex-frame {
    position: relative;
    flex: none;
    transform-origin: center center;
    box-shadow: 0 1px 24px rgb(0 0 0 / 0.55);
  }
  /* will-change ONLY while a gesture runs. Left on, it pins the photograph
     in a layer rasterised at its fitted size and the GPU stretches that -
     which is why a 3178px file once looked no sharper than a 1763px one. */
  .ex-frame.is-moving {
    will-change: transform;
  }
  .ex-frame img {
    display: block;
    width: 100%;
    height: 100%;
    user-select: none;
    -webkit-user-drag: none;
  }
  .ex-marks {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .ex-region {
    visibility: hidden;
    /* Past the file's own pixels the frame is enlarged by transform, which
       would thicken the outline and blow up the label. --tag-scale undoes
       that, so both stay the same size on screen at any zoom. */
    border-width: calc(2px * var(--tag-scale, 1));
  }
  .ex-region .region-tag {
    font-size: 0.66rem;
    transform: scale(var(--tag-scale, 1));
    transform-origin: left bottom;
  }
  .ex-region.tag-below .region-tag {
    transform-origin: left top;
  }
  .ex-region .tag-name {
    font-size: 0.95rem !important;
  }
  .ex-region.is-named {
    pointer-events: auto;
  }
  .ex-region.on-face {
    visibility: visible;
  }
  .ex-region.is-active,
  .ex-region.is-named,
  .regions-mode .ex-region {
    opacity: 1;
  }

  .ex-top {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 0.9rem;
    padding: var(--ex-pad);
    pointer-events: none;
    background: linear-gradient(to bottom, rgb(10 9 6 / 0.94), rgb(10 9 6 / 0.7) 58%, rgb(10 9 6 / 0));
  }
  .ex-top > * {
    pointer-events: auto;
  }
  .ex-title {
    flex: 1 1 12rem;
    min-width: 0;
    margin: 0;
    overflow: hidden;
    color: #bdb4a0;
    font: 0.67rem/1.3 ui-monospace, monospace;
    letter-spacing: 0.13em;
    text-overflow: ellipsis;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .ex-ctl {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    align-items: center;
    gap: 0.4rem;
  }
  .ex-group {
    display: flex;
    align-items: center;
    gap: 1px;
  }
  .ex-ctl button {
    min-width: 2.3rem;
    height: 2.3rem;
    padding: 0 0.62rem;
    border: 1px solid rgb(247 244 236 / 0.17);
    border-radius: 2px;
    background: rgb(247 244 236 / 0.07);
    color: #e8e2d6;
    font: 0.64rem/1 ui-monospace, monospace;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
  }
  .ex-group button {
    border-radius: 0;
  }
  .ex-group > :first-child {
    border-radius: 2px 0 0 2px;
  }
  .ex-group > :last-child {
    border-radius: 0 2px 2px 0;
  }
  .ex-ctl button:hover {
    background: rgb(247 244 236 / 0.16);
    border-color: rgb(247 244 236 / 0.42);
  }
  .ex-ctl button:focus-visible,
  .ex-aside-btn:focus-visible {
    outline: 2px solid #c4785a;
    outline-offset: 1px;
  }
  .ex-ctl button[aria-pressed='true'] {
    background: #9c5b3f;
    border-color: #9c5b3f;
    color: #f7f4ec;
  }
  .ex-ctl button:disabled {
    opacity: 0.32;
    cursor: default;
    background: none;
  }
  .ex-pct {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 3.1rem;
    height: 2.3rem;
    border-block: 1px solid rgb(247 244 236 / 0.17);
    background: rgb(247 244 236 / 0.04);
    color: #a79d89;
    font: 0.62rem/1 ui-monospace, monospace;
  }
  /* Pinch is the zoom on a touch screen; the buttons only take room there.
     And on a phone the title gives its row back to the photograph. */
  @media (pointer: coarse) {
    .ex-zoom {
      display: none;
    }
  }
  @media (max-width: 640px) {
    .ex-title {
      display: none;
    }
  }

  .ex-note {
    position: absolute;
    left: var(--ex-pad);
    bottom: calc(var(--ex-pad) + var(--ex-aside-b));
    box-sizing: border-box;
    max-width: min(54ch, calc(100% - var(--ex-pad) * 2 - var(--ex-aside)));
    max-height: 40vh;
    overflow-y: auto;
    padding: 0.8rem 1rem;
    background: rgb(10 9 6 / 0.9);
    border: 1px solid rgb(247 244 236 / 0.15);
    border-left: 2px solid #9c5b3f;
    border-radius: 2px;
  }
  .ex-note p {
    margin: 0;
    color: #dcd5c6;
    font-size: 0.95rem;
    line-height: 1.55;
    white-space: pre-line;
  }

  /* Side by side. The aside takes a column on a wide screen and a band at
     the bottom on a narrow one; the stage's padding makes room for it. */
  .ex-aside {
    display: none;
  }
  .ex.is-compare {
    --ex-aside: min(34vw, 30rem);
  }
  /* Solid ground: a zoomed photograph pans under the aside, and without it
     the two would show through each other. */
  .ex.is-compare .ex-aside {
    position: absolute;
    top: var(--ex-chrome);
    right: 0;
    bottom: 0;
    width: var(--ex-aside);
    box-sizing: border-box;
    padding: 0 var(--ex-pad) var(--ex-pad);
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    background: #17150f;
  }
  @media (max-width: 700px) {
    .ex.is-compare {
      --ex-aside: 0px;
      --ex-aside-b: 36dvh;
    }
    .ex.is-compare .ex-aside {
      top: auto;
      left: 0;
      width: auto;
      height: var(--ex-aside-b);
      padding-top: 0.5rem;
    }
  }
  .ex-aside-label {
    margin: 0;
    color: #a79d89;
    font: 0.6rem/1 ui-monospace, monospace;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .ex-aside-btn {
    flex: 1;
    min-height: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 1px solid rgb(247 244 236 / 0.12);
    background: rgb(247 244 236 / 0.03);
    cursor: pointer;
  }
  .ex-aside-btn img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
  }

  .ex-toast {
    position: absolute;
    left: 50%;
    bottom: calc(var(--ex-pad) + var(--ex-aside-b));
    max-width: calc(100% - 2rem);
    margin: 0;
    padding: 0.5rem 0.8rem;
    border-radius: 2px;
    background: #e8e2d6;
    color: #17150f;
    font: 0.66rem/1.4 ui-monospace, monospace;
    letter-spacing: 0.04em;
    opacity: 0;
    transform: translate(-50%, 0.5rem);
    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
    pointer-events: none;
  }
  .ex-toast.is-on {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  /* Authoring mode. Created by script, so these are global. */
  :global(.region-pick) {
    position: absolute;
    z-index: 4;
    border: 1.5px solid #e2a15c;
    background: rgb(226 161 92 / 0.18);
    pointer-events: none;
  }
  :global(.region-banner) {
    position: fixed;
    left: 50%;
    bottom: 1rem;
    z-index: 70;
    transform: translateX(-50%);
    max-width: calc(100% - 2rem);
    padding: 0.55rem 0.9rem;
    border-radius: 2px;
    background: #17150f;
    color: #f0ead9;
    font: 0.68rem/1.45 ui-monospace, monospace;
    letter-spacing: 0.03em;
  }
  .regions-mode .face-box {
    cursor: crosshair;
  }

  @media (prefers-reduced-motion: reduce) {
    .pin,
    .face,
    .face.is-on,
    .region-box,
    .ex-region,
    .ex-toast {
      transition: none;
    }
  }

  /* ---------------------------------------------------------------- *
   * THE CATALOGUE SHEET
   *
   * What comes out of a printer is not a screenshot of a web page: it is the
   * record on paper, to be filed with someone's family papers. So the page
   * becomes one column, both views of the object are shown with their labels,
   * the faces keep their numbered boxes so the sheet is its own key, and the
   * citation, the control number and the permalink are on it, because a
   * printed sheet with no way back to its source is an orphan.
   * ---------------------------------------------------------------- */
  .sheet-head,
  .sheet-foot,
  .face-cap {
    display: none;
  }

  @media print {
    @page {
      margin: 16mm 15mm;
    }
    .ex,
    .examine-btn,
    .plate-tools,
    .cite-tools,
    .pager,
    .record-json,
    .photo-find,
    .ins-show,
    .pin {
      display: none !important;
    }
    .item-page {
      max-width: none;
      padding: 0;
      font-size: 10.5pt;
      color: #000;
    }
    /* A sheet of paper is white. Tints that carry meaning on screen only
       cost ink here. */
    .ins-text {
      background: none;
      border-left: 1pt solid #000;
    }
    .photo-thumb,
    .cite {
      background: none;
    }
    /* Other photographs of the same people belong on their own pages, not on
       this object's sheet - they ran to three pages of thumbnails. */
    section[aria-labelledby='also-h'] {
      display: none;
    }
    .topline {
      display: none;
    }
    .sheet-head {
      display: block;
      margin-bottom: 6mm;
    }
    .sheet-rule,
    .sheet-foot {
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      font-family: var(--mono);
      font-size: 7.5pt;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }
    .sheet-rule {
      padding-bottom: 2.5mm;
      border-bottom: 0.5pt solid #000;
    }
    /* The sheet's own heading, so the object is not the first thing on the
       page with no idea what it is. */
    .sheet-title {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 6mm;
      margin-top: 4mm;
    }
    .sheet-title h2 {
      margin: 0;
      font-size: 16pt;
      font-weight: 500;
      line-height: 1.15;
    }
    .sheet-no {
      font-family: var(--mono);
      font-size: 9pt;
      white-space: nowrap;
    }
    h1.title {
      display: none;
    }
    .sheet-foot {
      margin-top: 8mm;
      padding-top: 3mm;
      border-top: 0.5pt solid #000;
      text-transform: none;
      overflow-wrap: anywhere;
      /* Follow the record rather than starting a page of its own. */
      break-before: avoid;
    }
    /* One column, in reading order: title and record first, plates after. */
    .layout {
      display: block;
    }
    .plate-col,
    .layout--split .plate-col {
      position: static;
      break-inside: avoid;
    }
    .record,
    .layout--wide .record,
    .layout--wide .record--solo {
      display: flow-root;
      margin-top: 7mm;
    }
    /* The screen's height cap means nothing on paper; 11cm below does. */
    .face-box {
      width: auto;
    }
    .mat {
      padding: 0;
      background: none;
      border: 0;
    }
    /* Both views, one after the other, each with its label. */
    .stack {
      display: flex;
      flex-wrap: wrap;
      gap: 6mm;
      align-items: flex-start;
    }
    .face {
      visibility: visible;
      opacity: 1;
      grid-area: auto;
      max-width: 48%;
      break-inside: avoid;
    }
    .face-box img {
      max-height: 11cm;
      width: auto;
      border: 0.5pt solid #000;
    }
    .face-cap {
      display: block;
      margin-bottom: 1.5mm;
      font-family: var(--mono);
      font-size: 7pt;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }
    /* The sheet is its own key: every identified face keeps its number. */
    .region-box--person {
      opacity: 1;
      border-color: #fff;
      box-shadow: 0 0 0 0.5pt #000;
    }
    .region-tag {
      background: #000;
      color: #fff;
      print-color-adjust: exact;
      -webkit-print-color-adjust: exact;
    }
    .locs,
    .person,
    .inscription,
    section {
      break-inside: avoid;
    }
    .cite {
      border: 0.5pt solid #000;
      font-size: 9pt;
    }
    a {
      color: inherit;
      text-decoration: none;
    }
    .also,
    .also-row {
      break-inside: avoid;
    }
  }
</style>

<style is:global>
  /* Page scroll stays put behind an open viewer - no script, no restoring. */
  html:has(dialog.ex[open]) {
    overflow: hidden;
  }

  @media print {
    html,
    body {
      background: #fff;
    }
    /* THE SITE'S FURNITURE IS NOT PART OF THE RECORD. The Horizon header and
       the Caprock footer are rendered by RootLayout, outside this page's
       scoped styles, so they are hidden from here - otherwise they land in
       the middle of the sheet wherever the page happens to break. */
    body > header,
    body > footer,
    body > nav,
    body > .site-header,
    body > .site-footer,
    main > header,
    main > footer {
      display: none !important;
    }
  }
</style>

<script>
  import { navigate } from 'astro:transitions/client';

  type FaceData = {
    key: string;
    label: string;
    title: string;
    alt: string;
    view: string;
    big: string;
    study: string;
    studyW: number;
    w: number;
    h: number;
  };
  type MarkData = {
    id: string;
    kind: string;
    face: string;
    x: number;
    y: number;
    w: number;
    h: number;
    caption: string;
  };
  type PageData = {
    note: string;
    prev: string | null;
    next: string | null;
    faces: FaceData[];
    marks: MarkData[];
  };
  type Box = { x: number; y: number; w: number; h: number };

  const round1 = (n: number) => Math.round(n * 10) / 10;
  const clamp = (v: number, lo: number, hi: number) => Math.min(hi, Math.max(lo, v));

  async function copyText(text: string, html?: string) {
    try {
      if (html && 'ClipboardItem' in window) {
        await navigator.clipboard.write([
          new ClipboardItem({
            'text/plain': new Blob([text], { type: 'text/plain' }),
            'text/html': new Blob([html], { type: 'text/html' }),
          }),
        ]);
      } else {
        await navigator.clipboard.writeText(text);
      }
      return true;
    } catch {
      window.prompt('Copy this:', text);
      return false;
    }
  }

  function wire() {
    const root = document.querySelector<HTMLElement>('[data-item-page]');
    const dataEl = document.getElementById('item-data');
    const dialog = document.getElementById('examine') as HTMLDialogElement | null;
    if (!root || !dataEl || !dialog || root.dataset.wired) return;
    root.dataset.wired = '1';

    // Everything below registers with this signal. ClientRouter keeps window
    // and document across pages, so without it every visit to an item page
    // added another set of resize/keydown/popstate listeners.
    const ac = new AbortController();
    const signal = ac.signal;
    document.addEventListener('astro:before-swap', () => ac.abort(), { once: true });

    const data = JSON.parse(dataEl.textContent || '{}') as PageData;
    const faceData = new Map(data.faces.map((f) => [f.key, f]));
    const markData = new Map(data.marks.map((m) => [m.id, m]));
    const regionsMode = new URLSearchParams(location.search).has('regions');
    // History handling below must only ever act on entries for THIS page.
    // Back from a view opened on arrival goes to a different page, and that
    // navigation belongs to ClientRouter, not to the viewer.
    const here = location.pathname;

    const $ = <T extends Element = HTMLElement>(sel: string, from: ParentNode = document) =>
      from.querySelector<T>(sel);
    const $$ = <T extends Element = HTMLElement>(sel: string, from: ParentNode = document) =>
      Array.from(from.querySelectorAll<T>(sel));

    /* ---------------------------------------------------------------- *
     * The plate
     * ---------------------------------------------------------------- */
    const plateFaces = $$('.face', root);
    const faceBtns = $$<HTMLButtonElement>('[data-face-btn]', root);
    let plateFace = data.faces[0]?.key ?? 'recto';

    const showFace = (key: string) => {
      if (!faceData.has(key)) return;
      plateFace = key;
      plateFaces.forEach((f) => f.classList.toggle('is-on', f.dataset.face === key));
      faceBtns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.faceBtn === key)));
      layoutPlateTags();
    };
    faceBtns.forEach((b) => b.addEventListener('click', () => showFace(b.dataset.faceBtn || 'recto'), { signal }));

    /* Labels ---------------------------------------------------------- */
    // PLACE THE NAMES. Largest faces first, each tries its full name; the
    // name is kept only if the label stays inside the bounds and touches no
    // other face and no label already placed. Otherwise that face keeps its
    // number. So a portrait is named outright and a crowded back row stays
    // numbered, with the People list as its key.
    const hit = (a: DOMRect, b: DOMRect) =>
      !(a.right <= b.left || a.left >= b.right || a.bottom <= b.top || a.top >= b.bottom);
    const clearTags = (boxes: HTMLElement[]) =>
      boxes.forEach((b) => b.classList.remove('tag-full', 'tag-below', 'is-open'));
    const placeTags = (boxes: HTMLElement[], bounds: DOMRect) => {
      const measure = (b: HTMLElement, full: boolean) => {
        const tag = b.querySelector<HTMLElement>('.region-tag');
        if (!tag) return null;
        b.classList.toggle('tag-full', full);
        b.classList.remove('tag-below');
        let r = tag.getBoundingClientRect();
        if (r.top < bounds.top) {
          b.classList.add('tag-below');
          r = tag.getBoundingClientRect();
        }
        return r;
      };
      // First every face takes its number, and that footprint is reserved:
      // a name may not cover another face's number any more than its face.
      const faces = boxes.map((b) => ({ b, r: b.getBoundingClientRect(), tag: measure(b, false) }));
      [...faces]
        .sort((x, y) => y.r.width * y.r.height - x.r.width * x.r.height)
        .forEach((f) => {
          if (!f.tag) return;
          const below = f.b.classList.contains('tag-below');
          const r = measure(f.b, true);
          const clear =
            !!r &&
            r.left >= bounds.left - 1 &&
            r.right <= bounds.right + 1 &&
            r.bottom <= bounds.bottom + 1 &&
            !faces.some((o) => o !== f && (hit(r, o.r) || (o.tag && hit(r, o.tag))));
          if (clear && r) f.tag = r;
          else {
            f.b.classList.remove('tag-full');
            f.b.classList.toggle('tag-below', below);
          }
        });
    };

    const mat = $('[data-mat]', root);
    const namesBtn = $<HTMLButtonElement>('[data-names]', root);
    const plateNamed = () => namesBtn?.getAttribute('aria-pressed') === 'true';
    const layoutPlateTags = () => {
      if (!plateNamed() || !mat) return;
      const shown = plateFaces.find((f) => f.classList.contains('is-on'));
      if (shown) placeTags($$('.region-box--person', shown), mat.getBoundingClientRect());
    };
    namesBtn?.addEventListener(
      'click',
      () => {
        const on = namesBtn.getAttribute('aria-pressed') !== 'true';
        namesBtn.setAttribute('aria-pressed', String(on));
        const people = $$('.region-box--person', root);
        // A box is drawn on the view its region is on. If none of them is on
        // the view showing - the plate turned to the back, say - turn it to
        // one that has them, or the button would seem to do nothing.
        if (on && !people.some((b) => b.closest('.face')?.classList.contains('is-on'))) {
          const view = people[0]?.closest<HTMLElement>('.face')?.dataset.face;
          if (view) showFace(view);
        }
        people.forEach((b) => b.classList.toggle('is-named', on));
        if (on) layoutPlateTags();
        else clearTags(people);
      },
      { signal }
    );
    if (mat) {
      const plateRO = new ResizeObserver(() => layoutPlateTags());
      plateRO.observe(mat);
      signal.addEventListener('abort', () => plateRO.disconnect());
    }

    // Point at a name, a transcription or a detail and its box lights on the
    // plate. If the box is on the other face, the plate turns to it.
    const light = (id: string | null) => {
      $$('.region-box.is-lit', root).forEach((m) => {
        m.classList.remove('is-lit', 'is-open');
        if (!plateNamed()) clearTags([m]);
      });
      if (!id) return;
      const m = markData.get(id);
      if (m && m.face !== plateFace) showFace(m.face);
      $$(`[data-mark="${CSS.escape(id)}"]`, root).forEach((el) => {
        el.classList.add('is-lit');
        // One face lit from the list always shows its name: nothing else
        // is on the plate for it to crowd.
        if (plateNamed()) el.classList.add('is-open');
        else if (mat) placeTags([el], mat.getBoundingClientRect());
      });
    };

    // The other direction: point at a face and its name opens and its row in
    // the People list lights. Press it and Examine opens on that face.
    const rowFor = (id: string) => root.querySelector<HTMLElement>(`[data-hover-mark="${CSS.escape(id)}"]`);
    const boxFrom = (t: EventTarget | null) =>
      t instanceof Element ? t.closest<HTMLElement>('.region-box--person.is-named') : null;
    root.addEventListener(
      'pointerover',
      (e) => {
        const b = boxFrom(e.target);
        if (!b || !b.dataset.mark) return;
        b.classList.add('is-open');
        rowFor(b.dataset.mark)?.classList.add('is-lit');
      },
      { signal }
    );
    root.addEventListener(
      'pointerout',
      (e) => {
        const b = boxFrom(e.target);
        if (!b || !b.dataset.mark || b.contains(e.relatedTarget as Node | null)) return;
        b.classList.remove('is-open');
        rowFor(b.dataset.mark)?.classList.remove('is-lit');
      },
      { signal }
    );
    root.addEventListener(
      'click',
      (e) => {
        if (regionsMode) return;
        const b = boxFrom(e.target);
        const m = b?.dataset.mark ? markData.get(b.dataset.mark) : undefined;
        if (!m) return;
        rowFor(m.id)?.classList.remove('is-lit');
        open(m.face, { box: m, caption: m.caption, noteOpen: true, mark: m.id });
      },
      { signal }
    );
    $$('[data-hover-mark]', root).forEach((el) => {
      const id = el.dataset.hoverMark;
      if (!id) return;
      el.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') light(id); }, { signal });
      el.addEventListener('pointerleave', (e) => { if (e.pointerType === 'mouse') light(null); }, { signal });
      el.addEventListener('focusin', () => light(id), { signal });
      el.addEventListener('focusout', () => light(null), { signal });
    });

    /* ---------------------------------------------------------------- *
     * Examine
     *
     * STATE. k is zoom relative to the fitted size; tx/ty the pan in px
     * from the centre of the stage's content box; rot a quarter-turn angle.
     * The frame always keeps its UNROTATED layout size and is turned by
     * transform, so every region stays in the same percentages it was
     * authored in - rotation only changes how a screen point maps onto it.
     *
     * MOTION. Buttons, keys, double-tap, Fit and flying to a face all
     * animate on transform alone; a flung pan glides to a stop. Everything
     * lands instantly under prefers-reduced-motion.
     * ---------------------------------------------------------------- */
    const stage = $('#ex-stage', dialog)!;
    const frameEl = $('#ex-frame', dialog)!;
    const img = $<HTMLImageElement>('#ex-img', dialog)!;
    const titleEl = $('#ex-title', dialog)!;
    const pctEl = $('#ex-pct', dialog)!;
    const note = $('#ex-note', dialog)!;
    const cap = $('#ex-cap', dialog)!;
    const toastEl = $('#ex-toast', dialog)!;
    const topBar = $('#ex-top', dialog)!;
    const srEl = $('#ex-sr', dialog);
    const inBtn = $<HTMLButtonElement>('[data-ex="in"]', dialog);
    const outBtn = $<HTMLButtonElement>('[data-ex="out"]', dialog);
    const infoBtn = $<HTMLButtonElement>('[data-ex="info"]', dialog);
    const compareBtn = $<HTMLButtonElement>('[data-ex="compare"]', dialog);
    const fullBtn = $<HTMLButtonElement>('[data-ex="full"]', dialog);
    const exFaceBtns = $$<HTMLButtonElement>('[data-ex-face]', dialog);
    const exMarks = $$('[data-ex-mark]', dialog);
    const asideImg = $<HTMLImageElement>('#ex-aside-img', dialog);
    const asideLabel = $('#ex-aside-label', dialog);
    const mapEl = $('#ex-map', dialog);
    const mapInner = $('#ex-map-inner', dialog);
    const mapImg = $<HTMLImageElement>('#ex-map-img', dialog);
    const mapView = $('#ex-map-view', dialog);

    const calm = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let face = data.faces[0]?.key ?? 'recto';
    let k = 1;
    let tx = 0;
    let ty = 0;
    let rot = 0;
    let layoutK = 1; // how much of k is baked into layout size
    let fitW = 0; // the fitted size, UNROTATED
    let fitH = 0;
    let area = { cx: 0, cy: 0, w: 0, h: 0 };
    let bestW = 0;
    let studySrc = '';
    let upgraded = false;
    let settle = 0;
    let compare = false;
    let pushed = false; // did opening add a history entry
    let toastTimer = 0;
    let anim = 0; // rAF id of a running animation or glide
    let loadToken = 0; // bumps on every face load; late image swaps check it
    let shownRank = 0; // 0 = page image, 1 = detail file, 2 = study file
    let lastSaid = '';

    const toast = (text: string) => {
      const target = dialog.open ? toastEl : pageToast();
      target.textContent = text;
      target.classList.add('is-on');
      window.clearTimeout(toastTimer);
      toastTimer = window.setTimeout(() => target.classList.remove('is-on'), 2600);
    };
    // Screen readers hear where a gesture LANDS, never every frame of it.
    const say = (text: string) => {
      if (!srEl || text === lastSaid) return;
      lastSaid = text;
      srEl.textContent = text;
    };

    /* Rotation geometry ------------------------------------------------ */
    const odd = () => rot % 180 !== 0;
    const cs = () => {
      const a = (rot * Math.PI) / 180;
      return { c: Math.round(Math.cos(a)), s: Math.round(Math.sin(a)) };
    };
    // A vector in the unrotated frame, as it lands on screen; and back.
    const turn = (u: number, v: number) => {
      const { c, s } = cs();
      return { x: u * c - v * s, y: u * s + v * c };
    };
    const unturn = (x: number, y: number) => {
      const { c, s } = cs();
      return { u: x * c + y * s, v: -x * s + y * c };
    };
    const visW = () => (odd() ? fitH : fitW);
    const visH = () => (odd() ? fitW : fitH);

    // The stage's content box, which is where a fitted image is centred.
    const measure = () => {
      const r = stage.getBoundingClientRect();
      const st = getComputedStyle(stage);
      const pl = parseFloat(st.paddingLeft);
      const pr = parseFloat(st.paddingRight);
      const pt = parseFloat(st.paddingTop);
      const pb = parseFloat(st.paddingBottom);
      const w = Math.max(1, r.width - pl - pr);
      const h = Math.max(1, r.height - pt - pb);
      area = { w, h, cx: r.left + pl + w / 2, cy: r.top + pt + h / 2 };
      const f = faceData.get(face)!;
      const s = odd() ? Math.min(w / f.h, h / f.w) : Math.min(w / f.w, h / f.h);
      fitW = f.w * s;
      fitH = f.h * s;
    };

    // THE ZOOM CEILING. At most one file pixel per CSS pixel times the
    // screen's density - true 1:1 on an ordinary monitor, and on a phone a
    // little further, where a thumb needs the room. Past that there is
    // nothing more in the file to see.
    const maxK = () => Math.max(1, (bestW / Math.max(1, fitW)) * (window.devicePixelRatio || 1));

    const clampTo = (nk: number, x: number, y: number) => {
      nk = clamp(nk, 1, maxK());
      const mx = Math.max(0, (visW() * nk - area.w) / 2);
      const my = Math.max(0, (visH() * nk - area.h) / 2);
      return { k: nk, tx: clamp(x, -mx, mx), ty: clamp(y, -my, my) };
    };
    const clampView = () => {
      ({ k, tx, ty } = clampTo(k, tx, ty));
    };

    const layout = () => {
      frameEl.style.width = `${Math.round(fitW * layoutK)}px`;
      frameEl.style.height = `${Math.round(fitH * layoutK)}px`;
    };

    /* Images: show at once, sharpen when ready ------------------------ */
    // What the page itself is already showing for a face - decoded, in
    // memory, and instant. Examine opens on it, never on an empty frame.
    const plateSrc = (key: string) =>
      root.querySelector<HTMLImageElement>(`.face[data-face="${CSS.escape(key)}"] img`)?.currentSrc || '';
    // A sharper file replaces the one on screen only once it is DECODED, so
    // the swap is a single frame with no blank between; and only if nothing
    // newer or sharper has landed in the meantime.
    const sharpen = (src: string, rank: number) => {
      if (!src) return;
      const token = loadToken;
      const key = face;
      const pre = new Image();
      pre.src = src;
      const done = () => {
        if (token !== loadToken || key !== face || !dialog.open || rank <= shownRank) return;
        img.src = src;
        shownRank = rank;
        if (rank >= 1) dialog.classList.remove('is-sharpening');
      };
      // If the file cannot be had, stop saying it is on its way.
      const failed = () => {
        if (rank === 1 && token === loadToken) dialog.classList.remove('is-sharpening');
      };
      pre.decode().then(done, () => {
        if (pre.complete && pre.naturalWidth) done();
        else if (pre.complete) failed();
        else {
          pre.addEventListener('load', done, { once: true });
          pre.addEventListener('error', failed, { once: true });
        }
      });
    };
    const upgrade = () => {
      if (upgraded || !studySrc) return;
      upgraded = true;
      sharpen(studySrc, 2);
    };

    /* The overview ----------------------------------------------------- */
    // Past the fitted size a small whole view shows which part of the print
    // is on screen; press or drag in it to go elsewhere.
    const MAP = 132;
    let mapKey = '';
    let mapIW = 0;
    let mapIH = 0;
    const viewBox = (): Box => {
      const W = fitW * k;
      const H = fitH * k;
      const pts = [
        [-area.w / 2, -area.h / 2],
        [area.w / 2, -area.h / 2],
        [-area.w / 2, area.h / 2],
        [area.w / 2, area.h / 2],
      ].map(([x, y]) => unturn(x - tx, y - ty));
      const us = pts.map((p) => clamp(p.u / W + 0.5, 0, 1));
      const vs = pts.map((p) => clamp(p.v / H + 0.5, 0, 1));
      const x0 = Math.min(...us);
      const y0 = Math.min(...vs);
      return { x: x0 * 100, y: y0 * 100, w: (Math.max(...us) - x0) * 100, h: (Math.max(...vs) - y0) * 100 };
    };
    const drawMap = () => {
      if (!mapEl || !mapInner || !mapView) return;
      const show = dialog.open && k > 1.15;
      mapEl.hidden = !show;
      if (!show) return;
      const key = `${face}|${rot}`;
      if (key !== mapKey) {
        mapKey = key;
        const f = faceData.get(face)!;
        const ar = f.w / f.h;
        mapIW = ar >= 1 ? MAP : MAP * ar;
        mapIH = ar >= 1 ? MAP / ar : MAP;
        mapEl.style.width = `${Math.round(odd() ? mapIH : mapIW)}px`;
        mapEl.style.height = `${Math.round(odd() ? mapIW : mapIH)}px`;
        mapInner.style.width = `${mapIW}px`;
        mapInner.style.height = `${mapIH}px`;
        mapInner.style.transform = `translate(-50%, -50%) rotate(${rot}deg)`;
      }
      const v = viewBox();
      mapView.style.left = `${v.x}%`;
      mapView.style.top = `${v.y}%`;
      mapView.style.width = `${v.w}%`;
      mapView.style.height = `${v.h}%`;
    };

    /* Painting and settling ------------------------------------------- */
    // `free` skips the pan limits - for a swipe in progress, which is meant
    // to carry the photograph off its resting place.
    const paint = (free = false) => {
      if (!free) clampView();
      frameEl.style.transform = `translate(${tx}px, ${ty}px) rotate(${rot}deg) scale(${k / layoutK})`;
      frameEl.style.setProperty('--tag-scale', String(layoutK / k));
      stage.classList.toggle('can-pan', k > 1.001);
      pctEl.textContent = `${Math.round(k * 100)}%`;
      if (inBtn) inBtn.disabled = k >= maxK() - 0.001;
      if (outBtn) outBtn.disabled = k <= 1.001;
      if (k > 1.5) upgrade();
      drawMap();
    };

    // TRANSFORM WHILE MOVING, LAYOUT SIZE WHEN STILL. A transform is smooth
    // but rasterised once and stretched; a layout width is rasterised at
    // real size. The layout is capped where one file pixel meets one SCREEN
    // pixel - the old cap was one CSS pixel, which on a 3x phone drew nine
    // times the pixels the file has, for no gain in sharpness.
    const commit = () => {
      window.clearTimeout(settle);
      frameEl.classList.remove('is-moving');
      const dpr = window.devicePixelRatio || 1;
      const want = Math.min(k, Math.max(1, bestW / dpr / Math.max(1, fitW)));
      if (Math.abs(want - layoutK) > 0.01) {
        layoutK = want;
        layout();
      }
      paint();
      syncHash();
      layoutExTags();
      if (dialog.open) say(`Zoom ${Math.round(k * 100)} percent`);
    };
    const commitSoon = (ms = 160) => {
      frameEl.classList.add('is-moving');
      window.clearTimeout(settle);
      settle = window.setTimeout(commit, ms);
    };

    /* Animation ---------------------------------------------------------- */
    const stopAnim = () => {
      if (anim) cancelAnimationFrame(anim);
      anim = 0;
    };
    // Glide to a view along the path a real zoom takes: about the one point
    // that stays put, with the scale interpolated geometrically so 1x->8x
    // spends as long on each doubling rather than rushing the last.
    const animateTo = (target: { k: number; tx: number; ty: number }, ms = 260) => {
      stopAnim();
      const t = clampTo(target.k, target.tx, target.ty);
      const k0 = k;
      const x0 = tx;
      const y0 = ty;
      if (calm() || (Math.abs(t.k - k0) < 0.001 && Math.hypot(t.tx - x0, t.ty - y0) < 0.5)) {
        ({ k, tx, ty } = t);
        paint();
        commit();
        return;
      }
      const r = t.k / k0;
      const pivot = Math.abs(1 - r) > 0.001 ? { x: (t.tx - x0 * r) / (1 - r), y: (t.ty - y0 * r) / (1 - r) } : null;
      const t0 = performance.now();
      frameEl.classList.add('is-moving');
      const step = (now: number) => {
        const p = Math.min(1, (now - t0) / ms);
        const e = 1 - Math.pow(1 - p, 3);
        if (pivot) {
          k = k0 * Math.pow(r, e);
          tx = pivot.x - (pivot.x - x0) * (k / k0);
          ty = pivot.y - (pivot.y - y0) * (k / k0);
        } else {
          tx = x0 + (t.tx - x0) * e;
          ty = y0 + (t.ty - y0) * e;
        }
        paint(true);
        if (p < 1) anim = requestAnimationFrame(step);
        else {
          anim = 0;
          ({ k, tx, ty } = t);
          commit();
        }
      };
      anim = requestAnimationFrame(step);
    };
    // Zoom about a point on screen, so what is under the cursor or between
    // the fingers stays there. zoomAt moves at once (gestures); zoomTo glides
    // (buttons, keys, double-tap).
    const aboutPoint = (nk: number, cx: number, cy: number) => {
      nk = clamp(nk, 1, maxK());
      const px = cx - area.cx;
      const py = cy - area.cy;
      return { k: nk, tx: px - (px - tx) * (nk / k), ty: py - (py - ty) * (nk / k) };
    };
    const zoomAt = (nk: number, cx = area.cx, cy = area.cy) => {
      ({ k, tx, ty } = aboutPoint(nk, cx, cy));
      paint();
    };
    const zoomTo = (nk: number, cx = area.cx, cy = area.cy) => animateTo(aboutPoint(nk, cx, cy));
    const fit = () => animateTo({ k: 1, tx: 0, ty: 0 });

    // A flung pan keeps going and slows to a stop, and stops dead at an edge.
    const glide = (vx: number, vy: number) => {
      stopAnim();
      if (calm() || k <= 1.001 || Math.hypot(vx, vy) < 0.3) {
        commit();
        return;
      }
      let last = performance.now();
      frameEl.classList.add('is-moving');
      const step = (now: number) => {
        const dt = Math.min(32, now - last);
        last = now;
        const x = tx + vx * dt;
        const y = ty + vy * dt;
        ({ k, tx, ty } = clampTo(k, x, y));
        if (tx !== x) vx = 0;
        if (ty !== y) vy = 0;
        const decay = Math.exp(-dt / 320);
        vx *= decay;
        vy *= decay;
        paint();
        if (Math.hypot(vx, vy) > 0.02) anim = requestAnimationFrame(step);
        else {
          anim = 0;
          commit();
        }
      };
      anim = requestAnimationFrame(step);
    };

    // Where a region should land: centred, at 80% of the stage.
    const targetFor = (r: Box) => {
      const bw = (fitW * r.w) / 100;
      const bh = (fitH * r.h) / 100;
      const nk = clamp(Math.min(area.w / (odd() ? bh : bw), area.h / (odd() ? bw : bh)) * 0.8, 1, maxK());
      const p = turn(((r.x + r.w / 2) / 100 - 0.5) * fitW * nk, ((r.y + r.h / 2) / 100 - 0.5) * fitH * nk);
      return { k: nk, tx: -p.x, ty: -p.y };
    };
    const frameTo = (r: Box) => animateTo(targetFor(r), 480);
    // Put a point of the photograph (as fractions) at the centre.
    const centreOn = (fx: number, fy: number) => {
      const p = turn((fx - 0.5) * fitW * k, (fy - 0.5) * fitH * k);
      tx = -p.x;
      ty = -p.y;
      paint();
      commitSoon();
    };

    /* The address --------------------------------------------------------- */
    const visibleBox = (): Box | null => (k <= 1.001 ? null : viewBox());
    const buildHash = () => {
      const v = visibleBox();
      const parts = [`face=${encodeURIComponent(face)}`];
      if (v) parts.push(`xywh=percent:${round1(v.x)},${round1(v.y)},${round1(v.w)},${round1(v.h)}`);
      if (rot) parts.push(`rot=${rot}`);
      return `#${parts.join('&')}`;
    };
    // replaceState with the CURRENT state object, so ClientRouter's own
    // bookkeeping (index, scroll) survives every update.
    const syncHash = () => {
      if (!dialog.open) return;
      history.replaceState(history.state, '', `${location.pathname}${location.search}${buildHash()}`);
    };
    const parseHash = (): { face: string; box: Box | null; rot: number } | null => {
      const params = new URLSearchParams(location.hash.slice(1));
      const f = params.get('face');
      const xywh = params.get('xywh');
      if (!f && !xywh) return null;
      let parsed: Box | null = null;
      if (xywh) {
        const nums = xywh.replace(/^percent:/, '').split(',').map(Number);
        if (nums.length === 4 && nums.every((n) => Number.isFinite(n)) && nums[2] > 0 && nums[3] > 0) {
          parsed = { x: nums[0], y: nums[1], w: nums[2], h: nums[3] };
        }
      }
      const r = Number(params.get('rot'));
      return {
        face: f && faceData.has(f) ? f : data.faces[0].key,
        box: parsed,
        rot: [90, 180, 270].includes(r) ? r : 0,
      };
    };

    const setNote = (text: string, open: boolean) => {
      cap.textContent = text;
      const has = !!text.trim();
      note.hidden = !(open && has);
      dialog.classList.toggle('note-open', !note.hidden);
      if (infoBtn) {
        infoBtn.disabled = !has;
        infoBtn.setAttribute('aria-expanded', String(!note.hidden));
        infoBtn.classList.toggle('is-on', !note.hidden);
      }
    };

    // Examine labels are placed on what is actually on screen after each
    // move settles. On a turned photograph they would read sideways, so
    // while it is turned only the outlines show.
    const exNamesBtn = $<HTMLButtonElement>('[data-ex="names"]', dialog);
    const layoutExTags = () => {
      if (!dialog.open) return;
      const people = exMarks.filter((m) => m.classList.contains('region-box--person'));
      clearTags(people);
      if (rot) return;
      const named = exNamesBtn?.getAttribute('aria-pressed') === 'true';
      const shown = people.filter((m) => m.classList.contains('on-face') && (named || m.classList.contains('is-active')));
      if (!shown.length) return;
      placeTags(shown, new DOMRect(area.cx - area.w / 2, area.cy - area.h / 2, area.w, area.h));
    };

    const setActiveMark = (id: string | null) => {
      exMarks.forEach((m) => m.classList.toggle('is-active', m.dataset.exMark === id));
      layoutExTags();
    };

    const otherFace = () => data.faces.find((f) => f.key !== face);
    const updateAside = () => {
      const o = otherFace();
      if (!compare || !o || !asideImg || !asideLabel) return;
      asideImg.src = plateSrc(o.key) || o.view;
      asideLabel.textContent = o.label;
    };

    const setRot = (r: number) => {
      rot = ((r % 360) + 360) % 360;
      dialog.toggleAttribute('data-rot', rot !== 0);
    };

    const loadFace = (key: string, r = 0) => {
      stopAnim();
      const f = faceData.get(key) ?? data.faces[0];
      face = f.key;
      loadToken++;
      shownRank = 0;
      upgraded = false;
      studySrc = f.study;
      bestW = f.studyW || f.w;
      setRot(r);
      // Open on what the page already holds; the detail file follows.
      const quick = plateSrc(f.key) || f.view;
      img.alt = f.alt;
      img.src = quick;
      if (mapImg) mapImg.src = quick;
      mapKey = '';
      dialog.classList.add('is-sharpening');
      sharpen(f.big, 1);
      titleEl.textContent = f.title;
      exFaceBtns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.exFace === face)));
      exMarks.forEach((m) => m.classList.toggle('on-face', m.dataset.face === face));
      setActiveMark(null);
      showFace(face);
      updateAside();
      k = 1;
      tx = 0;
      ty = 0;
      layoutK = 1;
      measure();
      layout();
      paint();
    };

    // Step through the views - front, back, and any others - in order.
    const stepFace = (dir: number, slide = true) => {
      const n = data.faces.length;
      if (n < 2) return;
      const i = data.faces.findIndex((f) => f.key === face);
      const next = data.faces[(i + dir + n) % n];
      loadFace(next.key);
      setNote(data.note, false);
      syncHash();
      say(next.label);
      if (slide && !calm()) {
        tx = dir * area.w * 0.18;
        paint(true);
        animateTo({ k: 1, tx: 0, ty: 0 }, 220);
      }
    };

    const rotate = (dir: number) => {
      stopAnim();
      setRot(rot + 90 * dir);
      k = 1;
      tx = 0;
      ty = 0;
      layoutK = 1;
      mapKey = '';
      measure();
      layout();
      paint();
      commit();
      say(rot ? `Turned ${rot} degrees` : 'Upright');
    };

    /* Full screen - where the browser allows it on an element. An iPhone
       does not, so there the button never appears. */
    const canFull = !!(document.fullscreenEnabled && dialog.requestFullscreen);
    if (fullBtn) fullBtn.hidden = !canFull;
    const toggleFull = async () => {
      if (!canFull) return;
      try {
        if (document.fullscreenElement) await document.exitFullscreen();
        else await dialog.requestFullscreen();
      } catch {
        /* refused - the viewer is already as large as the window */
      }
    };
    document.addEventListener(
      'fullscreenchange',
      () => fullBtn?.setAttribute('aria-pressed', String(document.fullscreenElement === dialog)),
      { signal }
    );

    type OpenOpts = {
      box?: Box | null;
      caption?: string;
      noteOpen?: boolean;
      mark?: string;
      rot?: number;
      history?: 'push' | 'replace' | 'none';
    };
    const open = (key: string, opts: OpenOpts = {}) => {
      const wasOpen = dialog.open;
      if (!wasOpen) dialog.showModal();
      loadFace(key, opts.rot ?? 0);

      // THE HISTORY ENTRY GOES IN BEFORE ANY FRAMING. Framing commits, and a
      // commit rewrites the hash of whatever entry is current - done first,
      // that would stamp the view onto the PAGE's entry, the push below would
      // find nothing to push, and the router's own fragment handling would
      // then close the viewer it had just been asked to open.
      if (!wasOpen) {
        const url = `${location.pathname}${location.search}${buildHash()}`;
        const mode = opts.history ?? 'push';
        if (mode === 'push') {
          // Through ClientRouter, not around it: its router then knows this
          // is a same-page hash entry, so Back off it is an in-page step
          // rather than a page transition that re-fetches and swaps the page.
          navigate(url, { history: 'push', state: { examine: true } });
          pushed = true;
        } else if (mode === 'replace') {
          history.replaceState({ ...(history.state ?? {}), examine: true }, '', url);
          pushed = false;
        } else {
          pushed = true;
        }
      }

      // A named face or detail is FLOWN to from the whole photograph, so the
      // reader sees where on the print it sits.
      if (opts.box) frameTo(opts.box);
      else syncHash();
      if (opts.mark) setActiveMark(opts.mark);
      setNote(opts.caption ?? data.note, !!opts.noteOpen);
      stage.focus({ preventScroll: true });
    };

    // Closing, by any route - the button, Escape, the Back gesture, a swipe.
    dialog.addEventListener(
      'close',
      () => {
        stopAnim();
        window.clearTimeout(settle);
        loadToken++;
        frameEl.classList.remove('is-moving');
        dialog.classList.remove('is-sharpening');
        dialog.style.removeProperty('--pull');
        img.removeAttribute('src');
        pointers.clear();
        pinch = null;
        panFrom = null;
        swipe = null;
        gesturing = false;
        setRot(0);
        setActiveMark(null);
        if (mapEl) mapEl.hidden = true;
        lastSaid = '';
        if (document.fullscreenElement === dialog) document.exitFullscreen().catch(() => {});
        if (pushed && history.state?.examine) {
          // Our entry is on top: step back off it.
          history.back();
        } else if (location.pathname === here && location.hash) {
          history.replaceState({ ...(history.state ?? {}), examine: false }, '', `${location.pathname}${location.search}`);
        }
        pushed = false;
      },
      { signal }
    );

    // BACK CLOSES THE VIEWER. ClientRouter has already treated the step as
    // an in-page hash move by the time this runs; all that is left is to
    // bring the viewer into line with the entry we landed on.
    window.addEventListener(
      'popstate',
      () => {
        if (location.pathname !== here) return;
        if (dialog.open && !history.state?.examine) {
          pushed = false;
          dialog.close();
        } else if (!dialog.open && history.state?.examine) {
          // Forward, back into a view.
          const h = parseHash();
          if (h) open(h.face, { box: h.box, rot: h.rot, history: 'none' });
        }
      },
      { signal }
    );
    // A view link pasted into the address bar of this same page.
    window.addEventListener(
      'hashchange',
      () => {
        if (dialog.open || location.pathname !== here) return;
        const h = parseHash();
        if (h) open(h.face, { box: h.box, rot: h.rot, history: 'replace' });
      },
      { signal }
    );

    /* Buttons ---------------------------------------------------------- */
    $('[data-examine]', root)?.addEventListener('click', () => open(plateFace), { signal });

    $$<HTMLButtonElement>('[data-locate]', root).forEach((b) =>
      b.addEventListener(
        'click',
        () => {
          const m = markData.get(b.dataset.locate || '');
          if (m) open(m.face, { box: m, caption: m.caption, noteOpen: true, mark: m.id });
        },
        { signal }
      )
    );

    exFaceBtns.forEach((b) =>
      b.addEventListener(
        'click',
        () => {
          loadFace(b.dataset.exFace || 'recto');
          setNote(data.note, false);
          syncHash();
        },
        { signal }
      )
    );

    dialog.addEventListener(
      'click',
      async (e) => {
        const t = (e.target as Element).closest<HTMLButtonElement>('[data-ex]');
        if (!t) return;
        const action = t.dataset.ex;
        if (action === 'close') dialog.close();
        if (action === 'in') zoomTo(k * 1.6);
        if (action === 'out') zoomTo(k / 1.6);
        if (action === 'fit') fit();
        if (action === 'rotate') rotate(1);
        if (action === 'full') toggleFull();
        if (action === 'info') setNote(cap.textContent || data.note, Boolean(note.hidden));
        if (action === 'names') {
          const on = t.getAttribute('aria-pressed') !== 'true';
          t.setAttribute('aria-pressed', String(on));
          exMarks
            .filter((m) => m.classList.contains('region-box--person'))
            .forEach((m) => m.classList.toggle('is-named', on));
          layoutExTags();
        }
        if (action === 'link') {
          syncHash();
          if (await copyText(location.href)) toast('Link to this view copied');
        }
        if (action === 'compare') {
          compare = !compare;
          dialog.classList.toggle('is-compare', compare);
          compareBtn?.setAttribute('aria-pressed', String(compare));
          updateAside();
          stopAnim();
          const w0 = fitW;
          measure();
          const s = fitW / Math.max(1, w0);
          tx *= s;
          ty *= s;
          layoutK = 1;
          layout();
          commit();
        }
        if (action === 'swap') {
          const o = otherFace();
          if (o) {
            loadFace(o.key);
            setNote(data.note, false);
            syncHash();
          }
        }
      },
      { signal }
    );

    // The overview: press or drag to move the view there.
    if (mapEl && mapInner) {
      let mapDrag = false;
      const mapTo = (e: PointerEvent) => {
        const r = mapEl.getBoundingClientRect();
        const { u, v } = unturn(e.clientX - (r.left + r.width / 2), e.clientY - (r.top + r.height / 2));
        centreOn(clamp(u / Math.max(1, mapIW) + 0.5, 0, 1), clamp(v / Math.max(1, mapIH) + 0.5, 0, 1));
      };
      mapEl.addEventListener(
        'pointerdown',
        (e) => {
          e.preventDefault();
          e.stopPropagation();
          stopAnim();
          mapDrag = true;
          try { mapEl.setPointerCapture(e.pointerId); } catch { /* not fatal */ }
          mapTo(e);
        },
        { signal }
      );
      mapEl.addEventListener('pointermove', (e) => { if (mapDrag) mapTo(e); }, { signal });
      const mapEnd = () => {
        if (!mapDrag) return;
        mapDrag = false;
        commit();
      };
      mapEl.addEventListener('pointerup', mapEnd, { signal });
      mapEl.addEventListener('pointercancel', mapEnd, { signal });
      mapEl.addEventListener('lostpointercapture', mapEnd, { signal });
    }

    /* Gestures --------------------------------------------------------- */
    // Pointers are tracked by id, so two fingers are a pinch and one is a
    // pan. At the fitted size a finger does something else: a swipe DOWN
    // closes the viewer, a swipe ACROSS turns to the next view - the way the
    // photo apps on a phone behave. A mouse never swipes.
    const pointers = new Map<number, { x: number; y: number }>();
    let pinch: { d0: number; k0: number; mx: number; my: number; tx0: number; ty0: number } | null = null;
    let panFrom: { x: number; y: number; tx0: number; ty0: number } | null = null;
    let swipe: 'x' | 'y' | 'none' | null = null;
    let samples: { x: number; y: number; t: number }[] = [];
    let down = { x: 0, y: 0, t: 0 };
    let lastTap = { x: 0, y: 0, t: 0 };
    let picking = false;

    const pair = () => {
      const [a, b] = [...pointers.values()];
      return { d: Math.hypot(a.x - b.x, a.y - b.y) || 1, mx: (a.x + b.x) / 2, my: (a.y + b.y) / 2 };
    };
    const startPan = () => {
      const [p] = [...pointers.values()];
      panFrom = p ? { x: p.x, y: p.y, tx0: tx, ty0: ty } : null;
      samples = p ? [{ x: p.x, y: p.y, t: performance.now() }] : [];
    };
    // Speed over the last tenth of a second, in px per ms.
    const velocity = () => {
      if (samples.length < 2) return { x: 0, y: 0 };
      const a = samples[0];
      const b = samples[samples.length - 1];
      const dt = Math.max(1, b.t - a.t);
      if (performance.now() - b.t > 80) return { x: 0, y: 0 }; // held still before letting go
      return { x: (b.x - a.x) / dt, y: (b.y - a.y) / dt };
    };

    stage.addEventListener(
      'pointerdown',
      (e) => {
        if (picking || (e.target as Element).closest('button, a')) return;
        if (e.pointerType === 'mouse' && e.button !== 0) return;
        stopAnim();
        try { stage.setPointerCapture(e.pointerId); } catch { /* not fatal */ }
        pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
        if (pointers.size === 1) {
          down = { x: e.clientX, y: e.clientY, t: e.timeStamp };
          swipe = null;
          startPan();
        } else if (pointers.size === 2) {
          const p = pair();
          pinch = { d0: p.d, k0: k, mx: p.mx, my: p.my, tx0: tx, ty0: ty };
          panFrom = null;
          swipe = 'none';
        }
        frameEl.classList.add('is-moving');
        e.preventDefault();
      },
      { signal }
    );

    stage.addEventListener(
      'pointermove',
      (e) => {
        if (!pointers.has(e.pointerId)) return;
        // Ask whether a button is held NOW rather than trusting that a
        // pointerup arrived: a swallowed pointerup once left the photograph
        // following the bare cursor around the screen.
        if (e.pointerType === 'mouse' && e.buttons === 0) {
          endPointer(e);
          return;
        }
        pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
        if (pinch && pointers.size >= 2) {
          const p = pair();
          const nk = clamp((pinch.k0 * p.d) / pinch.d0, 1, maxK());
          const px = pinch.mx - area.cx;
          const py = pinch.my - area.cy;
          tx = px - (px - pinch.tx0) * (nk / pinch.k0) + (p.mx - pinch.mx);
          ty = py - (py - pinch.ty0) * (nk / pinch.k0) + (p.my - pinch.my);
          k = nk;
          paint();
          return;
        }
        if (!panFrom) return;
        const now = performance.now();
        samples.push({ x: e.clientX, y: e.clientY, t: now });
        samples = samples.filter((s) => now - s.t <= 100);
        const dx = e.clientX - panFrom.x;
        const dy = e.clientY - panFrom.y;
        if (k > 1.001 && swipe !== 'x' && swipe !== 'y') {
          tx = panFrom.tx0 + dx;
          ty = panFrom.ty0 + dy;
          paint();
          return;
        }
        if (e.pointerType === 'mouse') return;
        if (swipe === null && Math.hypot(dx, dy) > 12) {
          swipe = Math.abs(dy) > Math.abs(dx) ? 'y' : data.faces.length > 1 ? 'x' : 'none';
        }
        if (swipe === 'y') {
          tx = 0;
          ty = dy;
          dialog.style.setProperty('--pull', String(Math.min(1, Math.abs(dy) / 220)));
          paint(true);
        } else if (swipe === 'x') {
          tx = dx;
          ty = 0;
          paint(true);
        }
      },
      { signal }
    );

    const endPointer = (e: PointerEvent) => {
      if (!pointers.has(e.pointerId)) return;
      pointers.delete(e.pointerId);
      if (pointers.size < 2) pinch = null;
      if (pointers.size === 1) startPan();
      if (pointers.size > 0) return;
      panFrom = null;
      const v = velocity();
      const was = swipe;
      swipe = null;

      if (was === 'y') {
        if (Math.abs(ty) > 110 || Math.abs(v.y) > 0.6) {
          dialog.close();
          return;
        }
        dialog.style.removeProperty('--pull');
        animateTo({ k: 1, tx: 0, ty: 0 }, 200);
        return;
      }
      if (was === 'x') {
        if (Math.abs(tx) > 80 || Math.abs(v.x) > 0.5) stepFace(tx < 0 ? 1 : -1);
        else animateTo({ k: 1, tx: 0, ty: 0 }, 200);
        return;
      }

      // A double tap (or double click) zooms in on that spot, or back out.
      const still = Math.hypot(e.clientX - down.x, e.clientY - down.y) < 10 && e.timeStamp - down.t < 300;
      if (still && e.type === 'pointerup') {
        const near = Math.hypot(e.clientX - lastTap.x, e.clientY - lastTap.y) < 30;
        if (near && e.timeStamp - lastTap.t < 320) {
          lastTap = { x: 0, y: 0, t: 0 };
          if (k > 1.05) fit();
          else zoomTo(Math.min(2.5, maxK()), e.clientX, e.clientY);
          return;
        }
        lastTap = { x: e.clientX, y: e.clientY, t: e.timeStamp };
        commit();
        return;
      }
      glide(v.x, v.y);
    };
    stage.addEventListener('pointerup', endPointer, { signal });
    stage.addEventListener('pointercancel', endPointer, { signal });
    stage.addEventListener('lostpointercapture', endPointer, { signal });

    // THE WHEEL, AND WHAT IS ACTUALLY TURNING IT.
    //   - ctrl + wheel is a trackpad PINCH in Chrome, Firefox and Edge (and
    //     ctrl + a mouse wheel anywhere): zoom.
    //   - a trackpad's two-finger scroll PANS, as it does in every map and
    //     design tool; at the fitted size, where there is nothing to pan, it
    //     zooms, so the gesture is never dead.
    //   - a mouse wheel zooms.
    // A trackpad is told from a wheel by its deltas - fractional, sideways,
    // or small - and the decision is held for the whole gesture, so one
    // flick never switches from zooming to panning halfway through.
    let wheelMode: 'zoom' | 'pan' | null = null;
    let wheelIdle = 0;
    let gesturing = false;
    const smooth = (e: WheelEvent) =>
      e.deltaMode === 0 && (e.deltaX !== 0 || !Number.isInteger(e.deltaY) || Math.abs(e.deltaY) < 50);
    stage.addEventListener(
      'wheel',
      (e) => {
        e.preventDefault();
        if (gesturing) return;
        stopAnim();
        window.clearTimeout(wheelIdle);
        wheelIdle = window.setTimeout(() => (wheelMode = null), 220);
        const unit = e.deltaMode === 1 ? 16 : e.deltaMode === 2 ? area.h : 1;
        if (e.ctrlKey) {
          zoomAt(k * Math.exp(-e.deltaY * unit * 0.01), e.clientX, e.clientY);
          commitSoon();
          return;
        }
        if (!wheelMode) wheelMode = smooth(e) && k > 1.001 ? 'pan' : 'zoom';
        if (wheelMode === 'pan') {
          tx -= e.deltaX * unit;
          ty -= e.deltaY * unit;
          paint();
        } else {
          zoomAt(k * Math.exp(-e.deltaY * unit * 0.0018), e.clientX, e.clientY);
        }
        commitSoon();
      },
      { passive: false, signal }
    );

    // SAFARI'S TRACKPAD PINCH is not a wheel event at all: it arrives as
    // gesturestart/change/end, and unhandled it zooms the whole page. On an
    // iPhone the same events come alongside the touch pointers, which the
    // pinch above already handles - so these only act with no touch down.
    type Gesture = Event & { scale: number; clientX?: number; clientY?: number };
    let g0 = 1;
    dialog.addEventListener(
      'gesturestart',
      (e) => {
        if (pointers.size) return;
        e.preventDefault();
        stopAnim();
        gesturing = true;
        g0 = k;
      },
      { signal }
    );
    dialog.addEventListener(
      'gesturechange',
      (e) => {
        if (!gesturing) return;
        e.preventDefault();
        const g = e as Gesture;
        const cx = Number.isFinite(g.clientX) ? (g.clientX as number) : area.cx;
        const cy = Number.isFinite(g.clientY) ? (g.clientY as number) : area.cy;
        zoomAt(g0 * g.scale, cx, cy);
        frameEl.classList.add('is-moving');
      },
      { signal }
    );
    dialog.addEventListener(
      'gestureend',
      (e) => {
        if (!gesturing) return;
        e.preventDefault();
        gesturing = false;
        commit();
      },
      { signal }
    );

    dialog.addEventListener(
      'keydown',
      (e) => {
        if (e.altKey || e.ctrlKey || e.metaKey) return;
        const step = e.shiftKey ? 160 : 48;
        let handled = true;
        switch (e.key) {
          case 'ArrowLeft': stopAnim(); tx += step; paint(); commitSoon(); break;
          case 'ArrowRight': stopAnim(); tx -= step; paint(); commitSoon(); break;
          case 'ArrowUp': stopAnim(); ty += step; paint(); commitSoon(); break;
          case 'ArrowDown': stopAnim(); ty -= step; paint(); commitSoon(); break;
          case '+':
          case '=': zoomTo(k * 1.6); break;
          case '-':
          case '_': zoomTo(k / 1.6); break;
          case '0': fit(); break;
          case 'r': rotate(1); break;
          case 'R': rotate(-1); break;
          case 'f':
          case 'F': toggleFull(); break;
          case '[': stepFace(-1); break;
          case ']': stepFace(1); break;
          default: handled = false;
        }
        if (handled) e.preventDefault();
      },
      { signal }
    );

    img.addEventListener('dragstart', (e) => e.preventDefault(), { signal });

    // Keep the view when the viewport changes - including the phone URL bar
    // sliding in and out, and going full screen.
    window.addEventListener(
      'resize',
      () => {
        if (!dialog.open) return;
        stopAnim();
        const w0 = fitW;
        measure();
        const s = fitW / Math.max(1, w0);
        tx *= s;
        ty *= s;
        layoutK = 1;
        layout();
        mapKey = '';
        commitSoon(60);
      },
      { signal }
    );

    // The bar wraps to two rows on a narrow screen; the stage keeps clear of
    // however tall it actually is.
    const ro = new ResizeObserver(() => {
      dialog.style.setProperty('--ex-chrome', `${Math.ceil(topBar.getBoundingClientRect().height)}px`);
    });
    ro.observe(topBar);
    signal.addEventListener('abort', () => ro.disconnect());

    /* ---------------------------------------------------------------- *
     * Citation and links
     * ---------------------------------------------------------------- */
    const accessed = new Date().toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
    $$('[data-accessed]', root).forEach((el) => (el.textContent = ` (accessed ${accessed})`));
    const copyNote = $('[data-copy-note]', root);
    $$<HTMLButtonElement>('[data-copy]', root).forEach((b) =>
      b.addEventListener(
        'click',
        async () => {
          const cite = $('[data-cite]', root)!;
          let ok = false;
          if (b.dataset.copy === 'cite') {
            const clean = cite.cloneNode(true) as HTMLElement;
            clean.querySelectorAll('*').forEach((n) => [...n.attributes].forEach((a) => n.removeAttribute(a.name)));
            ok = await copyText(cite.textContent!.replace(/\s+/g, ' ').trim(), clean.innerHTML);
          } else {
            ok = await copyText(`${location.origin}${location.pathname}`);
          }
          if (copyNote && ok) {
            copyNote.textContent = b.dataset.copy === 'cite' ? 'Citation copied' : 'Link copied';
            window.setTimeout(() => (copyNote.textContent = ''), 2400);
          }
        },
        { signal }
      )
    );

    // Previous / next with the arrow keys, when nothing else wants them.
    document.addEventListener(
      'keydown',
      (e) => {
        if (dialog.open || e.defaultPrevented || e.altKey || e.ctrlKey || e.metaKey || e.shiftKey) return;
        if ((e.target as Element).closest('input, textarea, select, [contenteditable]')) return;
        const href = e.key === 'ArrowLeft' ? data.prev : e.key === 'ArrowRight' ? data.next : null;
        if (href) {
          e.preventDefault();
          navigate(href);
        }
      },
      { signal }
    );

    /* ---------------------------------------------------------------- *
     * ?regions - the authoring mode
     * ---------------------------------------------------------------- */
    let pageToastEl: HTMLElement | null = null;
    function pageToast() {
      if (!pageToastEl) {
        pageToastEl = document.createElement('p');
        pageToastEl.className = 'region-banner';
        pageToastEl.setAttribute('role', 'status');
        root!.append(pageToastEl);
      }
      return pageToastEl;
    }

    const attachPicker = (host: HTMLElement, faceOf: () => string, needShift: boolean) => {
      let start: { x: number; y: number } | null = null;
      let boxEl: HTMLElement | null = null;
      let current: Box = { x: 0, y: 0, w: 0, h: 0 };
      // getBoundingClientRect already includes any transform, so this is
      // right at any zoom.
      const rel = (e: PointerEvent) => {
        const r = host.getBoundingClientRect();
        return { x: clamp((e.clientX - r.left) / r.width, 0, 1) * 100, y: clamp((e.clientY - r.top) / r.height, 0, 1) * 100 };
      };
      host.addEventListener(
        'pointerdown',
        (e) => {
          if ((needShift && !e.shiftKey) || e.button !== 0) return;
          // Regions are recorded against the upright photograph.
          if (host === frameEl && rot) {
            toast('Turn the photograph upright to draw a region.');
            return;
          }
          e.preventDefault();
          e.stopPropagation();
          picking = true;
          start = rel(e);
          boxEl = document.createElement('span');
          boxEl.className = 'region-pick';
          host.append(boxEl);
          try { host.setPointerCapture(e.pointerId); } catch { /* not fatal */ }
        },
        { capture: true, signal }
      );
      host.addEventListener(
        'pointermove',
        (e) => {
          if (!start || !boxEl) return;
          e.stopPropagation();
          const p = rel(e);
          current = { x: Math.min(start.x, p.x), y: Math.min(start.y, p.y), w: Math.abs(p.x - start.x), h: Math.abs(p.y - start.y) };
          Object.assign(boxEl.style, { left: `${current.x}%`, top: `${current.y}%`, width: `${current.w}%`, height: `${current.h}%` });
        },
        { capture: true, signal }
      );
      const finish = async (e: PointerEvent) => {
        if (!start || !boxEl) return;
        e.stopPropagation();
        const el = boxEl;
        start = null;
        boxEl = null;
        picking = false;
        if (current.w < 0.4 || current.h < 0.4) {
          el.remove();
          return;
        }
        const line = `region: { face: '${faceOf()}', x: ${round1(current.x)}, y: ${round1(current.y)}, w: ${round1(current.w)}, h: ${round1(current.h)} },`;
        await copyText(line);
        toast(`Copied  ${line}`);
        window.setTimeout(() => el.remove(), 5000);
      };
      host.addEventListener('pointerup', finish, { capture: true, signal });
      host.addEventListener('pointercancel', finish, { capture: true, signal });
    };

    if (regionsMode) {
      root.classList.add('regions-mode');
      dialog.classList.add('regions-mode');
      $$('.face-box', root).forEach((fb) => attachPicker(fb, () => fb.dataset.faceBox || 'recto', false));
      attachPicker(frameEl, () => face, true);
      $$('.face-box img', root).forEach((i) => i.addEventListener('dragstart', (e) => e.preventDefault(), { signal }));
      toast('Region mode: drag on the photograph to copy a region. In Examine, zoom in and Shift+drag.');
    }

    /* ---------------------------------------------------------------- *
     * Arriving on a shared view
     * ---------------------------------------------------------------- */
    const arrival = parseHash();
    if (arrival) {
      const go = () => open(arrival.face, { box: arrival.box, rot: arrival.rot, history: 'replace' });
      if (document.readyState === 'complete') requestAnimationFrame(go);
      else window.addEventListener('load', go, { once: true, signal });
    }
  }

  document.addEventListener('astro:page-load', wire);
</script>