---
// src/pages/collections/[collection].astro
// The collection record: what this body of material is, where it came from,
// and an inventory of it by series.
//
// THE ORDER OF THE INVENTORY. Within a series the default is ARRANGEMENT
// order - control numbers read as numbers, so c.1.2.10 follows c.1.2.9 -
// which is the order the material is actually in, and what a finding aid
// lists. It is not the order records happen to sit in the data file, which is
// what this page showed before and which drifts as records are added.
// Readers can re-sort by date or by title. Both orders are worked out here
// and carried on each row; the buttons move the rows themselves rather than
// re-ordering them in CSS, so what a screen reader and the Tab key follow
// stays the same as what the eye sees. With no JavaScript the page still
// lists in arrangement order.
//
// FINDING YOUR WAY IN A LARGE COLLECTION (2026-09):
//   - CONTENTS at the head: each series with its count and date span, as
//     jump links - the container list of a finding aid - plus the names.
//   - A FILTER over the inventory: title, names (with see-from forms),
//     place, format, control number, description, and years matched
//     against date intervals. Everything it searches is already on the
//     page; nothing is fetched. ?q= in the address keeps it, so a filtered
//     inventory can be sent as a link.
//   - NAMES IN THIS COLLECTION: every person in it, alphabetical by the
//     authority heading, with a count, linked to their authority record.
//
// HOW IT LOOKS (2026-09 redesign, matching the guide and the person pages)
//   THE FRONT. A desk-paper band: the title and scope beside the
//   collection's key photographs standing on a hairline (the same prints,
//   with the same transition names, as its entry on the guide - so they
//   carry across when you arrive), three figures, and a row of the people
//   in it, each face linked to their record.
//   THE SHEET. The inventory opens as a contact sheet: every photograph at
//   its true proportions on a hairline, title and date beneath. List view,
//   with the names and format, is one button away; ?view=list keeps it.
//   Both views are the same rows restyled, so the filter and the order
//   work in either.
//
// THE FRONTISPIECE (2026-10). The page opens on ONE print, large, on a
// dark ground - the only dark surface in the collections. It is the key
// print (the one the guide shows large), so it grows here from the guide;
// `frontispiece: '<item-slug>'` on the collection chooses another.
//
// WHAT STANDS BESIDE IT. By default, THE RECORD: the print's title, the
// people in it with the same confidence words as the item page (silent when
// certain), and its date - all from the description, so a correction made
// there reaches the frontispiece on the next build. Optionally, above that,
// an EPIGRAPH the collection states in `epigraph` - words chosen on purpose
// and attributed by hand. NOTHING IS QUOTED AUTOMATICALLY. (An earlier pass
// lifted the first inscription it found; on the first collection visited that
// put a mistaken identification from a verso in the largest type on the page,
// out of the context that showed it was mistaken. An inscription is evidence,
// not a caption.)
//
// THE SPREAD (2026-10, second pass). The dark band is now a book's opening:
// the frontispiece at left with its record as the plate's caption, and the
// TITLE PAGE at right - which collection this is ("Collection 02 of 05",
// the same folder number as its entry on the guide), the h1, the scope, the
// epigraph if one is stated, and the figures. At its foot a line names what
// is below and links to it ("The inventory: 214 photographs in 4 series"),
// and the print is sized so the band fits the window with the next band
// showing beneath it, so the page plainly goes on. On a narrow screen the
// title page comes first, then the print.
//
// THE PRINT ROOM (2026-10). The band is lit by the sun over Lubbock at the
// moment of the visit: a window's light across the desk, its bearing, length,
// softness, colour and strength from the sun's real position, the print's
// shadow cut out of it; after sunset a twilight, then a lamp, and moonlight
// when the moon is up. Drawn by src/lib/print-room.ts on a transparent
// canvas BEHIND the content - the light touches the desk, never the
// photograph. Before the script runs (or without it) the band is the flat
// dark ground it always was.
//
// THE MOUNT TONE (2026-10). The dark ground and the pale desk bands take
// their hue from this collection's own key print, sampled at build time (see
// src/data/collections/mount.ts), so no two collections are the same cream.
// `mount: '#rrggbb'` on the collection pins or overrules it. Without either,
// the page falls back to the site palette.
import RootLayout from '../../layouts/RootLayout.astro';
import {
  COLLECTIONS,
  itemsOf,
  collectionBySlug,
  depictedNames,
  mentionedNames,
  extentOf,
  compareArrangement,
  compareChronology,
  compareTitles,
  spanOf,
  personById,
  personHref,
  headingDates,
  PEOPLE_WITH_ITEMS,
  keyItemsOf,
  naturalName,
  FACES,
  FACE_W,
  FACE_H,
  faceHref,
} from '../../data/collections/index';
import type { ResolvedItem, Face } from '../../data/collections/index';
import { plate } from '../../data/collections/images';
import { mountTokens, mountStyle } from '../../data/collections/mount';
import { CONFIDENCE_LABEL } from '../../data/collections/types';

export function getStaticPaths() {
  return COLLECTIONS.map((c) => ({ params: { collection: c.slug } }));
}

const { collection } = Astro.params;
const c = collectionBySlug.get(collection!)!;
const items = itemsOf(c.slug);

const EN = '\u2013';
const plural = (n: number, one: string, many = `${one}s`) =>
  `${n.toLocaleString('en-US')} ${n === 1 ? one : many}`;
const years = (a: number, b: number) => (a === b ? `${a}` : `${a}${EN}${b}`);

const thumbs = new Map(
  await Promise.all(
    items.map(
      async (i) =>
        [i.slug, await plate(i.collection, i.recto.file, i.recto)] as const
    )
  )
);

const H2 =
  'sec-h border-b border-haze pb-1.5 mt-10 mb-4';
const DT = 'font-mono text-[0.7rem] uppercase tracking-[0.12em] text-sage sm:w-36 sm:shrink-0 sm:pt-1';
const ROW = 'flex flex-col sm:flex-row sm:gap-4 border-b border-haze py-2';

// Series that actually have something in them, plus anything unfiled.
const grouped = c.series
  .map((s) => ({ ...s, items: items.filter((i) => i.series === s.id) }))
  .filter((s) => s.items.length > 0);
const unfiled = items.filter((i) => !i.series || !c.series.some((s) => s.id === i.series));

// Each series is listed in arrangement order, and carries the rank of every
// item in the other two orders so the buttons can rearrange it in place.
const rankIn = (list: ResolvedItem[], cmp: (a: ResolvedItem, b: ResolvedItem) => number) => {
  const order = new Map<string, number>();
  [...list].sort(cmp).forEach((i, n) => order.set(i.slug, n + 1));
  return order;
};
const sections = [
  ...grouped,
  ...(unfiled.length ? [{ id: 'unfiled', title: 'Items', scope: undefined, items: unfiled }] : []),
].map((s) => {
  const arranged = [...s.items].sort(compareArrangement);
  const byDate = rankIn(s.items, compareChronology);
  const byTitle = rankIn(s.items, compareTitles);
  return {
    ...s,
    items: arranged.map((i, n) => ({
      item: i,
      arr: n + 1,
      date: byDate.get(i.slug) ?? 0,
      title: byTitle.get(i.slug) ?? 0,
    })),
  };
});

const extent = extentOf(items);

// What the filter searches, folded the way the script folds a query:
// accents off, lower case, punctuation to spaces.
const fold = (v: string) =>
  v
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, ' ')
    .trim();
const hayOf = (i: ResolvedItem) =>
  fold(
    [
      i.title,
      i.controlNumber,
      i.format,
      i.place,
      i.date.display,
      i.description,
      ...depictedNames(i),
      ...mentionedNames(i),
      ...i.depicts.flatMap((d) => (d.person ? personById.get(d.person)?.variants ?? [] : [])),
    ]
      .filter(Boolean)
      .join(' ')
  );
// A year in the filter matches the date INTERVAL, as everywhere else in the
// collections. Open ends reach 15 years, the same reach the guide uses.
const REACH = 15;
const yearsOfItem = (i: ResolvedItem) => {
  const sp = spanOf(i);
  if (!sp) return null;
  return { a: sp.openStart ? sp.to - REACH : sp.from, b: sp.openEnd ? sp.from + REACH : sp.to };
};

// Contents: every series with its figures.
const contents = sections.map((s) => {
  const e = extentOf(s.items.map((r) => r.item));
  return { id: s.id, title: s.title, n: s.items.length, years: e ? years(e.from, e.to) : '' };
});

// Names in this collection, filed by the authority heading - this is an
// index, so the inverted form is the right one here.
const names = PEOPLE_WITH_ITEMS.map(({ person, appearances }) => ({
  p: person,
  n: new Set(appearances.filter((a) => a.item.collection === c.slug).map((a) => a.item.slug)).size,
}))
  .filter((x) => x.n > 0)
  .sort((a, b) => a.p.authorized.localeCompare(b.p.authorized));
const NAMES_ID = 'collection-names';

/* ---------------------------------------------------------------- *
 * The front
 * ---------------------------------------------------------------- */
// The key photographs: the same four the guide shows for this collection,
// so their transition names pair and they carry across from the guide.
const keys = keyItemsOf(c.slug, 4);
const key = keys[0] ?? null;

/* ---------------------------------------------------------------- *
 * The frontispiece, its record, and the epigraph if the collection has one
 * ---------------------------------------------------------------- */
// The build stops on a slug that is not this collection's own, the same
// rule as keyItems: a frontispiece that silently falls back is a choice the
// page quietly ignored.
const ownItem = (slug: string, field: string) => {
  const found = items.find((i) => i.slug === slug);
  if (!found) {
    throw new Error(
      `[collections] ${c.slug}: ${field} '${slug}' is not an item in this collection.`
    );
  }
  return found;
};
const fronti = c.frontispiece ? ownItem(c.frontispiece, 'frontispiece') : key;
const frontR = fronti ? thumbs.get(fronti.slug)! : null;
const frontAr = frontR ? frontR.width / frontR.height : 1;
// The shelf beside the title: the other key prints, never the frontispiece.
const shelf = keys.filter((i) => i.slug !== fronti?.slug).slice(0, 3);

// THE RECORD beside the print. Named people first, each with its
// confidence word when it is less than certain; the unidentified are counted
// rather than listed, and a crowd is cut short.
const RECORD_NAMES_MAX = 6;
const recordPeople = (i: ResolvedItem) => {
  const named: { name: string; qualifier: string }[] = [];
  let unknown = 0;
  for (const d of i.depicts) {
    const p = d.person ? personById.get(d.person) : undefined;
    const name = p ? naturalName(p) : d.as?.trim();
    if (!name || d.confidence === 'unidentified') {
      unknown++;
      continue;
    }
    named.push({ name, qualifier: d.confidence === 'certain' ? '' : CONFIDENCE_LABEL[d.confidence] });
  }
  const shown = named.slice(0, RECORD_NAMES_MAX);
  const more = named.length - shown.length;
  const tail = [
    more > 0 ? `${more} more named` : '',
    unknown > 0 ? (unknown === 1 ? 'one unidentified person' : `${unknown} unidentified people`) : '',
  ].filter(Boolean);
  return { shown, tail: tail.length ? `${named.length ? 'and ' : ''}${tail.join(', ')}` : '' };
};
const dateOf = (i: ResolvedItem) => (i.date.display && !/^\[?undated\]?$/i.test(i.date.display) ? i.date.display : '');
const record = fronti
  ? { title: fronti.title, href: fronti.href, date: dateOf(fronti), ...recordPeople(fronti) }
  : null;

// THE EPIGRAPH, only when the collection states one. Line breaks in the
// text are kept. `source` may name an item, which the attribution then links.
const epigraph = c.epigraph
  ? {
      lines: c.epigraph.text.split(/\r?\n/).map((l) => l.trim()).filter(Boolean),
      attribution: c.epigraph.attribution,
      source: c.epigraph.source ? ownItem(c.epigraph.source, 'epigraph source') : null,
    }
  : null;

// The mount tone, sampled from the KEY print (as on the guide, so the two
// pages agree) unless pinned with `mount`.
// Which collection this is, numbered as on the guide.
const collNo = COLLECTIONS.findIndex((x) => x.slug === c.slug) + 1;
const pad2 = (n: number) => String(n).padStart(2, '0');
// What the line at the foot of the band promises.
const cueFig = `${plural(items.length, 'photograph')}${sections.length > 1 ? ` in ${sections.length} series` : ''}`;

const tone = await mountTokens(c.slug, c.mount, key ? thumbs.get(key.slug)?.index : undefined, Astro.site ?? Astro.url);

// The people in it: each person's best face FROM THIS COLLECTION (identified
// as certain or probable, the largest share of its photograph), in order of
// birth, then by earliest photograph. Up to FACES_MAX.
const FACES_MAX = 18;
const FIRM: Record<string, number> = { certain: 0, probable: 1 };
const here = new Set(items.map((i) => i.slug));
const faceArea = (f: Face) => f.region.w * f.region.h;
const bestHere = new Map<string, Face>();
for (const f of FACES) {
  if (!(f.confidence in FIRM) || !here.has(f.item.slug)) continue;
  const cur = bestHere.get(f.person);
  if (
    !cur ||
    FIRM[f.confidence] < FIRM[cur.confidence] ||
    (FIRM[f.confidence] === FIRM[cur.confidence] && faceArea(f) > faceArea(cur))
  ) {
    bestHere.set(f.person, f);
  }
}
const yearOf = (v?: string) => (v && /^\d{3,4}$/.test(v.trim()) ? Number(v) : undefined);
const firstIn = (pid: string) => {
  const froms = items
    .filter((i) => i.depicts.some((d) => d.person === pid))
    .map((i) => spanOf(i)?.from)
    .filter((y): y is number => y !== undefined);
  return froms.length ? Math.min(...froms) : Infinity;
};
const people = names
  .filter(({ p }) => bestHere.has(p.id))
  .map(({ p, n }) => {
    const dates = headingDates(p).replace(/(\d)-/g, `$1${EN}`);
    return {
      p,
      face: bestHere.get(p.id)!,
      born: yearOf(p.birth),
      first: firstIn(p.id),
      name: naturalName(p),
      caption: `${naturalName(p)}${dates ? `, ${dates}` : ''} \u00b7 ${plural(n, 'photograph')} here`,
      n,
    };
  })
  .sort((a, b) => b.n - a.n)
  .slice(0, FACES_MAX)
  .sort((a, b) => {
    if (a.born !== undefined && b.born !== undefined) return a.born - b.born || a.name.localeCompare(b.name);
    if (a.born !== undefined) return -1;
    if (b.born !== undefined) return 1;
    return a.first - b.first || a.name.localeCompare(b.name);
  });
const PEOPLE_NOTE = 'The people in this collection, in order of birth';
const sortable = sections.some((s) => s.items.length > 1);
const custodyKnown = !/^TODO/i.test(c.custody);
---

<RootLayout
  title={`${c.title} | Collections | Austin Allison`}
  description={c.scope}
  image={items[0] ? thumbs.get(items[0].slug)?.view : undefined}
  prose={false}
>
  <noscript>
    <style is:inline>
      [data-js-only] { display: none !important; }
    </style>
  </noscript>

  <div class="collection max-w-4xl mx-auto py-6 text-iron font-serif" style={mountStyle(tone)} data-collection>
    <!-- THE SPREAD: frontispiece and title page -->
    {fronti && frontR && record && (
      <section class="fronti" aria-labelledby="coll-title" data-room>
        <canvas class="room" aria-hidden="true" data-room-canvas></canvas>
        <nav class="fronti-crumb" aria-label="Breadcrumb">
          <a href="/collections">Collections</a>
        </nav>
        <div class="fronti-grid">
          <div class="tp">
            <p class="tp-no">Collection {pad2(collNo)} <span>of {pad2(COLLECTIONS.length)}</span></p>
            <h1 id="coll-title" class="tp-title">{c.title}</h1>
            <p class="tp-lede">{c.scope}</p>
            {epigraph && (
              <figure class="epi">
                <blockquote class="epi-text">
                  {epigraph.lines.map((l) => <span class="epi-line">{l}</span>)}
                </blockquote>
                <figcaption class="epi-cap">
                  {epigraph.source ? (
                    <a href={epigraph.source.href} class="cap-t">{epigraph.attribution}</a>
                  ) : (
                    <span>{epigraph.attribution}</span>
                  )}
                </figcaption>
              </figure>
            )}
            <dl class="tp-figs">
              <div>
                <dt>Photographs</dt>
                <dd>{items.length.toLocaleString('en-US')}</dd>
              </div>
              {extent && (
                <div>
                  <dt>Dates</dt>
                  <dd>{years(extent.from, extent.to)}</dd>
                </div>
              )}
              {names.length > 0 && (
                <div>
                  <dt>People</dt>
                  <dd>{names.length.toLocaleString('en-US')}</dd>
                </div>
              )}
            </dl>
          </div>

          <figure class="plate-fig">
            <div class="fronti-stage">
              <a href={fronti.href} class="fronti-print" tabindex="-1" aria-hidden="true" style={`--ar:${frontAr.toFixed(4)}`}>
                <img
                  src={frontR.view}
                  srcset={frontR.viewSrcset}
                  sizes={`min(92vw, ${(62 * frontAr).toFixed(1)}vh)`}
                  width={frontR.width}
                  height={frontR.height}
                  alt=""
                  decoding="async"
                  fetchpriority="high"
                  transition:name={`plate-${fronti.slug}`}
                />
              </a>
            </div>
            {/* The plate's caption is its record: title, people with their
                confidence words, date - never an inscription. */}
            <figcaption class="rec">
              <a href={record.href} class="rec-link">{record.title}</a>
              {(record.shown.length > 0 || record.tail) && (
                <span class="rec-people">
                  {record.shown.map((n, k) => (
                    <>
                      {k > 0 && <span class="rec-sep">; </span>}
                      <span class="rec-name">{n.name}</span>
                      {n.qualifier && <span class="rec-q">{n.qualifier.toLowerCase()}</span>}
                    </>
                  ))}
                  {record.tail && <span class="rec-tail">{record.shown.length ? '; ' : ''}{record.tail}</span>}
                </span>
              )}
              {record.date && <span class="rec-date">{record.date}</span>}
            </figcaption>
          </figure>
        </div>

        {items.length > 0 && (
          <a href="#inventory" class="cue">
            <span class="cue-k">The inventory</span>
            <span class="cue-fig">{cueFig}</span>
            <span class="cue-arrow" aria-hidden="true">&darr;</span>
          </a>
        )}
      </section>
    )}

    <!-- THE FRONT -->
    {(!fronti || people.length > 0) && (
    <header class:list={['front', 'bleed', { 'has-plates': !fronti && shelf.length > 0, 'is-people': !!fronti }]}>
      {!fronti && (
      <div class="front-text">
        <nav class="front-crumb" aria-label="Breadcrumb">
          <a href="/collections">Collections</a>
        </nav>
        <h1 class="front-title">{c.title}</h1>
        <p class="lede">{c.scope}</p>
        <dl class="figs">
          <div>
            <dt>Photographs</dt>
            <dd>{items.length.toLocaleString('en-US')}</dd>
          </div>
          {extent && (
            <div>
              <dt>Dates</dt>
              <dd>{years(extent.from, extent.to)}</dd>
            </div>
          )}
          {names.length > 0 && (
            <div>
              <dt>People</dt>
              <dd>{names.length.toLocaleString('en-US')}</dd>
            </div>
          )}
        </dl>
      </div>
      )}

      {!fronti && shelf.length > 0 && (
        <div class="front-shelf" aria-hidden="true">
          {shelf.map((it) => {
            const r = thumbs.get(it.slug)!;
            return (
              <a href={it.href} tabindex="-1" class="plate plate--small" style={`--ar:${(r.width / r.height).toFixed(4)}`}>
                <img
                  src={r.index}
                  srcset={r.indexSrcset}
                  width={r.width}
                  height={r.height}
                  alt=""
                  decoding="async"
                  transition:name={`plate-${it.slug}`}
                />
              </a>
            );
          })}
        </div>
      )}

      {people.length > 0 && (
        <figure class="people">
          <ol class="people-row" aria-label={`${PEOPLE_NOTE}.`}>
            {people.map((w) => (
              <li>
                <a href={personHref(w.p.id)} class="people-face" aria-label={w.caption} data-caption={w.caption}>
                  <img
                    src={faceHref(w.face.id)}
                    srcset={`${faceHref(w.face.id)} 1x, ${faceHref(w.face.id, 2)} 2x`}
                    width={FACE_W}
                    height={FACE_H}
                    alt=""
                    loading="lazy"
                    decoding="async"
                    transition:name={`person-${w.p.id}`}
                  />
                </a>
              </li>
            ))}
          </ol>
          <figcaption class="people-cap">
            <span class="people-read" aria-hidden="true" data-people-read>{PEOPLE_NOTE}</span>
            <a href={`#${NAMES_ID}`} class="people-all">
              All {plural(names.length, 'name')} <span aria-hidden="true">&darr;</span>
            </a>
          </figcaption>
        </figure>
      )}
    </header>
    )}

    <span id="inventory" class="inv-anchor" aria-hidden="true"></span>
    <dl class="mt-6 border-t border-haze">
      <div class={ROW}>
        <dt class={DT}>Custody</dt>
        <dd class="m-0 min-w-0 flex-1">
          {custodyKnown
            ? c.custody
            : <span class="font-mono text-[0.7rem] uppercase tracking-[0.1em] text-caprock">To be recorded</span>}
        </dd>
      </div>
      <div class={ROW}>
        <dt class={DT}>Extent</dt>
        <dd class="m-0 min-w-0 flex-1">{plural(items.length, 'photograph')}</dd>
      </div>
      {extent && (
        <div class={ROW}>
          <dt class={DT}>Dates</dt>
          <dd class="m-0 min-w-0 flex-1">
            {years(extent.from, extent.to)}
            {extent.bulk && <span class="opacity-70">, bulk {years(extent.bulk.from, extent.bulk.to)}</span>}
            {extent.undated > 0 && <span class="opacity-70">; {extent.undated} undated</span>}
          </dd>
        </div>
      )}
      {c.lines.length > 0 && (
        <div class={ROW}>
          <dt class={DT}>Lines</dt><dd class="m-0 min-w-0 flex-1">{c.lines.join(', ')}</dd>
        </div>
      )}
      {c.places.length > 0 && (
        <div class={ROW}>
          <dt class={DT}>Places</dt><dd class="m-0 min-w-0 flex-1">{c.places.join(', ')}</dd>
        </div>
      )}
      {c.arrangement && (
        <div class={ROW}>
          <dt class={DT}>Arrangement</dt><dd class="m-0 min-w-0 flex-1">{c.arrangement}</dd>
        </div>
      )}
    </dl>

    {(contents.length > 1 || names.length > 0) && (
      <nav class="contents" aria-labelledby="contents-h">
        <h2 id="contents-h" class={H2}>Contents</h2>
        <ol class="contents-list">
          {contents.length > 1 &&
            contents.map((s) => (
              <li class="contents-row" data-contents={s.id}>
                <a href={`#${s.id}`} class="contents-link">{s.title}</a>
                <span class="contents-fig">
                  <span data-contents-n data-total={s.n}>{plural(s.n, 'photograph')}</span>
                  {s.years && <span> &middot; {s.years}</span>}
                </span>
              </li>
            ))}
          {names.length > 0 && (
            <li class="contents-row">
              <a href={`#${NAMES_ID}`} class="contents-link">Names in this collection</a>
              <span class="contents-fig">{plural(names.length, 'name')}</span>
            </li>
          )}
        </ol>
      </nav>
    )}

    {items.length > 1 && (
      <div class="filter" data-js-only>
        <label for="coll-filter" class="tool-label">Filter the inventory</label>
        <div class="filter-field">
          <input
            id="coll-filter"
            type="search"
            autocomplete="off"
            spellcheck="false"
            placeholder="A name, a title, a place, or a year"
            data-filter
          />
        </div>
        <p class="filter-status" aria-live="polite" data-filter-status></p>
      </div>
    )}

    {items.length > 1 && (
      <div class="sorter" data-js-only>
        <span class="font-mono text-[0.7rem] uppercase tracking-[0.12em] text-sage">View</span>
        <div class="seg" role="group" aria-label="How the inventory is shown">
          <button type="button" class="seg-btn" data-view="sheet" aria-pressed="true">Sheet</button>
          <button type="button" class="seg-btn" data-view="list" aria-pressed="false">List</button>
        </div>
        {sortable && (
          <>
            <span class="font-mono text-[0.7rem] uppercase tracking-[0.12em] text-sage sorter-gap">Order</span>
            <div class="seg" role="group" aria-label="Order of the inventory">
              <button type="button" class="seg-btn" data-order="arr" aria-pressed="true">As arranged</button>
              <button type="button" class="seg-btn" data-order="date" aria-pressed="false">By date</button>
              <button type="button" class="seg-btn" data-order="title" aria-pressed="false">By title</button>
            </div>
          </>
        )}
        <p class="sr-only" aria-live="polite" data-order-status></p>
      </div>
    )}

    {items.length === 0 && (
      <p class="mt-10 italic opacity-70">Nothing in this collection has been described yet.</p>
    )}

    <p class="filter-empty" hidden data-filter-empty>
      Nothing in this collection matches. Try fewer words, or a decade such as 1890s.
    </p>

    {sections.map((s) => (
      <section data-section={s.id}>
        <h2 class={H2} id={s.id}>{s.title}</h2>
        {s.scope && <p class="text-sm opacity-75 -mt-2 mb-3">{s.scope}</p>}
        <ul class="inventory is-sheet" data-list>
          {s.items.map((row) => {
            const i = row.item;
            const t = thumbs.get(i.slug)!;
            const yr = yearsOfItem(i);
            return (
              <li
                class="entry"
                data-arr={row.arr}
                data-date={row.date}
                data-title={row.title}
                data-hay={hayOf(i)}
                data-a={yr ? yr.a : undefined}
                data-b={yr ? yr.b : undefined}
              >
                <span class="entry-print">
                  <img
                    src={t.index}
                    srcset={t.indexSrcset}
                    alt=""
                    width={t.width}
                    height={t.height}
                    loading="lazy"
                    decoding="async"
                    class="entry-thumb"
                  />
                </span>
                <div class="entry-text">
                  <a href={i.href} class="entry-link text-caprock">{i.title}</a>
                  <div class="entry-meta font-mono text-[0.7rem] uppercase tracking-[0.08em] text-sage mt-0.5">
                    {i.controlNumber && <span>{i.controlNumber} &middot; </span>}
                    {i.format && <span>{i.format} &middot; </span>}
                    <span>{i.date.display}</span>
                    {i.verso && <span> &middot; verso</span>}
                    {i.pageCount > 0 && <span> &middot; {i.pageCount} {i.pageCount === 1 ? 'page' : 'pages'}</span>}
                  </div>
                  <div class="entry-names text-sm opacity-75 mt-0.5">
                    {i.depicts.length > 0 ? (
                      depictedNames(i).join(', ')
                    ) : i.mentions.length > 0 ? (
                      (() => {
                        const named = mentionedNames(i);
                        const shown = named.slice(0, 6);
                        return `Names ${shown.join(', ')}${named.length > shown.length ? `, and ${named.length - shown.length} more` : ''}`;
                      })()
                    ) : (
                      <span class="italic opacity-70">no one named</span>
                    )}
                  </div>
                </div>
              </li>
            );
          })}
        </ul>
      </section>
    ))}

    {names.length > 0 && (
      <section aria-labelledby={NAMES_ID} class="bleed names-band">
        <h2 id={NAMES_ID} class={H2}>Names in this collection</h2>
        <p class="text-sm opacity-75 -mt-2 mb-3">
          Headings as they stand in the <a href="/collections/names" class="text-caprock hover:underline">name authority file</a>.
          Figures are photographs in this collection.
        </p>
        <ul class="names">
          {names.map(({ p, n }) => {
            const d = headingDates(p);
            return (
              <li>
                <a href={personHref(p.id)} class="names-link">{p.authorized}{d ? `, ${d}` : ''}</a>
                <span class="names-n">{n}</span>
              </li>
            );
          })}
        </ul>
      </section>
    )}
  </div>
</RootLayout>

<style>
  .collection {
    --c-caprock: var(--color-caprock, #9c5b3f);
    --c-sage: var(--color-sage, #7a8471);
    --c-haze: var(--color-haze, #dad3c4);
    --c-dust: var(--color-dust, #ede7da);
    --c-iron: var(--color-iron, #3b3833);
    --c-mount: var(--color-caliche, #e8e1d1);
    /* The desk bands take this collection's mount tone when it has one. */
    --c-desk: var(--m-tint, var(--color-desk, #f5f3ed));
    --mono: var(--font-mono, ui-monospace, monospace);
  }
  /* FULL-WIDTH BANDS by border-image outset (ink overflow: no scrollbar),
     as on the guide and the person pages. */
  .bleed {
    border-image: conic-gradient(var(--c-desk) 0 0) fill 0 / / 0 100vmax;
  }

  /* The spread ---------------------------------------------------- */
  /* A dark ground in the collection's own hue, wider than the reading
     column (up to 76rem, never past the window less 2.5rem, so no sideways
     scroll), carried to the window edges by the same border-image outset as
     the bands. The negative top margin cancels the page's py-6, so the
     ground meets the header. No filter, blend, mask or 3D; the only motion
     is the cue's arrow, twice, and not at all under reduced motion. */
  .fronti {
    --fw: min(76rem, 100vw - 2.5rem);
    width: var(--fw);
    margin: -1.5rem calc((100% - var(--fw)) / 2) 0;
    padding: clamp(1.1rem, 2.5vw, 1.6rem) 0 0;
    border-image: conic-gradient(var(--m-ground, #26221d) 0 0) fill 0 / / 0 100vmax;
    color: var(--m-ink, #efe8da);
    position: relative;
  }
  /* The print room's light: a transparent canvas filling the band's box,
     under everything in it. It fades in once drawn, so a slow script never
     shows a half-lit room. */
  .room {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.6s ease;
  }
  .room.is-lit {
    opacity: 1;
  }
  .fronti > :not(.room) {
    position: relative;
  }
  .fronti-crumb a {
    color: var(--m-quiet, #b3ab9c);
    font: 0.7rem/1.4 var(--mono);
    letter-spacing: 0.1em;
    text-decoration: none;
    text-transform: uppercase;
  }
  .fronti-crumb a:hover {
    color: var(--m-ink, #efe8da);
    text-decoration: underline;
  }
  /* Narrow: the title page, then the print. Wide: the print at left, the
     title page facing it, as a frontispiece faces its title. */
  .fronti-grid {
    display: grid;
    gap: 2.25rem;
    margin-top: clamp(1rem, 2.5vw, 1.5rem);
  }
  @media (min-width: 60rem) {
    .fronti-grid {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      grid-template-areas: 'plate tp';
      align-items: center;
      gap: clamp(2.5rem, 5vw, 4.5rem);
    }
    .tp {
      grid-area: tp;
    }
    .plate-fig {
      grid-area: plate;
    }
  }

  /* The title page. */
  .tp {
    max-width: 34rem;
  }
  .tp-no {
    margin: 0;
    color: var(--m-rule, #b8957c);
    font: 0.72rem/1.4 var(--mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .tp-no span {
    color: var(--m-quiet, #b3ab9c);
  }
  .tp-title {
    margin: 0.6rem 0 0;
    font-size: clamp(2.4rem, 1.4rem + 3.4vw, 4.1rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }
  .tp-lede {
    margin: 1rem 0 0;
    font-size: 1.12rem;
    line-height: 1.5;
    opacity: 0.84;
    text-wrap: pretty;
  }
  .epi {
    margin: 1.75rem 0 0;
  }
  .epi-text {
    margin: 0;
    padding-left: clamp(0.9rem, 1.6vw, 1.25rem);
    border-left: 2px solid var(--m-rule, #b8957c);
    font-size: clamp(1.15rem, 0.95rem + 0.7vw, 1.45rem);
    font-style: italic;
    line-height: 1.35;
    text-wrap: balance;
  }
  .epi-line {
    display: block;
  }
  .epi-cap {
    margin: 0.7rem 0 0;
    padding-left: calc(clamp(0.9rem, 1.6vw, 1.25rem) + 2px);
    color: var(--m-quiet, #b3ab9c);
    font: 0.68rem/1.6 var(--mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .cap-t {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid var(--m-rule, #b8957c);
  }
  .cap-t:hover {
    color: var(--m-ink, #efe8da);
  }
  /* The figures, at the foot of the title page like an imprint. */
  .tp-figs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2.25rem;
    margin: 1.9rem 0 0;
    padding-top: 1rem;
    border-top: 1px solid rgb(255 255 255 / 0.14);
  }
  .tp-figs dt {
    color: var(--m-quiet, #b3ab9c);
    font: 0.68rem/1.4 var(--mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .tp-figs dd {
    margin: 0.2rem 0 0;
    font-size: clamp(1.45rem, 1.1rem + 1.2vw, 1.95rem);
    font-weight: 500;
    font-variant-numeric: oldstyle-nums proportional-nums;
    line-height: 1;
    white-space: nowrap;
  }

  /* The plate and its caption. */
  .plate-fig {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: 0;
  }
  /* The stage is a size container, so the print is sized from the width it
     actually has. Its HEIGHT is the smallest of: the window less the header
     and the rest of the band (so the cue and a sliver of the next band show
     on a desktop), a ceiling, and the column width over its own ratio. Width
     follows, so nothing is squashed. Where container units are unknown the
     min() is dropped whole and max-height / max-width keep the proportions. */
  .fronti-stage {
    container-type: inline-size;
    display: flex;
    justify-content: center;
    width: 100%;
  }
  .fronti-print {
    display: block;
    line-height: 0;
  }
  .fronti-print img {
    display: block;
    margin: 0;
    width: auto;
    max-width: 100%;
    max-height: 62vh;
    height: min(max(17rem, calc(100vh - var(--header-h, 5.5rem) - 18rem)), 44rem, calc(100cqi / var(--ar, 1)));
    height: min(max(17rem, calc(100svh - var(--header-h, 5.5rem) - 18rem)), 44rem, calc(100cqi / var(--ar, 1)));
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.45),
      0 30px 56px -28px rgb(0 0 0 / 0.85);
  }
  @media (min-width: 60rem) {
    .fronti-print img {
      max-height: none;
    }
  }
  @media (max-width: 40rem) {
    .fronti-print img {
      height: min(60svh, calc(100cqi / var(--ar, 1)));
    }
  }
  .rec {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
    max-width: 32rem;
    margin-top: 1.1rem;
    text-align: center;
  }
  .rec-link {
    color: var(--m-ink, #efe8da);
    font-size: 1.1rem;
    font-style: italic;
    line-height: 1.3;
    text-decoration: none;
    text-wrap: balance;
  }
  .rec-link:hover {
    text-decoration: underline;
    text-decoration-color: var(--m-rule, #b8957c);
    text-underline-offset: 0.15em;
  }
  .rec-people {
    font-size: 0.98rem;
    line-height: 1.45;
    opacity: 0.9;
    text-wrap: pretty;
  }
  /* The confidence word, as on the item page: small capitals after the name,
     absent when the identification is certain. */
  .rec-q {
    margin-left: 0.35em;
    color: var(--m-rule, #b8957c);
    font-variant-caps: all-small-caps;
    letter-spacing: 0.06em;
  }
  .rec-sep,
  .rec-tail {
    color: var(--m-quiet, #b3ab9c);
  }
  .rec-tail {
    font-style: italic;
  }
  .rec-date {
    color: var(--m-quiet, #b3ab9c);
    font: 0.72rem/1.6 var(--mono);
    letter-spacing: 0.08em;
  }

  /* THE CUE. The band's last line: what is below, how much, and a link to
     it - an index line, not a bouncing chevron. */
  .cue {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 1rem;
    margin-top: clamp(1.75rem, 3.5vw, 2.5rem);
    padding: 0.85rem 0 1rem;
    border-top: 1px solid rgb(255 255 255 / 0.14);
    color: var(--m-quiet, #b3ab9c);
    font: 0.72rem/1.4 var(--mono);
    letter-spacing: 0.12em;
    text-decoration: none;
    text-transform: uppercase;
  }
  .cue-k {
    color: var(--m-rule, #b8957c);
  }
  .cue-arrow {
    display: inline-block;
    margin-left: auto;
    font-size: 0.95rem;
    color: var(--m-ink, #efe8da);
    animation: cue-nudge 1.4s ease-in-out 1.2s 2;
  }
  .cue:hover .cue-k,
  .cue:hover .cue-arrow {
    color: var(--m-ink, #efe8da);
  }
  .cue:hover .cue-fig {
    color: var(--m-ink, #efe8da);
  }
  @keyframes cue-nudge {
    0%,
    100% {
      transform: none;
    }
    45% {
      transform: translateY(0.3rem);
    }
  }
  .rec-link:focus-visible,
  .cap-t:focus-visible,
  .cue:focus-visible,
  .fronti-crumb a:focus-visible {
    outline: 2px solid var(--m-rule, #b8957c);
    outline-offset: 3px;
  }
  /* Where the cue lands: clear of the sticky header. */
  .inv-anchor {
    display: block;
    scroll-margin-top: calc(var(--header-h, 5.5rem) + 1rem);
  }
  /* With the spread above it, the light band carries only the people. */
  .front.is-people {
    padding: 1.6rem 0 1.75rem;
    margin-bottom: 0.5rem;
  }
  .front.is-people .people {
    margin-top: 0;
  }

  /* The front ------------------------------------------------------- */
  .front {
    display: grid;
    gap: 2rem 2.75rem;
    align-items: end;
    padding: 2.25rem 0 2.5rem;
    margin-bottom: 1.5rem;
  }
  @media (min-width: 48rem) {
    .front.has-plates {
      grid-template-columns: minmax(0, 1fr) auto;
    }
  }
  .front-crumb a {
    color: var(--c-caprock);
    font: 0.7rem/1.4 var(--mono);
    letter-spacing: 0.1em;
    text-decoration: none;
    text-transform: uppercase;
  }
  .front-crumb a:hover {
    text-decoration: underline;
  }
  .front-title {
    margin: 0.5rem 0 0;
    font-size: clamp(2.3rem, 1.5rem + 3.2vw, 3.6rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }
  .front .lede {
    max-width: 34rem;
    margin: 0.9rem 0 0;
    font-size: 1.15rem;
    line-height: 1.5;
    text-wrap: pretty;
  }
  .figs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2.25rem;
    margin: 1.6rem 0 0;
  }
  .figs dt {
    color: var(--c-sage);
    font: 0.7rem/1.4 var(--mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .figs dd {
    margin: 0.15rem 0 0;
    font-size: clamp(1.6rem, 1.2rem + 1.4vw, 2.1rem);
    font-weight: 500;
    font-variant-numeric: oldstyle-nums proportional-nums;
    line-height: 1;
    white-space: nowrap;
  }

  /* The key photographs on a hairline, as on the guide. Width is capped
     through the height, never with max-width, so nothing is squashed. */
  .front-shelf {
    display: flex;
    align-items: flex-end;
    gap: clamp(0.75rem, 1.8vw, 1.5rem);
    padding-bottom: 0.9rem;
    border-bottom: 1px solid rgb(26 25 25 / 0.28);
    overflow-x: auto;
    scrollbar-width: none;
  }
  .front-shelf::-webkit-scrollbar {
    display: none;
  }
  .plate {
    flex: none;
    display: block;
    transition: transform 0.35s ease;
  }
  .plate img {
    display: block;
    width: auto;
    max-width: none;
    height: 100%;
    box-shadow:
      0 1px 1px rgb(26 25 25 / 0.16),
      0 16px 26px -18px rgb(26 25 25 / 0.6);
  }
  /* With the key print gone to the frontispiece, the shelf beside the
     title holds the other three, a size up from the old strip. */
  .plate--small {
    height: min(clamp(5.5rem, 13vw, 9rem), calc(min(8rem, 22vw) / var(--ar, 1)));
  }
  .front-shelf:hover .plate {
    transform: translateY(-3px);
  }

  /* The people in it. */
  .people {
    grid-column: 1 / -1;
    margin: 0.5rem 0 0;
  }
  .people-row {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(3.6rem, 1fr));
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (max-width: 40rem) {
    .people-row {
      grid-template-columns: repeat(auto-fill, minmax(3.1rem, 1fr));
      gap: 0.45rem;
    }
    .people-row li:nth-child(n + 13) {
      display: none;
    }
  }
  .people-face {
    display: block;
    padding: 3px;
    background: var(--c-mount);
    border: 1px solid var(--c-haze);
    box-shadow: 0 8px 14px -12px rgb(26 25 25 / 0.6);
    transition:
      transform 0.25s ease,
      border-color 0.25s ease,
      opacity 0.25s ease;
  }
  .people-face img {
    display: block;
    width: 100%;
    height: auto;
  }
  .people-face:hover,
  .people-face:focus-visible {
    border-color: var(--c-caprock);
    transform: translateY(-3px);
  }
  .people-face:focus-visible {
    outline: 2px solid var(--c-caprock);
    outline-offset: 2px;
  }
  .people-row:has(.people-face:hover) .people-face:not(:hover) {
    opacity: 0.5;
  }
  .people-cap {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.3rem 1.25rem;
    margin-top: 0.8rem;
    color: var(--c-sage);
    font: 0.7rem/1.5 var(--mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .people-read {
    min-height: 1.5em;
  }
  .people-read.is-reading {
    color: var(--c-iron);
  }
  .people-all {
    color: var(--c-caprock);
    text-decoration: none;
    white-space: nowrap;
  }
  .people-all:hover {
    text-decoration: underline;
  }

  .sorter-gap {
    margin-left: 0.6rem;
  }
  .names-band {
    margin-top: 3.5rem;
    padding: 0.5rem 0 2.5rem;
  }
  .names-band :global(h2) {
    border-bottom-color: rgb(26 25 25 / 0.12);
  }



  /* Anything this page hides with the `hidden` attribute stays hidden:
     .entry sets display, and a class selector outranks the browser's own
     [hidden] rule - the bug this project has hit twice already. */
  .collection [hidden] {
    display: none !important;
  }

  /* Contents ------------------------------------------------------ */
  .contents-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .contents-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.1rem 1rem;
    padding: 0.4rem 0;
    border-bottom: 1px dotted var(--c-haze);
    transition: opacity 0.2s ease;
  }
  .contents-row.is-empty {
    opacity: 0.4;
  }
  .contents-link {
    color: var(--c-caprock);
    text-decoration: none;
  }
  .contents-link:hover {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
  .contents-fig {
    font-family: ui-monospace, monospace;
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--c-sage);
    white-space: nowrap;
  }

  /* Filter -------------------------------------------------------- */
  .filter {
    max-width: 30rem;
    margin-top: 2rem;
  }
  .tool-label {
    display: block;
    font-family: ui-monospace, monospace;
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c-sage);
  }
  .filter input {
    width: 100%;
    padding: 0.4rem 0.2rem;
    border: 0;
    border-bottom: 1.5px solid var(--c-iron);
    border-radius: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    font-size: 1.1rem;
    -webkit-appearance: none;
    appearance: none;
  }
  .filter input::placeholder {
    color: var(--c-sage);
    font-style: italic;
  }
  .filter input:focus {
    outline: none;
    border-bottom-color: var(--c-caprock);
    box-shadow: 0 1.5px 0 0 var(--c-caprock);
  }
  .filter-status {
    min-height: 1.3em;
    margin: 0.35rem 0 0;
    font-family: ui-monospace, monospace;
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--c-sage);
  }
  .filter-empty {
    margin-top: 2rem;
    font-style: italic;
    opacity: 0.75;
  }

  /* Names in this collection ------------------------------------- */
  .names {
    margin: 0;
    padding: 0;
    list-style: none;
    columns: 1;
    column-gap: 2.5rem;
  }
  @media (min-width: 40rem) {
    .names {
      columns: 2;
    }
  }
  .names li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.3rem 0;
    border-bottom: 1px dotted var(--c-haze);
    break-inside: avoid;
  }
  .names-link {
    color: var(--c-caprock);
    text-decoration: none;
  }
  .names-link:hover {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
  .names-n {
    flex-shrink: 0;
    font-family: ui-monospace, monospace;
    font-size: 0.72rem;
    color: var(--c-sage);
  }

  .sorter {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.9rem;
    margin-top: 1.75rem;
  }
  .seg {
    display: inline-flex;
  }
  .seg-btn {
    padding: 0.3rem 0.75rem;
    border: 1px solid var(--c-haze);
    background: transparent;
    color: var(--c-iron);
    font: 500 0.7rem/1.2 ui-monospace, monospace;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
  }
  .seg-btn + .seg-btn {
    margin-left: -1px;
  }
  .seg-btn:hover {
    position: relative;
    border-color: var(--c-caprock);
  }
  .seg-btn[aria-pressed='true'] {
    position: relative;
    background: var(--c-caprock);
    border-color: var(--c-caprock);
    color: var(--color-canvas, #f7f4ec);
  }
  .seg-btn:focus-visible {
    outline: 2px solid var(--c-caprock);
    outline-offset: 2px;
  }

  .inventory {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .entry {
    position: relative;
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
    padding: 1rem 0.5rem 1rem 0;
    border-top: 1px solid var(--c-haze);
    transition: background-color 0.2s ease;
  }
  .entry:hover,
  .entry:focus-within {
    background: rgb(218 211 196 / 0.2);
  }
  .entry:focus-within {
    outline: 2px solid var(--c-caprock);
    outline-offset: 2px;
  }
  /* LIST VIEW. A fixed sleeve: rows keep their height before the images
     arrive, and a portrait cabinet card and a landscape gin print read as
     one size of object rather than one width. */
  .entry-print {
    position: relative;
    display: block;
    flex-shrink: 0;
  }
  .entry-thumb {
    display: block;
    width: 7rem;
    height: 9rem;
    padding: 0.25rem;
    object-fit: contain;
    background: rgb(218 211 196 / 0.4);
    border: 1px solid var(--c-haze);
  }
  .entry-text {
    min-width: 0;
    flex: 1;
  }

  /* SHEET VIEW. The same rows as a contact sheet: every photograph at its
     true proportions standing on one hairline, title and date beneath. The
     caption block has a fixed height so every row of prints shares its
     baseline whatever the titles do. */
  .inventory.is-sheet {
    --sheet-h: 9.5rem;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 2.25rem 1.6rem;
    padding-top: 0.75rem;
  }
  @media (max-width: 40rem) {
    .inventory.is-sheet {
      --sheet-h: 7rem;
      gap: 1.75rem 1.1rem;
    }
  }
  .is-sheet .entry {
    flex-direction: column;
    align-items: stretch;
    gap: 0;
    max-width: 100%;
    padding: 0;
    border-top: 0;
  }
  .is-sheet .entry:hover,
  .is-sheet .entry:focus-within {
    background: none;
  }
  .is-sheet .entry-print {
    transition: transform 0.25s ease;
  }
  .is-sheet .entry:hover .entry-print,
  .is-sheet .entry:focus-within .entry-print {
    transform: translateY(-4px);
  }
  /* max-height, not height, so a wide print is never squashed. */
  .is-sheet .entry-thumb {
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: var(--sheet-h);
    padding: 0;
    object-fit: fill;
    background: none;
    border: 0;
    box-shadow:
      0 1px 1px rgb(26 25 25 / 0.18),
      0 12px 18px -12px rgb(26 25 25 / 0.55);
  }
  /* The hairline, run half a gap past each print so a row reads as one. */
  .is-sheet .entry-print::after {
    content: '';
    position: absolute;
    left: -0.8rem;
    right: -0.8rem;
    bottom: -1px;
    border-bottom: 1px solid rgb(26 25 25 / 0.28);
  }
  /* Width 0 and min-width 100%: the caption takes the print's width and
     never widens it. */
  .is-sheet .entry-text {
    flex: none;
    width: 0;
    min-width: 100%;
    height: 3.6rem;
    margin-top: 0.55rem;
  }
  .is-sheet .entry-link {
    display: -webkit-box;
    overflow: hidden;
    font-size: 0.95rem;
    line-height: 1.25;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }
  .is-sheet .entry-meta {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .is-sheet .entry-names {
    display: none;
  }

  /* The whole row is the link, and one link per row for the keyboard. */
  .entry-link {
    text-decoration: none;
  }
  .entry-link::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .entry-link:focus {
    outline: none;
  }
  .entry:hover .entry-link {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  @media (prefers-reduced-motion: reduce) {
    .entry,
    .entry-print,
    .plate,
    .people-face {
      transition: none;
    }
    .cue-arrow {
      animation: none;
    }
    .room {
      transition: none;
    }
    .is-sheet .entry:hover .entry-print,
    .is-sheet .entry:focus-within .entry-print,
    .front-shelf:hover .plate,
    .people-face:hover,
    .people-face:focus-visible {
      transform: none;
    }
  }
  @media print {
    .bleed {
      border-image: none;
    }
    .fronti {
      width: auto;
      margin: 0 0 1rem;
      border-image: none;
    }
    .fronti,
    .fronti a,
    .tp-no,
    .tp-no span,
    .tp-figs dt,
    .epi-cap,
    .rec-sep,
    .rec-tail,
    .rec-date,
    .rec-q {
      color: #3b3833 !important;
    }
    .fronti-print img {
      height: auto;
      max-height: 55vh;
      box-shadow: none !important;
    }
    .cue,
    .room {
      display: none;
    }
  }
</style>

<script>
  import { lightAt, drawRoom } from '../../lib/print-room';

  // THE PRINT ROOM. Draw the light for now; again on resize, when the print
  // or the fonts settle (either moves the print), and every five minutes
  // while the page is open. Nothing animates between draws.
  function wireRoom(root: HTMLElement, signal: AbortSignal) {
    const band = root.querySelector<HTMLElement>('[data-room]');
    const canvas = band?.querySelector<HTMLCanvasElement>('[data-room-canvas]');
    const print = band?.querySelector<HTMLImageElement>('.fronti-print img');
    if (!band || !canvas || !print) return;
    const work = document.createElement('canvas');
    let queued = 0;
    const paint = () => {
      queued = 0;
      if (signal.aborted) return;
      const tint = getComputedStyle(root).getPropertyValue('--m-tint');
      try {
        const shadow = drawRoom(canvas, print, tint, lightAt(Date.now()), work);
        if (shadow) print.style.boxShadow = shadow;
        canvas.classList.add('is-lit');
      } catch {
        // The room stays its flat ground; nothing else depends on this.
      }
    };
    const soon = () => {
      if (!queued) queued = requestAnimationFrame(paint);
    };
    const ro = new ResizeObserver(soon);
    ro.observe(band);
    if (!print.complete) print.addEventListener('load', soon, { once: true, signal });
    document.fonts?.ready.then(soon);
    const timer = window.setInterval(soon, 5 * 60 * 1000);
    signal.addEventListener('abort', () => {
      ro.disconnect();
      window.clearInterval(timer);
      if (queued) cancelAnimationFrame(queued);
    });
    soon();
  }

  function wire() {
    const root = document.querySelector<HTMLElement>('[data-collection]');
    if (!root || root.dataset.wired) return;
    root.dataset.wired = '1';
    const ac = new AbortController();
    document.addEventListener('astro:before-swap', () => ac.abort(), { once: true });

    wireFilter(root, ac.signal);
    wireView(root, ac.signal);
    wirePeople(root, ac.signal);
    wireRoom(root, ac.signal);
    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-order]'));
    const status = root.querySelector<HTMLElement>('[data-order-status]');
    buttons.forEach((b) =>
      b.addEventListener(
        'click',
        () => {
          const order = (b.dataset.order ?? 'arr') as 'arr' | 'date' | 'title';
          root.querySelectorAll<HTMLElement>('[data-list]').forEach((list) => {
            const rows = Array.from(list.querySelectorAll<HTMLElement>('.entry'));
            rows
              .sort((x, y) => Number(x.dataset[order] ?? 0) - Number(y.dataset[order] ?? 0))
              .forEach((row) => list.append(row));
          });
          buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
          if (status) status.textContent = `Inventory ordered ${b.textContent?.trim().toLowerCase()}.`;
        },
        { signal: ac.signal }
      )
    );
  }

  // SHEET OR LIST. Only a class on each inventory; the rows are the same,
  // so the filter and the order carry over. ?view=list keeps the list.
  function wireView(root: HTMLElement, signal: AbortSignal) {
    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-view]'));
    if (!buttons.length) return;
    const lists = Array.from(root.querySelectorAll<HTMLElement>('[data-list]'));
    const status = root.querySelector<HTMLElement>('[data-order-status]');
    const set = (view: string, announce: boolean) => {
      lists.forEach((l) => l.classList.toggle('is-sheet', view === 'sheet'));
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.view === view)));
      const url = new URL(location.href);
      if (view === 'list') url.searchParams.set('view', 'list');
      else url.searchParams.delete('view');
      history.replaceState(history.state, '', url);
      if (announce && status) status.textContent = view === 'list' ? 'Inventory as a list.' : 'Inventory as a contact sheet.';
    };
    if (new URLSearchParams(location.search).get('view') === 'list') set('list', false);
    buttons.forEach((b) => b.addEventListener('click', () => set(b.dataset.view ?? 'sheet', true), { signal }));
  }

  // The line under the faces names the one you are on.
  function wirePeople(root: HTMLElement, signal: AbortSignal) {
    const read = root.querySelector<HTMLElement>('[data-people-read]');
    if (!read) return;
    const rest = read.textContent ?? '';
    const say = (text: string | null) => {
      read.textContent = text ?? rest;
      read.classList.toggle('is-reading', !!text);
    };
    root.querySelectorAll<HTMLElement>('.people-face').forEach((a) => {
      const text = a.dataset.caption ?? null;
      a.addEventListener('pointerenter', () => say(text), { signal });
      a.addEventListener('pointerleave', () => say(null), { signal });
      a.addEventListener('focus', () => say(text), { signal });
      a.addEventListener('blur', () => say(null), { signal });
    });
  }

  // THE FILTER. Every word must begin some word of the row's record; a
  // four-digit year, or a decade like 1890s, must overlap the row's date
  // interval. Rows that fail are hidden, series with nothing left are
  // hidden, and the contents say how many of each series are showing.
  function wireFilter(root: HTMLElement, signal: AbortSignal) {
    const input = root.querySelector<HTMLInputElement>('[data-filter]');
    if (!input) return;
    const status = root.querySelector<HTMLElement>('[data-filter-status]');
    const empty = root.querySelector<HTMLElement>('[data-filter-empty]');
    const sections = Array.from(root.querySelectorAll<HTMLElement>('[data-section]'));
    const rows = Array.from(root.querySelectorAll<HTMLElement>('.entry'));
    const total = rows.length;
    const fold = (v: string) =>
      v
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, ' ')
        .trim();
    const hay = new Map(rows.map((r) => [r, (r.dataset.hay ?? '').split(' ')]));
    const plural = (n: number, one: string) => `${n.toLocaleString('en-US')} ${n === 1 ? one : `${one}s`}`;

    const apply = (q: string) => {
      const words = fold(q).split(' ').filter(Boolean);
      const dates = words.filter((w) => /^\d{4}s?$/.test(w));
      const text = words.filter((w) => !dates.includes(w));
      let shown = 0;
      rows.forEach((r) => {
        const h = hay.get(r) ?? [];
        let ok = text.every((t) => h.some((x) => x.startsWith(t)));
        if (ok && dates.length) {
          const a = r.dataset.a === undefined ? NaN : Number(r.dataset.a);
          const b = r.dataset.b === undefined ? NaN : Number(r.dataset.b);
          ok = dates.every((d) => {
            const from = Number(d.slice(0, 4));
            const to = d.endsWith('s') ? from + 9 : from;
            return !Number.isNaN(a) && !Number.isNaN(b) && b >= from && a <= to;
          });
        }
        r.hidden = !ok;
        if (ok) shown++;
      });
      sections.forEach((s) => {
        const n = Array.from(s.querySelectorAll<HTMLElement>('.entry')).filter((r) => !r.hidden).length;
        s.hidden = n === 0;
        const row = root.querySelector<HTMLElement>(`[data-contents="${CSS.escape(s.dataset.section ?? '')}"]`);
        const fig = row?.querySelector<HTMLElement>('[data-contents-n]');
        if (row && fig) {
          const t = Number(fig.dataset.total ?? 0);
          fig.textContent = words.length ? `${n} of ${plural(t, 'photograph')}` : plural(t, 'photograph');
          row.classList.toggle('is-empty', words.length > 0 && n === 0);
        }
      });
      if (empty) empty.hidden = !(words.length && shown === 0);
      if (status) status.textContent = words.length ? `Showing ${shown} of ${plural(total, 'photograph')}` : '';
      // Keep it in the address, so a filtered inventory is a link.
      const url = new URL(location.href);
      if (words.length) url.searchParams.set('q', q.trim());
      else url.searchParams.delete('q');
      history.replaceState(history.state, '', url);
    };

    const start = new URLSearchParams(location.search).get('q');
    if (start) {
      input.value = start;
      apply(start);
    }
    input.addEventListener('input', () => apply(input.value), { signal });
    input.addEventListener(
      'keydown',
      (e) => {
        if (e.key === 'Escape' && input.value) {
          e.preventDefault();
          input.value = '';
          apply('');
        }
      },
      { signal }
    );
  }

  document.addEventListener('astro:page-load', wire);
</script>