---
/**
 * src/pages/photography/[slug].astro — "The Light Table"
 *
 * A pannable 3200x2200 mount desk. Plates are pinned at surveyed
 * coordinates; clicking one opens a viewing station.
 *
 * ── WHAT CHANGED IN THIS VERSION ──────────────────────────────────
 *
 *  1. SERIES, the galleries, and the image pipeline moved to
 *     src/data/photography.ts. Nothing about the board changed; the
 *     data is now readable by the plate index and the plate pages too.
 *     Plate `title` and `place` are separate fields there, and
 *     coordinates are numbers — see the schema notes in that file.
 *  2. The open plate is written to the URL as ?plate=04, and a
 *     ?plate= on arrival opens that plate. This is what makes the
 *     index's "view on the light table" links land in the right frame,
 *     and what lets a reader share the view they're looking at.
 *  3. Window-level listeners are registered against an AbortController
 *     that fires on astro:before-swap. Previously each View Transition
 *     navigation left a full set of keydown/pointer/resize handlers
 *     alive, closed over the detached previous page.
 *  4. The HUD registry gains a link to the plate index.
 *  5. The "plate record" link moved out of the lightbox toolbar and
 *     into the actions row beside the print and licensing links, so
 *     it's reachable on a phone. The toolbar is already full at 380px.
 *     The actions row hides itself when it has nothing in it.
 *  6. The gallery essay is gone from the HUD — it lives on the album
 *     page now as SERIES[].lede. `essay` is no longer a gallery field.
 *  7. Plate x/y/w are optional in the data module now — omit them and
 *     the auto-flow places the plate. The sheet sizes itself to the
 *     result, so BOARD_W/BOARD_H are gone in favour of gallery.boardW
 *     and gallery.boardH.
 *  8. The HUD moved OUT of <main> to sit beside it, so it escapes the
 *     board's touch-none and can be scrolled and pinched on a phone.
 *     It's inerted explicitly while the lightbox is open. Ctrl/Cmd/Alt
 *     key combinations and a ctrl+wheel over the HUD now pass through
 *     to the browser — previously the board swallowed Ctrl+- and
 *     Ctrl+0, so a page-zoomed visitor was stuck at that zoom.
 *  9. PAGE-ZOOM ESCAPE, all of it local to this file. `touch-none` on
 *     the viewport hands pinch to the board, which is right — except
 *     when the PAGE itself is zoomed (the visual viewport), because
 *     then the one gesture that would undo it is the one the board has
 *     claimed. The board now watches visualViewport.scale and, while
 *     the page is zoomed, releases pinch back to the browser and says
 *     so. It reclaims it the moment the page returns to 1:1.
 *
 *     Confirmed on a phone: the notice fires, and it only can when
 *     visualViewport.scale reads above 1.02 — so what carried across
 *     really was the visual viewport, not browser page zoom.
 *
 *     ?debugViewport puts the live numbers on screen, for reading on a
 *     real phone where there's no console. DEV only — it never reaches
 *     a build. `npm run dev -- --host`, then the network URL.
 *
 * Everything else — the pointer model, the clamped pan, fit-to-board,
 * the bake/unbake zoom, the focus trap — is unchanged.
 */
import Layout from '../../layouts/RootLayout.astro';
import {
  getGalleries,
  getGallery,
  LICENSE_EMAIL,
  SERIES,
  plateLine,
} from '../../data/photography';

export async function getStaticPaths() {
  const galleries = await getGalleries();
  return galleries.map((g) => ({ params: { slug: g.slug } }));
}

const { slug } = Astro.params;
const gallery = await getGallery(slug!);
const { plates, bounds, eager, sheets } = gallery;

/* A gallery only shows sheet machinery if it actually has sheets. One
   unnamed sheet is the ordinary case and looks exactly as it did before
   any of this existed. */
const hasSheets = sheets.length > 1 || sheets[0].label !== '';
const registry = SERIES;
---

{/* bleed AND hideNav, both load-bearing.

    Without bleed, RootLayout wraps this in its own
    `max-w-7xl mx-auto px-6 py-12` <main>: 24px of white down each side
    of the desk, 48px above and below, and a document 222px taller than
    the viewport on a phone — so a workspace that is meant to be fixed
    under your thumb scrolled. The prop was added in August for exactly
    this on the album; the light table never got it.

    Without hideNav the sticky header takes 126px of flow above a board
    already sized at 100dvh, which is the rest of that scroll, and then
    pins itself over the top of the desk. Keeping it would mean
    measuring --header-h here too, to preserve a frame this page does
    not use: the light table is a place you go INTO, it already carries
    a complete navigation of its own — close album to leave, the
    registry to change series, a link to the plate index — and two
    exits sitting near each other only asks which one is real. hideFoot
    was already declaring half of this. */}
<Layout
  title={`${gallery.title} | Austin Allison`}
  bleed={true}
  hideNav={true}
  hideFoot={true}
>
  {/* A section, not a <main>. This sat inside RootLayout's own <main>,
      so the page shipped NESTED LANDMARKS — invalid, and two of them is
      a real problem for a screen reader deciding what the page is.

      Not role="application" either, tempting as it is for a pannable
      canvas: that suppresses browse mode outright, and a reader who
      lands here would lose the normal way of getting around before
      discovering there is a keyboard scheme to replace it. A named
      region says what this is and takes nothing away. */}
  <section
    id="workspace-viewport"
    class="w-full h-[100dvh] overflow-hidden bg-plat-desk text-iron select-none cursor-grab active:cursor-grabbing relative touch-none"
    aria-label={`${gallery.title} — mount desk`}
  >
    <!-- ── the mount desk ─────────────────────────────────────── -->
    <div
      id="light-table"
      class="absolute pointer-events-auto origin-top-left will-change-transform"
      style={`width:${gallery.boardW}px; height:${gallery.boardH}px;`}
      data-center-x={gallery.centerX}
      data-center-y={gallery.centerY}
      data-board-w={gallery.boardW}
      data-board-h={gallery.boardH}
      data-min-x={bounds.minX}
      data-min-y={bounds.minY}
      data-max-x={bounds.maxX}
      data-max-y={bounds.maxY}
    >
      {/* Each sheet names itself on the desk, the way a plat book
          titles its sheets. It is also the only orientation you get
          while panning freely across a desk with several on it — the
          rail says where you are, this says what you are looking at
          without a trip back to the notebook. */}
      {hasSheets &&
        sheets.map((sh) =>
          sh.label ? (
            <div
              class="sheet-title"
              aria-hidden="true"
              style={`left:${sh.bounds.minX}px; top:${sh.bounds.minY - 62}px; width:${sh.bounds.maxX - sh.bounds.minX}px;`}
            >
              {sh.label}
            </div>
          ) : null,
        )}

      {plates.map((plate) => (
        <button
          type="button"
          class="plate absolute flex flex-col group text-left cursor-pointer focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-caprock"
          style={`left:${plate.x}px; top:${plate.y}px; width:${plate.w}px;`}
          data-lightbox-trigger
          data-index={plate.index}
          aria-label={`Open ${plate.plate}, ${plateLine(plate)}`}
        >
          <span class="block border border-iron/10 p-3 bg-canvas shadow-md overflow-hidden transition-all duration-500 group-hover:shadow-xl group-hover:border-caprock/30">
            <span class="block overflow-hidden bg-iron/5">
              {/* No srcset. Density descriptors (1x/2x) choose on DPR
                  alone and cannot see the transform on #light-table, so
                  a plate drawn at 42px on a phone was still fetching the
                  1400 file. The ladder goes in data-lod instead and the
                  board picks a rung from its own scale — see LEVEL OF
                  DETAIL in the script.

                  Opening src is the 160 thumb: at the fit-to-board view
                  a phone has every plate on screen at once, so lazy
                  loading defers nothing and whatever is named here is
                  what all 38 download. */}
              <img
                src={plate.img.thumb}
                data-lod={[
                  `${Math.min(160, plate.img.width)}|${plate.img.thumb}`,
                  `${Math.min(280, plate.img.width)}|${plate.img.index}`,
                  `${Math.min(700, plate.img.width)}|${plate.img.board}`,
                  `${Math.min(1400, plate.img.width)}|${plate.img.board2x}`,
                ].join(',')}
                width={plate.img.width}
                height={plate.img.height}
                alt=""
                loading={eager.has(plate.index) ? 'eager' : 'lazy'}
                fetchpriority={eager.has(plate.index) ? 'high' : 'auto'}
                decoding="async"
                draggable="false"
                class="w-full h-auto object-cover opacity-95 group-hover:opacity-100 transition-opacity duration-700"
              />
            </span>
          </span>
          <span class="w-full flex justify-between items-baseline text-[10px] font-mono text-sage uppercase tracking-wider mt-2 px-1">
            <span class="font-semibold text-iron/70">{plate.plate}</span>
            <span>{plate.coordinates}</span>
          </span>
        </button>
      ))}
    </div>
  </section>

  <!-- ── field notebook (fixed HUD) ────────────────────────────────
       A SIBLING of #workspace-viewport, not a child. It's
       position:fixed either way, so it renders in the same place — but touch-action is intersected
       down the ancestor chain, and #workspace-viewport carries
       touch-none for the board's own pinch. Nested, the notebook
       inherited that and couldn't be pinched or scrolled on a phone; a
       `touch-action: auto` rule on it lost to the ancestor. Out here the
       rule actually applies.

       The trade: it's no longer covered when the board is made inert,
       so openLightbox/closeLightbox toggle inert on it explicitly. -->
  <div
    id="fixed-hud-container"
    class="fixed top-4 left-4 right-4 md:top-8 md:left-8 md:right-8 z-50 flex justify-between items-start pointer-events-none gap-4"
  >
    <div
      id="hud-overlay"
      data-expanded="false"
      class="pointer-events-auto w-full bg-canvas p-4 md:p-6 border border-llano/70 shadow-md transition-all duration-300 flex flex-col gap-1.5"
    >
      <div class="flex items-start justify-between gap-3">
        <span class="font-serif text-lg md:text-2xl text-iron/60">
          Series {gallery.number}.
        </span>
        <button
          id="hud-toggle"
          type="button"
          class="md:hidden font-mono text-[10px] uppercase tracking-widest text-iron/70 hover:text-caprock transition-colors flex items-center gap-1 focus:outline-none shrink-0"
          aria-expanded="false"
          aria-controls="hud-collapsible"
        >
          <span id="toggle-text">info</span>
          <span id="toggle-icon" class="transition-transform duration-300 inline-block">+</span>
        </button>
      </div>

      <h1 class="font-serif text-lg md:text-2xl font-light tracking-tight text-caprock leading-tight">
        {gallery.title}
      </h1>

      <p class="font-mono text-[10px] uppercase tracking-widest text-iron/70">
        {gallery.region}
      </p>

      {/* Above the fold on purpose. The collapsible below is shut on a
          phone, and once a series is spread over sheets this is its
          primary navigation — not a detail to go looking for. */}
      {hasSheets && (
        <nav
          id="sheet-rail"
          class="flex flex-wrap items-center gap-x-3 gap-y-1 mt-3 pt-3 border-t border-llano/60"
          aria-label="Sheets"
        >
          <span class="font-mono text-[10px] uppercase tracking-widest text-iron/60 w-full">
            Sheets
          </span>
          {sheets.map((sh) => (
            <button
              type="button"
              class="sheet-mark font-mono text-[10px] text-redbed hover:text-caprock transition-colors text-left inline-flex items-center min-h-[30px] py-1 pr-1"
              data-sheet={sh.index}
              data-current={sh.index === 0 ? 'true' : 'false'}
            >
              {sh.label || `Sheet ${sh.index + 1}`}
            </button>
          ))}
        </nav>
      )}

      <div id="hud-collapsible" class="hidden md:block transition-all duration-300 overflow-hidden">
        <nav class="flex flex-col gap-1.5 mt-4 border-t border-llano/60 pt-4 pb-2">
          <span class="font-mono text-[10px] uppercase tracking-widest text-iron/60 mb-1">
            Series Registry
          </span>
          {registry.map((s) =>
            !s.built ? (
              <span
                class="font-mono text-[10px] text-iron/70 truncate cursor-default"
                title="In preparation"
              >
                {s.number}. {s.title} <span class="text-iron/55">— in preparation</span>
              </span>
            ) : s.slug === gallery.slug ? (
              <span
                aria-current="page"
                class="font-mono text-[10px] text-redbed font-semibold truncate flex items-center gap-1.5"
              >
                <span aria-hidden="true">▸</span>{s.number}. {s.title}
              </span>
            ) : (
              <a
                href={`/photography/${s.slug}`}
                class="font-mono text-[10px] text-redbed hover:text-caprock transition-colors truncate"
              >
                {s.number}. {s.title}
              </a>
            ),
          )}

          <a
            href={`/photography/plates#${gallery.slug}`}
            class="font-mono text-[10px] uppercase tracking-widest text-iron/70 hover:text-caprock transition-colors mt-2 pt-2 border-t border-llano/40"
          >
            Plate index &rarr;
          </a>
        </nav>
      </div>

      <!-- board controls + legend -->
      <div class="flex items-center gap-3 mt-2 pt-2 border-t border-llano/60">
        {/* The control now reads louder than the instructions that
            describe it. It was the other way round: `fit board` at
            iron/50 beside a caprock instruction line, so the loudest
            text on the page was also the least important. */}
        <button
          id="btn-fit"
          type="button"
          class="font-mono text-[10px] uppercase tracking-widest text-redbed hover:text-caprock transition-colors focus:outline-none border border-llano px-2 py-1"
          title="Frame every plate (0)"
        >
          fit board
        </button>
        <span class="hidden md:inline font-mono text-[10px] uppercase tracking-wider text-iron/70">
          drag to move · ⌘/ctrl + scroll to zoom · click to open
        </span>
      </div>

      <div
        id="mobile-instructions"
        class="hidden md:hidden font-mono text-[10px] uppercase tracking-wider text-iron/70 items-center gap-2 border-t border-llano/50 pt-3 mt-1"
      >
        <span aria-hidden="true">●</span> Pinch and drag to explore. Tap to open.
      </div>
    </div>

    <div class="pointer-events-auto shrink-0">
      <a
        href="/photography"
        class="font-mono text-[10px] lowercase tracking-wide bg-canvas px-3 py-1.5 md:px-4 md:py-2 border border-llano/70 text-redbed hover:text-caprock transition-colors shadow-sm block"
      >
        &larr; close<span class="hidden sm:inline"> album</span>
      </a>
    </div>
  </div>

  <!-- ?debugViewport readout. DEV only — it never reaches a build, so
       nobody can summon a diagnostic panel on the live site by pasting
       a query string. Run `npm run dev -- --host` and open the network
       URL on a phone to use it. -->
  {import.meta.env.DEV && (
    <div
      id="viewport-probe"
      class="hidden fixed bottom-2 left-2 z-[200] bg-canvas/95 border border-caprock rounded-sm px-2 py-1.5 font-mono text-[10px] leading-snug text-iron pointer-events-none whitespace-pre"
    ></div>
  )}

  <!-- Page-zoom notice, shown only while the visual viewport is zoomed.
       Empty here: the script fills it, because a phone gets "pinch" and
       anything else gets the keyboard shortcut. A desktop visitor has
       no pinch to offer them. -->
  <div
    id="zoom-notice"
    class="hidden fixed bottom-4 left-1/2 -translate-x-1/2 z-[150] bg-caprock text-canvas rounded-sm px-3 py-2 font-mono text-[10px] uppercase tracking-widest shadow-lg pointer-events-none max-w-[90vw] text-center"
  ></div>

  <!-- ── viewing station ──────────────────────────────────────────
       Outside #workspace-viewport so the board can be made inert
       while it's open. -->
  <div
    id="lightbox-modal"
    role="dialog"
    aria-modal="true"
    aria-labelledby="lightbox-plate-title"
    data-license-email={LICENSE_EMAIL}
    data-slug={gallery.slug}
    class="fixed inset-0 z-[100] h-[100dvh] bg-canvas/98 backdrop-blur-md opacity-0 flex-col justify-between p-4 md:p-8 transition-opacity duration-300 select-none"
  >
    <!-- toolbar -->
    <div class="w-full max-w-7xl mx-auto flex justify-between items-center shrink-0">
      <div class="font-mono text-[10px] uppercase tracking-widest text-iron/50 flex items-center gap-3 md:gap-6">
        <span id="lightbox-progress"></span>

        <div class="flex items-center gap-1.5 border-l border-haze/60 pl-3 md:pl-6">
          <button id="btn-zoom-out" type="button" class="hover:text-caprock transition-colors p-1 md:p-1.5 rounded-sm hover:bg-iron/5 focus:outline-none" aria-label="Zoom out" title="Zoom out (−)">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"></line></svg>
          </button>
          <button id="btn-zoom-reset" type="button" class="hover:text-caprock transition-colors p-1 md:p-1.5 rounded-sm hover:bg-iron/5 focus:outline-none" aria-label="Reset zoom" title="Reset zoom (0)">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path><path d="M3 3v5h5"></path></svg>
          </button>
          <button id="btn-zoom-in" type="button" class="hover:text-caprock transition-colors p-1 md:p-1.5 rounded-sm hover:bg-iron/5 focus:outline-none" aria-label="Zoom in" title="Zoom in (+)">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
          </button>
        </div>
      </div>

      <div class="flex items-center gap-2 md:gap-4">
        <button id="btn-fullscreen" type="button" class="font-mono text-[10px] uppercase tracking-widest text-iron/50 hover:text-caprock transition-colors p-2 focus:outline-none flex items-center gap-1.5" aria-label="Toggle fullscreen">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"></path></svg>
          <span class="hidden md:inline">fullscreen</span>
        </button>

        <button id="close-lightbox" type="button" class="font-mono text-[10px] uppercase tracking-widest text-iron/50 hover:text-caprock transition-colors p-2 focus:outline-none">
          esc // close view
        </button>
      </div>
    </div>

    <!-- the print -->
    <div
      id="lightbox-stage"
      class="w-full max-w-5xl mx-auto flex-1 min-h-0 flex items-center justify-center overflow-hidden my-4 relative touch-none"
    >
      <button id="nav-prev" type="button" class="absolute left-0 md:-left-12 z-50 text-iron/30 hover:text-caprock transition-colors p-4 focus:outline-none hidden md:block" aria-label="Previous plate">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
      </button>

      <img
        id="lightbox-img"
        src=""
        alt=""
        class="max-w-full max-h-full object-contain shadow-md border border-haze p-2 bg-canvas cursor-zoom-in relative z-40"
        decoding="async"
        draggable="false"
      />

      <button id="nav-next" type="button" class="absolute right-0 md:-right-12 z-50 text-iron/30 hover:text-caprock transition-colors p-4 focus:outline-none hidden md:block" aria-label="Next plate">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
      </button>
    </div>

    <!-- metadata + strip -->
    <div class="w-full max-w-5xl mx-auto border-t border-haze/40 pt-4 pb-2 md:pb-4 shrink-0">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-4 md:gap-8 items-start font-mono text-[11px] uppercase tracking-wider">
        <div class="col-span-12 md:col-span-5 flex flex-col gap-1 min-w-0">
          <span id="lightbox-plate-title" class="font-semibold text-iron break-words"></span>
          <div class="flex gap-4 text-iron/40 text-[10px] lowercase tracking-normal mt-0.5">
            <span id="lightbox-specs"></span>
            <span id="lightbox-coords"></span>
          </div>

          <div id="lightbox-actions" class="flex flex-wrap items-center gap-x-4 gap-y-1 mt-2 pt-2 border-t border-haze/30">
            <a
              id="lightbox-record"
              href="#"
              class="font-mono text-[10px] uppercase tracking-widest text-iron/70 hover:text-caprock transition-colors"
            >
              Plate record &rarr;
            </a>
            <a
              id="lightbox-order-print"
              href="#"
              target="_blank"
              rel="noopener noreferrer"
              class="hidden font-mono text-[10px] uppercase tracking-widest text-redbed hover:text-iron transition-colors"
            >
              Order a print &rarr;
            </a>
            <a
              id="lightbox-license"
              href="#"
              class="hidden font-mono text-[10px] uppercase tracking-widest text-iron/70 hover:text-caprock transition-colors"
            >
              Inquire about licensing
            </a>
          </div>
        </div>
        <div
          id="lightbox-notes"
          class="col-span-12 md:col-span-7 border-t border-dashed border-haze/40 pt-3 md:pt-0 md:border-t-0 font-serif normal-case tracking-normal text-xs text-iron/70 leading-relaxed max-h-[12dvh] overflow-y-auto pr-2 scrollbar-none select-text touch-pan-y"
        >
          <p id="lightbox-caption" class="cursor-text"></p>
        </div>
      </div>

      <div id="thumbnail-strip" class="w-full flex gap-2 overflow-x-auto scrollbar-none mt-4 md:mt-6 pt-2 pb-1 snap-x touch-pan-x">
        {plates.map((plate) => (
          <button
            type="button"
            class="thumbnail-btn shrink-0 w-12 h-12 md:w-16 md:h-16 rounded-xs opacity-40 hover:opacity-100 transition-all border border-transparent focus:outline-none snap-center"
            data-index={plate.index}
            aria-label={`Jump to ${plate.plate}`}
          >
            <img src={plate.img.thumb} class="w-full h-full object-cover rounded-xs pointer-events-none" alt="" width="64" height="64" loading="lazy" decoding="async" />
          </button>
        ))}
      </div>
    </div>
  </div>

  <!-- plate records, read by the lightbox -->
  <!-- sheet extents, read by fit-to-sheet and the sheet rail -->
  <script type="application/json" id="sheet-data" is:inline set:html={JSON.stringify(
    sheets.map((sh) => ({
      i: sh.index,
      label: sh.label,
      minX: sh.bounds.minX,
      minY: sh.bounds.minY,
      maxX: sh.bounds.maxX,
      maxY: sh.bounds.maxY,
      cx: sh.centerX,
      cy: sh.centerY,
    })),
  )} />

  <script type="application/json" id="plate-data" is:inline set:html={JSON.stringify(
    plates.map((p) => ({
      full: p.img.full,
      detail: p.img.detail,
      w: p.img.width,
      h: p.img.height,
      title: plateLine(p),
      specs: p.specs,
      coords: p.coordinates,
      caption: p.caption || '',
      plate: p.plate,
      no: p.no,
      href: p.href,
      printLink: p.printLink,
      sellable: p.sellable,
    })),
  ).replace(/</g, '\\u003c')}></script>
</Layout>

<script>
  type PlateRecord = {
    full: string;
    detail: string;
    w: number;
    h: number;
    title: string;
    specs: string;
    coords: string;
    caption: string;
    plate: string;
    no: string;
    href: string;
    printLink: string;
    sellable: boolean;
  };

  function initLightTable() {
    const viewport = document.getElementById('workspace-viewport');
    const table = document.getElementById('light-table');
    const modal = document.getElementById('lightbox-modal');
    const modalImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
    const stage = document.getElementById('lightbox-stage');
    const dataEl = document.getElementById('plate-data');
    if (!viewport || !table || !modal || !modalImg || !stage || !dataEl) return;

    // idempotent: survives a second call from astro:page-load
    if (viewport.dataset.tableReady === 'true') return;
    viewport.dataset.tableReady = 'true';

    /* Window-level listeners outlive the elements they close over — on a
       View Transition the document is swapped but `window` isn't, so
       every navigation used to leave another full set of handlers
       running against the detached previous page. They all register
       against this signal instead, and it fires on the way out. */
    const ac = new AbortController();
    const sig = { signal: ac.signal };
    document.addEventListener('astro:before-swap', () => ac.abort(), { once: true });

    const PLATES: PlateRecord[] = JSON.parse(dataEl.textContent || '[]');
    const total = PLATES.length;
    if (!total) return;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const clamp = (v: number, lo: number, hi: number) => Math.min(Math.max(v, lo), hi);

    /* ══ THE BOARD ═════════════════════════════════════════════ */

    const MIN_SCALE = 0.2;
    const MAX_SCALE = 1.6;
    const EDGE_PAD = 160; // board units of slack around the plates

    /* WHOLE-DESK bounds. clampPan uses these, so panning is free across
       every sheet — they are laid side by side on one surface and
       walling each one off would undo the reason for that. */
    const bMinX = Number(table.dataset.minX) - EDGE_PAD;
    const bMinY = Number(table.dataset.minY) - EDGE_PAD;
    const bMaxX = Number(table.dataset.maxX) + EDGE_PAD;
    const bMaxY = Number(table.dataset.maxY) + EDGE_PAD;

    /* ── SHEETS ──────────────────────────────────────────────────
       Sheets are regions of one desk, not pages of a book, so almost
       nothing here has to know about them. The lightbox still runs the
       whole series in order and crosses sheet boundaries without
       comment, ?plate= still centres on its plate, the album handoff
       still opens on a board that is already in the DOM, and the
       level-of-detail pass already culls what is off screen, so the
       sheets you are not looking at cost nothing.

       What DOES change is the unit that framing works on. `fit board`
       used to have to frame every plate in the gallery, which is what
       capped a series near thirty on a phone. It frames a SHEET now, so
       only a sheet has to stay legible and the gallery can be any
       size. */
    type SheetRecord = {
      i: number; label: string;
      minX: number; minY: number; maxX: number; maxY: number;
      cx: number; cy: number;
    };
    const sheetEl = document.getElementById('sheet-data');
    const SHEETS: SheetRecord[] = sheetEl ? JSON.parse(sheetEl.textContent || '[]') : [];
    const sheetMarks = Array.from(
      document.querySelectorAll<HTMLElement>('#sheet-rail .sheet-mark'),
    );
    let activeSheet = 0;

    /* The framing bounds: the active sheet when there is one, the whole
       desk when the gallery never named any. */
    const sheetFrame = () => {
      const sh = SHEETS[activeSheet];
      if (!sh) return { minX: bMinX, minY: bMinY, maxX: bMaxX, maxY: bMaxY, cx: 0, cy: 0 };
      return {
        minX: sh.minX - EDGE_PAD, minY: sh.minY - EDGE_PAD,
        maxX: sh.maxX + EDGE_PAD, maxY: sh.maxY + EDGE_PAD,
        cx: sh.cx, cy: sh.cy,
      };
    };

    const markSheet = (k: number) => {
      if (k === activeSheet || !SHEETS[k]) return;
      activeSheet = k;
      sheetMarks.forEach((m) =>
        m.setAttribute('data-current', String(Number(m.dataset.sheet) === k)),
      );
    };

    /* Which sheet you are actually over, by whichever centre is nearest
       the middle of the viewport. Panning across the desk keeps the rail
       honest without anyone having to click it. */
    const sheetUnderView = () => {
      if (SHEETS.length < 2) return 0;
      const cx = (viewport.clientWidth / 2 - panX) / scale;
      const cy = (viewport.clientHeight / 2 - panY) / scale;
      let best = 0, bestD = Infinity;
      for (const sh of SHEETS) {
        const d = Math.hypot(sh.cx - cx, sh.cy - cy);
        if (d < bestD) { bestD = d; best = sh.i; }
      }
      return best;
    };
    const centerX = Number(table.dataset.centerX) || 1600;
    const centerY = Number(table.dataset.centerY) || 1100;

    let scale = 0.65;
    let panX = 0;
    let panY = 0;
    let frame = 0;

    /* Off only while the album handoff is in flight. See ARRIVING
       FROM THE ALBUM below: the opening frame is deliberately outside
       the legal range, and the animation ends inside it. */
    let noClamp = false;

    /* Clamp against the plates, not the empty sheet — you can never
       drag the work off screen and lose your place. */
    /* ── THE NOTEBOOK'S FOOTPRINT ────────────────────────────────
       On a phone the notebook spans most of the width, so the band
       under it is the only place a sheet can actually live. That used
       to be handled by reserving its height TWICE and letting clampPan
       centre the result — which clears the notebook, but pays for it
       with an equal band of dead desk at the BOTTOM, over nothing.
       With a notebook 39% of the screen tall that left 19% for the
       photographs and 39% empty beneath them.

       Telling clampPan about the inset instead means the sheet is
       centred in the band BELOW the notebook and the height is paid
       for once. Same clearance, three times the room.

       Zero on a desktop: there the notebook is a narrow left-hand
       panel, not a top band, and the desk is meant to run under it.

       Cached because clampPan runs on every frame of every pan and
       getBoundingClientRect is a layout read. Re-measured on resize and
       whenever the notebook opens or shuts. */
    let topInsetPx = 0;
    let leftInsetPx = 0;

    /* WHICH AXIS depends on the shape the notebook actually takes.
       On a phone it spans most of the width, so it is a top band. On
       anything wider it is a LEFT PANEL, and insetting from the top
       would reserve a strip where nothing is in the way while leaving
       the sheet centred behind the panel.

       That was the landscape bug: 1411x646 is neither narrow nor short,
       so no inset applied at all — while the notebook took 41% of the
       width and 64% of the height, and a fitted sheet centred in the
       full viewport landed 377px behind it.

       Each is capped at half its axis so the notebook can never leave
       the desk with nowhere to go. */
    const measureInset = () => {
      const el = document.getElementById('hud-overlay');
      const vw = viewport.clientWidth;
      const vh = viewport.clientHeight;
      topInsetPx = 0;
      leftInsetPx = 0;
      if (!el) return;
      const r = el.getBoundingClientRect();
      if (r.width / vw > 0.6) topInsetPx = Math.min(r.bottom + 12, vh * 0.55);
      else leftInsetPx = Math.min(r.right + 16, vw * 0.5);
    };

    const clampPan = () => {
      if (noClamp) return;
      const vw = viewport.clientWidth;
      const vh = viewport.clientHeight;
      const cw = (bMaxX - bMinX) * scale;
      const ch = (bMaxY - bMinY) * scale;
      const top = topInsetPx;
      const left = leftInsetPx;
      const availH = vh - top;
      const availW = vw - left;
      const midY = (top + vh) / 2;
      const midX = (left + vw) / 2;

      /* The rule is that the viewport's CENTRE stays on the desk, not
         that the whole viewport does. The stricter version could not be
         satisfied and a sheet centred at the same time: framing the
         first or last sheet asks to show desk past the end, so the
         clamp hauled it back — 186px on the first sheet here, 477px on
         a small one at the far end. Any point of the desk can now reach
         the middle of the screen, and no more than that. */
      panX = cw <= availW
        ? left + (availW - cw) / 2 - bMinX * scale
        : clamp(panX, midX - bMaxX * scale, midX - bMinX * scale);

      panY = ch <= availH
        ? top + (availH - ch) / 2 - bMinY * scale
        : clamp(panY, midY - bMaxY * scale, midY - bMinY * scale);
    };

    /* ══ LEVEL OF DETAIL ═══════════════════════════════════════
       The board is a CSS transform, and no declarative image feature
       can see through one. `sizes` resolves against layout; density
       descriptors resolve against DPR. Neither knows that a 300-unit
       plate is being drawn at 14% of that. So the browser was asked to
       choose and had nothing to choose with: on a phone at the
       fit-to-board view every plate renders about 42px wide and every
       one of them fetched the 1400 file — roughly 13x too wide, 180x
       the pixels, and about 5.4 MB across the sheet.

       The pick has to be imperative, so it is made here from the one
       number that actually decides it: the plate width times the board
       scale times the pixel ratio.

       Nothing new enters the image pipeline. All four rungs are already
       built for every plate — 160 for the filmstrip, 280 for the plate
       index, 700 and 1400 for the board.

       UPGRADE ONLY. A file already fetched costs nothing to keep, and
       refusing to go back down means a zoom-out cannot thrash the
       network re-requesting what it just had. `at` is the rung index
       each plate has reached; it only ever climbs.

       CULLED to the visible board rectangle plus a margin, so panning
       across a sheet upgrades what you are arriving at rather than all
       38 at once.

       Rectangles are measured ONCE at init. Plate positions are static
       inline styles and never move, and reading them per pass would be
       190 layout reads on every settle. */
    const LOD_LOOKAHEAD = 260; // board units of margin around the view
    const LOD_SETTLE = 160; // ms of stillness before swapping
    const LOD_MAX_DPR = 3; // past this the top rung is the ceiling anyway

    type LodPlate = {
      img: HTMLImageElement;
      x: number;
      y: number;
      w: number;
      h: number;
      iw: number;
      rungs: { w: number; src: string }[];
      at: number;
    };

    const lodPlates: LodPlate[] = [];

    table.querySelectorAll<HTMLElement>('.plate').forEach((btn) => {
      const img = btn.querySelector<HTMLImageElement>('img');
      const spec = img?.dataset.lod;
      if (!img || !spec) return;
      const rungs = spec
        .split(',')
        .map((r) => {
          const [w, src] = r.split('|');
          return { w: Number(w), src: src || '' };
        })
        .filter((r) => r.w > 0 && r.src);
      if (!rungs.length) return;
      lodPlates.push({
        img,
        x: btn.offsetLeft,
        y: btn.offsetTop,
        w: btn.offsetWidth,
        h: btn.offsetHeight,
        /* the IMAGE is narrower than the button — the mount border and
           the caption row are the difference — and it is the image that
           has to carry the pixels. */
        iw: img.offsetWidth || btn.offsetWidth,
        rungs,
        at: 0,
      });
    });

    const runLod = () => {
      if (!lodPlates.length) return;
      const vw = viewport.clientWidth;
      const vh = viewport.clientHeight;
      // the visible slice of the board, in board units
      const x0 = -panX / scale - LOD_LOOKAHEAD;
      const y0 = -panY / scale - LOD_LOOKAHEAD;
      const x1 = (vw - panX) / scale + LOD_LOOKAHEAD;
      const y1 = (vh - panY) / scale + LOD_LOOKAHEAD;
      const density = scale * Math.min(window.devicePixelRatio || 1, LOD_MAX_DPR);

      for (const p of lodPlates) {
        if (p.at >= p.rungs.length - 1) continue;
        if (p.x + p.w < x0 || p.x > x1 || p.y + p.h < y0 || p.y > y1) continue;

        const need = p.iw * density;
        let want = p.rungs.length - 1;
        for (let i = 0; i < p.rungs.length; i++) {
          if (p.rungs[i].w >= need) {
            want = i;
            break;
          }
        }
        if (want <= p.at) continue;
        p.at = want;
        p.img.src = p.rungs[want].src;
      }
    };

    let lodTimer = 0;
    const scheduleLod = () => {
      window.clearTimeout(lodTimer);
      lodTimer = window.setTimeout(() => {
        runLod();
        markSheet(sheetUnderView());
        settleIntoSheet();
      }, LOD_SETTLE);
    };
    ac.signal.addEventListener('abort', () => window.clearTimeout(lodTimer), { once: true });

    /* Where a pan/scale WILL end up once clamped, without moving
       anything. Every animation has to land on this, because the frame
       after it finishes runs clampPan — and an animation whose target
       the clamp disagrees with ends with a jump. Running the real
       clampPan over a borrowed state is the only version of this that
       cannot drift from it. */
    const settled = (x: number, y: number, s: number) => {
      const px = panX, py = panY, ps = scale;
      panX = x; panY = y; scale = s;
      clampPan();
      const out = { x: panX, y: panY, s: scale };
      panX = px; panY = py; scale = ps;
      return out;
    };

    const commit = () => {
      if (frame) return;
      frame = requestAnimationFrame(() => {
        frame = 0;
        clampPan();
        paint();
        scheduleLod();
      });
    };

    const zoomAt = (clientX: number, clientY: number, factor: number) => {
      const rect = viewport.getBoundingClientRect();
      const px = clientX - rect.left;
      const py = clientY - rect.top;
      const next = clamp(scale * factor, MIN_SCALE, MAX_SCALE);
      const k = next / scale;
      panX = px - (px - panX) * k;
      panY = py - (py - panY) * k;
      scale = next;
      commit();
    };

    /* The one place a sheet's framing is worked out. fitBoard and the
       sheet glide both take it, so the button and the rail can never
       land a sheet in two different places. */
    const fitTarget = () => {
      const vw = viewport.clientWidth;
      const vh = viewport.clientHeight;
      const pad = vw < 768 ? 20 : 64;
      const f = sheetFrame();
      const cw = f.maxX - f.minX;
      const ch = f.maxY - f.minY;
      const availW = vw - leftInsetPx;
      const availH = vh - topInsetPx;
      return {
        cx: (f.minX + f.maxX) / 2,
        cy: (f.minY + f.maxY) / 2,
        s: clamp(
          Math.min((availW - pad * 2) / cw, (availH - pad * 2) / ch),
          MIN_SCALE,
          1,
        ),
      };
    };

    const fitBoard = () => {
      const t = fitTarget();
      scale = t.s;
      panX = leftInsetPx + (viewport.clientWidth - leftInsetPx) / 2 - t.cx * t.s;
      panY = topInsetPx + (viewport.clientHeight - topInsetPx) / 2 - t.cy * t.s;
      commit();
    };

    /* ── how a phone should arrive ────────────────────────────────
       fitBoard() fits BOTH axes, which is right for a button called
       "fit board" and wrong as an arrival. A landscape sheet in a
       portrait viewport is bound entirely by width: on a 321x704 phone
       the plates landed in a band about a quarter of the height, every
       one of them around 40px, with three quarters of the screen bare
       desk. Twenty unreadable squares and a lot of paper.

       A light table is not a thing you view entire. It is a thing you
       stand over part of. So the phone arrives filling the height with
       plates near 100px, and pans. The whole sheet is still one tap
       away on `fit board`.

       The height is reserved TWICE over, once for the notebook and once
       for the gap it leaves at the bottom, because clampPan re-centres
       anything shorter than the viewport — so asking for a band below
       the notebook would simply be centred back underneath it. Sizing
       the content to clear the notebook at dead centre is the one form
       of this that survives the clamp. */
    /* MEASURED, not remembered. This was a hardcoded 132 taken before
       the sheet rail existed; a four-sheet gallery wraps to three rows
       in a 70vw notebook and adds about 88px, so the number was 88
       short and the top of the sheet slid under the notebook.

       Clamped at 42% of the viewport so an expanded notebook cannot
       crush the desk to nothing. */
    const narrowView = () => {
      const vh = viewport.clientHeight;
      const f = sheetFrame();
      /* Once, not twice — clampPan now knows where the notebook ends,
         so the sheet is centred in the band beneath it rather than in
         the whole viewport. */
      const availH = vh - topInsetPx - 24;
      return {
        cx: (f.minX + f.maxX) / 2,
        cy: (f.minY + f.maxY) / 2,
        s: clamp(availH / (f.maxY - f.minY), MIN_SCALE, 0.5),
      };
    };

    /* Flipping a sheet SLIDES the desk. A cut would make these look
       like pages, which is the reading the whole side-by-side layout
       exists to avoid — you should see the next sheet arrive from the
       direction it actually lies in. Reduced motion gets the cut. */
    let gliding = 0;

    const glideToSheet = (k: number) => {
      if (!SHEETS[k]) return;
      markSheet(k);
      if (reduceMotion) {
        fitBoard();
        return;
      }
      window.cancelAnimationFrame(gliding);
      const from = { x: panX, y: panY, s: scale };
      const vw = viewport.clientWidth;
      const vh = viewport.clientHeight;
      const target = vw < 768 ? narrowView() : fitTarget();
      const to = settled(
        leftInsetPx + (vw - leftInsetPx) / 2 - target.cx * target.s,
        topInsetPx + (vh - topInsetPx) / 2 - target.cy * target.s,
        target.s,
      );
      /* Warm the destination BEFORE the glide, not after it. paint()
         deliberately does not schedule the level-of-detail pass — it
         runs 60 times a second — so without this the sheet you are
         gliding to arrives holding whatever rung it had while it was
         off screen, and sharpens a beat after it lands. Same reasoning
         as the synchronous runLod on the album arrival. */
      {
        const px = panX, py = panY, ps = scale;
        panX = to.x; panY = to.y; scale = to.s;
        runLod();
        panX = px; panY = py; scale = ps;
      }

      const t0 = performance.now();
      const DUR = 620;
      const step = (t: number) => {
        const u = Math.min(1, (t - t0) / DUR);
        const e = 1 - Math.pow(1 - u, 3);
        panX = from.x + (to.x - from.x) * e;
        panY = from.y + (to.y - from.y) * e;
        scale = from.s + (to.s - from.s) * e;
        paint();
        if (u < 1) {
          gliding = window.requestAnimationFrame(step);
          return;
        }
        /* CLEARED, not just left holding the last handle. Other code
           reads `gliding` as 'is something in flight', and a spent rAF
           id is still a truthy number — leaving it set disabled
           settleIntoSheet permanently after the first sheet you
           clicked. */
        gliding = 0;
        commit();
      };
      gliding = window.requestAnimationFrame(step);
    };

    /* A 520-unit gutter at a phone's scale is about 200px of bare desk —
       half the width of the screen showing nothing. Free panning is
       deliberate and stays that way, but ending a drag parked between
       two sheets is a 'where am I' moment with no upside, so on a narrow
       screen the desk settles the nearest sheet back under you. Pan
       only: the scale you chose is yours to keep. Desktop is untouched —
       there is room enough to see where you are. */
    const glidePanTo = (cx: number, cy: number) => {
      window.cancelAnimationFrame(gliding);
      const from = { x: panX, y: panY };
      const to = settled(
        viewport.clientWidth / 2 - cx * scale,
        viewport.clientHeight / 2 - cy * scale,
        scale,
      );
      const t0 = performance.now();
      const step = (t: number) => {
        const u = Math.min(1, (t - t0) / 460);
        const e = 1 - Math.pow(1 - u, 3);
        panX = from.x + (to.x - from.x) * e;
        panY = from.y + (to.y - from.y) * e;
        paint();
        if (u < 1) {
          gliding = window.requestAnimationFrame(step);
          return;
        }
        gliding = 0;
        commit();
      };
      gliding = window.requestAnimationFrame(step);
    };

    const settleIntoSheet = () => {
      /* Read live rather than using the init-time isNarrow, which goes
         stale the moment a phone is rotated. */
      if (viewport.clientWidth >= 768 || SHEETS.length < 2 || gliding) return;
      const cx = (viewport.clientWidth / 2 - panX) / scale;
      const onPaper = SHEETS.some(
        (sh) => cx >= sh.minX - EDGE_PAD && cx <= sh.maxX + EDGE_PAD,
      );
      if (onPaper) return;
      const sh = SHEETS[sheetUnderView()];
      if (sh) glidePanTo(sh.cx, sh.cy);
    };

    const centerOn = (x: number, y: number, s: number) => {
      scale = clamp(s, MIN_SCALE, MAX_SCALE);
      panX = viewport.clientWidth / 2 - x * scale;
      panY = viewport.clientHeight / 2 - y * scale;
      commit();
    };

    /* ── ARRIVING FROM THE ALBUM ──────────────────────────────────
       /photography hands over with ?from=<plate index>. That page ends
       its own animation with the plate occupying EXIT_WIDTH_VW of the
       viewport, centred, at its true aspect ratio. The board opens in
       exactly that state and pulls back to its normal view, so the
       navigation between the two pages is invisible: same plate, same
       size, same place on screen, either side of the load.

       EXIT_WIDTH_VW IS A CONTRACT. It is repeated in photography.astro
       and nowhere else. Change one, change both.

       BOTH CLAMPS ARE OFF during the flight. clampPan would pull a
       cover near the edge of the sheet back into range, and MAX_SCALE
       would refuse the opening scale on a wide display — 34vw against a
       400-unit plate is about 2.2. Either correction lands the arrival
       somewhere other than where the album left off, which is the one
       thing that makes the seam visible. The final frame is the default
       view, which is legal, so nothing is relaxed permanently.

       The plate's board rectangle comes off the DOM rather than PLATES,
       which carries w and h but not x and y. The button is positioned
       against the table and the image against the button, so the two
       offsets sum to the image's rectangle in board units.

       NOT ANIMATED when the reader asked for less motion, when the
       index is out of range, or when ?plate= is also present — that
       last one means a deep link into the viewing station, and the
       lightbox is the intent. The board just opens where it normally
       would. */
    /* Evaluated once, not live — the HUD collapse and the first-visit
       nudge below both read it, and both want the value as it was at
       init. This was declared in the block the album handoff replaced;
       losing it took those two with it. */
    const isNarrow = window.matchMedia('(max-width: 767px)').matches;

    const EXIT_WIDTH_VW = 34;

    const defaultView = () => {
      const vw = viewport.clientWidth;
      const vh = viewport.clientHeight;
      if (isNarrow) return narrowView();
      return { cx: centerX, cy: centerY, s: 0.65 };
    };

    /* Writes the transform straight out, skipping commit's rAF batching
       so the animation owns its own frames. */
    /* The board's transform and the desk's ruling are ONE operation.
       The plat is painted on the viewport rather than on the board — a
       board is sized per gallery, so ruling it meant the lines stopped
       in mid air at a distance that depended on how many plates the
       series happened to have. Painting the surface and sliding the
       board across it gives an edgeless desk for one viewport-sized
       element instead of an oversized layer to rasterize.

       Both writers go through here so the two can never drift apart by
       a frame. */
    const paint = () => {
      table.style.transform = `translate3d(${panX}px, ${panY}px, 0) scale(${scale})`;
      viewport.style.setProperty('--plat-k', String(scale));
      viewport.style.setProperty('--plat-x', `${panX}px`);
      viewport.style.setProperty('--plat-y', `${panY}px`);
    };

    const setView = (cx: number, cy: number, s: number) => {
      scale = s;
      panX = viewport.clientWidth / 2 - cx * s;
      panY = viewport.clientHeight / 2 - cy * s;
      paint();
    };

    const coverRect = (index: number) => {
      const btn = table.querySelector<HTMLElement>(`.plate[data-index="${index}"]`);
      const img = btn?.querySelector<HTMLImageElement>('img');
      if (!btn || !img || !img.offsetWidth) return null;
      return {
        x: btn.offsetLeft + img.offsetLeft,
        y: btn.offsetTop + img.offsetTop,
        w: img.offsetWidth,
        h: img.offsetHeight,
      };
    };

    const params = new URLSearchParams(window.location.search);
    const fromRaw = params.get('from');

    /* Resolve the sheet before anything frames anything. ?plate= and
       ?from= both name a plate, and framing the wrong sheet would open
       the desk somewhere the plate is not — for the handoff that means
       the dolly runs against bare desk, which is the one animation that
       cannot afford to be wrong. */
    const sheetOfPlate = (i: number) => {
      const el = table.querySelector<HTMLElement>(`.plate[data-index="${i}"]`);
      if (!el || SHEETS.length < 2) return 0;
      const x = el.offsetLeft + el.offsetWidth / 2;
      const y = el.offsetTop + el.offsetHeight / 2;
      let best = 0, bestD = Infinity;
      for (const sh of SHEETS) {
        const d = Math.hypot(sh.cx - x, sh.cy - y);
        if (d < bestD) { bestD = d; best = sh.i; }
      }
      return best;
    };

    {
      const want = params.get('plate') ?? params.get('from');
      const n = want === null ? NaN : Number.parseInt(want, 10);
      if (Number.isInteger(n)) {
        const i = params.has('plate') ? n - 1 : n;
        if (i >= 0 && i < total) markSheet(sheetOfPlate(i));
      }
    }

    /* Before ANY framing. Every opening view is computed against the
       band under the notebook, so the band has to be known first. */
    measureInset();

    const fromIdx = fromRaw === null ? NaN : Number.parseInt(fromRaw, 10);
    const rect =
      Number.isInteger(fromIdx) && fromIdx >= 0 && fromIdx < total ? coverRect(fromIdx) : null;

    if (!rect || reduceMotion || params.has('plate')) {
      // Desktop opens on the composed view; a phone opens over the
      // sheet rather than above it — see narrowView.
      const v = defaultView();
      centerOn(v.cx, v.cy, v.s);
    } else {
      noClamp = true;
      /* Landed through the clamp for the same reason the sheet glide is.
         The dolly finishes with commit(), and an end the clamp disagrees
         with is a jump at the exact moment the handoff is meant to be
         invisible. `settled` is computed with noClamp already true, so
         it is asked explicitly rather than implicitly skipped. */
      const endRaw = defaultView();
      noClamp = false;
      const endPos = settled(
        viewport.clientWidth / 2 - endRaw.cx * endRaw.s,
        viewport.clientHeight / 2 - endRaw.cy * endRaw.s,
        endRaw.s,
      );
      noClamp = true;
      const end = {
        cx: (viewport.clientWidth / 2 - endPos.x) / endPos.s,
        cy: (viewport.clientHeight / 2 - endPos.y) / endPos.s,
        s: endPos.s,
      };
      const start = {
        cx: rect.x + rect.w / 2,
        cy: rect.y + rect.h / 2,
        s: ((viewport.clientWidth * EXIT_WIDTH_VW) / 100) / rect.w,
      };
      setView(start.cx, start.cy, start.s);
      /* Synchronous, not scheduled. The arrival opens with one plate
         filling 34vw at roughly 2x scale; waiting out LOD_SETTLE would
         show the 160 thumb blown up for the first tenth of a second of
         the one animation whose whole job is to be seamless. setView
         deliberately bypasses commit, so nothing else would have run
         it. */
      runLod();

      const DUR = 620;
      const t0 = performance.now();
      let dollyFrame = 0;

      const step = (now: number) => {
        if (ac.signal.aborted) return;
        const p = Math.min(1, (now - t0) / DUR);
        const e = 1 - Math.pow(1 - p, 3);
        setView(
          start.cx + (end.cx - start.cx) * e,
          start.cy + (end.cy - start.cy) * e,
          start.s + (end.s - start.s) * e,
        );
        if (p < 1) {
          dollyFrame = requestAnimationFrame(step);
          return;
        }
        noClamp = false;
        commit();
      };

      dollyFrame = requestAnimationFrame(step);
      ac.signal.addEventListener(
        'abort',
        () => {
          cancelAnimationFrame(dollyFrame);
          noClamp = false;
        },
        { once: true },
      );
    }

    /* The parameter has done its job. Leaving it in the bar means a
       reload or a shared link replays the arrival from a page nobody
       came from. */
    if (fromRaw !== null) {
      const cleaned = new URL(window.location.href);
      cleaned.searchParams.delete('from');
      history.replaceState(history.state, '', cleaned.toString());
    }

    let resizeTimer = 0;
    const onResize = () => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        /* A rotation rewraps the sheet rail and moves the notebook's
           bottom edge, so the band under it has to be re-measured
           before the board is re-clamped against it. */
        measureInset();
        commit();
      }, 120);
    };
    window.addEventListener('resize', onResize, sig);

    /* ── HUD ──────────────────────────────────────────────────── */

    const hudContainer = document.getElementById('fixed-hud-container');
    const hud = document.getElementById('hud-overlay');
    const hudToggle = document.getElementById('hud-toggle');
    const hudCollapsible = document.getElementById('hud-collapsible');
    const mobileInstructions = document.getElementById('mobile-instructions');
    const toggleText = document.getElementById('toggle-text');
    const toggleIcon = document.getElementById('toggle-icon');

    const setHud = (open: boolean) => {
      hud?.setAttribute('data-expanded', String(open));
      hudToggle?.setAttribute('aria-expanded', String(open));
      hudCollapsible?.classList.toggle('hidden', !open);
      // needs `flex`, not the default block, or the pulse dot won't align
      mobileInstructions?.classList.toggle('hidden', !open);
      mobileInstructions?.classList.toggle('flex', open);
      if (toggleText) toggleText.textContent = open ? 'close' : 'info';
      if (toggleIcon) toggleIcon.style.transform = open ? 'rotate(45deg)' : 'rotate(0deg)';
      /* The notebook just changed height, so the band under it did too.
         Deferred a frame so the rect is read after layout settles. */
      requestAnimationFrame(() => {
        measureInset();
        commit();
      });
    };

    hudToggle?.addEventListener('click', (e) => {
      e.stopPropagation();
      setHud(hud?.getAttribute('data-expanded') !== 'true');
    });

    const collapseHud = () => {
      /* Width was the wrong test here too: on a landscape phone the
         notebook is collapsible again, so picking a sheet should shut
         it. Matches the CSS query above. */
      const compact =
        viewport.clientWidth < 768 || window.matchMedia('(max-height: 560px)').matches;
      if (compact && hud?.getAttribute('data-expanded') === 'true') setHud(false);
    };

    document.getElementById('btn-fit')?.addEventListener('click', (e) => {
      e.stopPropagation();
      fitBoard();
    });

    document.getElementById('sheet-rail')?.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLElement>('.sheet-mark');
      if (!b) return;
      e.stopPropagation();
      glideToSheet(Number(b.dataset.sheet));
      collapseHud();
    });

    /* ── wheel: pan by default, zoom on ctrl/cmd or a notched wheel ── */

    viewport.addEventListener(
      'wheel',
      (e) => {
        if (isOpen()) return;
        if (viewport.classList.contains('pinch-released')) return;

        // the notebook isn't board surface — let it scroll, and let a
        // ctrl+wheel over it reach the browser's own zoom
        if ((e.target as HTMLElement).closest('#fixed-hud-container')) return;

        e.preventDefault();

        // A trackpad pinch arrives as ctrlKey+wheel. A mouse wheel
        // reports in lines/pages rather than pixels; treat that as zoom
        // since a mouse has no second axis to pan with.
        const wantsZoom = e.ctrlKey || e.metaKey || e.deltaMode !== 0;

        if (wantsZoom) {
          zoomAt(e.clientX, e.clientY, Math.exp(-e.deltaY * (e.deltaMode !== 0 ? 0.08 : 0.01)));
        } else {
          panX -= e.deltaX;
          panY -= e.deltaY;
          commit();
        }
      },
      { passive: false },
    );

    /* ── pointer drag + pinch (one path for mouse, touch, pen) ──
       No setPointerCapture: it retargets the click and breaks the
       plate buttons, same bug as the footer cards. */

    const active = new Map<number, { x: number; y: number }>();
    let dragging = false;
    let dragOriginX = 0;
    let dragOriginY = 0;
    let downX = 0;
    let downY = 0;
    let moved = false;
    let pinchDist = 0;
    let pinchScale = 1;

    const midpoint = () => {
      const pts = [...active.values()];
      return {
        x: (pts[0].x + pts[1].x) / 2,
        y: (pts[0].y + pts[1].y) / 2,
      };
    };
    const spread = () => {
      const pts = [...active.values()];
      return Math.hypot(pts[0].x - pts[1].x, pts[0].y - pts[1].y);
    };

    const beginDrag = (x: number, y: number) => {
      dragging = true;
      dragOriginX = x - panX;
      dragOriginY = y - panY;
      downX = x;
      downY = y;
    };

    viewport.addEventListener('pointerdown', (e) => {
      if (isOpen()) return;
      // the page itself is zoomed — the browser gets this gesture
      if (viewport.classList.contains('pinch-released')) return;
      if ((e.target as HTMLElement).closest('#fixed-hud-container')) return;

      active.set(e.pointerId, { x: e.clientX, y: e.clientY });
      moved = false;

      if (active.size === 1) {
        beginDrag(e.clientX, e.clientY);
        collapseHud();
      } else if (active.size === 2) {
        dragging = false;
        pinchDist = spread();
        pinchScale = scale;
      }
    });

    window.addEventListener('pointermove', (e) => {
      if (!active.has(e.pointerId)) return;
      active.set(e.pointerId, { x: e.clientX, y: e.clientY });

      if (active.size >= 2 && pinchDist > 0) {
        const mid = midpoint();
        const next = clamp((spread() / pinchDist) * pinchScale, MIN_SCALE, MAX_SCALE);
        const rect = viewport.getBoundingClientRect();
        const px = mid.x - rect.left;
        const py = mid.y - rect.top;
        const k = next / scale;
        panX = px - (px - panX) * k;
        panY = py - (py - panY) * k;
        scale = next;
        moved = true;
        commit();
        return;
      }

      if (!dragging) return;
      // a click that wobbles a few pixels is still a click
      if (Math.hypot(e.clientX - downX, e.clientY - downY) > 6) moved = true;
      panX = e.clientX - dragOriginX;
      panY = e.clientY - dragOriginY;
      commit();
    }, sig);

    const releasePointer = (e: PointerEvent) => {
      if (!active.has(e.pointerId)) return;
      active.delete(e.pointerId);

      if (active.size === 1) {
        // came off a pinch — keep panning with the remaining finger
        const [p] = [...active.values()];
        pinchDist = 0;
        beginDrag(p.x, p.y);
      } else if (active.size === 0) {
        dragging = false;
        pinchDist = 0;
        // let the click through, then re-arm
        window.setTimeout(() => { moved = false; }, 0);
      }
    };
    window.addEventListener('pointerup', releasePointer, sig);
    window.addEventListener('pointercancel', releasePointer, sig);

    // double-click on bare canvas reframes
    viewport.addEventListener('dblclick', (e) => {
      if ((e.target as HTMLElement).closest('.plate, #fixed-hud-container')) return;
      fitBoard();
    });

    // first-visit nudge on touch: the surface should announce that it moves
    if (isNarrow && !reduceMotion) {
      window.setTimeout(() => {
        if (moved || isOpen()) return;
        const startX = panX;
        const t0 = performance.now();
        const drift = (t: number) => {
          const p = Math.min((t - t0) / 1400, 1);
          panX = startX + Math.sin(p * Math.PI) * -90;
          commit();
          if (p < 1 && !moved) requestAnimationFrame(drift);
          else { panX = startX; commit(); }
        };
        requestAnimationFrame(drift);
      }, 900);
    }

    /* ══ THE VIEWING STATION ═══════════════════════════════════ */

    const triggers = Array.from(table.querySelectorAll<HTMLButtonElement>('[data-lightbox-trigger]'));
    const thumbnails = Array.from(document.querySelectorAll<HTMLButtonElement>('.thumbnail-btn'));
    const titleEl = document.getElementById('lightbox-plate-title');
    const specsEl = document.getElementById('lightbox-specs');
    const coordsEl = document.getElementById('lightbox-coords');
    const captionEl = document.getElementById('lightbox-caption');
    const notesEl = document.getElementById('lightbox-notes');
    const progressEl = document.getElementById('lightbox-progress');
    const orderPrintEl = document.getElementById('lightbox-order-print') as HTMLAnchorElement | null;
    const licenseEl = document.getElementById('lightbox-license') as HTMLAnchorElement | null;
    const recordEl = document.getElementById('lightbox-record') as HTMLAnchorElement | null;
    const actionsEl = document.getElementById('lightbox-actions');
    const licenseEmail = modal.dataset.licenseEmail || '';

    function isOpen() {
      return modal!.hasAttribute('data-open');
    }

    /* The open plate belongs in the URL: it's what makes a view
       shareable, and what the plate index links back into. replaceState
       rather than pushState — a reader stepping through fourteen plates
       shouldn't have to press Back fourteen times to leave. */
    const syncUrl = (no: string | null) => {
      const url = new URL(window.location.href);
      if (no) url.searchParams.set('plate', no);
      else url.searchParams.delete('plate');
      window.history.replaceState(window.history.state, '', url);
    };

    let current = 0;
    let lastFocus: HTMLElement | null = null;

    let lbScale = 1;
    let lbX = 0;
    let lbY = 0;
    let baseW = 0;
    let baseH = 0;
    let insetX = 0;   // the mat: padding + border, which shouldn't grow with zoom
    let insetY = 0;
    let baked = false;
    let detailWanted = false;
    let settleTimer = 0;

    /* Transform-scaling an image tells the compositor to stretch a bitmap
       it already rasterized at 1x — that's the blur. So transform is used
       only WHILE a gesture is in flight, and once it settles the zoom is
       written to the element's real width/height, which the browser
       rasterizes from the full decoded image. */
    const unbake = () => {
      if (!baked) return;
      baked = false;
      modalImg.style.width = '';
      modalImg.style.height = '';
      modalImg.style.maxWidth = '';
      modalImg.style.maxHeight = '';
      modalImg.style.flexShrink = '';
    };

    const measure = () => {
      unbake();
      const prevTransform = modalImg.style.transform;
      const prevTransition = modalImg.style.transition;
      modalImg.style.transition = 'none';
      modalImg.style.transform = 'none';
      const r = modalImg.getBoundingClientRect();
      baseW = r.width;
      baseH = r.height;
      const cs = getComputedStyle(modalImg);
      insetX =
        parseFloat(cs.paddingLeft) + parseFloat(cs.paddingRight) +
        parseFloat(cs.borderLeftWidth) + parseFloat(cs.borderRightWidth);
      insetY =
        parseFloat(cs.paddingTop) + parseFloat(cs.paddingBottom) +
        parseFloat(cs.borderTopWidth) + parseFloat(cs.borderBottomWidth);
      modalImg.style.transform = prevTransform;
      modalImg.style.transition = prevTransition;
    };

    // printed size at the current zoom, whichever mode we're in
    const visualW = () => (baked ? (baseW - insetX) * lbScale + insetX : baseW * lbScale);
    const visualH = () => (baked ? (baseH - insetY) * lbScale + insetY : baseH * lbScale);

    /* translate-based panning, clamped to the print's own edges —
       the image follows the pointer 1:1 instead of swimming under it */
    const clampLb = () => {
      const rect = stage.getBoundingClientRect();
      const overflowX = Math.max(0, (visualW() - rect.width) / 2);
      const overflowY = Math.max(0, (visualH() - rect.height) / 2);
      lbX = clamp(lbX, -overflowX, overflowX);
      lbY = clamp(lbY, -overflowY, overflowY);
    };

    /* hand the layer back to the main thread and re-render at full res */
    const bake = () => {
      modalImg.classList.remove('is-zooming');
      modalImg.style.transition = 'opacity 200ms ease';

      if (lbScale === 1) {
        unbake();
        modalImg.style.transform = `translate3d(${lbX}px, ${lbY}px, 0)`;
        return;
      }

      baked = true;
      modalImg.style.maxWidth = 'none';
      modalImg.style.maxHeight = 'none';
      modalImg.style.flexShrink = '0';
      modalImg.style.width = `${(baseW - insetX) * lbScale + insetX}px`;
      modalImg.style.height = `${(baseH - insetY) * lbScale + insetY}px`;
      clampLb();
      modalImg.style.transform = `translate3d(${lbX}px, ${lbY}px, 0)`;
    };

    const scheduleBake = () => {
      window.clearTimeout(settleTimer);
      settleTimer = window.setTimeout(bake, 150);
    };

    const applyLb = (animate = false) => {
      unbake();
      clampLb();
      // will-change only for the duration of the gesture — leaving it on
      // pins the layer at whatever scale it was last rasterized
      modalImg.classList.add('is-zooming');
      modalImg.style.transition = animate
        ? 'transform 220ms cubic-bezier(0.25, 1, 0.5, 1), opacity 200ms ease'
        : 'transform 0s, opacity 200ms ease';
      modalImg.style.transform = `translate3d(${lbX}px, ${lbY}px, 0) scale(${lbScale})`;
      modalImg.style.cursor = lbScale > 1 ? 'grab' : 'zoom-in';
      scheduleBake();
    };

    const resetLb = (animate = false) => {
      lbScale = 1;
      lbX = 0;
      lbY = 0;
      applyLb(animate);
    };

    /* past ~1.5x the station copy runs out of pixels — fetch the big one
       once, in the background, and swap it in when it has decoded */
    const requestDetail = () => {
      if (detailWanted) return;
      const rec = PLATES[current];
      if (!rec.detail || rec.detail === rec.full) return;
      detailWanted = true;
      const pre = new Image();
      pre.decoding = 'async';
      pre.onload = () => {
        if (PLATES[current] !== rec || !isOpen()) return;
        modalImg.src = rec.detail;
      };
      pre.src = rec.detail;
    };

    /* zoom about a point in stage coordinates, keeping it fixed */
    const zoomLbAt = (clientX: number, clientY: number, next: number, animate = false) => {
      const rect = stage.getBoundingClientRect();
      const cx = rect.left + rect.width / 2;
      const cy = rect.top + rect.height / 2;
      const target = clamp(next, 1, 4);
      const ux = (clientX - cx - lbX) / lbScale;
      const uy = (clientY - cy - lbY) / lbScale;
      lbX = clientX - cx - ux * target;
      lbY = clientY - cy - uy * target;
      lbScale = target;
      if (lbScale === 1) { lbX = 0; lbY = 0; }
      if (lbScale > 1.5) requestDetail();
      applyLb(animate);
    };

    const stepZoom = (delta: number) => {
      const rect = stage.getBoundingClientRect();
      zoomLbAt(rect.left + rect.width / 2, rect.top + rect.height / 2, lbScale + delta, true);
    };

    const preload = (i: number) => {
      const rec = PLATES[(i + total) % total];
      if (rec) { const im = new Image(); im.src = rec.full; }
    };

    const setThumb = (i: number) => {
      thumbnails.forEach((t, n) => {
        const on = n === i;
        t.classList.toggle('opacity-100', on);
        t.classList.toggle('border-caprock', on);
        t.classList.toggle('opacity-40', !on);
        t.classList.toggle('border-transparent', !on);
        if (on) t.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'nearest', inline: 'center' });
      });
    };

    const loadPlate = (index: number) => {
      current = (index + total) % total;
      const rec = PLATES[current];
      detailWanted = false;
      resetLb();

      // reserve the frame's shape before the new file even starts
      // downloading. width/height attributes (not just CSS) are what
      // let the browser hold the intrinsic ratio pre-decode — without
      // them the box is 0 until the file lands, then snaps to full
      // size, and that jump is what was shifting the whole page.
      if (rec.w && rec.h) {
        modalImg.width = rec.w;
        modalImg.height = rec.h;
      } else {
        modalImg.removeAttribute('width');
        modalImg.removeAttribute('height');
      }

      modalImg.classList.add('is-loading');
      modalImg.src = rec.full;
      modalImg.alt = rec.title;

      if (titleEl) {
        titleEl.textContent = '';
        const tag = document.createElement('span');
        tag.className = 'text-iron/40';
        tag.textContent = rec.plate;
        titleEl.append(tag, document.createTextNode(` \u2022 ${rec.title}`));
      }
      if (specsEl) specsEl.textContent = rec.specs;
      if (coordsEl) coordsEl.textContent = rec.coords;
      if (captionEl) captionEl.textContent = rec.caption;
      // an empty field shouldn't announce itself
      notesEl?.classList.toggle('hidden', !rec.caption);
      if (progressEl) progressEl.textContent = `Plate ${current + 1} of ${total}`;
      // an untitled plate has no record page
      if (recordEl) {
        recordEl.style.display = rec.href ? '' : 'none';
        recordEl.href = rec.href || '#';
      }

      // print/licensing controls — gated per-gallery by `sellable`, and
      // the print button additionally needs a real checkout link per plate
      const canOrderPrint = rec.sellable && !!rec.printLink;
      if (orderPrintEl) {
        orderPrintEl.classList.toggle('hidden', !canOrderPrint);
        orderPrintEl.href = canOrderPrint ? rec.printLink : '#';
      }
      if (licenseEl) {
        licenseEl.classList.toggle('hidden', !rec.sellable || !licenseEmail);
        if (rec.sellable && licenseEmail) {
          const subject = encodeURIComponent(`Licensing inquiry \u2014 ${rec.plate}: ${rec.title}`);
          licenseEl.href = `mailto:${licenseEmail}?subject=${subject}`;
        }
      }
      // nothing to offer? don't leave a bordered empty row behind
      actionsEl?.classList.toggle(
        'hidden',
        !rec.href && !canOrderPrint && !(rec.sellable && licenseEmail),
      );

      setThumb(current);
      syncUrl(rec.no);
      preload(current + 1);
      preload(current - 1);
    };

    modalImg.addEventListener('load', () => {
      modalImg.classList.remove('is-loading');
      measure();
      applyLb();
    });

    const openLightbox = (index: number, from: HTMLElement | null) => {
      lastFocus = from;
      modal.setAttribute('data-open', '');
      viewport.setAttribute('inert', '');
      // the HUD is a sibling now, so it needs its own inert
      hudContainer?.setAttribute('inert', '');
      requestAnimationFrame(() => requestAnimationFrame(() => modal.classList.remove('opacity-0')));
      loadPlate(index);
      (document.getElementById('close-lightbox') as HTMLElement | null)?.focus();
    };

    const closeLightbox = () => {
      modal.classList.add('opacity-0');
      viewport.removeAttribute('inert');
      hudContainer?.removeAttribute('inert');
      syncUrl(null);
      if (document.fullscreenElement) document.exitFullscreen().catch(() => {});
      window.setTimeout(() => {
        modal.removeAttribute('data-open');
        resetLb();
        lastFocus?.focus();
        lastFocus = null;
      }, 300);
    };

    triggers.forEach((trigger, index) => {
      trigger.addEventListener('click', () => {
        if (moved) return; // it was a drag, not a click
        openLightbox(index, trigger);
      });
    });

    thumbnails.forEach((thumb) => {
      thumb.addEventListener('click', (e) => {
        e.stopPropagation();
        loadPlate(Number(thumb.dataset.index || 0));
      });
    });

    document.getElementById('nav-prev')?.addEventListener('click', (e) => { e.stopPropagation(); loadPlate(current - 1); });
    document.getElementById('nav-next')?.addEventListener('click', (e) => { e.stopPropagation(); loadPlate(current + 1); });
    document.getElementById('btn-zoom-in')?.addEventListener('click', (e) => { e.stopPropagation(); stepZoom(0.5); });
    document.getElementById('btn-zoom-out')?.addEventListener('click', (e) => { e.stopPropagation(); stepZoom(-0.5); });
    document.getElementById('btn-zoom-reset')?.addEventListener('click', (e) => { e.stopPropagation(); resetLb(true); });
    document.getElementById('close-lightbox')?.addEventListener('click', closeLightbox);

    document.getElementById('btn-fullscreen')?.addEventListener('click', (e) => {
      e.stopPropagation();
      if (!document.fullscreenElement) modal.requestFullscreen().catch(() => {});
      else document.exitFullscreen().catch(() => {});
    });

    // click the backdrop to close
    modal.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (t.closest('a, button, #lightbox-img, #lightbox-notes, #thumbnail-strip')) return;
      closeLightbox();
    });

    /* wheel zoom in the station, without the transition fighting it */
    stage.addEventListener(
      'wheel',
      (e) => {
        if (!isOpen()) return;
        e.preventDefault();
        zoomLbAt(e.clientX, e.clientY, lbScale * Math.exp(-e.deltaY * 0.0018));
      },
      { passive: false },
    );

    /* pointer: drag to pan when zoomed, swipe to advance when not */
    const lbPointers = new Map<number, { x: number; y: number }>();
    let lbDrag = false;
    let lbStartX = 0;
    let lbStartY = 0;
    let lbOriginX = 0;
    let lbOriginY = 0;
    let lbMoved = false;
    let lbPinch = 0;
    let lbPinchScale = 1;

    stage.addEventListener('pointerdown', (e) => {
      if ((e.target as HTMLElement).closest('button')) return;
      lbPointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
      lbMoved = false;

      if (lbPointers.size === 1) {
        lbDrag = true;
        lbStartX = e.clientX;
        lbStartY = e.clientY;
        lbOriginX = lbX;
        lbOriginY = lbY;
      } else if (lbPointers.size === 2) {
        lbDrag = false;
        const p = [...lbPointers.values()];
        lbPinch = Math.hypot(p[0].x - p[1].x, p[0].y - p[1].y);
        lbPinchScale = lbScale;
      }
    });

    window.addEventListener('pointermove', (e) => {
      if (!isOpen() || !lbPointers.has(e.pointerId)) return;
      lbPointers.set(e.pointerId, { x: e.clientX, y: e.clientY });

      if (lbPointers.size >= 2 && lbPinch > 0) {
        const p = [...lbPointers.values()];
        const d = Math.hypot(p[0].x - p[1].x, p[0].y - p[1].y);
        const mx = (p[0].x + p[1].x) / 2;
        const my = (p[0].y + p[1].y) / 2;
        zoomLbAt(mx, my, (d / lbPinch) * lbPinchScale);
        lbMoved = true;
        return;
      }

      if (!lbDrag) return;
      const dx = e.clientX - lbStartX;
      const dy = e.clientY - lbStartY;
      if (Math.hypot(dx, dy) > 6) lbMoved = true;

      if (lbScale > 1) {
        lbX = lbOriginX + dx;
        lbY = lbOriginY + dy;
        applyLb();
      } else {
        // rubber-band the whole print with the finger, ready to advance
        modalImg.style.transition = 'none';
        modalImg.style.transform = `translate3d(${dx * 0.55}px, 0, 0) scale(1)`;
      }
    }, sig);

    const lbRelease = (e: PointerEvent) => {
      if (!lbPointers.has(e.pointerId)) return;
      const dx = e.clientX - lbStartX;
      lbPointers.delete(e.pointerId);

      if (lbPointers.size === 1) {
        const [p] = [...lbPointers.values()];
        lbPinch = 0;
        lbDrag = true;
        lbStartX = p.x;
        lbStartY = p.y;
        lbOriginX = lbX;
        lbOriginY = lbY;
        return;
      }
      if (lbPointers.size > 0) return;

      lbDrag = false;
      lbPinch = 0;

      if (lbScale === 1 && lbMoved) {
        if (Math.abs(dx) > 60) loadPlate(dx < 0 ? current + 1 : current - 1);
        else applyLb(true); // spring back
      }
      window.setTimeout(() => { lbMoved = false; }, 0);
    };
    window.addEventListener('pointerup', lbRelease, sig);
    window.addEventListener('pointercancel', lbRelease, sig);

    // click / tap toggles a 2.5x inspection zoom on the point you touched
    modalImg.addEventListener('click', (e) => {
      if (lbMoved) return;
      if (lbScale === 1) zoomLbAt(e.clientX, e.clientY, 2.5, true);
      else resetLb(true);
    });

    window.addEventListener('resize', () => {
      if (!isOpen()) return;
      measure();
      applyLb();
    }, sig);

    /* ── keyboard ─────────────────────────────────────────────── */

    const onKey = (e: KeyboardEvent) => {
      /* Ctrl/Cmd/Alt combinations belong to the browser and the OS.
         Without this, the board's own -/0/+ and w/a/s/d bindings swallow
         Ctrl+- and Ctrl+0 (leaving a page-zoomed visitor with no way
         back) along with Cmd+A, Cmd+S and Cmd+R. */
      if (e.ctrlKey || e.metaKey || e.altKey) return;

      if (isOpen()) {
        if (e.key === 'Escape') { closeLightbox(); return; }
        if (e.key === 'ArrowRight') { loadPlate(current + 1); return; }
        if (e.key === 'ArrowLeft') { loadPlate(current - 1); return; }
        if (e.key === '+' || e.key === '=') { stepZoom(0.5); return; }
        if (e.key === '-' || e.key === '_') { stepZoom(-0.5); return; }
        if (e.key === '0') { resetLb(true); return; }

        if (e.key === 'Tab') {
          const focusable = modal.querySelectorAll<HTMLElement>(
            'button:not([disabled]), a[href], [tabindex]:not([tabindex="-1"])',
          );
          if (!focusable.length) return;
          const first = focusable[0];
          const last = focusable[focusable.length - 1];
          if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
          else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
        }
        return;
      }

      if ((e.target as HTMLElement)?.tagName === 'INPUT') return;

      const step = e.shiftKey ? 240 : 80;
      let hit = true;
      switch (e.key) {
        case 'ArrowUp': case 'w': panY += step; break;
        case 'ArrowDown': case 's': panY -= step; break;
        case 'ArrowLeft': case 'a': panX += step; break;
        case 'ArrowRight': case 'd': panX -= step; break;
        case '0': fitBoard(); break;
        case '+': case '=': zoomAt(innerWidth / 2, innerHeight / 2, 1.25); break;
        case '-': case '_': zoomAt(innerWidth / 2, innerHeight / 2, 0.8); break;
        default: hit = false;
      }
      if (hit) { e.preventDefault(); collapseHud(); commit(); }
    };
    window.addEventListener('keydown', onKey, sig);

    /* ══ PAGE ZOOM ═════════════════════════════════════════════
       Two different zooms live on this page. The BOARD's zoom is
       `scale` above, ours to control. The PAGE's zoom is the visual
       viewport — a two-finger pinch on the browser chrome itself — and
       it is read-only: nothing here can set it back to 1.

       That matters because #workspace-viewport carries touch-none so
       the board can own pinch. If a visitor arrives already pinched
       (a soft View Transition swap carries the visual viewport across
       from the previous page, where a hard navigation would have reset
       it), the board is magnified and the gesture that would undo it
       has been taken away.

       So: while the page is zoomed, give pinch back. The board loses
       its own pinch for exactly as long as the page is zoomed, and
       takes it back the moment we're at 1:1. */

    const vv = window.visualViewport;
    const probe = document.getElementById('viewport-probe');
    const notice = document.getElementById('zoom-notice');
    const debugging =
      import.meta.env.DEV &&
      new URLSearchParams(window.location.search).has('debugViewport');

    let pageZoomed = false;

    const pageScale = () => {
      if (vv) return vv.scale;
      // no visualViewport (older browsers): outer/inner is the best proxy
      return window.outerWidth / window.innerWidth;
    };

    const readProbe = () => {
      const m = /scale\(([\d.]+)\)/.exec(table.style.transform);
      return {
        visualScale: (vv?.scale ?? NaN),
        outerInner: window.outerWidth / window.innerWidth,
        vvW: Math.round(vv?.width ?? 0),
        innerW: window.innerWidth,
        dpr: window.devicePixelRatio,
        boardScale: m ? Number(m[1]) : scale,
        released: pageZoomed,
      };
    };

    const paintProbe = () => {
      if (!debugging || !probe) return;
      const r = readProbe();
      probe.textContent =
        `visualScale  ${r.visualScale.toFixed(3)}\n` +
        `outer/inner  ${r.outerInner.toFixed(3)}\n` +
        `vv width     ${r.vvW}\n` +
        `innerWidth   ${r.innerW}\n` +
        `dpr          ${r.dpr}\n` +
        `board scale  ${r.boardScale.toFixed(3)}\n` +
        `pinch        ${r.released ? 'RELEASED to browser' : 'held by board'}`;
    };

    /* A phone can pinch its way back; a laptop can't. Ask for the
       gesture the visitor actually has. */
    if (notice) {
      notice.textContent = window.matchMedia('(pointer: coarse)').matches
        ? 'Page is zoomed \u2014 pinch to return to 1:1'
        : 'Page is zoomed \u2014 press \u2318/Ctrl + 0 to reset';
    }

    /* 1.02 rather than 1: iOS reports tiny fractional scales at rest. */
    const syncPageZoom = () => {
      const zoomed = pageScale() > 1.02;
      if (zoomed !== pageZoomed) {
        pageZoomed = zoomed;
        viewport.classList.toggle('pinch-released', zoomed);
        notice?.classList.toggle('hidden', !zoomed);
        if (zoomed) {
          // drop any gesture the board thinks is in flight
          active.clear();
          dragging = false;
          pinchDist = 0;
        }
      }
      paintProbe();
    };

    if (debugging) probe?.classList.remove('hidden');
    syncPageZoom();

    if (vv) {
      vv.addEventListener('resize', syncPageZoom, sig);
      vv.addEventListener('scroll', paintProbe, sig);
    } else {
      window.addEventListener('resize', syncPageZoom, sig);
    }

    /* ── arriving on a plate ──────────────────────────────────────
       /photography/escarpments?plate=04 opens straight into the
       viewing station. Anything out of range is ignored rather than
       clamped: a stale link should show the board, not plate 1
       pretending to be plate 40. */
    const wanted = new URLSearchParams(window.location.search).get('plate');
    if (wanted) {
      const n = Number.parseInt(wanted, 10);
      if (Number.isInteger(n) && n >= 1 && n <= total) {
        openLightbox(n - 1, triggers[n - 1] ?? null);
      } else {
        syncUrl(null);
      }
    }
  }

  initLightTable();
  document.addEventListener('astro:page-load', initLightTable);
</script>

<style is:global>

html, body {
  overflow-x: hidden;
  overscroll-behavior-x: none;
}
  .scrollbar-none::-webkit-scrollbar { display: none; }
  .scrollbar-none { -ms-overflow-style: none; scrollbar-width: none; }

  /* works now that the container is a sibling of #workspace-viewport
     rather than a child of it — see the markup comment */
  #fixed-hud-container { touch-action: auto; }

  /* While the PAGE is zoomed, the board gives pinch back to the browser
     so the visitor can get to 1:1 — otherwise touch-none traps them at
     whatever zoom they arrived with. Set from the script; see PAGE ZOOM
     there. !important because it has to beat Tailwind's touch-none on
     the same element. */
  #workspace-viewport.pinch-released { touch-action: auto !important; }

  /* The sheet's own title, ruled onto the desk above its plates. It
     scales with the board like everything else on it, so it reads as
     something written on the paper rather than as an overlay. */
  .sheet-title {
    position: absolute;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 26px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: color-mix(in oklab, var(--color-llano, #BFB49A) 78%, var(--color-iron, #1A1919));
    padding-bottom: 10px;
    border-bottom: 2px solid color-mix(in oklab, var(--color-llano, #BFB49A) 70%, transparent);
    pointer-events: none;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .sheet-mark[data-current='true'] {
    color: var(--color-caprock, #B85A38);
    font-weight: 600;
  }

  .sheet-mark[data-current='true']::before {
    content: '\25B8';
    margin-right: 0.35em;
  }

  .sheet-mark[data-current='false']::before {
    content: '';
    margin-right: 0.9em;
  }

  /* one display authority — `hidden` and `flex` on the same element
     is a coin flip on which utility wins */
  #lightbox-modal { display: none; }
  #lightbox-modal[data-open] { display: flex; }

  /* the width/height reservation above should make this unnecessary,
     but scroll-anchoring is the browser mechanism that turns any
     leftover layout shift into a page nudge — opt the whole dialog
     out as a backstop */
  #lightbox-modal { overflow-anchor: none; }

  #lightbox-img {
    transform-origin: center center;
    transition: opacity 200ms ease;
  }
  /* only while a zoom/pan gesture is in flight — a permanent will-change
     pins the layer to the scale it was last rasterized at, which is the
     blur you see when scroll-zooming */
  #lightbox-img.is-zooming { will-change: transform; }
  #lightbox-img.is-loading { opacity: 0; }

  /* the notebook widens when it's opened on a phone */
  #hud-overlay { max-width: 70vw; }
  #hud-overlay[data-expanded='true'] { max-width: calc(100vw - 2rem); }
  @media (min-width: 768px) {
    #hud-overlay,
    #hud-overlay[data-expanded='true'] { max-width: 24rem; }
  }

  /* ── SHORT VIEWPORTS ─────────────────────────────────────────
     A phone in landscape is 844 x 390: WIDE enough to satisfy `md:`,
     so the notebook opened its full desktop body — registry, plate
     index, the lot — into 390px of height. It ran about 480px tall,
     overflowed the bottom of the screen, and took `fit board` with it,
     since the toolbar is the last thing in the panel.

     The condition was never width. Height decides whether the long
     body fits, so a height query brings back the same collapsed
     notebook and `info` toggle that portrait already uses. Both
     selectors carry an id, so they beat the `md:` utilities without
     !important. */
  @media (max-height: 560px) {
    #hud-toggle { display: inline-flex; }
    #hud-collapsible.hidden { display: none; }
  }

  /* A backstop, independent of the above: whatever ends up inside the
     notebook, it can never be taller than the screen, and the part that
     gives is the long body — the title, the sheet rail and the toolbar
     never scroll away. `min-height: 0` is required or a flex child
     refuses to shrink below its content and the cap does nothing. */
  #hud-overlay {
    max-height: calc(100dvh - 2rem);
  }

  #hud-collapsible {
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  @media (min-width: 768px) {
    #hud-overlay { max-height: calc(100dvh - 4rem); }
  }

  /* .bg-plat-desk lives in global.css. The album's gutter rules the
     same sheet, and one desk defined in two places is one desk that
     drifts. See that file for why the survey grid replaced the
     contours, and for how the two line weights are meant to degrade as
     this element scales. */

  @media (prefers-reduced-motion: reduce) {
    #lightbox-img,
    #light-table { transition: none !important; }
  }
</style>