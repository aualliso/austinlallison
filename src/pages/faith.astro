---
/**
 * faith.astro — /faith
 *
 * The statements of faith, under a cross. Reached from the cross on the
 * swell in the Caprock footer and the small cross in its basement line.
 *
 * THE PAGE, from the top:
 *
 *   the cross      a plain Latin cross in gilt, the footer's cedar cross
 *                  made precious: the same proportions, a struck line down
 *                  the middle of each bar, and the cover signature's dusty
 *                  gilt with a dark keyline, as on the favicon.
 *   the creeds     the Apostles' and the Nicene, side by side on a wide
 *                  screen and one after the other on a narrow one. Each is
 *                  kept exactly as it is written below, line breaks and
 *                  indents and all (the stylesheet sets them pre-wrap).
 *   my faith       a short personal statement. The paragraphs in MY_FAITH
 *                  are placeholders: replace them, add or remove as many as
 *                  you like. Each string is one paragraph.
 *
 * TO EDIT A CREED, edit its text below. A blank line starts a new stanza;
 * leading spaces indent a line. "Amen." is set in the accent colour
 * wherever it appears.
 */
import RootLayout from '../layouts/RootLayout.astro';

interface Creed {
  numeral: string;
  title: string;
  text: string;
}

const CREEDS: Creed[] = [
  {
    numeral: 'I',
    title: "The Apostles' Creed",
    text: `I believe in God, the Father Almighty,
maker of heaven and earth;

And in Jesus Christ his only Son, our Lord;
who was conceived by the Holy Spirit,
born of the Virgin Mary,
suffered under Pontius Pilate,
was crucified, dead, and buried;
the third day he rose from the dead;
he ascended into heaven,
and sitteth at the right hand of God the Father Almighty;
from thence he shall come to judge the quick and the dead.

I believe in the Holy Spirit,
the holy catholic church,
the communion of saints,
the forgiveness of sins,
the resurrection of the body,
and the life everlasting.

Amen.`,
  },
  {
    numeral: 'II',
    title: 'The Nicene Creed',
    text: `I believe in one God,
  the Father, the Almighty,
  maker of heaven and earth,
  of all that is, seen and unseen.

I believe in one Lord,
  Jesus Christ,
  the only Son of God,
  eternally begotten of the Father,
  God from God,
  Light from Light.

true God from true God,
  begotten, not made,
  of one Being with the Father;
  through him all things
  were made.

For me and for my salvation
he came down from heaven,
  was incarnate of the
  Holy Spirit and
  the Virgin Mary,
  and became truly human.

For my sake he was crucified
  under Pontius Pilate;
  he suffered death
  and was buried.

On the third day he rose again
  in accordance with
  the Scriptures;
  he ascended into heaven
  and is seated at the right
  hand of the Father.

He will come again in glory
  to judge the living
  and the dead,
  and his kingdom will
  have no end.

I believe in the Holy Spirit,
  the Lord, the giver of life,
  who proceeds from the Father
  and the Son,

who with the Father
  and the Son
  is worshiped and glorified,
  who has spoken
  through the prophets.

I believe in the one
  holy catholic and
  apostolic church.
  I acknowledge one baptism
  for the forgiveness of sins.

I look for the resurrection
  of the dead,
  and the life of the
  world to come.  Amen.`,
  },
];

// PLACEHOLDER: replace with your own words. One string per paragraph.
const MY_FAITH: string[] = [
  'These statements profess my faith, but more about my faith will appear later.',
  '',
  '',
];
const MOTTO = 'Soli Deo gloria.';

/** A creed as stanzas, each stanza as runs of plain text and "Amen." */
const stanzas = (text: string) =>
  text
    .replace(/\r\n/g, '\n')
    .split(/\n\s*\n/)
    .map((stanza) =>
      stanza
        .replace(/\s+$/, '')
        .split(/(Amen\.)/)
        .filter(Boolean)
        .map((run) => ({ run, amen: run === 'Amen.' }))
    );

// THE CROSS, in a 120 x 172 box: a shaft 14 wide from top to foot and a
// bar 14 deep crossing it a third of the way down. CROSS is its outline,
// STRUCK the line down the middle of each bar.
const CROSS = 'M53,8 H67 V46 H106 V60 H67 V164 H53 V60 H14 V46 H53 Z';
const STRUCK = 'M60,13 V159 M19,53 H101';
---

<RootLayout title="Faith" description="Statements of faith: the Apostles' Creed and the Nicene Creed.">
  <article class="faith">
    <header class="faith-head">
      <svg class="cross" viewBox="0 0 120 172" role="img" aria-labelledby="faith-cross-title">
        <title id="faith-cross-title">A cross</title>
        <defs>
          <linearGradient id="faith-gilt" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="0" y2="172">
            <stop offset="0" stop-color="#efe7d2"></stop>
            <stop offset="0.3" stop-color="#cdbc90"></stop>
            <stop offset="0.65" stop-color="#a8996c"></stop>
            <stop offset="1" stop-color="#877a56"></stop>
          </linearGradient>
        </defs>
        <path class="cross-body" d={CROSS}></path>
        <path class="cross-struck" d={STRUCK}></path>
      </svg>
      <p class="eyebrow">Faith</p>
      <h1 class="title">Statements of faith</h1>
      <p class="dek">What I know to be true, in the words professed by those who precede us.</p>
    </header>

    <div class="creeds">
      {CREEDS.map((creed, i) => (
        <section class="creed" aria-labelledby={`creed-${i}`}>
          <p class="eyebrow">{creed.numeral}</p>
          <h2 class="creed-title" id={`creed-${i}`}>{creed.title}</h2>
          {stanzas(creed.text).map((stanza) => (
            <p class="stanza">
              {stanza.map((part) => (part.amen ? <span class="amen">{part.run}</span> : part.run))}
            </p>
          ))}
        </section>
      ))}
    </div>

    <div class="divider" aria-hidden="true">
      <span class="rule"></span>
      <svg viewBox="0 0 120 172" class="divider-cross">
        <path d={CROSS}></path>
      </svg>
      <span class="rule"></span>
    </div>

    <section class="mine" aria-labelledby="my-faith">
      <p class="eyebrow">III</p>
      <h2 class="creed-title" id="my-faith">My faith</h2>
      {MY_FAITH.map((para) => <p>{para}</p>)}
      <p class="motto">{MOTTO}</p>
    </section>
  </article>
</RootLayout>

<style>
  .faith {
    /* the page's own colours; each reads a site token where there is one */
    --ink: var(--color-ink, #2b211a);
    --ink-soft: #5a4a3d;
    --ink-faint: #7a6a5c;
    --accent: var(--color-caprock, #9c5b3f);
    --rule: rgba(156, 91, 63, 0.35);
    --keyline: #3b2a1c;
    --serif: cormorant-garamond, 'Cormorant Garamond', Garamond, serif;
    --mono: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, Consolas, monospace);

    max-width: 64rem;
    margin: 0 auto;
    padding: clamp(2.5rem, 6vw, 4.5rem) clamp(1.25rem, 4vw, 3rem) clamp(3rem, 7vw, 5.5rem);
    color: var(--ink);
    font-family: var(--serif);
  }

  /* ── the head ─────────────────────────────────────────────── */
  .faith-head {
    text-align: center;
    margin-bottom: clamp(2.5rem, 5vw, 3.75rem);
  }
  .cross {
    display: block;
    width: clamp(6.5rem, 14vw, 8.75rem);
    height: auto;
    margin: 0 auto clamp(1.5rem, 3vw, 2rem);
    overflow: visible;
  }
  .cross-body {
    fill: url(#faith-gilt);
    stroke: var(--keyline);
    stroke-width: 1.3;
    stroke-linejoin: miter;
  }
  .cross-struck {
    fill: none;
    stroke: rgba(59, 42, 28, 0.35);
    stroke-width: 0.9;
  }

  .eyebrow {
    font-family: var(--mono);
    font-size: 0.6875rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin: 0;
  }
  .title {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(2.25rem, 5vw, 3.25rem);
    line-height: 1.05;
    margin: 0.4rem 0 0.6rem;
  }
  .dek {
    font-style: italic;
    font-size: clamp(1.125rem, 2vw, 1.3rem);
    color: var(--ink-soft);
    margin: 0;
  }

  /* ── the creeds ───────────────────────────────────────────── */
  .creeds {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(2.5rem, 5vw, 3.5rem);
  }
  @media (min-width: 52rem) {
    .creeds {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .creed-title {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(1.5rem, 2.6vw, 1.85rem);
    line-height: 1.15;
    margin: 0.25rem 0 1.1rem;
    padding-bottom: 0.55rem;
    border-bottom: 1px solid var(--rule);
  }
  /* each stanza keeps its line breaks and indents exactly as written */
  .stanza {
    white-space: pre-wrap;
    font-size: clamp(1.0625rem, 1.5vw, 1.15rem);
    line-height: 1.55;
    margin: 0 0 1.05em;
  }
  .amen {
    font-style: italic;
    color: var(--accent);
  }

  /* ── between the creeds and my own words ──────────────────── */
  .divider {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin: clamp(2.5rem, 6vw, 4rem) auto clamp(2rem, 4vw, 3rem);
    max-width: 22rem;
  }
  .divider .rule {
    flex: 1;
    height: 1px;
    background: var(--rule);
  }
  .divider-cross {
    width: 1.1rem;
    height: auto;
    fill: var(--accent);
    overflow: visible;
  }

  /* ── my faith ─────────────────────────────────────────────── */
  .mine {
    max-width: 36rem;
    margin: 0 auto;
  }
  .mine p:not(.eyebrow) {
    font-size: clamp(1.125rem, 1.7vw, 1.25rem);
    line-height: 1.65;
    margin: 0 0 1em;
  }
  .mine .motto {
    text-align: right;
    font-style: italic;
    color: var(--ink-soft);
    margin-top: 1.5rem;
  }
</style>