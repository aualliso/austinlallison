/* ── THE CREEDS ────────────────────────────────────────────────
   `latin` is the creed's name as the old books give it, set as the rubric
   over the English title. `notes` pairs a line, by its exact words, with
   the key of a verse above. */
interface Creed {
  numeral: string;
  latin: string;
  title: string;
  text: string;
  notes: [line: string, verse: keyof typeof VERSES][];
}

const CREEDS: Creed[] = [
