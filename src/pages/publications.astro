---
// src/pages/publications.astro
//
// REBUILT 2026-09-09. Every card on this page used to be hand-typed HTML, and
// it had drifted: two titles disagreed with the CV, three volume formats were
// in use across four entries, and two finished article pages (ja_cattle_company,
// newspapers_oil_and_railroad_land) had no card at all.
//
// The page now derives from src/data/publications/index.ts, which reads the
// CITATION each article data file already exports. Nothing here restates a
// citation, so nothing here can disagree with one. Add a data file and a page
// the normal way and the card appears on its own.
//
// The card designs are unchanged - the row layout for articles, the
// bottom-bleed card for everything else.
import RootLayout from '../layouts/RootLayout.astro';
import {
  SECTIONS,
  bySection,
  sourceLine,
  PUBLICATIONS,
  type SectionId,
} from '../data/publications/index';

/** Sections that use the thumbnail-beside-text row layout. */
const ROW_LAYOUT: SectionId[] = ['articles', 'notes'];

const H2 =
  'text-sm font-mono text-sage uppercase tracking-widest font-bold flex items-center gap-2';
const CARD =
  'border-t-4 border-t-caprock border-x border-b border-haze rounded-sm bg-haze/10 flex flex-col justify-between hover:shadow-sm transition-all group overflow-hidden';
const TITLE =
  'font-serif text-xl font-medium tracking-tight text-iron group-hover:text-caprock transition-colors duration-300';
const IMG =
  'w-full h-full object-cover filter group-hover:grayscale transition-all duration-500';
const BTN =
  'px-3 py-1.5 bg-caprock text-canvas rounded-sm hover:bg-sage transition-colors';
const READ =
  'text-xs font-mono text-caprock font-semibold hover:text-iron pt-2 inline-block';

const visible = SECTIONS.map((s) => ({ ...s, items: bySection(s.id) })).filter(
  (s) => s.items.length > 0
);
---

<RootLayout
  title="Research and Creative Activity | Austin Allison"
  description={`Articles, essays, columns and book chapters by Austin Allison on the history and landscapes of Texas and the American West - ${PUBLICATIONS.length} pieces, most readable in full on this site.`}
  prose={false}
>
  <div class="max-w-4xl mx-auto py-6 text-iron">
    <header class="border-b-2 border-caprock pb-4 mb-12">
      <h1 class="font-serif text-3xl font-medium tracking-tight text-iron">Research and Creative Activity</h1>
    </header>

    <div class="space-y-16">
      {visible.map((section) => (
        <section class="space-y-6">
          <h2 class={H2} id={section.id}>
            <span aria-hidden="true">&bull;</span> {section.title}
          </h2>

          {ROW_LAYOUT.includes(section.id) ? (
            <div class="space-y-8 pl-4 border-l border-haze">
              {section.items.map((e) => (
                <div class="group flex flex-col sm:flex-row gap-5 items-start">
                  {e.thumb && (
                    <div class="w-full sm:w-24 md:w-28 shrink-0 aspect-[4/3] sm:aspect-square overflow-hidden bg-haze rounded-sm">
                      <img src={e.thumb} alt={e.alt ?? ''} loading="lazy" decoding="async" class={IMG} />
                    </div>
                  )}
                  <div class="flex-1">
                    <span class="text-xs font-mono text-caprock font-semibold block mb-1">
                      {e.citation.monthYear ?? e.citation.dateLabel ?? e.citation.year}
                    </span>
                    <h3 class={TITLE}>{e.citation.displayTitle ?? e.citation.title}</h3>
                    <p class="text-base text-iron/70 mt-1 font-serif">
                      <span class="italic">{sourceLine(e.citation)}</span>
                    </p>
                    <div class="mt-4 flex flex-wrap gap-3 text-xs font-mono">
                      <a
                        href={e.citation.canonicalPath}
                        aria-label={`Read the full text of \u201c${e.citation.title}\u201d`}
                        class={BTN}
                      >read full text</a>
                      {e.otherVersions.map((v) => (
                        <a
                          href={v.path}
                          aria-label={`Read the ${v.label.toLowerCase()} of \u201c${e.citation.title}\u201d`}
                          class={BTN}
                        >{v.label.toLowerCase()}</a>
                      ))}
                    </div>
                  </div>
                </div>
              ))}
            </div>
          ) : (
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              {section.items.map((e) => (
                <div class={CARD}>
                  <div class="p-6 pb-4 space-y-2">
                    <span class="text-[10px] font-mono uppercase tracking-wider text-sage font-bold block">
                      {sourceLine(e.citation)}
                    </span>
                    <h3 class={TITLE}>{e.citation.displayTitle ?? e.citation.title}</h3>
                    <a
                      href={e.citation.canonicalPath}
                      aria-label={`Read the full text of \u201c${e.citation.title}\u201d`}
                      class={READ}
                    >read full article &rarr;</a>
                    {e.otherVersions.length > 0 && (
                      <div class="flex flex-wrap gap-4">
                        {e.otherVersions.map((v) => (
                          <a
                            href={v.path}
                            aria-label={`Read the ${v.label.toLowerCase()} of \u201c${e.citation.title}\u201d`}
                            class={READ}
                          >{v.label.toLowerCase()} &rarr;</a>
                        ))}
                      </div>
                    )}
                  </div>

                  {e.thumb && (
                    <div class="w-full h-40 overflow-hidden bg-haze mt-auto border-t border-haze/50">
                      <img src={e.thumb} alt={e.alt ?? ''} loading="lazy" decoding="async" class={IMG} />
                    </div>
                  )}
                </div>
              ))}
            </div>
          )}
        </section>
      ))}
    </div>
  </div>
</RootLayout>