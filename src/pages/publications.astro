---
// src/pages/publications-cards.astro
//
// Two movements, on the ground.
//
// 0. THE GROUND. The table is the land the work is about: a shaded relief of
//    the Llano Estacado and its edges from USGS elevation data
//    (public/ground/llano-dem.webp), lit by the sun - or the moon - where it
//    stands over Lubbock right now, and relit every ten minutes
//    (src/lib/ground.ts; the shading runs in a Web Worker). The only
//    lettering on the land is its name. The cards' own shadows fall away
//    from the light. Under `astro dev`, the header's ?debugTime=<ISO>
//    (or ?light=dawn, noon, dusk, fullmoon, newmoon) previews another hour.
//    Phones keep a plain table.
//
// 1. THE TABLE. Every publication as a card, dealt at random across one
//    screen - the room left under the site header - and sized by rank: the
//    three peer-reviewed articles largest, Authentic Texas next, Caprock
//    Chronicles next, notes and documents smallest. The page is titled by a
//    small placard pinned to the corner of the table rather than a headline.
//    Cards overlap, but only ever over another card's picture, never its
//    text (src/lib/scatter.ts enforces that). Every visit deals a new layout;
//    "Deal again" deals another.
//
// 2. THE VIEWER. Choosing a card lifts it off the table and grows it into a
//    large plate floating on a coloured ground: a spread of the piece's
//    images, its opening line, where and when it appeared, how to cite it.
//    Newer / Older (or the arrow keys) step through the pieces, most recent
//    first; Close, Esc or a click on the ground settles the plate back into
//    its card. The address names the open piece, so it can be shared, and a
//    link to #pub-<slug> opens that piece on arrival. On a phone the viewer
//    is a full-screen panel.
//
// Without JavaScript the cards link down to the same plates, set out as a
// plain list below the table - which is also what search engines read.
//
// The site header is sticky and takes real height (104px on desktop, 85px on
// a phone). The script measures it into --header-h; the table and the
// viewer size themselves to the room left beneath it.
//
// Motion: transforms and opacity only - no filter, blend mode or mask.
import RootLayout from '../layouts/RootLayout.astro';
import Plate from '../components/publications/Plate.astro';
import { PUBLICATIONS, type Entry, type Form, type ResolvedImage } from '../data/publications/index';
import { citeChicago, type Citation } from '../lib/citation';
import { scatter, type CardSpec } from '../lib/scatter';

/* ---------------- rank, colour, date ---------------- */

type Tier = 1 | 2 | 3 | 4;
const TIER_OF: Record<Form, Tier> = { feature: 1, magazine: 2, newspaper: 3, book: 3, archive: 4 };
const TIER_LABEL: Record<Tier, string> = {
  1: 'Peer-reviewed articles',
  2: 'Authentic Texas',
  3: 'Caprock Chronicles',
  4: 'Notes and documents',
};
/** Relative card AREA per tier, and card height as a multiple of width. */
const WEIGHT: Record<Tier, number> = { 1: 1, 2: 0.6, 3: 0.4, 4: 0.3 };
const ASPECT: Record<Tier, number> = { 1: 1.15, 2: 1.2, 3: 1.25, 4: 1.35 };
/** Narrowest a card may become, px: below this its title is too cramped. */
const MIN_W: Record<Tier, number> = { 1: 214, 2: 166, 3: 144, 4: 132 };
/** The ground each plate floats on, from the site's earth palette. */
const GROUND: Record<Form, string> = {
  feature: '#4c5a4c',   // juniper
  magazine: '#9a6d43',  // ochre
  newspaper: '#57524a', // newsprint ink
  book: '#8a5639',      // caprock
  archive: '#3d4a46',   // archive board
};

const MONTHS = ['january','february','march','april','may','june','july','august','september','october','november','december'];
const SEASONS: Record<string, number> = { winter: 1, spring: 4, summer: 7, fall: 10, autumn: 10 };
/** A sortable date: year * 12 + month, from monthYear / dateLabel. */
const dateKey = (c: Citation): number => {
  const label = `${c.monthYear ?? ''} ${c.dateLabel ?? ''}`.toLowerCase();
  let m = 6;
  MONTHS.forEach((name, i) => { if (label.includes(name)) m = i + 1; });
  for (const [name, mm] of Object.entries(SEASONS)) if (label.includes(name)) m = mm;
  const d = label.match(/\b([0-3]?\d),/);
  return c.year * 12 + m + (d ? Number(d[1]) / 40 : 0);
};

const titleParts = (c: Citation) => {
  if (c.displayTitle) return { main: c.displayTitle, sub: c.subtitle };
  const i = c.title.indexOf(': ');
  return i > 0 ? { main: c.title.slice(0, i), sub: c.title.slice(i + 2) } : { main: c.title, sub: c.subtitle };
};
const venue = (c: Citation) => (c.status === 'chapter' ? c.bookTitle?.split(/:\s+/)[0] : c.journal) ?? '';
const when = (c: Citation) => c.monthYear ?? c.dateLabel ?? String(c.year);
const pages = (c: Citation) => (c.firstPage != null && c.lastPage != null ? `${c.firstPage}\u2013${c.lastPage}` : '');
const issue = (c: Citation) => (c.volume ? `Vol. ${c.volume}${c.issue ? `, no. ${c.issue}` : ''}` : '');
const two = (n: number) => String(n).padStart(2, '0');


/* ---------------- images ---------------- */

/** The image that can lead, chosen from the piece's SHOW images (whose
    object types are real): a colour photograph or cover before a drawing. */
const coverOf = (e: Entry): ResolvedImage | undefined => {
  const chosen = e.images;
  return chosen.find((i) => i.object === 'plate') ?? chosen.find((i) => i.object === 'pamphlet') ??
    chosen.find((i) => i.object === 'notebook') ?? chosen[0] ?? e.gallery[0];
};
/** The lead image, then the rest of the figures, five at most. */
const spreadOf = (e: Entry): ResolvedImage[] => {
  const lead = coverOf(e);
  return lead ? [lead, ...e.gallery.filter((g) => g.src !== lead.src)].slice(0, 5) : [];
};
/** Photographs and covers fill their frame; clippings and documents are shown whole. */
const fills = (img: ResolvedImage) => img.fit !== 'whole' && ['plate', 'print', 'pamphlet', 'notebook'].includes(img.object);

/* ---------------- the table ---------------- */

// Cards in no particular order. The browser deals them at random on every
// visit, with their real measured sizes; this build-time deal, at a nominal
// table size and a fixed seed, is only the layout seen without JavaScript.
const tableCards = [...PUBLICATIONS];

const NOMINAL_W = 1376;
const NOMINAL_H = 640;
const LABEL_W = 300;
const LABEL_H = 110;
const ssrSpecs: CardSpec[] = [
  { weight: 0, aspect: 1, pin: { x: 0, y: 0 }, width: LABEL_W, height: LABEL_H },
  ...tableCards.map((e) => ({
    weight: WEIGHT[TIER_OF[e.form]],
    aspect: ASPECT[TIER_OF[e.form]],
    textHeight: coverOf(e) ? undefined : (w: number) => w * ASPECT[TIER_OF[e.form]],
    raised: TIER_OF[e.form] === 1,
  })),
];
const ssr = scatter(ssrSpecs, NOMINAL_W, NOMINAL_H, 1886, { density: 0.95, margin: 14, maxTilt: 2.4, maxCover: 0.4, candidates: 48, edgePull: 2 }).placed;
const pct = (v: number, of: number) => `${((v / of) * 100).toFixed(3)}%`;

/* ---------------- the plates, most recent first ---------------- */

const sequence = [...PUBLICATIONS].sort((a, b) => dateKey(b.citation) - dateKey(a.citation));
---

<RootLayout
  title="Publications | Austin Allison"
  description={`Articles, columns, notes and a book chapter by Austin Allison on land, survey, water and settlement in Texas and the American West - ${PUBLICATIONS.length} pieces, most readable in full on this site.`}
  prose={false}
  bleed={true}
>
  <div class="pc" id="pc-top">

    {/* ======================== THE TABLE ======================== */}
    <section class="pc-table" aria-labelledby="pc-h1">
      {/* the land under the table, drawn by src/lib/ground.ts */}
      <canvas class="pc-land" aria-hidden="true"></canvas>
      <div class="pc-felt" data-nominal-w={NOMINAL_W}>

        {/* The page's title, lettered on the land like the title of a map.
             The small control under it clears the cards off the land. */}
        <div class="pc-label" style={`z-index: ${ssr[0].z}`}>
          <h1 class="pc-label-h1" id="pc-h1">Publications</h1>
          <button type="button" class="pc-view" data-pc-view aria-pressed="false" hidden>
            <svg viewBox="0 0 20 12" width="18" height="11" aria-hidden="true"><path d="M1 6 C4 1.6 16 1.6 19 6 C16 10.4 4 10.4 1 6 Z" /><circle cx="10" cy="6" r="2.4" /></svg>
            <span data-pc-view-text>View the land</span>
          </button>
        </div>

        {tableCards.map((e, k) => {
          const t = TIER_OF[e.form];
          const p = ssr[k + 1];
          const tp = titleParts(e.citation);
          const img = coverOf(e);
          return (
            <a
              class={`pc-card t${t}`}
              href={`#pub-${e.slug}`}
              data-slug={e.slug}
              data-w={WEIGHT[t]}
              data-a={ASPECT[t]}
              data-min={MIN_W[t]}
              data-solid={img ? undefined : ''}
              data-raised={t === 1 ? '' : undefined}
              style={`left: ${pct(p.x, NOMINAL_W)}; top: ${pct(p.y, NOMINAL_H)}; width: ${pct(p.w, NOMINAL_W)}; z-index: ${p.z}; --tilt: ${p.rot.toFixed(2)}deg; --ground: ${GROUND[e.form]}`}
            >
              <span class:list={['pc-card-img', img?.fit === 'whole' && 'is-whole']}>
                {img ? (
                  <Plate img={{ ...img, alt: '' }} bare sizes={t === 1 ? '360px' : t === 2 ? '280px' : '220px'} widths={[320, 480, 640, 840]} />
                ) : (
                  <span class="pc-card-type" aria-hidden="true">{tp.main}</span>
                )}
              </span>
              <span class="pc-card-text" data-pc-text>
                <span class="pc-card-venue"><span class="pc-swatch" aria-hidden="true" />{venue(e.citation)}</span>
                <span class="pc-card-title">{tp.main}</span>
                <span class="pc-card-meta">{when(e.citation)}{pages(e.citation) && ` \u00b7 pp. ${pages(e.citation)}`}</span>
              </span>
            </a>
          );
        })}
      </div>
    </section>

    {/* ======================== THE PLATES ========================
         One plate per piece, most recent first. With JavaScript they wait
         here unseen, and the viewer below shows them one at a time. Without
         it - and for search engines - they read as a plain list, and every
         card on the table links down to its plate. */}
    <section class="pc-shelf" id="pc-shelf" aria-label="All publications, most recent first">
      <p class="pc-shelf-head">All publications, most recent first</p>
      {sequence.map((e) => {
        const tp = titleParts(e.citation);
        const spread = spreadOf(e);
        const hero = spread[0];
        const cite = citeChicago(e.citation);
        const rows: [string, string][] = [
          ['Published in', venue(e.citation)],
          ['Issue', [issue(e.citation), when(e.citation)].filter(Boolean).join(' \u00b7 ')],
          ['Pages', pages(e.citation)],
          ['Notes', e.noteCount ? String(e.noteCount) : ''],
          ['Figures', e.gallery.length > 1 ? String(e.gallery.length) : ''],
        ].filter(([, v]) => v) as [string, string][];
        return (
          <div
            class="pc-slot"
            id={`pub-${e.slug}`}
            data-slug={e.slug}
            data-kind={TIER_LABEL[TIER_OF[e.form]]}
            style={`--ground: ${GROUND[e.form]}`}
          >
            <article class="pc-plate" aria-labelledby={`pc-t-${e.slug}`}>
              <div class="pc-spread" data-n={spread.length}>
                {spread.length === 0 && (
                  <div class="pc-cell pc-cell--type"><span>{tp.main}</span></div>
                )}
                {spread.map((img, k) => (
                  <figure class:list={['pc-cell', k === 0 ? 'is-hero' : 'is-mount', k === 0 && !fills(img) && 'is-whole']}>
                    <Plate
                      img={k === 0 ? img : { ...img, position: undefined }}
                      bare
                      sizes={k === 0 ? '(max-width: 900px) 100vw, 760px' : '(max-width: 900px) 50vw, 300px'}
                      widths={k === 0 ? [640, 960, 1280, 1600] : [320, 480, 640]}
                    />
                  </figure>
                ))}
              </div>
              <div class="pc-info">
                <p class="pc-kicker"><span class="pc-swatch" aria-hidden="true" />{venue(e.citation)} &middot; {when(e.citation)}</p>
                <h2 id={`pc-t-${e.slug}`} class="pc-title"><a href={e.citation.canonicalPath}>{tp.main}</a></h2>
                {tp.sub && <p class="pc-deck">{tp.sub}</p>}
                {e.lead && <p class="pc-lead">{e.lead}</p>}
                <dl class="pc-facts">
                  {rows.map(([k, v]) => (<><dt>{k}</dt><dd>{v}</dd></>))}
                </dl>
                <p class="pc-links">
                  <a class="pc-read" href={e.citation.canonicalPath}>Read the {e.citation.status === 'chapter' ? 'chapter' : 'article'} &rarr;</a>
                  {e.otherVersions.map((v) => <a class="pc-read is-soft" href={v.path}>{v.label} &rarr;</a>)}
                </p>
                {hero && (hero.caption || hero.credit) && (
                  <p class="pc-figcap">
                    <span class="pc-figcap-k">Shown</span>
                    {hero.caption && <span set:html={hero.caption} />}
                    {hero.credit && <span class="pc-figcap-cr" set:html={` ${hero.credit}`} />}
                  </p>
                )}
                {cite && <p class="pc-cite"><span class="pc-figcap-k">Cite</span>{cite}</p>}
              </div>
            </article>
          </div>
        );
      })}
    </section>

    {/* ======================== THE VIEWER ========================
         A modal dialog: the browser keeps keyboard focus inside it, makes
         the page behind it inert and hands focus back to the card when it
         closes. It opens below the site header, which stays in view. */}
    <dialog class="pc-viewer" aria-label="Publication">
      <div class="pc-ground" aria-hidden="true"></div>
      <div class="pc-bar">
        <p class="pc-counter" aria-live="polite"><span data-pc-n>01</span> / {two(sequence.length)} &middot; <span data-pc-kind></span></p>
        <button type="button" class="pc-btn" data-pc-close>Close <span aria-hidden="true">&times;</span></button>
      </div>
      <div class="pc-stagearea" data-pc-stage></div>
      <div class="pc-nav">
        <button type="button" class="pc-btn" data-pc-step="-1"><span aria-hidden="true">&larr;</span> Newer</button>
        <button type="button" class="pc-btn" data-pc-step="1">Older <span aria-hidden="true">&rarr;</span></button>
      </div>
    </dialog>
  </div>
</RootLayout>

<script>
  import { scatter, type CardSpec, type Scatter } from '../lib/scatter';
  import { Ground, lightAt, makeView, moonAt, moonFraction, sunAt, type Light, type View } from '../lib/ground';

  const narrow = window.matchMedia('(max-width: 900px)');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  const EASE = 'cubic-bezier(.2,.7,.2,1)';
  /** Options for the deal; the same rules the build-time deal used. */
  const OPTS = { density: 0.74, margin: 14, maxTilt: 2.4, maxCover: 0.4, attempts: 8, candidates: 32, edgePull: 0.8 };
  const freshSeed = () => (Math.random() * 2147483647) | 0;
  const seed = freshSeed();

  /* ---- the horizon: the land fades into the footer's sky ----
     The footer stands the header's sky of this moment over the Caprock and
     keeps it current itself (its --sky-top). The table's last stretch of
     land fades into that same colour, and this page asks the footer's sky
     to start from it (see .caprock .sky in the styles), so the map passes
     into the sky above the Caprock without a line - by day and by night. */
  const watchedFooters = new WeakSet<Element>();
  const readFade = () => {
    const table = document.querySelector<HTMLElement>('.pc-table');
    const footer = document.querySelector<HTMLElement>('[data-caprock]');
    if (!table || !footer) return;
    const sync = () => {
      const top = getComputedStyle(footer).getPropertyValue('--sky-top').trim();
      if (top) table.style.setProperty('--pc-fade', top);
    };
    sync();
    if (!watchedFooters.has(footer)) {
      watchedFooters.add(footer);
      new MutationObserver(sync).observe(footer, { attributes: true, attributeFilter: ['style'] });
    }
  };

  /* ---- full bleed: the page spans the window, edge to edge ----
     Measured rather than assumed: whatever padding, max-width or off-centre
     wrapper the layout puts around the page, it is moved to the window's
     left edge and made as wide as the window's content (scrollbar excluded,
     so nothing scrolls sideways). Re-measured whenever the window or the
     scrollbar changes. The CSS on .pc is only the first guess. */
  let fitting = false;
  const fitBleed = () => {
    const pc = document.querySelector<HTMLElement>('.pc');
    if (!pc || fitting) return;
    fitting = true;
    const cw = document.documentElement.clientWidth;
    pc.style.width = `${cw}px`;
    pc.style.marginLeft = '0px';
    const left = pc.getBoundingClientRect().left + window.scrollX;
    pc.style.marginLeft = `${-left}px`;
    fitting = false;
  };
  const watchedRoots = new WeakSet<Element>();
  const trackBleed = () => {
    fitBleed();
    const root = document.documentElement;
    if (!watchedRoots.has(root) && 'ResizeObserver' in window) {
      watchedRoots.add(root);
      let lastW = root.clientWidth;
      // the scrollbar coming or going changes the width without a resize event
      new ResizeObserver(() => {
        if (root.clientWidth === lastW) return;
        lastW = root.clientWidth;
        fitBleed();
        onResize();
      }).observe(root);
    }
  };

  /* ---- the header: measure it, so everything below can fit the room left ---- */
  const watched = new WeakSet<Element>();
  const trackHeader = () => {
    const h = document.getElementById('horizon-sticky');
    const set = () => document.documentElement.style.setProperty('--header-h', `${h ? h.offsetHeight : 0}px`);
    set();
    if (h && !watched.has(h) && 'ResizeObserver' in window) {
      watched.add(h);
      new ResizeObserver(set).observe(h);
    }
  };

  /* ---- the ground: the land under the table, and the light on it ---- */
  let ground: Ground | null = null;
  let feltView: View | null = null;
  /** Mockup: a chosen moment to light the land by, instead of now. */
  let lightAt_: Date | null = null;

  /** The cards' shadows follow the light. */
  const applyLight = (light: Light) => {
    const table = document.querySelector<HTMLElement>('.pc-table');
    if (!table) return;
    const s = table.style;
    let L = 0;
    let alpha = 0.45;
    let col = '48 32 16';
    if (light.directI > 0.02) {
      L = Math.min(26, Math.max(3, 5 / Math.tan(Math.max(light.altitude, 0.05))));
      if (light.phase !== 'day') { alpha = 0.6; col = '4 6 12'; }
    } else { alpha = light.phase === 'day' ? 0.45 : 0.55; col = light.phase === 'day' ? '48 32 16' : '4 6 12'; }
    // a shadow falls away from the light
    const sx = -Math.sin(light.bearing) * L;
    const sy = Math.cos(light.bearing) * L;
    s.setProperty('--sx', `${sx.toFixed(1)}px`);
    s.setProperty('--sy', `${(sy + (L ? 2 : 10)).toFixed(1)}px`);
    s.setProperty('--sb', `${(14 + L * 0.7).toFixed(1)}px`);
    s.setProperty('--sa', alpha.toFixed(2));
    s.setProperty('--sc', col);
    table.dataset.light = light.phase === 'day' ? 'day' : light.ambientI > 0.4 ? 'dusk' : 'night';
  };

  const paintGround = async () => {
    const table = document.querySelector<HTMLElement>('.pc-table');
    const felt = document.querySelector<HTMLElement>('.pc-felt');
    if (!table || !felt || !ground || !ground.ready || !feltView || narrow.matches) return;
    const light = lightAt(lightAt_ ?? new Date());
    applyLight(light);
    // The view is fitted to the whole table, edge to edge, so the land
    // always reaches the window's sides - never stretched past the edge of
    // the elevation data, which would leave a bare strip.
    await ground.render(makeView(table.clientWidth, table.clientHeight, 0.004), light);
  };

  /* ---- the table: deal the cards ---- */
  const deal = () => {
    const felt = document.querySelector<HTMLElement>('.pc-felt');
    if (!felt) return;
    if (narrow.matches) { felt.dataset.dealt = 'static'; return; }
    const label = felt.querySelector<HTMLElement>('.pc-label')!;
    const cards = Array.from(felt.querySelectorAll<HTMLElement>('.pc-card'));
    felt.style.height = '';
    const W = felt.clientWidth;
    let H = felt.clientHeight;
    const lw = label.offsetWidth;
    const lh = label.offsetHeight;

    // the land the felt shows
    feltView = makeView(W, H);

    const weights = cards.map((c) => Number(c.dataset.w));
    // On a small table the floors give a little, so the deal still fits the screen.
    const shrink = Math.min(1, Math.max(0.84, Math.min(Math.sqrt((W * H) / (1300 * 700)), H / 720)));
    const mins = cards.map((c) => Number(c.dataset.min) * shrink);
    const aspects = cards.map((c) => Number(c.dataset.a));
    const sized = weights.reduce((s, w, i) => s + w * aspects[i], 0);
    const unit = Math.sqrt(Math.max(1, OPTS.density * W * H - lw * lh) / sized);

    // Size the cards, measure what they really are (text wraps differently at
    // every width), deal. If no lawful deal turns up, the cards get a little
    // smaller - down to a floor below which titles would be too cramped -
    // and past that floor the table grows a little taller instead.
    let res: Scatter = { placed: [], ok: false };
    let f = 1;
    for (let round = 0; round < 24; round++) {
      const widths = weights.map((w, i) => Math.round(Math.max(mins[i], Math.sqrt(w) * unit * f)));
      cards.forEach((c, i) => (c.style.width = `${widths[i]}px`));
      const heights = cards.map((c) => c.offsetHeight);
      // a card with no picture is all text: its lettered tile is protected too
      const texts = cards.map((c, i) => (c.hasAttribute('data-solid') ? heights[i] : c.querySelector<HTMLElement>('[data-pc-text]')!.offsetHeight));
      const specs: CardSpec[] = [
        { weight: 0, aspect: 1, pin: { x: 0, y: 0 }, width: lw, height: lh },
        ...cards.map((c, i) => ({
          weight: weights[i], aspect: 1, width: widths[i], height: heights[i], textHeight: () => texts[i],
          raised: c.hasAttribute('data-raised'),
        })),
      ];
      res = scatter(specs, W, H, seed, OPTS);
      if (res.ok) break;
      const atFloor = widths.every((w, i) => w <= Math.round(mins[i]));
      if (atFloor) { H = Math.round(H * 1.03); felt.style.height = `${H}px`; }
      else f *= 0.95;
    }
    label.style.zIndex = String(res.placed[0].z);
    const placedCards = res.placed.slice(1, 1 + cards.length);
    placedCards.forEach((p, i) => {
      const s = cards[i].style;
      s.left = `${p.x.toFixed(1)}px`;
      s.top = `${p.y.toFixed(1)}px`;
      s.width = `${p.w.toFixed(1)}px`;
      s.zIndex = String(p.z);
      s.setProperty('--tilt', `${p.rot.toFixed(2)}deg`);
    });
    felt.dataset.dealt = res.ok ? 'clean' : 'crowded';
    topZ = 0;
    paintGround();
  };

  /* ---- the entrance: the land first, then the cards laid on it ----
     Every time the page is loaded: the land fades up on its own and is left
     to be looked at for a moment, then the cards are laid on it one by one.
     Any click, key or scroll in the meantime deals them at once. Not on
     phones, and not for visitors who have asked their system for less
     motion. */
  /** How long the bare land is shown once it has fully faded in. */
  const LAND_ALONE_MS = 1600;
  /** The land's own fade-in (.pc-land transition), which has to finish first. */
  const LAND_FADE_MS = 1200;
  const enter = () => {
    const felt = document.querySelector<HTMLElement>('.pc-felt');
    if (!felt || felt.dataset.entered) return;
    felt.dataset.entered = '1';
    // bottom of the pile first, so each card lands on the ones before it
    const cards = Array.from(felt.querySelectorAll<HTMLElement>('.pc-card'))
      .sort((a, b) => Number(a.style.zIndex) - Number(b.style.zIndex));
    const STEP = 110;
    cards.forEach((c, i) => (c.style.transitionDelay = `${i * STEP}ms`));
    felt.classList.remove('pc-hold');
    // the delays are for the entrance only: hover and dragging respond at once
    window.setTimeout(() => cards.forEach((c) => (c.style.transitionDelay = '')), cards.length * STEP + 900);
  };

  /* ---- view the land: the cards cleared away, and back ---- */
  const setBare = (bare: boolean) => {
    const table = document.querySelector<HTMLElement>('.pc-table');
    const felt = document.querySelector<HTMLElement>('.pc-felt');
    const btn = document.querySelector<HTMLButtonElement>('[data-pc-view]');
    if (!table || !felt || !btn) return;
    if (bare === table.classList.contains('pc-bare')) return;
    const cards = Array.from(felt.querySelectorAll<HTMLElement>('.pc-card'));
    // each card slides away from the middle of the table, toward its nearest
    // edge, and comes back the same way
    const cx = felt.clientWidth / 2;
    const cy = felt.clientHeight / 2;
    cards.forEach((c, i) => {
      const dx = c.offsetLeft + c.offsetWidth / 2 - cx;
      const dy = c.offsetTop + c.offsetHeight / 2 - cy;
      const len = Math.hypot(dx, dy) || 1;
      c.style.setProperty('--ax', `${((dx / len) * 70).toFixed(1)}px`);
      c.style.setProperty('--ay', `${((dy / len) * 70).toFixed(1)}px`);
      c.style.transitionDelay = `${(bare ? i : cards.length - 1 - i) * 18}ms`;
    });
    window.setTimeout(() => cards.forEach((c) => (c.style.transitionDelay = '')), cards.length * 18 + 600);
    table.classList.toggle('pc-bare', bare);
    btn.setAttribute('aria-pressed', String(bare));
    btn.querySelector('[data-pc-view-text]')!.textContent = bare ? 'Show the publications' : 'View the land';
  };
  const setupViewToggle = () => {
    const btn = document.querySelector<HTMLButtonElement>('[data-pc-view]');
    if (!btn || btn.dataset.bound) return;
    btn.dataset.bound = '1';
    btn.hidden = false;
    btn.addEventListener('click', () => {
      const table = document.querySelector<HTMLElement>('.pc-table');
      setBare(!table?.classList.contains('pc-bare'));
    });
    document.addEventListener('keydown', (ev) => {
      if (ev.key !== 'Escape') return;
      if (document.querySelector<HTMLDialogElement>('.pc-viewer')?.open) return;
      setBare(false);
    });
  };

  /* ---- moving the cards by hand ----
     Press and move more than a few pixels and the card is picked up: it
     straightens, lifts, follows the pointer and comes to the top of the
     pile. Let go and it stays there. A press that does not move is still a
     click and opens the piece. Deal again (or resizing the window) deals a
     fresh table. Desktop only - phones show the cards as a plain list. */
  const DRAG_START = 6;
  let topZ = 0;
  const setupDrag = () => {
    const felt = document.querySelector<HTMLElement>('.pc-felt');
    if (!felt || felt.dataset.dragBound) return;
    felt.dataset.dragBound = '1';
    // images inside a link would otherwise start the browser's own drag
    felt.addEventListener('dragstart', (ev) => ev.preventDefault());
    felt.querySelectorAll<HTMLElement>('.pc-card').forEach((card) => {
      let sx = 0, sy = 0, left = 0, top = 0, moving = false, id = -1;
      card.addEventListener('pointerdown', (ev) => {
        if (narrow.matches || ev.button !== 0 || !ev.isPrimary) return;
        id = ev.pointerId;
        sx = ev.clientX;
        sy = ev.clientY;
        left = card.offsetLeft;
        top = card.offsetTop;
        moving = false;
      });
      card.addEventListener('pointermove', (ev) => {
        if (ev.pointerId !== id) return;
        const dx = ev.clientX - sx;
        const dy = ev.clientY - sy;
        if (!moving) {
          if (Math.hypot(dx, dy) < DRAG_START) return;
          moving = true;
          card.setPointerCapture(id);
          // to the top of the pile, still under the title placard
          if (!topZ) topZ = Math.max(...Array.from(felt.children).map((c) => Number((c as HTMLElement).style.zIndex) || 0));
          topZ += 1;
          card.style.zIndex = String(topZ);
          const label = felt.querySelector<HTMLElement>('.pc-label');
          if (label) label.style.zIndex = String(topZ + 1);
          card.classList.add('is-dragging');
        }
        const maxX = felt.clientWidth - card.offsetWidth;
        const maxY = felt.clientHeight - card.offsetHeight;
        card.style.left = `${Math.min(maxX, Math.max(0, left + dx)).toFixed(1)}px`;
        card.style.top = `${Math.min(maxY, Math.max(0, top + dy)).toFixed(1)}px`;
      });
      const end = (ev: PointerEvent) => {
        if (ev.pointerId !== id) return;
        id = -1;
        if (!moving) return;
        moving = false;
        card.dataset.dragged = '1';
        card.classList.remove('is-dragging');
        // it settles back down at a slight angle of its own
        card.style.setProperty('--tilt', `${((Math.random() * 2 - 1) * 2).toFixed(2)}deg`);
        // if no click follows (pointer released off the card), forget the drag
        window.setTimeout(() => delete card.dataset.dragged, 0);
      };
      card.addEventListener('pointerup', end);
      card.addEventListener('pointercancel', end);
    });
  };

  /* ---- previewing the light (dev server only) ----
     Uses the header's own debug switch, so one address stages the sky and
     the land together:
       ?debugTime=2026-10-13T19:05:00-05:00   any moment Date() accepts
       ?light=dawn | noon | dusk | fullmoon | newmoon   a named moment, found
                                                       for today or the next
                                                       full / new moon
     Both are ignored on the live site, exactly as the header ignores them:
     the gate is the header's data-debug-time attribute, which Header.astro
     sets only under `astro dev`. (?light= moves only the land; the header
     reads ?debugTime alone, so use that to see both agree.) ---- */
  const LUB = { lat: 33.58, lon: -101.85 };
  const scan = (from: Date, hours: number, stepMin: number, score: (d: Date) => number) => {
    let best = from;
    let bestS = -Infinity;
    for (let t = 0; t <= hours * 60; t += stepMin) {
      const d = new Date(from.valueOf() + t * 60000);
      const sc = score(d);
      if (sc > bestS) { bestS = sc; best = d; }
    }
    return best;
  };
  const momentFor = (key: string): Date | null => {
    const midnight = new Date();
    midnight.setHours(0, 0, 0, 0);
    const deg = (r: number) => r * 57.2958;
    const sunAlt = (d: Date) => deg(sunAt(d, LUB.lat, LUB.lon).altitude);
    switch (key) {
      case 'dawn': return scan(midnight, 12, 5, (d) => -Math.abs(sunAlt(d) - 6) - (sunAt(d, LUB.lat, LUB.lon).bearing > Math.PI ? 99 : 0));
      case 'noon': return scan(midnight, 24, 10, sunAlt);
      case 'dusk': return scan(new Date(midnight.valueOf() + 12 * 3600000), 12, 5, (d) => -Math.abs(sunAlt(d) - 5));
      case 'fullmoon': return scan(midnight, 24 * 32, 20, (d) => (sunAlt(d) < -15 ? moonFraction(d) * 3 - Math.abs(deg(moonAt(d, LUB.lat, LUB.lon).altitude) - 24) / 30 : -9));
      case 'newmoon': return scan(midnight, 24 * 32, 30, (d) => (sunAlt(d) < -18 ? -moonFraction(d) - (moonAt(d, LUB.lat, LUB.lon).altitude > 0 ? 1 : 0) : -9));
      default: return null;
    }
  };
  const readLightParam = () => {
    lightAt_ = null;
    const header = document.getElementById('horizon-header');
    if (header?.getAttribute('data-debug-time') !== '1') return;
    const q = new URLSearchParams(location.search);
    const iso = q.get('debugTime');
    if (iso) {
      const d = new Date(iso);
      if (!isNaN(d.getTime())) { lightAt_ = d; return; }
    }
    const key = q.get('light');
    if (key) lightAt_ = momentFor(key);
  };

  /* ---- the viewer: a card opens into its plate ---- */
  type Viewer = {
    dialog: HTMLDialogElement;
    stage: HTMLElement;
    ground: HTMLElement;
    chrome: HTMLElement[];
    order: string[];
    slots: Map<string, HTMLElement>;
    /** Each piece's plate, wherever it is: on the shelf or on the stage. */
    plates: Map<string, HTMLElement>;
    index: number;
    /** Opening, closing and stepping run one after another, never at once:
        an Esc pressed mid-animation waits its turn instead of being lost. */
    queue: Promise<void>;
    queued: number;
  };
  let V: Viewer | null = null;

  const motion = () => !reduce.matches;
  const plateOf = (slug: string) => V!.plates.get(slug)!;
  const cardOf = (slug: string) => document.querySelector<HTMLElement>(`.pc-card[data-slug="${slug}"]`);
  const visible = (el: HTMLElement | null) => {
    if (!el) return false;
    const r = el.getBoundingClientRect();
    return r.width > 0 && r.bottom > 0 && r.top < innerHeight;
  };
  const done = (anims: Animation[]) => Promise.all(anims.map((a) => a.finished.catch(() => undefined)));

  /** Stop the page behind from scrolling, without the layout jumping. */
  const lock = (on: boolean) => {
    const html = document.documentElement;
    if (on) {
      const bar = innerWidth - html.clientWidth;
      html.classList.add('pc-open');
      if (bar > 0) html.style.paddingRight = `${bar}px`;
    } else {
      html.classList.remove('pc-open');
      html.style.paddingRight = '';
    }
  };
  const setHash = (slug: string | null) => {
    const url = slug ? `#pub-${slug}` : location.pathname + location.search;
    // replaceState, keeping the router's own state: the address always names
    // the open piece (so it can be shared), and Back still leaves the page.
    history.replaceState(history.state, '', url);
  };

  /** Put plate i on the stage and update the counter, buttons and colour. */
  const mount = (i: number) => {
    const v = V!;
    const slug = v.order[i];
    const slot = v.slots.get(slug)!;
    v.index = i;
    v.stage.replaceChildren(plateOf(slug));
    v.dialog.style.setProperty('--ground', slot.style.getPropertyValue('--ground'));
    v.dialog.setAttribute('aria-labelledby', `pc-t-${slug}`);
    v.dialog.querySelector('[data-pc-n]')!.textContent = String(i + 1).padStart(2, '0');
    v.dialog.querySelector('[data-pc-kind]')!.textContent = slot.dataset.kind ?? '';
    v.dialog.querySelector<HTMLButtonElement>('[data-pc-step="-1"]')!.disabled = i === 0;
    v.dialog.querySelector<HTMLButtonElement>('[data-pc-step="1"]')!.disabled = i === v.order.length - 1;
    v.dialog.scrollTop = 0;
    setHash(slug);
  };
  /** Return the plate on stage to its place on the shelf. */
  const unmount = () => {
    const v = V!;
    const plate = v.stage.firstElementChild as HTMLElement | null;
    if (!plate) return;
    plate.getAnimations({ subtree: true }).forEach((a) => a.cancel());
    v.slots.get(v.order[v.index])!.append(plate);
  };

  /** The FLIP: the transform that lays the plate exactly over the card. */
  const overCard = (plate: HTMLElement, card: HTMLElement) => {
    const p = plate.getBoundingClientRect();
    const c = card.getBoundingClientRect();
    return `translate(${c.left - p.left}px, ${c.top - p.top}px) scale(${c.width / p.width}, ${c.height / p.height})`;
  };

  const doOpen = async (slug: string, card: HTMLElement | null) => {
    const v = V;
    if (!v || v.dialog.open) return;
    const i = v.order.indexOf(slug);
    if (i < 0) return;
    mount(i);
    lock(true);
    v.dialog.showModal();
    const plate = plateOf(slug);
    const anims: Animation[] = [];
    if (motion() && !narrow.matches && card && visible(card)) {
      // the card lifts off the table and grows into the plate
      const from = overCard(plate, card);
      card.style.visibility = 'hidden';
      anims.push(plate.animate([{ transform: from }, { transform: 'none' }], { duration: 560, easing: EASE }));
      for (const kid of Array.from(plate.children)) {
        anims.push(kid.animate([{ opacity: 0 }, { opacity: 0, offset: 0.4 }, { opacity: 1 }], { duration: 560 }));
      }
      plate.querySelectorAll('.is-mount').forEach((m, k) => {
        anims.push(m.animate([{ opacity: 0, transform: 'translateY(12px)' }, { opacity: 1, transform: 'none' }], { duration: 380, delay: 420 + k * 60, easing: EASE, fill: 'backwards' }));
      });
      anims.push(v.ground.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 420, easing: 'ease-out' }));
      for (const el of v.chrome) anims.push(el.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 300, delay: 300, fill: 'backwards' }));
      await done(anims);
      card.style.visibility = '';
    } else if (motion()) {
      await done([v.dialog.animate([{ opacity: 0, transform: 'translateY(16px)' }, { opacity: 1, transform: 'none' }], { duration: 300, easing: EASE })]);
    }
  };

  const doClose = async () => {
    const v = V;
    if (!v || !v.dialog.open) return;
    const slug = v.order[v.index];
    const plate = plateOf(slug);
    const card = cardOf(slug);
    if (motion() && !narrow.matches && visible(card)) {
      // the plate settles back into its card
      const to = overCard(plate, card!);
      const anims: Animation[] = [
        plate.animate([{ transform: 'none' }, { transform: to }], { duration: 460, easing: 'cubic-bezier(.4,0,.2,1)', fill: 'forwards' }),
        v.ground.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 460, easing: 'ease-in', fill: 'forwards' }),
        ...Array.from(plate.children).map((kid) => kid.animate([{ opacity: 1 }, { opacity: 0, offset: 0.35 }, { opacity: 0 }], { duration: 460, fill: 'forwards' })),
        ...v.chrome.map((el) => el.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 160, fill: 'forwards' })),
      ];
      card!.style.visibility = 'hidden';
      await done(anims);
      card!.style.visibility = '';
      anims.forEach((a) => a.cancel());
    } else if (motion()) {
      const a = v.dialog.animate([{ opacity: 1 }, { opacity: 0, transform: 'translateY(16px)' }], { duration: 220, easing: 'ease-in', fill: 'forwards' });
      await done([a]);
      a.cancel();
    }
    v.dialog.close();
    unmount();
    lock(false);
    setHash(null);
    card?.focus({ preventScroll: true });
  };

  const doStep = async (d: number) => {
    const v = V;
    if (!v || !v.dialog.open) return;
    const next = v.index + d;
    if (next < 0 || next >= v.order.length) return;
    if (motion()) {
      const out = v.stage.firstElementChild as HTMLElement;
      await done([out.animate([{ opacity: 1, transform: 'none' }, { opacity: 0, transform: `translateX(${-d * 36}px)` }], { duration: 140, easing: 'ease-in', fill: 'forwards' })]);
    }
    unmount();
    mount(next);
    if (motion()) {
      const plate = plateOf(v.order[next]);
      await done([plate.animate([{ opacity: 0, transform: `translateX(${d * 36}px)` }, { opacity: 1, transform: 'none' }], { duration: 260, easing: EASE })]);
    }
  };

  /** Run one viewer action after any still in progress. Steps are dropped
      when two are already waiting, so holding an arrow key cannot pile up. */
  const enqueue = (fn: () => Promise<void>, droppable = false) => {
    const v = V;
    if (!v || (droppable && v.queued > 1)) return;
    v.queued++;
    v.queue = v.queue.then(fn).catch(() => undefined).finally(() => { v.queued--; });
  };
  const open = (slug: string, card: HTMLElement | null) => enqueue(() => doOpen(slug, card));
  const close = () => enqueue(doClose);
  const step = (d: number) => enqueue(() => doStep(d), true);

  const setupViewer = () => {
    const dialog = document.querySelector<HTMLDialogElement>('.pc-viewer');
    if (!dialog) { V = null; return; }
    if (V && V.dialog === dialog) return; // already wired on this page
    const slots = new Map<string, HTMLElement>();
    const plates = new Map<string, HTMLElement>();
    document.querySelectorAll<HTMLElement>('.pc-slot').forEach((s) => {
      slots.set(s.dataset.slug!, s);
      plates.set(s.dataset.slug!, s.querySelector<HTMLElement>('.pc-plate')!);
    });
    V = {
      dialog,
      stage: dialog.querySelector<HTMLElement>('[data-pc-stage]')!,
      ground: dialog.querySelector<HTMLElement>('.pc-ground')!,
      chrome: Array.from(dialog.querySelectorAll<HTMLElement>('.pc-bar, .pc-nav')),
      order: Array.from(slots.keys()),
      slots,
      plates,
      index: 0,
      queue: Promise.resolve(),
      queued: 0,
    };

    // Cards open their plate. A modified click (new tab, etc.) is left alone.
    document.querySelectorAll<HTMLAnchorElement>('.pc-card').forEach((card) => {
      card.addEventListener('click', (ev) => {
        // the click that ends a drag is not a request to open the piece
        if (card.dataset.dragged) { delete card.dataset.dragged; ev.preventDefault(); return; }
        if (ev.button !== 0 || ev.metaKey || ev.ctrlKey || ev.shiftKey || ev.altKey) return;
        ev.preventDefault();
        open(card.dataset.slug!, card);
      });
    });
    dialog.querySelector('[data-pc-close]')!.addEventListener('click', close);
    dialog.querySelectorAll<HTMLButtonElement>('[data-pc-step]').forEach((b) =>
      b.addEventListener('click', () => step(Number(b.dataset.pcStep))));
    // Esc: close with the animation, not the browser's instant close.
    dialog.addEventListener('cancel', (ev) => { ev.preventDefault(); close(); });
    // A click anywhere on the coloured ground - outside the plate, the counter
    // and the buttons - closes.
    dialog.addEventListener('click', (ev) => {
      const t = ev.target as HTMLElement;
      if (t === dialog || t === V!.stage || t.matches('.pc-ground, .pc-bar, .pc-nav')) close();
    });
    dialog.addEventListener('keydown', (ev) => {
      if (ev.key === 'ArrowLeft') { ev.preventDefault(); step(-1); }
      if (ev.key === 'ArrowRight') { ev.preventDefault(); step(1); }
    });

    // Arriving at a link to one piece (#pub-slug) opens it straight away.
    const m = location.hash.match(/^#pub-(.+)$/);
    if (m && slots.has(m[1])) open(m[1], null);
  };

  let resizeTimer = 0;
  const onResize = () => {
    clearTimeout(resizeTimer);
    resizeTimer = window.setTimeout(deal, 180);
  };

  const start = () => {
    if (!document.querySelector('.pc')) return;
    document.documentElement.classList.add('pc-live');
    trackHeader();
    trackBleed();
    readFade();
    setupViewToggle();
    // Deal once the web fonts are in, so text is measured at its real size.
    const go = () => {
      // The cards are dealt (placed, still unseen) at once; the land comes up
      // first, and then the cards are laid on it - see enter().
      const felt = document.querySelector<HTMLElement>('.pc-felt');
      const entering = !!felt && !felt.dataset.entered && !narrow.matches && !reduce.matches;
      if (entering) felt!.classList.add('pc-hold');
      deal();
      setupViewer();
      setupDrag();
      // the land is relit every ten minutes
      const canvas = document.querySelector<HTMLCanvasElement>('.pc-land');
      let landIn: Promise<unknown> = Promise.resolve();
      if (canvas && !canvas.dataset.bound) {
        canvas.dataset.bound = '1';
        ground = new Ground(canvas);
        readLightParam();
        landIn = ground.load().then(() => paintGround()).then(() => canvas.classList.add('is-in')).catch(() => undefined);
        window.setInterval(() => { if (!lightAt_) paintGround(); }, 10 * 60 * 1000);
      }
      if (entering) {
        // the land, fully faded in and then on its own for a moment - but no
        // more than ~5 s of waiting in all, if the land is slow or never comes
        const landShown = landIn.then(() => new Promise((r) => window.setTimeout(r, LAND_FADE_MS + LAND_ALONE_MS)));
        const timeout = new Promise((r) => window.setTimeout(r, 5000));
        // a visitor who wants the cards now gets them now
        const skip = new Promise((r) => {
          const now = () => { ['pointerdown', 'keydown', 'wheel', 'touchstart'].forEach((t) => window.removeEventListener(t, now)); r(null); };
          ['pointerdown', 'keydown', 'wheel', 'touchstart'].forEach((t) => window.addEventListener(t, now, { once: true, passive: true }));
        });
        Promise.race([landShown, timeout, skip]).then(enter);
      } else if (felt) felt.dataset.entered = '1';
    };
    if (document.fonts && document.fonts.status !== 'loaded') {
      document.fonts.ready.then(go);
      window.setTimeout(() => { if (!document.querySelector('.pc-felt[data-dealt]')) go(); }, 1500);
    } else go();
  };

  window.addEventListener('resize', () => { fitBleed(); onResize(); });
  start();
  document.addEventListener('astro:page-load', start);
  // Leaving the page by the site's own links: make sure scrolling is back on.
  document.addEventListener('astro:before-swap', () => { lock(false); V = null; });
</script>

<style is:global>
  .pc {
    --ink: #24201b;
    --ink-soft: #3d372f;
    --muted: #5f574c;
    --paper: #f7f3ea;
    --ground-page: #f1ece1;
    --line: #d7cab0;
    --line-deep: #b6a684;
    --link: #7e4632;
    --accent: var(--color-caprock, #9c5b3f);
    --serif: var(--font-serif, 'Cormorant Garamond', Georgia, serif);
    --mono: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, monospace);
    --t1: #4c5a4c; --t2: #9a6d43; --t3: #57524a; --t4: #3d4a46;
    /* the room the sticky site header leaves */
    --room: calc(100svh - var(--header-h, 0px));
    /* Full bleed: the script (fitBleed) moves the page out of whatever
       padding or wrapper the layout puts around it, edge to edge of the
       window; until it runs, the page fills its wrapper. */
    width: 100%;
    box-sizing: border-box;
    background: var(--ground-page);
    color: var(--ink);
    font-family: var(--serif);
    overflow-x: clip;
  }
  .pc a:focus-visible, .pc button:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }

  /* ================= THE TABLE: one screen under the header ================= */
  .pc-table {
    position: relative;
    overflow: hidden;
    transition: background-color 900ms;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    min-height: max(var(--room), 600px);
    padding: 22px clamp(20px, 2.6vw, 40px) 26px;
    scroll-margin-top: var(--header-h, 0px);
  }
  .pc-felt { position: relative; z-index: 1; flex: 1 0 auto; align-self: center; width: 100%; max-width: 1480px; }

  /* ---- the ground: the land under the table ---- */
  .pc-table[data-light="dusk"] { background: #c9b8ae; }
  .pc-table[data-light="night"] { background: #1d2028; }
  .pc-land { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; transition: opacity 1200ms ease; font-family: var(--serif); pointer-events: none; }
  .pc-land.is-in { opacity: 1; }
  /* (the footer's own rule is scoped; `body` here outranks it) */
  body:has(.pc-table) .caprock:not(.caprock--map) .sky {
    background: linear-gradient(to bottom, var(--sky-top) 0%, var(--sky-top) 58%, var(--sky-horizon) 100%);
  }
  /* THE HORIZON. The last stretch of land fades into the footer's sky
     colour of this moment (--pc-fade, the footer's own --sky-top, kept in
     step by the script), and on this page the footer's sky starts from that
     colour instead of rising out of the bare page. Ground passes into sky
     with no line between, at noon and at midnight. */
  .pc-table::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: clamp(72px, 12vh, 120px);
    pointer-events: none;
    background: linear-gradient(
      to bottom,
