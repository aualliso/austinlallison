---
// src/pages/publications.astro
//
// REBUILT 2026-10-12 as an exhibition catalogue. The three major articles
// are set as full spreads at the top; the shorter pieces follow "in the forms
// they took" - a newspaper page, a magazine opener, documents on an archive
// board, a chapter in an open book.
//
// Everything still derives from src/data/publications/index.ts, which reads
// the CITATION (and FIGURES, and NOTES) each article data file exports.
// Nothing here restates a title, a citation, a caption or a credit. Where a
// piece appears, its opening line and which images it shows live in the SHOW
// blocks in index.ts. A new article with no SHOW block still appears, in the
// form its section implies, with its first figure.
//
// No client script. Motion is CSS only - plates rise as they scroll in, and
// the two full-width photographs drift inside their frames - and both sit
// behind @supports (animation-timeline: view()), so browsers without
// scroll-driven animations (Firefox included) get a still page, and
// prefers-reduced-motion turns them off. No filter, blend mode or mask
// anywhere on the page.
import RootLayout from '../layouts/RootLayout.astro';
import Plate from '../components/publications/Plate.astro';
import { PUBLICATIONS, byForm, type Entry } from '../data/publications/index';
import type { Citation } from '../lib/citation';

const features = byForm('feature');
const newspaper = byForm('newspaper');
const magazine = byForm('magazine');
const archive = byForm('archive');
const books = byForm('book');
const shorter = PUBLICATIONS.length - features.length;

const ROMAN = ['I', 'II', 'III', 'IV', 'V', 'VI', 'VII', 'VIII', 'IX', 'X'];
const WORDS = [
  'no', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine', 'ten',
  'eleven', 'twelve', 'thirteen', 'fourteen', 'fifteen', 'sixteen', 'seventeen',
  'eighteen', 'nineteen', 'twenty',
];
const word = (n: number) => WORDS[n] ?? String(n);
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);

/** Main title and deck. Uses displayTitle/subtitle, else splits at the first colon. */
const titleParts = (c: Citation) => {
  if (c.displayTitle) return { main: c.displayTitle, sub: c.subtitle };
  const i = c.title.indexOf(': ');
  return i > 0
    ? { main: c.title.slice(0, i), sub: c.title.slice(i + 2) }
    : { main: c.title, sub: c.subtitle };
};

/** Journal - Vol. x, no. y - date. */
const kicker = (c: Citation) =>
  [
    c.status === 'chapter' ? c.bookTitle : c.journal,
    c.volume ? `Vol. ${c.volume}${c.issue ? `, no. ${c.issue}` : ''}` : '',
    c.monthYear ?? c.dateLabel ?? String(c.year),
  ]
    .filter(Boolean)
    .join(' \u00b7 ');

const when = (c: Citation) => c.dateLabel ?? c.monthYear ?? String(c.year);

const extent = (e: Entry) =>
  [
    e.citation.firstPage != null && e.citation.lastPage != null
      ? `pp. ${e.citation.firstPage}\u2013${e.citation.lastPage}`
      : '',
    e.noteCount ? `${e.noteCount} notes` : '',
  ]
    .filter(Boolean)
    .join(' \u00b7 ');

/** Column spans for a shelf of n objects on a 12-column grid. */
const shelfSpans = (n: number): number[] =>
  n === 4 ? [3, 5, 2, 2] : n === 3 ? [4, 5, 3] : n === 2 ? [5, 7] : Array(n).fill(Math.max(2, Math.floor(12 / n)));
const shelfStarts = (spans: number[]) => spans.map((_, i) => 1 + spans.slice(0, i).reduce((a, b) => a + b, 0));

const LETTERS = 'abcdefghij';

const years = newspaper.map((e) => e.citation.year);
const newsYears = years.length ? `${Math.min(...years)} \u2013 ${Math.max(...years)}` : '';
const papers = [...new Set(newspaper.map((e) => e.citation.journal).filter(Boolean))];
const magTitles = [...new Set(magazine.map((e) => e.citation.journal).filter(Boolean))];

const [newsLead, ...newsRail] = newspaper;
const [magOpener, ...magRest] = magazine;
---

<RootLayout
  title="Publications | Austin Allison"
  description={`Articles, columns, notes and a book chapter by Austin Allison on land, survey, water and settlement in Texas and the American West - ${PUBLICATIONS.length} pieces, most readable in full on this site.`}
  prose={false}
  bleed={true}
>
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Old+Standard+TT:ital,wght@0,400;0,700;1,400&display=swap"
  />

  <div class="pubs">
    <header class="pubs-wrap pubs-masthead">
      <div class="pubs-ears">
        <span>Austin Lamar Allison</span>
        <span>Writings on Texas &amp; the American West</span>
        <span>{cap(word(PUBLICATIONS.length))} pieces</span>
      </div>
      <h1 class="pubs-h1">Publications</h1>
      <div class="pubs-g pubs-intro">
        <p class="pubs-lede">
          Articles, notes, columns and a book chapter on land, survey, water and settlement in the
          West. {cap(word(features.length))} are set here at full size; the other {word(shorter)} follow
          in the forms they first took. Every piece can be read in full on this site.
        </p>
        <nav aria-label="Featured articles" class="pubs-toc">
          {features.map((e, i) => (
            <a href={`#${ROMAN[i].toLowerCase()}`}>
              <span class="pubs-toc-n">{ROMAN[i]}</span>
              <span class="pubs-toc-t">
                {titleParts(e.citation).main}
                <span class="pubs-toc-s">{e.citation.journal} &middot; {e.citation.year}</span>
              </span>
            </a>
          ))}
          {shorter > 0 && (
            <a href="#forms" class="pubs-more pubs-ul">And {word(shorter)} shorter pieces &darr;</a>
          )}
        </nav>
      </div>
    </header>

    {features.map((e, i) => {
      const t = titleParts(e.citation);
      const id = ROMAN[i].toLowerCase();
      const layout = e.layout ?? 'portrait';
      const [hero, ...more] = e.images;

      const head = (
        <>
          <p class="pubs-kicker">{kicker(e.citation)}</p>
          <h2 id={`t-${id}`} class:list={['pubs-feature-title', layout !== 'portrait' && 'is-split']}>
            <a class="pubs-tl" href={e.citation.canonicalPath}>
              <span class="pubs-ft-main">{t.main}</span>
              {t.sub && <span class="pubs-ft-sub">{t.sub}</span>}
            </a>
          </h2>
        </>
      );
      const links = (
        <div class="pubs-links">
          <a class="pubs-ul pubs-strong" href={e.citation.canonicalPath}>Read the article &rarr;</a>
          {e.otherVersions.map((v) => (
            <a class="pubs-ul" href={v.path}>{v.label} &rarr;</a>
          ))}
          {extent(e) && <span class="pubs-muted">{extent(e)}</span>}
        </div>
      );

      if (layout === 'shelf') {
        const spans = shelfSpans(e.images.length);
        const starts = shelfStarts(spans);
        return (
          <section id={id} aria-labelledby={`t-${id}`} class="pubs-feature pubs-band">
            <div class="pubs-wrap">
              <div class="pubs-g pubs-rise" style="align-items: end">
                <div style="grid-column: 1 / span 8">
                  <div class="pubs-numrow"><span class="pubs-num pubs-num--md" aria-hidden="true">{ROMAN[i]}</span></div>
                  {head}
                </div>
                <div style="grid-column: 9 / span 4">
                  {e.lead && <p class="pubs-lead pubs-lead--sm">{e.lead}</p>}
                  {links}
                </div>
              </div>
              {e.images.length > 0 && (
                <>
                  <div class="pubs-g pubs-shelf">
                    {e.images.map((img, k) => (
                      <figure class="pubs-rise" style={`grid-column: ${starts[k]} / span ${spans[k]}; margin: 0`}>
                        <Plate img={img} class="pubs-plate" sizes={`(max-width: 860px) 100vw, ${Math.round((spans[k] / 12) * 1180)}px`} />
                      </figure>
                    ))}
                  </div>
                  <ol class="pubs-g pubs-shelf-caps">
                    {e.images.map((img, k) => (
                      <li style={`grid-column: ${starts[k]} / span ${spans[k]}`}>
                        <span class="pubs-letter">{LETTERS[k]}</span>
                        {img.caption && <span set:html={img.caption} />}
                        {img.credit && <span class="pubs-credit" set:html={` ${img.credit}`} />}
                      </li>
                    ))}
                  </ol>
                </>
              )}
            </div>
          </section>
        );
      }

      if (layout === 'panorama') {
        return (
          <section id={id} aria-labelledby={`t-${id}`} class="pubs-feature">
            {hero && (
              <div class="pubs-bleed pubs-bleed--pano">
                <Plate img={hero} class="pubs-drift" sizes="100vw" />
              </div>
            )}
            <div class="pubs-wrap">
              {/* The hero's caption lives INSIDE the left column, not in a
                  full-width line above the grid. The matted plate on the right
                  is lifted 170px into the photograph above it; a full-width
                  caption sat in exactly that band and was hidden behind it.
                  Rule for this page: anything lifted with a negative margin
                  may only overlap an image, never text - so text that shares
                  its band must sit in grid columns the lifted element does
                  not occupy. */}
              <div class="pubs-g" style="align-items: start">
                <div class="pubs-rise" style="grid-column: 1 / span 6">
                  {hero && (hero.caption || hero.credit) && (
                    <p class="pubs-cap pubs-cap--pano">
                      {hero.caption && <span set:html={hero.caption} />}
                      {hero.credit && <span class="pubs-credit" set:html={` ${hero.credit}`} />}
                    </p>
                  )}
                  <div class="pubs-numrow pubs-numrow--pano"><span class="pubs-num pubs-num--md" aria-hidden="true">{ROMAN[i]}</span></div>
                  {head}
                  {e.lead && <p class="pubs-lead pubs-drop">{e.lead}</p>}
                  {links}
                </div>
                {more[0] && (
                  <figure class="pubs-rise pubs-lift" style="grid-column: 8 / span 5; margin: -170px 0 0">
                    <Plate img={more[0]} class="pubs-plate pubs-matted" sizes="(max-width: 860px) 100vw, 480px" />
                    <figcaption class="pubs-cap">
                      {more[0].caption && <span set:html={more[0].caption} />}
                      {more[0].credit && <span class="pubs-credit" set:html={` ${more[0].credit}`} />}
                    </figcaption>
                  </figure>
                )}
              </div>
            </div>
          </section>
        );
      }

      // portrait
      return (
        <section id={id} aria-labelledby={`t-${id}`} class="pubs-feature pubs-wrap">
          <div class="pubs-g" style="align-items: start">
            {hero && (
              <figure class="pubs-rise" style="grid-column: 1 / span 6; margin: 0">
                <Plate img={hero} class="pubs-plate" sizes="(max-width: 860px) 100vw, 560px" />
                <figcaption class="pubs-cap">
                  {hero.caption && <span set:html={hero.caption} />}
                  {hero.credit && <span class="pubs-credit pubs-block" set:html={hero.credit} />}
                </figcaption>
              </figure>
            )}
            <div class="pubs-rise" style={`grid-column: ${hero ? '8 / span 5' : '1 / span 8'}; padding-top: 30px`}>
              <div class="pubs-num pubs-num--lg" aria-hidden="true">{ROMAN[i]}</div>
              {head}
              {e.lead && <p class="pubs-lead pubs-drop">{e.lead}</p>}
              {links}
              {more[0] && (
                <figure class="pubs-inset">
                  <Plate img={more[0]} class="pubs-plate" sizes="120px" widths={[240, 360]} />
                  <figcaption class="pubs-cap pubs-cap--sm">
                    {more[0].caption && <span set:html={more[0].caption} />}
                    {more[0].credit && <span class="pubs-credit pubs-block" set:html={more[0].credit} />}
                  </figcaption>
                </figure>
              )}
            </div>
          </div>
        </section>
      );
    })}

    {shorter > 0 && (
      <section id="forms" aria-labelledby="t-forms" class="pubs-forms">
        <div class="pubs-wrap">
          <div class="pubs-g pubs-forms-head">
            <h2 id="t-forms" class="pubs-forms-title">In the forms <em>they took</em></h2>
            <p class="pubs-forms-lede">
              {cap(word(shorter))} shorter pieces, each set the way it first reached readers.
            </p>
          </div>
        </div>

        {newsLead && (
          <div class="pubs-news">
            <div class="pubs-wrap">
              <div class="pubs-news-ears">
                <span>{papers.join(' \u00b7 ')}</span>
                <span class="pubs-hide-sm">Columns by Austin Allison</span>
                <span>{newsYears}</span>
              </div>
              <div class="pubs-news-plate pubs-rise">Caprock Chronicles</div>
              <h3 class="pubs-news-strap">
                In the newspaper &middot; {word(newspaper.length)} {newspaper.length === 1 ? 'column' : 'columns'}
              </h3>
              <div class="pubs-g pubs-news-cols">
                <article class="pubs-news-lead">
                  <p class="pubs-dateline">{when(newsLead.citation)}</p>
                  <h4 class="pubs-news-h pubs-news-h--lead">
                    <a class="pubs-tl" href={newsLead.citation.canonicalPath}>{newsLead.citation.title}</a>
                  </h4>
                  {newsLead.images[0] && (
                    <figure class="pubs-rise" style="margin: 26px 0 0">
                      <Plate img={newsLead.images[0]} class="pubs-fill" sizes="(max-width: 860px) 100vw, 760px" />
                      <figcaption class="pubs-news-cap">
                        {newsLead.images[0].caption && <span set:html={newsLead.images[0].caption} />}
                        {newsLead.images[0].credit && <span set:html={` ${newsLead.images[0].credit}`} />}
                      </figcaption>
                    </figure>
                  )}
                  {newsLead.lead && <p class="pubs-news-leadpara">{newsLead.lead}</p>}
                  <p class="pubs-byline">
                    <span>By Austin Allison</span>
                    <a class="pubs-ul pubs-strong" href={newsLead.citation.canonicalPath}>Read the column &rarr;</a>
                  </p>
                </article>
                {newsRail.length > 0 && (
                  <div class="pubs-news-rail">
                    {newsRail.map((e) => (
                      <article>
                        <p class="pubs-dateline">{when(e.citation)}</p>
                        <h4 class="pubs-news-h">
                          <a class="pubs-tl" href={e.citation.canonicalPath}>{e.citation.title}</a>
                        </h4>
                        {e.images[0] && (
                          <>
                            <Plate img={e.images[0]} class="pubs-fill pubs-news-art" sizes="(max-width: 860px) 100vw, 360px" />
                            {(e.images[0].caption || e.images[0].credit) && (
                              <p class="pubs-news-cap">
                                {e.images[0].caption && <span set:html={e.images[0].caption} />}
                                {e.images[0].credit && <span set:html={` ${e.images[0].credit}`} />}
                              </p>
                            )}
                          </>
                        )}
                        {e.lead && <p class="pubs-news-body">{e.lead}</p>}
                        <a class="pubs-ul pubs-strong pubs-news-more" href={e.citation.canonicalPath}>Read the column &rarr;</a>
                      </article>
                    ))}
                  </div>
                )}
              </div>
            </div>
          </div>
        )}

        {magOpener && (
          <div class="pubs-mag">
            <div class="pubs-wrap pubs-group-head">
              <h3 class="pubs-group-title">In the magazine</h3>
              <span class="pubs-group-meta">
                {magTitles.join(' \u00b7 ')} &middot; {word(magazine.length)} {magazine.length === 1 ? 'feature' : 'features'}
              </span>
            </div>
            {magOpener.images[0] && (
              <div class="pubs-bleed pubs-bleed--mag">
                <Plate img={magOpener.images[0]} class="pubs-drift" sizes="100vw" />
              </div>
            )}
            <div class="pubs-wrap">
              <div class="pubs-g">
                <div class:list={['pubs-mag-panel pubs-rise', magOpener.images[0] && 'pubs-lift is-over']}>
                  <p class="pubs-date">{when(magOpener.citation)}</p>
                  <h4 class="pubs-mag-title">
                    <a class="pubs-tl" href={magOpener.citation.canonicalPath}>{titleParts(magOpener.citation).main}</a>
                  </h4>
                  {titleParts(magOpener.citation).sub && <p class="pubs-deck">{titleParts(magOpener.citation).sub}</p>}
                  {magOpener.lead && <p class="pubs-lead pubs-lead--sm pubs-drop">{magOpener.lead}</p>}
                  <a class="pubs-ul pubs-strong pubs-mag-more" href={magOpener.citation.canonicalPath}>Read the feature &rarr;</a>
                </div>
                {magOpener.images[0] && (magOpener.images[0].caption || magOpener.images[0].credit) && (
                  <p class="pubs-cap pubs-mag-cap">
                    {magOpener.images[0].caption && <span set:html={magOpener.images[0].caption} />}
                    {magOpener.images[0].credit && <span class="pubs-credit" set:html={` ${magOpener.images[0].credit}`} />}
                  </p>
                )}
              </div>
              {magRest.length > 0 && (
                <div class="pubs-g pubs-mag-row">
                  {magRest.map((e) => {
                    const t = titleParts(e.citation);
                    const img = e.images[0];
                    return img ? (
                      <article class="pubs-mag-item pubs-rise">
                        <a href={e.citation.canonicalPath} tabindex="-1" aria-hidden="true" class="pubs-frame">
                          <Plate img={{ ...img, alt: '' }} sizes="(max-width: 860px) 100vw, 480px" />
                        </a>
                        <p class="pubs-date">{when(e.citation)}</p>
                        <h4 class="pubs-mag-item-title"><a class="pubs-tl" href={e.citation.canonicalPath}>{t.main}</a></h4>
                        {t.sub && <p class="pubs-deck pubs-deck--sm">{t.sub}</p>}
                      </article>
                    ) : (
                      <article class="pubs-mag-item pubs-mag-type pubs-rise">
                        <p class="pubs-date">{when(e.citation)}</p>
                        <h4 class="pubs-mag-type-title"><a class="pubs-tl" href={e.citation.canonicalPath}>{t.main}</a></h4>
                        {t.sub && <p class="pubs-deck pubs-deck--sm">{t.sub}</p>}
                        <span class="pubs-mag-rule" aria-hidden="true" />
                      </article>
                    );
                  })}
                </div>
              )}
            </div>
          </div>
        )}

        {archive.length > 0 && (
          <div class="pubs-archive">
            <div class="pubs-wrap">
              <div class="pubs-group-head pubs-group-head--dark">
                <h3 class="pubs-group-title">From the archive</h3>
                <span class="pubs-group-meta">Southwest Collection/Special Collections Library</span>
              </div>
              <div class="pubs-g pubs-docs">
                {archive.map((e) => {
                  const img = e.images[0];
                  return (
                    <article class="pubs-doc pubs-rise">
                      {img && <Plate img={img} class="pubs-doc-img" sizes="(max-width: 860px) 100vw, 600px" />}
                      <div class:list={['pubs-slip', !img && 'is-alone']}>
                        <p class="pubs-slip-src">{e.citation.journal ?? e.citation.bookTitle} &middot; {e.citation.year}</p>
                        <h4 class="pubs-slip-title"><a class="pubs-tl" href={e.citation.canonicalPath}>{e.citation.title}</a></h4>
                        {img && (img.label || img.caption) && (
                          <p class="pubs-slip-label" set:html={img.label ?? img.caption} />
                        )}
                      </div>
                    </article>
                  );
                })}
              </div>
            </div>
          </div>
        )}

        {books.length > 0 && (
          <div class="pubs-wrap pubs-books">
            <div class="pubs-group-head">
              <h3 class="pubs-group-title">In {books.length === 1 ? 'a book' : 'books'}</h3>
              <span class="pubs-group-meta">{[...new Set(books.map((b) => b.citation.publisher).filter(Boolean))].join(' \u00b7 ')}</span>
            </div>
            {books.map((e) => {
              const [book, sub] = (e.citation.bookTitle ?? '').split(/:\s+/);
              const img = e.images[0];
              return (
                <div class:list={['pubs-book pubs-rise', !img && 'is-text']}>
                  {img && (
                    <div class="pubs-book-page pubs-book-left">
                      <Plate img={img} class="pubs-fill" sizes="(max-width: 860px) 100vw, 520px" />
                      {(img.caption || img.credit) && (
                        <p class="pubs-cap pubs-cap--sm">
                          {img.caption && <span set:html={img.caption} />}
                          {img.credit && <span class="pubs-credit" set:html={` ${img.credit}`} />}
                        </p>
                      )}
                    </div>
                  )}
                  <div class="pubs-book-page pubs-book-right">
                    <p class="pubs-book-in">{book}</p>
                    {sub && <p class="pubs-book-sub">{sub}</p>}
                    <h4 class="pubs-book-title"><a class="pubs-tl" href={e.citation.canonicalPath}>{e.citation.title}</a></h4>
                    <p class="pubs-book-author">Austin Allison</p>
                    <div class="pubs-fleuron" aria-hidden="true"><span /><b>&#10086;</b><span /></div>
                    <a class="pubs-ul pubs-strong" href={e.citation.canonicalPath}>Read the chapter &rarr;</a>
                    <p class="pubs-muted pubs-book-meta">{[e.citation.publisher, String(e.citation.year), extent(e)].filter(Boolean).join(' \u00b7 ')}</p>
                  </div>
                  {img && <div class="pubs-book-gutter" aria-hidden="true" />}
                </div>
              );
            })}
          </div>
        )}
      </section>
    )}
  </div>
</RootLayout>

<style is:global>
  /* Everything is scoped under .pubs. is:global because Plate renders the
     <img> inside a child component, which a scoped style cannot reach. */
  .pubs {
    --pubs-ink: #25211c;
    --pubs-ink-2: #2e2923;
    --pubs-ink-soft: #3c362e;
    --pubs-muted: #5e564b;
    --pubs-rule: #cdc3b1;
    --pubs-accent: var(--color-caprock, #9c5b3f);
    --pubs-link: #7e4632;
    --pubs-serif: var(--font-serif, 'Cormorant Garamond', Georgia, serif);
    --pubs-mono: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, monospace);
    --pubs-news: 'Old Standard TT', Georgia, serif;
    background: #f5f1e8;
    color: var(--pubs-ink);
    font-family: var(--pubs-serif);
    overflow-x: clip;
    padding-bottom: 160px;
  }
  .pubs a { color: var(--pubs-link); }
  .pubs a:hover { color: #4f2a1d; }
  .pubs a:focus-visible { outline: 2px solid var(--pubs-accent); outline-offset: 4px; }
  .pubs ::selection { background: #e2c9ae; }
  .pubs [id] { scroll-margin-top: var(--header-h, 6rem); }

  .pubs-wrap { max-width: 1240px; margin: 0 auto; padding: 0 32px; box-sizing: border-box; }
  .pubs-g { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: 40px; }

  /* links */
  .pubs-ul { text-decoration: none; background-image: linear-gradient(currentColor, currentColor); background-repeat: no-repeat; background-position: 0 100%; background-size: 0% 1px; transition: background-size 420ms cubic-bezier(.2,.7,.2,1), color 300ms; }
  .pubs-ul:hover { background-size: 100% 1px; }
