---
// src/pages/publications/capitol_land_shq.astro
import RootLayout from '../../layouts/RootLayout.astro';
import ScholarlyMeta from '../../components/ScholarlyMeta.astro';
import Figure from '../../components/Figure.astro';
import FigRef from '../../components/FigRef.astro';
import Fn from '../../components/Fn.astro';
import CiteThis from '../../components/CiteThis.astro';
import Endnotes from '../../components/Endnotes.astro';
import { CITATION, NOTES, FIGURES, pageRange, doiUrl } from '../../data/publications/capitol-land-shq';

const c = CITATION;

const ABSTRACT =
  'In 1879 the State of Texas contracted J.\u2009T. Munson of Denison to survey the three ' +
  'million acres of Panhandle public domain the Constitution of 1876 had set aside to fund a ' +
  'new Capitol. This article reconstructs that survey from the field notes of H.\u2009A. Wiley, ' +
  'Munson\u2019s compass man \u2014 preserved as evidence in a Texas Supreme Court case file \u2014 and ' +
  'from the correspondence of commissioner N.\u2009L. Norton. It follows the two seasons of ' +
  'fieldwork across the Llano Estacado, the fraud prosecution of the Jack Land District ' +
  'surveyors whose earlier work for Gunter & Munson had already claimed the water along the ' +
  'Canadian River, and the errors \u2014 a misplaced northwest corner of Texas, leagues spilling ' +
  'into New Mexico, a mistaken connection line in Lamb County \u2014 that forced resurveys through ' +
  'the 1880s and litigation into the 1920s. The crews who first described the land that became ' +
  'the XIT Ranch left almost no other trace in the record; this account recovers what can be ' +
  'known of them.';
---

<RootLayout
  title={`${c.title} | ${c.authors[0]}`}
  description={ABSTRACT}
  image="/images/capitol_land_shq/01-map-dallam-hartley-oldham.png"
>
