---
/**
 * src/pages/photography.astro — the album
 *
 * A row of desks, seen from directly above one at a time. Each series
 * gets a screen; the cover fills it. Entering a series is not a page
 * load, it is a step backwards: the photograph contracts to the size
 * and shape it has on the light table, and the light table picks it up
 * from there.
 *
 * Two axes, and that is the whole idea. SCROLL moves you along the row
 * of desks. ENTER moves you away from the desk you are standing over.
 * Nothing else to learn, and a fifth series is a fifth desk in the row
 * with no other change anywhere.
 *
 * ── THE HANDOFF ───────────────────────────────────────────────────
 *
 * This page ends its animation with the plate occupying EXIT_WIDTH_VW
 * of the viewport width, centred, at its true aspect ratio. It then
 * navigates to /photography/<slug>?from=<plate index>.
 *
 * The light table must OPEN in that same state — that plate, centred,
 * at that width — and then ease out to its normal view. If it opens at
 * its default scale instead, the two halves do not line up and the
 * whole effect reads as a page load with a flourish. The receiving
 * block is small and I have written it out in chat; it belongs in
 * [slug].astro, which I have not seen.
 *
 * EXIT_WIDTH_VW is the contract. It lives in one place here and must
 * be repeated in one place there. If you change it, change both.
 *
 * ── WHY THE FRAME CONTRACTS INSTEAD OF SCALING ────────────────────
 *
 * The cover is object-fit: cover, so at full screen it is cropped —
 * the desk shows the whole plate. A transform: scale() would shrink
 * the CROPPED result and land on a different picture than the one the
 * light table draws, which is a visible jump at the seam.
 *
 * Animating the frame's width and height instead means the crop
 * resolves as it goes: as the frame approaches the plate's own aspect
 * ratio, `cover` crops less, and at the target it crops nothing at
 * all. The two halves show the same pixels.
 *
 * The cost is that this animates layout rather than compositing. It is
 * one absolutely positioned element with `contain: layout paint`, no
 * siblings affected, for 520ms — but layout animation is exactly the
 * class of thing that has been slow in Firefox on this site before, so
 * test there first. If it stutters, the fallback is to accept the jump
 * and animate a transform.
 *
 * ── A COVER MUST BE A PLATE ───────────────────────────────────────
 *
 * The zoom is only truthful if the cover is a real plate with real
 * board coordinates, so `deskFor` looks the cover up among the
 * gallery's plates by filename. Escarpments passes: its cover is
 * escarpment20.jpg. Water DOES NOT — water/water-cover.jpg is a
 * cover-only file that is not on the desk — so it falls back to plain
 * navigation with no animation, silently and correctly. Point that
 * series' `cover` at the Tule Creek plate and it joins in.
 *
 * ── SNAP, SVH, PINCH, BACK ────────────────────────────────────────
 *
 * Snap is PROXIMITY: mandatory fights the footer and makes a short
 * trackpad flick feel overruled. Panes are svh because on mobile vh is
 * the tallest the viewport ever gets, so the bottom of every pane
 * would hide behind browser chrome.
 *
 * The old data-astro-reload is gone, replaced by a CONDITIONAL hard
 * load. The reason it existed: a View Transition carries the visual
 * viewport's pinch zoom into the light table, which owns pinch itself,
 * stranding a magnified visitor. But that punished everyone for a case
 * almost nobody hits, and a hard load also destroys this animation and
 * the scroll position. So: if the reader has actually pinched, skip
 * the animation and hard-load. Otherwise animate and go.
 *
 * Coming back matters as much as leaving. Departing stores the pane
 * and scroll offset; returning restores them before paint. Land at the
 * top of the album after stepping back from one desk and the whole
 * thing feels broken on the second try.
 *
 * ── NO theme() ────────────────────────────────────────────────────
 *
 * Colours and typefaces are utility classes. Tailwind v4 resolves the
 * palette through CSS custom properties, not the v3 config path, so
 * theme('colors.canvas') in a style block fails the build. Utilities
 * work on both.
 */
import RootLayout from '../layouts/RootLayout.astro';
import { getCovers, getGalleries } from '../data/photography';
import { plateLight } from '../lib/solar';

const series = await getCovers();
const galleries = await getGalleries();

/** Must match the light table's arrival constant. */
const EXIT_WIDTH_VW = 34;

const DESCRIPTION =
  'Visual monographs of the American West: photographs of the escarpments, the water of the Llano Estacado, the cotton gins of Texas, and the county courthouses of the Great Plains, by Austin Allison.';

const coverAlt = (s: (typeof series)[number]) =>
  'coverAlt' in s && typeof s.coverAlt === 'string' && s.coverAlt.trim()
    ? s.coverAlt
    : `${s.title} — ${s.coverLabel}`;

/* Where this cover sits on its desk. Null when the cover is not a
   plate, which disables the zoom for that series rather than faking a
   position it does not have. */
/* The prints under the top one. Up to STRIP_MAX plates from the same
   desk, skipping the cover — the point is to show there is more here,
   so repeating the photograph already filling the screen would waste a
   slot. Uses the 280px index derivative the plate index already
   generates; nothing new enters the image pipeline.

   Each links to ?plate=NN, the light table's existing deep link, which
   opens that plate in the viewing station. The board deliberately
   skips the pull-back when ?plate= is present, so the two gestures
   stay distinct: step back to browse the desk, or reach past it for
   one print you can already see. */
const STRIP_MAX = 5;

function stripFor(s: (typeof series)[number]) {
  const g = galleries.find((x) => x.slug === s.slug);
  if (!g) return [];
  return g.plates
    .filter((p) => p.file !== s.cover && !p.draft)
    .slice(0, STRIP_MAX)
    .map((p) => ({
      src: p.img.index,
      no: String(p.index + 1).padStart(2, '0'),
      label: `${p.plate}, ${p.title}`,
    }));
}

function deskFor(s: (typeof series)[number]) {
  const g = galleries.find((x) => x.slug === s.slug);
  if (!g) return null;
  const p = g.plates.find((pl) => pl.file === s.cover);
  if (!p) return null;
  return { index: p.index, aspect: p.w / p.h };
}

/* ── THE DESK IS LIT BY THE PLATE'S OWN SUN ────────────────────────

   Every plate already carries lat/lng. Give it `taken` and `timeZone`
   as well and solar.ts returns the light that was actually on the
   ground at that moment: the direction and length of the shadow the
   print throws on the desk, how hard or soft that shadow is, and the
   colour of the paper under it.

   The plate is the source of truth. A cover that IS a plate reads its
   own record; only a cover that is not one — an unbuilt series with no
   gallery — falls back to SeriesEntry.exposure.

   Without a date this returns null and the desk keeps a plain neutral
   shadow. That is the state it ships in today. Nothing here fails for
   want of data; it simply does not light.

   ONE RULE, AND IT IS NOT NEGOTIABLE: this light touches the DESK
   ONLY — paper, cast shadow, the wash across the surface. The moment
   any of it lands on a photograph you have started editing the
   picture, and the whole idea is dead. */
function exposureFor(s: (typeof series)[number]) {
  const g = galleries.find((x) => x.slug === s.slug);
  const p = g?.plates.find((pl) => pl.file === s.cover);
  if (p?.taken && p.timeZone) {
    return {
      lat: p.lat,
      lon: p.lng,
      timeZone: p.timeZone,
      taken: p.taken,
      ...(typeof p.bearing === 'number' ? { cameraBearingDeg: p.bearing } : {}),
    };
  }
  const e = s.exposure;
  if (e) {
    return {
      lat: e.lat,
      lon: e.lon,
      timeZone: e.timeZone,
      taken: e.taken,
      ...(typeof e.bearing === 'number' ? { cameraBearingDeg: e.bearing } : {}),
    };
  }
  return null;
}

/* A cover whose sun was below the horizon at its recorded time is
   almost always a camera clock never reset after driving north, or a
   body still on a previous owner's zone. Fail the build rather than
   ship a desk lit at midnight: it is the one check that catches nearly
   every time-and-zone error, and a plate that passes it is almost
   certainly right. */
const belowHorizon: string[] = [];

function lightVarsFor(s: (typeof series)[number]) {
  const e = exposureFor(s);
  if (!e) return {} as Record<string, string>;
  const light = plateLight(e);
  if (light.belowHorizon) belowHorizon.push(`${s.slug} (${e.taken} ${e.timeZone}, sun ${light.trueAltitudeDeg.toFixed(1)}\u00B0)`);
  return light.vars;
}

/* Chrome sampled from the cover by scripts/sample-covers.mjs. Absent
   means the rail and catchword keep white-with-a-shadow, which is a
   correct fallback and not a broken state. */
function chromeVarsFor(s: (typeof series)[number]) {
  const c = s.chrome;
  if (!c) return {} as Record<string, string>;
  return {
    '--ink-rail': c.rail.ink,
    '--halo-rail': c.rail.halo,
    '--halo-rail-strength': String(c.rail.haloStrength),
    '--ink-catchword': c.catchword.ink,
    '--halo-catchword': c.catchword.halo,
    '--halo-catchword-strength': String(c.catchword.haloStrength),
    ...(c.plateline
      ? {
          '--ink-plateline': c.plateline.ink,
          '--halo-plateline': c.plateline.halo,
          '--halo-plateline-strength': String(c.plateline.haloStrength),
        }
      : {}),
  } as Record<string, string>;
}

function paneStyle(s: (typeof series)[number]) {
  const vars = { ...lightVarsFor(s), ...chromeVarsFor(s) };
  return Object.entries(vars).map(([k, v]) => `${k}:${v}`).join(';');
}

const paneStyles = series.map(paneStyle);

if (belowHorizon.length) {
  throw new Error(
    `[photography] the sun was below the horizon at the recorded exposure time for: ${belowHorizon.join(', ')}. ` +
      `Check DateTimeOriginal and the IANA zone on those plates — this is nearly always a camera clock or a stored zone, not a night exposure.`,
  );
}
---

<RootLayout
  title="Photography | Austin Allison"
  description={DESCRIPTION}
  image={series[0]?.src}
  bleed
>
  <div class="album relative" data-exit-vw={EXIT_WIDTH_VW}>
    {series.map((s, i) => {
      const href = s.built ? `/photography/${s.slug}` : null;
      const headingId = `series-${s.slug}`;
      const desk = href ? deskFor(s) : null;
      const strip = href ? stripFor(s) : [];
      const next = series[i + 1];

      return (
        <section class="pane" id={s.slug} aria-labelledby={headingId} style={paneStyles[i]}>
          {/* The cast shadow the print throws on the desk. A separate
              element rather than a box-shadow on .zoomer, which has
              `contain: layout paint` and would clip it, and rather than
              a drop-shadow filter, which is the family of thing that has
              been slow in Firefox on this site. It has no background, so
              only the shadow paints, and it carries the same contraction
              as the photograph so the two stay registered. */}
          <div class="cast" aria-hidden="true"></div>

          <div class="zoomer">
            <img
              src={s.src}
              srcset={s.wideSrcset}
              sizes="100vw"
              width={s.width}
              height={s.height}
              alt={coverAlt(s)}
              loading={i === 0 ? 'eager' : 'lazy'}
              fetchpriority={i === 0 ? 'high' : 'auto'}
              decoding="async"
              class="unmatted plate"
            />
          </div>

          {/* The plate label. It tells you this full-screen photograph IS
              a plate — the one line the whole zoom premise rests on — but
              it answers a question about the PICTURE, while everything in
              the slip answers a question about the SERIES. Sitting above
              the title in the same card it read as though it might be
              labelling the series.

              So it sits on the photograph, and the gutter gives it
              somewhere better to go: as the print contracts it rides up
              onto the desk margin that opens above it. A caption written
              on the mount rather than printed over the picture — the same
              distinction the light table already makes. */}
          <span class="plateline">{s.coverLabel}</span>

          <div class="foot">
          <div class="slip bg-caliche border border-llano p-5 sm:p-6 md:p-8">
            {/* The numeral moves down to sit WITH the title. It used to
                hold the right end of a justify-between row whose left end
                was the plate label; with the label gone it would have been
                a lone Roman numeral floating in a corner. Beside the title
                is where it belonged anyway — a catalogue entry, not a
                header ornament. */}
            <div class="flex items-baseline gap-3 mb-3">
              <span
                aria-hidden="true"
                class="font-serif text-3xl md:text-4xl font-light leading-none text-sage/50 select-none shrink-0"
              >
                {s.number}
              </span>
              <h2
                id={headingId}
                class="font-serif text-2xl sm:text-3xl md:text-4xl font-medium tracking-tight text-caprock leading-tight"
              >
                <span class="sr-only">Series {s.number}. </span>
                {s.title}
              </h2>
            </div>

            <p class="slip-lede font-serif text-base leading-relaxed text-iron/80">{s.lede}</p>

            <div class="slip-rule">
            {href ? (
              <a
                href={href}
                class="enter inline-block py-1.5 font-mono text-[11px] uppercase tracking-widest text-redbed hover:opacity-60 transition-opacity"
                data-astro-prefetch="hover"
                data-slug={s.slug}
                data-plate={desk ? String(desk.index) : ''}
                data-aspect={desk ? desk.aspect.toFixed(4) : ''}
              >
                Step back to the desk &rarr;
              </a>
            ) : (
              <span class="inline-block py-1.5 font-mono text-[11px] uppercase tracking-widest text-iron/70">
                In preparation
              </span>
            )}
            </div>
          </div>

          {strip.length > 0 && (
            <div class="strip">
              {strip.map((t, k) => (
                <a
                  href={`/photography/${s.slug}?plate=${t.no}`}
                  class="strip-print"
                  style={`--tilt:${[-1.6, 1.1, -0.7, 1.8, -1.2, 0.6, -1.9][k % 7]}deg; --shift:${
                    (strip.length - 1 - k) * -12
                  }px; --i:${strip.length - 1 - k}`}
                >
                  <img src={t.src} alt={t.label} loading="lazy" decoding="async" width="280" />
                </a>
              ))}
            </div>
          )}
          </div>

          {/* The catchword. In a bound book the foot of a page carries
              the first word of the next one, so a reader knows what is
              coming and a binder knows the sheets are in order. The
              Register uses them already; this is the same device doing
              the same job, and it beats a bouncing chevron on both
              counts — it says how many are left and what they are,
              rather than restating that pages scroll.

              The last pane points at the plate index, so the album ends
              somewhere instead of simply stopping. */}
          <a class="catchword" href={next ? `#${next.slug}` : '/photography/plates'}>
            {next ? `${next.number}. ${next.title}` : 'Plate index'} &rarr;
          </a>

        </section>
      );
    })}

    {/* Shown at EVERY width now. It was lg-and-up, which meant that on
        a phone — where one pane fills the screen and nothing peeks over
        the fold — nothing indicated the album held more than one
        series. That is the fact a scroll hint should carry, and this is
        the element that carries it.

        Exposed to assistive tech rather than aria-hidden: these are
        tappable controls, and hiding a control a sighted touch user can
        press is worse than mildly duplicating the headings. Numerals
        appear from lg, where there is room for them.

        The rail-tick and rail-no CLASSES MATTER — the current-pane
        styling below hangs off them, and without them the observer sets
        data-current on an element nothing is listening to. */}
    <nav class="rail flex flex-col gap-2" aria-label="Series">
      {series.map((s) => (
        <a
          href={`#${s.slug}`}
          class="rail-mark"
          data-for={s.slug}
          aria-label={`Series ${s.number}, ${s.title}`}
        >
          <span class="rail-no">{s.number}</span>
          <span class="rail-tick"></span>
        </a>
      ))}
    </nav>
  </div>
</RootLayout>

<style>
  /* A pane is the viewport MINUS THE HEADER. #horizon-sticky is
     sticky top-0 with an opaque sky behind it, so it never scrolls
     away — 100svh would put the bottom of every pane, and the whole
     foot row with it, underneath the header's own height of content.

     --header-h is measured, not hardcoded: the header's height is
     2.5rem of sky (3.5rem from md) plus the signature, landmark and
     markers below it, and it moves with the breakpoint. The script
     sets it and keeps it current through a ResizeObserver.

     scroll-margin-top is the other half. scroll-snap-align: start
     aligns a pane's top edge with the top of the SCROLLPORT, which
     here is behind the header — so each pane needs its snap position
     pushed down by the same amount. */
  /* ── THE GUTTER ─────────────────────────────────────────────
     Crossing from one series to the next used to be a hard cut
     between two full-bleed photographs, which is the one moment the
     album read as a slideshow. In a bound book you pass THROUGH
     something. Now, as a pane leaves centre, the photograph contracts
     and the desk shows around all four edges, then closes as the next
     pane settles.

     It also fixes the first-paint problem: the desk is what this page
     is built around, and before this you could not see it existed
     without clicking or hovering.

     --gutter-t is 0 at rest and 1 at the seam. It is driven by a view
     progress timeline, so it runs on the compositor with no scroll
     listener at all. Where that is unsupported — Firefox still has it
     behind a flag — the property holds its initial 0 and the panes
     stay exactly as they ship today. That is the deliberate choice:
     no JS scroll handler on the one browser where scroll handlers on
     this site have hurt.

     --contract is the SINGLE quantity both this and the enter-hover
     foreshadow write. They are the same gesture at two depths, and
     giving them one variable is what stops them cancelling each other
     — two rules setting `transform` on .zoomer would have meant the
     later one won outright. */
  .pane {
    --gutter-depth: 0.075;
    --contract: max(calc(var(--gutter-depth) * var(--gutter-t)), var(--hover-contract, 0));
    /* 0 at rest, 1 when the desk is fully open. Drives everything that
       should cost nothing while the photograph fills the screen. */
    --reveal: min(1, calc(var(--contract) / var(--gutter-depth)));

    position: relative;
    height: calc(100svh - var(--header-h, 0px));

    /* THE DESK — the same sheet the light table lays its plates on.
       It used to be dust with a ruled ledger line, while the light
       table was canvas with contours: 2.11:1 apart, two different
       surfaces for the one thing the zoom insists is continuous. The
       contour sheet won because it is the better idea for photographs
       of land, and both pages now draw it from global.css.

       --plate-desk carries the paper's colour under the plate's own
       sun; without a date it resolves to the plain sheet. */
    background-color: var(--plate-desk, var(--color-desk, #F5F3ED));
    background-image: var(--topo-lines);
    background-size: 1800px 1800px;
    min-height: 30rem;
    overflow: hidden;
    scroll-snap-align: start;
    scroll-margin-top: var(--header-h, 0px);
  }

  @supports not (height: 100svh) {
    .pane {
      height: calc(100vh - var(--header-h, 0px));
    }
  }

  @keyframes album-gutter {
    0%,
    100% {
      --gutter-t: 1;
    }
    38%,
    62% {
      --gutter-t: 0;
    }
  }

  /* view(block) runs 0 as the pane enters the scrollport to 1 as it
     leaves, so 50% is the pane at rest in the middle. The flat span
     between 38% and 62% is what keeps the resting state EXACTLY as it
     was — full bleed, nothing shrunk, no shadow. */
  @supports (animation-timeline: view()) {
    .pane {
      animation-name: album-gutter;
      animation-timing-function: linear;
      animation-fill-mode: both;
      animation-duration: auto;
      animation-timeline: view(block);
    }
  }

  /* Still scroll-coupled rather than autoplaying, so it is not motion
     the reader did not ask for — but a 7.5% lurch is more than anyone
     with this set wants, so the depth drops to the same amount the
     hover foreshadow already used. */
  @media (prefers-reduced-motion: reduce) {
    .pane {
      --gutter-depth: 0.028;
    }
  }

  /* The light across the desk, ending at the sun. Costs nothing at
     rest: --reveal is 0 while the photograph fills the pane. */
  .pane::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: var(--reveal);
    background: linear-gradient(
      var(--plate-wash-angle, 140deg),
      transparent 18%,
      color-mix(
        in oklab,
        var(--plate-light, #fdf2dd) calc(var(--plate-wash, 0.1) * 100%),
        transparent
      )
        100%
    );
  }

  /* No background of its own — only the shadow paints. A low sun is
     filtered through a long atmospheric path, so its shadow is long,
     soft and WEAK; a high sun gives a short hard dark one. solar.ts
     computes that inverse relationship, and it is the thing that makes
     this read as light rather than as a drop-shadow being animated. */
  .cast {
    position: absolute;
    inset: 0;
    pointer-events: none;
    border-radius: calc(1px + 4px * var(--reveal));
    box-shadow: var(--plate-sh-dx, 6px) var(--plate-sh-dy, 10px)
      var(--plate-sh-blur, 24px) var(--plate-shadow, rgb(20 14 6 / 0.55));
    opacity: calc(var(--plate-sh-alpha, 0.3) * var(--reveal));
    transform: scale(calc(1 - var(--contract)));
  }

  /* The frame that contracts. Containment keeps the layout animation
     from reaching anything outside this box. */
  .zoomer {
    position: absolute;
    inset: 0;
    overflow: hidden;
    contain: layout paint;
  }

  .plate {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  /* ── the slip sits ON the desk ──────────────────────────────
     THE PAPER IS CALICHE, NOT CANVAS. --color-canvas is #FBFBF9, a
     relative luminance of 0.963 — on a full-bleed photograph it is
     almost always the brightest thing on screen, and against a bright
     Llano sky it measures 1.11:1, which is to say the same value. It
     did not sit on a bright cover so much as punch a hole in it.

     The gutter is what forced the question. It shows the desk, and the
     desk is dust — so at every seam you saw two papers that did not
     match: a warm ruled sheet, and a card 2.11:1 brighter than it.
     Caliche closes that to 1.68:1 while staying unmistakably lighter,
     and it comes out of the palette that is already there. That palette
     is a stratigraphic column — caliche, llano, ogallala, redbed,
     dockum, basement, the Llano Estacado's own section from the
     surface down — so the slip is now built from the top two layers
     and its small print from further down.

     The print mounts in the fan stay pure white on purpose. A
     photographic print IS mounted on white board and a catalogue slip
     IS buff card; that difference is real, not an inconsistency.

     shadow-2xl is Tailwind's generic 0 25px 50px — straight down,
     always. The print beside it now throws a shadow whose direction
     comes from where the sun actually was, so the two were two objects
     on the same desk lit by two different suns. The slip takes the same
     light at about a third the offset, because it lies much closer to
     the surface than the print does.

     Defaults are chosen so a series with no exposure date still gets a
     sensible straight-down shadow, close to what shadow-2xl gave.

     rounded-sm is gone with it. 2px is small, but a rounded corner is
     the specific detail that made this read as a UI card rather than a
     piece of paper. Paper has square corners. */
  .slip {
    max-width: 32rem;
    box-shadow: calc(var(--plate-sh-dx, 0px) * 0.32) calc(var(--plate-sh-dy, 40px) * 0.32)
      calc(var(--plate-sh-blur, 26px) * 0.55 + 4px) -6px
      color-mix(
        in oklab,
        var(--plate-shadow, #191410) calc(var(--plate-sh-alpha, 0.3) * 68%),
        transparent
      ),
      /* the top edge of the card catching the light. One inset pixel —
         paper has a thickness and a lit side, and this is the whole of
         what says so. */
      inset 0 1px 0 rgb(255 255 255 / 0.5);
  }

  /* A hairline above the action, the way a catalogue slip rules off its
     foot. Does more for the paper reading than anything else this small.
     Carries the margin the link used to hold itself. */
  .slip-rule {
    margin-top: 1.15rem;
    padding-top: 0.7rem;
    /* haze measures 1.03:1 on caliche — a rule you cannot see. */
    border-top: 1px solid var(--color-llano, #BFB49A);
  }

  /* ── the plate label ────────────────────────────────────────
     Top right, because that is the corner the sampler measures for it
     and the one corner no other element competes for: the rail is
     vertically centred, the foot and the catchword are at the bottom.

     It rides UP by --reveal, so at the seam it lands on the strip of
     desk that has just opened above the print. The same variable drives
     the hover foreshadow, so the two gestures agree without a second
     rule.

     THE COLOUR CROSSFADES. At rest it is the ink sampled from the sky
     it sits on; by the seam it is iron on canvas, because it is no
     longer on the photograph at all. Without this, a cover with a dark
     sky would take light ink and then vanish the moment it moved onto
     the pale desk. */
  .plateline {
    position: absolute;
    z-index: 2;
    top: 1.25rem;
    right: 1.25rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    pointer-events: none;
    transform: translateY(calc(-24px * var(--reveal)));
    color: color-mix(
      in oklab,
      var(--ink-plateline, rgb(255 255 255 / 0.78)) calc((1 - var(--reveal)) * 100%),
      var(--color-iron, #1a1919)
    );
    text-shadow: 0 0 calc(7px * var(--halo-plateline-strength, 0.8))
        color-mix(
          in oklab,
          var(--halo-plateline, rgb(0 0 0 / 0.55)) calc((1 - var(--reveal)) * 100%),
          transparent
        ),
      0 1px 3px
        color-mix(
          in oklab,
          var(--halo-plateline, rgb(0 0 0 / 0.55)) calc((1 - var(--reveal)) * 100%),
          transparent
        );
    transition: opacity 240ms ease;
  }

  @media (min-width: 1024px) {
    .plateline {
      top: 2rem;
      right: 3rem;
    }
  }

  /* ── the lede on a phone ────────────────────────────────────
     Measured at a 390px viewport, the ledes run 3 to 10 lines, so the
     slip plus the strip covered between 60% and 91% of the photograph
     — Water left about 60px of it visible — and was a different height
     on every pane, because Water's lede is 410 characters and the
     Courthouses one is 90.

     Three lines says what the series is. The rest is the pitch, and on
     a phone the photograph is a better pitch than 410 characters are.
     All four slips now land within a few pixels of each other, which
     matters as much as the height: the inconsistency was as
     distracting as the size.

     The full text STAYS IN THE DOM. This hides lines visually, it does
     not remove them, so a screen reader still gets the whole lede.

     THE DIAL: 3. Two is tighter; four gives most of Water back. */
  @media (max-width: 767px) {
    .slip-lede {
      display: -webkit-box;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 3;
      line-clamp: 3;
      overflow: hidden;
    }
  }

  /* Departure state. The slip and the nav wash leave first so the
     photograph is alone as it contracts. */
  /* ── the prints underneath ──────────────────────────────────
     They sit below the bottom edge with only their top margin
     showing, the way a stack of prints shows under the one you are
     looking at. Approaching the pane lifts them. The resting peek is
     larger on touch, where there is no hover to discover them with. */
  /* ── the bottom of the pane ─────────────────────────────────
     The slip and the prints share one row rather than being
     positioned independently. Two earlier attempts hung the strip off
     bottom: 0 and pushed it down by its own height, which meant the
     pane's overflow: hidden ate most of it and the only cure was
     guessing at a reveal amount. Worse, the reveal depended on hover,
     so on a phone the prints were never visible at all.

     Now nothing is hidden and nothing is clipped. On a narrow screen
     the prints stack above the slip (column-reverse); from md they sit
     opposite it on the same baseline. The slip keeps its width cap, so
     the two cannot collide however wide the run gets. */
  .foot {
    position: absolute;
    left: 1.25rem;
    right: 1.25rem;
    bottom: 4rem;
    z-index: 2;
    display: flex;
    flex-direction: column-reverse;
    align-items: flex-start;
    gap: 1.25rem;
    transition: opacity 240ms ease, transform 240ms ease;
  }

  /* The row starts at lg, not md. At md the slip's 32rem cap plus the
     fan plus the gap needs about 1090px and the row began at 768, so
     the slip was being squeezed at every middling width even before
     anything was hovered. Below lg they stack instead, where each gets
     the full width. */
  @media (min-width: 1024px) {
    .foot {
      left: 3rem;
      right: 3rem;
      bottom: 5.5rem;
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
      gap: 2rem;
    }
  }

  .strip {
    display: flex;
    align-items: flex-end;
    flex-shrink: 0;
    z-index: 1;
  }

  /* Above the fan, so a print that spreads left tucks behind the label
     rather than landing on top of it. */
  .slip {
    position: relative;
    z-index: 2;
  }

  /* Fanned, not spaced — a stack rather than a row of tiles. The
     overlap keeps the run bounded however many prints there are, and
     it opens out when you approach the pane, which is a better use of
     hover than making them appear at all. */
  .strip-print {
    display: block;
    padding: 4px;
    background: #fff;
    border-radius: 2px;
    box-shadow: 0 6px 18px rgb(0 0 0 / 0.3);
    transform: rotate(var(--tilt)) translateX(calc(var(--shift) * var(--spread)));
    transform-origin: bottom center;
    pointer-events: auto;
    transition: transform 260ms cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: 0ms;
  }

  .strip-print + .strip-print {
    margin-left: -2.5rem;
  }

  /* ── the fan deals itself out ───────────────────────────────
     The spread is a TRANSFORM, not a margin. Animating margin-left
     changed the strip's width, and since the strip is flex-shrink: 0
     and the slip is not, the slip absorbed the difference and visibly
     narrowed every time the pane was hovered. Transforms do not
     participate in layout, so the slip holds still.

     --shift runs leftward, computed per print in the template so the
     RIGHTMOST stays put. Spreading rightward would push the run off
     the edge, since the fan is right-aligned.

     --spread is 0 stacked, 1 open. Hover and arrival both set that ONE
     variable instead of each writing their own transform — the same
     reason --contract exists for the gutter and the foreshadow. Two
     rules setting transform on this element would mean the later one
     won outright, and the individual-print lift below would have had
     to know about both. */
  .pane {
    --spread: 0;
  }

  .pane:hover,
  .pane:focus-within {
    --spread: 1;
  }

  /* The gesture has never existed on a phone: the fan opened on hover,
     and touch does not hover. So where there is no pointer, ARRIVING at
     the pane opens it — the same crossing trackRail already reports for
     the rail, no second observer and no scroll handler.

     Gated on (hover: none) deliberately. On a desktop the stack at rest
     and the opening on approach is the behaviour that was designed, and
     making the current pane permanently open would take that away to
     fix a problem desktop does not have. */
  @media (hover: none) {
    .pane.is-current {
      --spread: 1;
    }
  }

  /* Staggered from the print that does not move, so they DEAL rather
     than slide as one block. The delay lives on the open state only:
     transitions read their timing from the style being moved TO, so
     closing collapses straight away instead of unwinding print by
     print. */
  .pane:hover .strip-print,
  .pane:focus-within .strip-print,
  .pane.is-current .strip-print {
    transition-delay: calc(var(--i, 0) * 38ms);
  }

  /* Fixed thumbnail box. Plates are a mix of portrait and landscape,
     and letting them size themselves gave a ragged run with no
     predictable height — which is also what made the reveal
     unguessable. */
  .strip-print img {
    display: block;
    width: 96px;
    height: 64px;
    object-fit: cover;
    border-radius: 1px;
  }

  /* Individual hover wins over the group spread — same specificity,
     later in the sheet — so a print you point at straightens and lifts
     out of the fan while its neighbours stay where the spread put
     them. */
  .strip-print:hover,
  .strip-print:focus-visible {
    transform: rotate(0deg) translateX(calc(var(--shift) * var(--spread))) translateY(-12px);
    transition-delay: 0ms;
    z-index: 3;
    position: relative;
  }



  /* ── foreshadowing the pull-back ────────────────────────────
     Hovering the enter link eases the photograph back by a hair, so a
     sliver of desk shows at the edges. The smallest possible preview
     of what the click does, and the reason the click needs no
     explaining. :has() is progressive enhancement — where it is
     unsupported nothing happens and nothing breaks. */
  .zoomer {
    transform: scale(calc(1 - var(--contract)));
    transition: transform 420ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* 0.028 is the old scale(0.972), unchanged — but written as a
     CONTRACTION so the gutter and this cannot overwrite one another.
     max() means the deeper of the two wins and the shallower never
     cancels it. */
  .pane:has(.enter:hover),
  .pane:has(.enter:focus-visible) {
    --hover-contract: 0.028;
  }

  /* The exit animates .zoomer's width/height/left/top to land on
     EXIT_WIDTH_VW exactly. Any contraction still applied is a scale on
     top of that, so the plate arrives at the light table 2.8% smaller
     than the contract says and the seam shows. Dropping the animation
     reverts --gutter-t to its registered initial 0; --hover-contract
     goes with it, since the pointer is still over the link at the
     moment of the click.

     This was true before the gutter existed — the hover foreshadow was
     already riding along into the handoff. */
  .pane.is-leaving {
    animation-name: none;
    animation-timeline: auto;
    --hover-contract: 0;
  }

  /* Snap, do not ease. .zoomer carries a 420ms transform transition, so
     easing the contraction away would run the photograph OUTWARD for
     the first 420ms of the 520ms contraction — a pop in the wrong
     direction at the exact moment the gesture has to read as one
     movement. A single-frame 2.8% correction under a contraction that
     is already running is invisible. */
  .pane.is-leaving .zoomer {
    transition: none;
  }

  .pane.is-leaving .cast {
    opacity: 0;
  }

  .pane.is-leaving .foot,
  .pane.is-leaving .plateline,
  .pane.is-leaving .catchword {
    opacity: 0;
    transform: translateY(8px);
    pointer-events: none;
  }

  /* Over the photograph, so it carries its own shadow rather than
     assuming the image behind it is dark. Neither this nor the rail
     can assume anything about a cover it has never seen. */
  .catchword {
    position: absolute;
    left: 50%;
    bottom: 1.5rem;
    z-index: 2;
    transform: translateX(-50%);
    padding: 0.5rem 0.75rem;
    white-space: nowrap;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    /* Sampled from the patch of cover this actually sits on, not from
       the image as a whole: an average over a bright sky and a dark
       foreground lands on a mid grey that is wrong at both ends. The
       polarity FLIPS per plate — a bright cover takes dark ink and a
       light halo, a dark one takes the opposite. It is the plate's own
       opposite, never a global 'make it darker'.

       Unsampled covers keep white-with-a-shadow, which is correct
       rather than broken. */
    color: var(--ink-catchword, rgb(255 255 255 / 0.72));
    text-shadow:
      0 0 calc(7px * var(--halo-catchword-strength, 0.8))
        var(--halo-catchword, rgb(0 0 0 / 0.55)),
      0 1px 3px var(--halo-catchword, rgb(0 0 0 / 0.55));
    transition: color 200ms ease, opacity 240ms ease;
  }

  .catchword:hover,
  .catchword:focus-visible {
    color: var(--ink-catchword, #fff);
    text-shadow:
      0 0 calc(10px * var(--halo-catchword-strength, 0.8))
        var(--halo-catchword, rgb(0 0 0 / 0.7)),
      0 1px 3px var(--halo-catchword, rgb(0 0 0 / 0.7));
  }

  /* ── the rail ───────────────────────────────────────────────
     It was a 1px line, 16px long, white at 60%, over photographs that
     are mostly bright sky — so it disappeared. Three things fix that,
     and none of them is "make it brighter", which only works until a
     cover has a white cloud where the rail sits.

     1. A DARK EDGE behind every light element, so contrast comes from
        the rail itself rather than from luck about the image. Same
        reasoning as the catchword's text-shadow. box-shadow and
        text-shadow rather than a filter on the group: filters are the
        family of thing that has been slow in Firefox here, and this
        buys nothing over the cheaper properties.
     2. A SPINE. Four loose marks read as debris; marks hanging off a
        vertical rule read as a scale, which is what it is.
     3. SIZE. 2px tall, and the numerals now show at every width —
        they were lg-only, which is where the rail was least needed. */
  .rail {
    position: fixed;
    right: 0.875rem;
    top: 50%;
    transform: translateY(-50%);
    z-index: 20;
    padding-right: 0.5rem;
    transition: opacity 240ms ease;
  }

  .rail::before {
    content: '';
    position: absolute;
    top: 0.5rem;
    bottom: 0.5rem;
    right: 0.5rem;
    width: 1px;
    /* The rail is FIXED and lives outside every pane, so it cannot
       inherit the current cover's ink. trackRail copies it across as
       the pane changes — the same observer that already knows which
       pane you are on. */
    background: color-mix(in oklab, var(--ink-rail, #fff) 42%, transparent);
    box-shadow: 0 0 4px var(--halo-rail, rgb(0 0 0 / 0.55));
  }

  @media (min-width: 1024px) {
    .rail {
      right: 1.5rem;
    }
  }

  .rail-mark {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.5rem;
    min-height: 26px;
  }

  .rail-no {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 10px;
    letter-spacing: 0.1em;
    color: color-mix(in oklab, var(--ink-rail, #fff) 68%, transparent);
    text-shadow: 0 0 calc(6px * var(--halo-rail-strength, 0.8)) var(--halo-rail, rgb(0 0 0 / 0.7)),
      0 1px 3px var(--halo-rail, rgb(0 0 0 / 0.7));
    transition: color 200ms ease;
  }

  .rail-tick {
    display: block;
    width: 14px;
    height: 2px;
    border-radius: 1px;
    background: color-mix(in oklab, var(--ink-rail, #fff) 68%, transparent);
    box-shadow: 0 0 calc(4px * var(--halo-rail-strength, 0.8)) var(--halo-rail, rgb(0 0 0 / 0.6));
    transition: width 200ms ease, background-color 200ms ease;
  }

  .rail-mark:hover .rail-tick,
  .rail-mark:focus-visible .rail-tick {
    width: 24px;
    background: var(--ink-rail, #fff);
  }

  .rail-mark:hover .rail-no,
  .rail-mark:focus-visible .rail-no {
    color: var(--ink-rail, #fff);
  }

  .album.is-leaving .rail {
    opacity: 0;
  }

  /* ── the rail knows where you are ───────────────────────────
     It was four identical marks with no current state, which is a
     scrollbar that tells you nothing. */
  .rail-mark[data-current='true'] .rail-tick {
    width: 30px;
    background: var(--ink-rail, #fff);
  }

  .rail-mark[data-current='true'] .rail-no {
    color: var(--ink-rail, #fff);
  }

  @media (prefers-reduced-motion: reduce) {
    .foot,
    .rail,
    .catchword,
    .plateline,
    .strip-print,
    .zoomer {
      transition: none;
    }

    /* The fan still opens — it is what tells you the series has more
       than one plate, and on a phone there is no hover to reveal it.
       It just arrives there instantly rather than dealing out. The
       previous rule cancelled the spread outright, which on touch
       meant the information was never available at all. */
    .pane:hover .strip-print,
    .pane:focus-within .strip-print,
    .pane.is-current .strip-print {
      transition-delay: 0ms;
    }

    .pane:has(.enter:hover) {
      --hover-contract: 0;
    }
  }
</style>

<style is:global>
  /* A custom property only INTERPOLATES if it is registered, and the
     gutter is nothing but an interpolation of this number. Unregistered
     it would jump 0 to 1 with no travel. Global because @property is
     document-scoped whatever block it is written in, and hiding it in a
     scoped sheet only makes that surprising later. */
  @property --gutter-t {
    syntax: '<number>';
    inherits: true;
    initial-value: 0;
  }

  /* Astro ships this only on routes rendering this component. Change
     `proximity` to `mandatory` for an uninterruptible snap.

     SNAPPING IS OFF UNTIL THE HEADER HAS BEEN MEASURED. Before the
     script runs, --header-h falls back to 0px — so a pane is a full
     100svh tall and its scroll-margin-top is 0, which puts its snap
     area at the header's full height instead of at 0. Proximity snap
     resolves that the only way it can: by scrolling the document down
     by exactly the height of the header, on load, before anyone has
     touched it.

     It shows on a phone and not a desktop because that is where the
     script lands late enough for the browser to lay out, snap and
     paint first. Turning snap on only once the measurement is in
     place removes the window entirely. Re-enabling it at scroll
     position 0 moves nothing, because by then pane one's snap area
     starts at 0 too. */
  html {
    scroll-snap-type: none;
    scroll-behavior: smooth;
  }

  html[data-album-ready] {
    scroll-snap-type: y proximity;
  }

  /* The catchword and the rail both navigate by fragment, and a jump
     cut between two full-screen photographs is disorienting. The
     restore path passes behavior: 'instant' explicitly, so returning
     from a desk still lands without an animated scroll. */
  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }
</style>

<script>
  const KEY = 'album:return';

  function init() {
    const album = document.querySelector<HTMLElement>('.album');
    if (!album || album.dataset.wired === '1') return;
    album.dataset.wired = '1';

    const exitVw = Number(album.dataset.exitVw ?? 34);

    trackHeaderHeight();
    restore();
    trackRail(album);

    album.addEventListener('click', (e) => {
      const link = (e.target as Element)?.closest<HTMLAnchorElement>('a.enter');
      if (!link) return;
      if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || (e as MouseEvent).button !== 0) return;

      const slug = link.dataset.slug ?? '';
      const plate = link.dataset.plate ?? '';
      const aspect = Number(link.dataset.aspect ?? 0);
      const pane = link.closest<HTMLElement>('.pane');
      const zoomer = pane?.querySelector<HTMLElement>('.zoomer');

      remember(slug);

      /* A reader who has pinched carries that magnification into the
         light table, which owns pinch itself. Only they need the hard
         load — everyone else gets the animation. */
      const pinched = (window.visualViewport?.scale ?? 1) > 1.01;
      const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const canZoom = plate !== '' && aspect > 0 && zoomer && !pinched && !still;

      if (!canZoom) {
        if (pinched) {
          e.preventDefault();
          window.location.assign(link.href);
        }
        return;
      }

      e.preventDefault();
      pane!.classList.add('is-leaving');
      album.classList.add('is-leaving');

      const w = (window.innerWidth * exitVw) / 100;
      const h = w / aspect;

      const anim = zoomer!.animate(
        [
          { width: '100%', height: '100%', left: '0px', top: '0px' },
          {
            width: `${Math.round(w)}px`,
            height: `${Math.round(h)}px`,
            left: `${Math.round((window.innerWidth - w) / 2)}px`,
            top: `${Math.round((pane!.clientHeight - h) / 2)}px`,
          },
        ],
        { duration: 520, easing: 'cubic-bezier(0.33, 0, 0.2, 1)', fill: 'forwards' },
      );

      const go = () => {
        const url = new URL(link.href, window.location.origin);
        url.searchParams.set('from', plate);
        window.location.assign(url.toString());
      };

      anim.finished.then(go).catch(go);
      /* If the animation never settles — a backgrounded tab, a browser
         that drops it — the reader is not left staring at a frozen
         photograph. */
      window.setTimeout(go, 900);
    });
  }

  /* The header is sticky and its height varies with breakpoint and
     content, so the pane height that depends on it has to be measured
     rather than assumed. Runs before restore(), so a returning reader
     is scrolled against the correct pane height rather than one that
     changes under them a frame later. */
  function hasSavedReturn() {
    try {
      return !!sessionStorage.getItem(KEY);
    } catch {
      return false;
    }
  }

  /* Arms the snap, and first undoes the load-time nudge if the browser
     managed one before the attribute landed — a slow phone can lay out,
     snap and paint before a module script executes. The correction is
     deliberately narrow: only a scroll position inside the header's own
     height, only with no fragment in the URL, and only when no return
     is pending, so a deep link or a reader coming back from a desk is
     never dragged to the top. */
  function armSnap(root: HTMLElement) {
    if (!location.hash && !hasSavedReturn()) {
      const h = parseFloat(getComputedStyle(root).getPropertyValue('--header-h')) || 0;
      if (window.scrollY > 0 && window.scrollY <= h + 4) {
        window.scrollTo({ top: 0, behavior: 'instant' as ScrollBehavior });
      }
    }
    root.setAttribute('data-album-ready', '');
  }

  function trackHeaderHeight() {
    const sticky = document.getElementById('horizon-sticky');
    const root = document.documentElement;

    if (!sticky) {
      /* No header on this render — hideNav, or the markup moved. Zero
         is right, not a guess: the panes get the whole viewport. */
      root.style.setProperty('--header-h', '0px');
      armSnap(root);
      return;
    }

    const set = () =>
      root.style.setProperty('--header-h', `${Math.round(sticky.getBoundingClientRect().height)}px`);
    set();
    armSnap(root);

    if ('ResizeObserver' in window) {
      const ro = new ResizeObserver(set);
      ro.observe(sticky);
      document.addEventListener('astro:before-swap', () => ro.disconnect(), { once: true });
    } else {
      window.addEventListener('resize', set);
    }
  }

  /* Warms a light table's HTML before anyone asks for it.

     The handoff is a real page load: the album's animation finishes,
     then the browser fetches the desk. If that fetch takes half a
     second the pull-back turns into a pause, and the one thing this
     page is built around stops working. Prefetching on approach means
     the document is already in cache when location.assign fires.

     data-astro-prefetch="hover" on the links covers a pointer, but
     only if prefetch is enabled in astro.config — and it does nothing
     at all on a touchscreen, where there is no hover to prefetch on.
     This covers both: by the time a reader has looked at a pane, its
     desk is warm. Once per series, and never against the reader's
     wishes — Save-Data and 2g mean they are paying for bytes and this
     one is speculative. */
  const warmed = new Set<string>();

  function warm(pane: Element) {
    const href = pane.querySelector<HTMLAnchorElement>('a.enter')?.href;
    if (!href || warmed.has(href)) return;

    const conn = (navigator as Navigator & { connection?: { saveData?: boolean; effectiveType?: string } })
      .connection;
    if (conn?.saveData || /(^|-)2g$/.test(conn?.effectiveType ?? '')) return;

    warmed.add(href);
    const link = document.createElement('link');
    link.rel = 'prefetch';
    link.as = 'document';
    link.href = href;
    document.head.appendChild(link);
  }

  /* Marks the pane filling most of the screen. threshold 0.5 with one
     pane per viewport means exactly one qualifies at a time, and
     mid-scroll the last to cross wins — which is the one you are
     moving toward. The same crossing is the cue to warm that pane's
     desk, which is why the two share an observer rather than running
     a second one over the same elements. */
  /* The rail is position: fixed and sits outside every pane, so it
     cannot inherit the current cover's sampled ink the way the
     catchword does. Copying three custom properties across on the
     crossing the observer already reports is the whole mechanism —
     no second observer, no scroll handler, and it does nothing at all
     for a cover that has not been sampled. */
  const TINT_VARS = ['--ink-rail', '--halo-rail', '--halo-rail-strength'];

  function carryTint(rail: HTMLElement | null, pane: Element) {
    if (!rail) return;
    const from = getComputedStyle(pane as HTMLElement);
    for (const name of TINT_VARS) {
      const value = from.getPropertyValue(name).trim();
      if (value) rail.style.setProperty(name, value);
      else rail.style.removeProperty(name);
    }
  }

  function trackRail(album: HTMLElement) {
    const marks = album.querySelectorAll<HTMLElement>('.rail-mark');
    if (!marks.length || !('IntersectionObserver' in window)) return;

    const rail = album.querySelector<HTMLElement>('.rail');
    const panes = album.querySelectorAll<HTMLElement>('.pane');

    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const id = entry.target.id;
          marks.forEach((m) => m.setAttribute('data-current', String(m.dataset.for === id)));
          /* Marks the pane you have arrived at. On a touch device that
             is what opens the print fan, which until now only ever
             opened on hover — a gesture a phone does not have. Four
             classList writes on a crossing that was already happening. */
          panes.forEach((p) => p.classList.toggle('is-current', p === entry.target));
          carryTint(rail, entry.target);
          warm(entry.target);
        }
      },
      { threshold: 0.5 },
    );

    album.querySelectorAll('.pane').forEach((p) => io.observe(p));
    document.addEventListener('astro:before-swap', () => io.disconnect(), { once: true });
  }

  function remember(slug: string) {
    try {
      sessionStorage.setItem(KEY, JSON.stringify({ slug, y: window.scrollY }));
    } catch {
      /* private mode; the album just opens at the top */
    }
  }

  function restore() {
    let saved: { slug?: string; y?: number } | null = null;
    try {
      const raw = sessionStorage.getItem(KEY);
      if (raw) saved = JSON.parse(raw);
      sessionStorage.removeItem(KEY);
    } catch {
      return;
    }
    if (!saved) return;

    const pane = saved.slug ? document.getElementById(saved.slug) : null;
    if (pane) {
      pane.scrollIntoView({ block: 'start', behavior: 'instant' as ScrollBehavior });
    } else if (typeof saved.y === 'number') {
      window.scrollTo({ top: saved.y, behavior: 'instant' as ScrollBehavior });
    }
  }

  if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
  document.addEventListener('astro:page-load', init);
  window.addEventListener('pageshow', (e) => {
    if ((e as PageTransitionEvent).persisted) {
      document.querySelectorAll('.pane.is-leaving').forEach((p) => p.classList.remove('is-leaving'));
      document.querySelector('.album')?.classList.remove('is-leaving');
      restore();
    }
  });
  init();
</script>