---
/**
 * src/pages/photography.astro — the album
 *
 * The three series as facing-page spreads, alternating sides. Driven
 * entirely by SERIES in src/data/photography.ts: cover image, lede,
 * plate label, and whether the entry links anywhere all come from
 * there, so a fourth series appears here the moment it's added, and
 * Cotton Gins becomes a link the moment `built` flips to true.
 *
 * The ledes moved here out of the light table's HUD, which was the
 * wrong posture for reading — this is where someone is choosing which
 * series to enter, which is the decision the text is written to inform.
 */
import RootLayout from '../layouts/RootLayout.astro';
import { getCovers } from '../data/photography';

const series = await getCovers();
---

<RootLayout title="Photography | Austin Allison">
  <div class="max-w-6xl mx-auto py-6 text-iron">

    <!-- Minimalist Catalog Header -->
    <header class="border-b border-haze pb-4 mb-16 flex flex-wrap justify-between items-end gap-4">
      <div>
        <span class="text-sm font-mono text-sage uppercase tracking-widest block mb-1">
          Series I &mdash; {series[series.length - 1]?.number}
        </span>
        <h1 class="font-serif text-4xl font-medium tracking-tight text-caprock">
          Visual Monographs of the American West
        </h1>
      </div>
      <a
        href="/photography/plates"
        class="font-mono text-[11px] uppercase tracking-widest text-sage hover:text-caprock transition-colors shrink-0"
      >
        Plate index &rarr;
      </a>
    </header>

    <!-- THE BOOK SPREADS -->
    <div class="space-y-32">
      {series.map((s, i) => {
        const href = s.built ? `/photography/${s.slug}` : null;
        /* data-astro-reload: a View Transition swaps the document
           without a real navigation, and the browser carries the visual
           viewport's pinch zoom straight across. The light table owns
           pinch (touch-none, for the board's own zoom), so a visitor
           who pinched here used to arrive magnified with no way back.
           A full load resets the visual viewport. The light table also
           detects and recovers from this on its own — belt and braces,
           but this way the reader never has to read an instruction. */
        const flipped = i % 2 === 1; // odd spreads put the plate on the right

        return (
          <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-16 items-start">

            {/* the plate */}
            <div class={`md:col-span-7 space-y-3 ${flipped ? 'md:order-2' : ''}`}>
              <div class="border border-iron/10 rounded-sm overflow-hidden p-3 bg-canvas shadow-lg">
                <div class="overflow-hidden bg-dust/35">
                  {href ? (
                    <a href={href} data-astro-reload>
                      <img
                        src={s.src}
                        srcset={s.srcset}
                        width={s.width}
                        height={s.height}
                        alt={`${s.title} — ${s.coverLabel}`}
                        loading={i === 0 ? 'eager' : 'lazy'}
                        fetchpriority={i === 0 ? 'high' : 'auto'}
                        decoding="async"
                        class="w-full h-auto hover:grayscale transition-all duration-700 ease-out"
                      />
                    </a>
                  ) : (
                    <img
                      src={s.src}
                      srcset={s.srcset}
                      width={s.width}
                      height={s.height}
                      alt={`${s.title} — ${s.coverLabel}`}
                      loading="lazy"
                      decoding="async"
                      class="w-full h-auto opacity-80"
                    />
                  )}
                </div>
              </div>

              <div class="flex justify-between items-baseline text-[11px] font-mono text-iron/50 uppercase tracking-wider px-1">
                <span>{s.coverLabel}</span>
                {!s.built && <span class="text-iron/35">In preparation</span>}
              </div>
            </div>

            {/* the facing page */}
            <div
              class={`md:col-span-5 h-full flex flex-col pt-4 md:pt-12 ${
                flipped ? 'md:order-1 md:text-right md:items-end' : ''
              }`}
            >
              <span class="font-serif text-5xl font-light text-sage/70 block leading-none select-none mb-4">
                {s.number}
              </span>

              <h2 class="font-serif text-3xl font-medium tracking-tight text-caprock leading-snug mb-4">
                {href ? (
                  <a href={href} data-astro-reload class="hover:text-sage transition-colors">{s.title}</a>
                ) : (
                  s.title
                )}
              </h2>

              <p class="text-md font-serif text-iron/80 leading-relaxed max-w-sm">
                {s.lede}
              </p>

              {href && (
                <a
                  href={`/photography/plates#${s.slug}`}
                  class="font-mono text-[10px] uppercase tracking-widest text-iron/45 hover:text-caprock transition-colors mt-6"
                >
                  Plate list &rarr;
                </a>
              )}
            </div>

          </div>
        );
      })}
    </div>

  </div>
</RootLayout>