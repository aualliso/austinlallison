---
// src/layouts/RootLayout.astro
import '../styles/global.css';
import { Image } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import signature from '../assets/signature.svg';
import Header from '../components/Header.astro'; // IMPORT THE NEW HEADER HERE
import Footer from '../components/Footer.astro'; // IMPORT THE NEW HEADER HERE

interface Props {
  title: string;
  description?: string;
  image?: string;
  /* `prose` was being destructured without ever being declared here.
     Harmless at runtime, but it means nothing type-checks it and
     nothing tells you the prop exists. */
  prose?: boolean;
  /* Edge to edge. Drops main's gutters, its vertical rhythm and its
     max-width so the page owns the full viewport.

     For pages whose content IS a photograph rather than a column of
     text: /photography, where each pane is 100svh and object-fit:
     cover. Without this, px-6 leaves a 24px strip of page colour down
     both sides on a phone, py-12 keeps the panes off the top and
     bottom, and max-w-7xl reintroduces the same bars on any display
     wider than 1280px.

     Use it sparingly. Text set edge to edge on a phone is unreadable,
     which is exactly what the default is protecting. */
  bleed?: boolean;
  hideNav?: boolean;
  hideFoot?: boolean;
}

const {
  title,
  description,
  image,
  prose,
  bleed = false,
  hideNav = false,
  hideFoot = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;



---

<!DOCTYPE html>
<html lang="en" class="bg-canvas text-iron antialiased scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="stylesheet" href="https://use.typekit.net/szd4cpt.css">
		<title>{title}</title>
		<link rel="canonical" href={canonical} />
{description && <meta name="description" content={description} />}

<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:url" content={canonical} />
{description && <meta property="og:description" content={description} />}
{image && <meta property="og:image" content={image} />}

<meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
{image && <meta name="twitter:image" content={image} />}
		<ClientRouter />
	</head>
	<body class="min-h-screen flex flex-col selection:bg-caprock/20 selection:text-caprock">
		
{!hideNav && <Header />}

<!-- The main page content container -->
	<main class:list={['flex-grow w-full', !bleed && 'max-w-7xl mx-auto px-6 py-12']}>

  		<div class:list={[prose && !bleed && 'prose prose-neutral', 'max-w-none font-sans']}>
    	<slot />
  		</div>
		</main>

<!-- The Large-Format Film Rebate & Geodetic Matrix -->

<!-- The Large-Format Film Rebate & Geodetic Matrix -->
{!hideFoot && (
  <Footer>
    <Fragment slot="signature" set:html={signature} />
  </Footer>
)}

	</body>
</html>
<style is:global>
  /* Premium architectural easing for the sliding bounding box */
  #active-loupe {
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), width 0.4s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease-out;
  }
</style>

<!-- Kinetic Loupe Tracking Engine -->
<script>
  const nav = document.getElementById('loupe-nav');
  const loupe = document.getElementById('active-loupe');
  const nodes = document.querySelectorAll('.nav-node');

  if (nav && loupe && nodes.length > 0) {
    nodes.forEach(node => {
      node.addEventListener('mouseenter', (e) => {
        const target = e.currentTarget as HTMLElement;
        
        // Calculate dynamic bounding box relative to the nav container
        const navRect = nav.getBoundingClientRect();
        const targetRect = target.getBoundingClientRect();
        
        const leftPos = targetRect.left - navRect.left;
        const targetWidth = targetRect.width;

        // Slide the loupe and snap its width perfectly around the hovered word
        loupe.style.opacity = '1';
        loupe.style.transform = `translateX(${leftPos}px)`;
        loupe.style.width = `${targetWidth}px`;
      });
    });

    // Reset smoothly when the cursor leaves the navigation area entirely
    nav.addEventListener('mouseleave', () => {
      loupe.style.opacity = '0';
    });
  }
</script>